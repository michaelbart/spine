# _workspace-route — shared library, sourced by phase-gate, path-escalate,
# dep-gate. Not a hook itself (no shebang execution path; nothing in
# .claude/settings.json wires it directly) — same convention as
# _bash-write-targets.
#
# Resolves which root's own `.spine/` config should govern an edit target:
# the project itself (plain single-repo project, or a workspace-native path
# like workspace.json/contracts/**), or — only when $project/workspace.json
# exists — the specific member repo the target's absolute path falls under,
# per workspace.json's repos[] list. This is the mechanical form of the
# rule that hooks load once, from the workspace, and route by path: a hook
# loaded at the workspace root is the only one that ever fires for an edit
# inside an added member-repo directory, so routing happens *inside* that
# one hook, not by installing a second copy of it in the member repo
# (which would never fire at all).
#
# Usage:
#   workspace_route "$project" "$file_path"
# Sets three globals (never prints — this runs in the caller's own shell,
# sourced, not a subshell, so plain variable assignment is simpler and
# safer than serializing paths that could themselves contain the field
# separator):
#   WSR_OWNER_ROOT  — absolute path whose .spine/ should be consulted, or
#                      empty if $file_path resolves under neither $project
#                      nor any registered repo (a genuinely unknown path).
#   WSR_OWNER_NAME  — the matched repo's `name` from workspace.json when the
#                      target falls under a member repo; the literal string
#                      "(workspace)" for a workspace-native path (inside the
#                      workspace root itself, not any member repo);
#                      "(unknown)" when WSR_OWNER_ROOT is empty; or, when
#                      $project/workspace.json does not exist at all (plain
#                      single-repo project), the **empty string** —
#                      deliberately distinct from "(workspace)", so a caller
#                      that only prefixes messages with "$WSR_OWNER_NAME:"
#                      when it's non-empty reproduces its pre-Extension-B,
#                      unqualified single-repo message text exactly. This is
#                      the specific detail that makes the routing helper's
#                      regression guarantee (below) hold at the message-text
#                      level, not just the allow/deny level.
#   WSR_REL         — $file_path relative to WSR_OWNER_ROOT ("." if it names
#                      the root itself), or $file_path verbatim when
#                      WSR_OWNER_ROOT is empty (nothing to make it relative
#                      to).
#
# **Regression guarantee**: when $project/workspace.json does not exist
# and $file_path resolves under $project, this always sets
# WSR_OWNER_ROOT="$project", WSR_OWNER_NAME="" (the empty string — see
# this function's own field-semantics comment above), WSR_REL=<$file_path
# relative to $project> — i.e. it degenerates to
# exactly the single-repo rel-path computation every hook already did
# before workspace routing existed. A caller that routes every target
# through this function instead of hand-rolling the rel computation gets
# byte-identical single-repo behavior for free; this is what makes "a
# single-repo project sees zero behavioral change" a property of the
# routing helper itself, not something each of the three call sites has to
# separately get right.
#
# **Out-of-project paths, single-repo mode (disclosed behavior change,
# not a silent regression):** a $file_path that does NOT resolve under
# $project gets the same WSR_OWNER_ROOT="", WSR_OWNER_NAME="(unknown)"
# treatment workspace mode already gave a genuinely-unmatched path (below)
# — previously this branch unconditionally claimed ownership
# (WSR_OWNER_ROOT="$project") for every path regardless of containment,
# which meant a hook whose allow/deny logic checks
# `[[ -n "$WSR_OWNER_ROOT" ]] || return 0` (path-escalate, dep-gate) could
# never actually exercise that early-return in single-repo mode, only in
# workspace mode. This symmetry fix means both hooks now correctly no-op
# on a path outside $project in either mode, and a caller like phase-gate
# that wasn't consulting this function's ownership result at all before
# can now do so to add the same "outside my project entirely" allowance.

# _wsr_collapse — collapses `.`/`..` segments out of an absolute path
# string purely lexically (no filesystem access, so it works for a path
# that doesn't exist yet — the common case for a about-to-be-written
# file). Without this, "$project/work/T1/../../etc/passwd" survives as a
# literal string all the way to every glob match below (protected-paths.conf,
# task_dir confinement, install-command manifests), and none of them match
# it even though it plainly resolves outside the boundary they exist to
# enforce — a bare `../` in an ordinary relative file_path silently walks
# past phase-gate/path-escalate/dep-gate. Confirmed by direct repro: a
# single ../.. component made an otherwise-denied protected-path write and
# an otherwise-confined out-of-task-dir write both pass clean.
_wsr_collapse() {
  # Bash 3.2 (macOS system bash) has no negative array subscripts
  # (${arr[-1]} is a 4.2+ feature) — last-index reads/removals below use
  # $((${#out[@]}-1)) instead, deliberately, not for style.
  local input="$1" seg out=() IFS='/' last
  local -a segs
  read -ra segs <<<"$input"
  # Same bash-3.2 "unbound variable under set -u on a legitimately empty
  # array" gotcha this function already guards below for "${out[@]}" —
  # found here too, on "${segs[@]}", by a fuzz harness feeding raw
  # unrestricted strings directly to this function (core-selftest's
  # "fuzz:" section). `read -ra segs <<<""` (input is the literal empty
  # string) leaves segs with zero elements, and bash 3.2 throws on
  # dereferencing that under nounset — every real caller in this codebase
  # is traced to never pass "" here (workspace_route/hooks all guard
  # file_path/task_id non-empty before this point), so this is not known
  # to be reachable through any hook today, but the function's own
  # contract ("never crashes, always returns at least /") shouldn't
  # depend on every future caller rediscovering that precondition by hand.
  if [[ ${#segs[@]} -gt 0 ]]; then
    for seg in "${segs[@]}"; do
      case "$seg" in
        ''|'.') continue ;;
        '..')
          if [[ ${#out[@]} -gt 0 ]]; then
            last="${out[$((${#out[@]}-1))]}"
            [[ "$last" != '..' ]] && unset 'out[$((${#out[@]}-1))]'
          fi
          ;;
        *) out+=("$seg") ;;
      esac
    done
  fi
  local result="" p
  # Bash 3.2 throws "unbound variable" under `set -u` when expanding
  # "${out[@]}" on a *legitimately empty* array (no empty-array exemption
  # until 4.4+) — confirmed by direct repro: a path that collapses all the
  # way to root (e.g. a `../` chain that cancels a whole absolute prefix,
  # or a relative $project silently mis-rooted to "/proj" by the
  # unconditional leading "/" below) hit this, the surrounding $(...) swallowed
  # the error and returned "", and the caller (_wsr_realpath's ancestor
  # walk) then recursed on that same non-progressing "" input forever —
  # each level a real subshell fork, confirmed as a genuine multi-thousand-
  # process runaway, not just a hypothetical crash. Guard the dereference
  # instead of ever letting it fire.
  if [[ ${#out[@]} -gt 0 ]]; then
    for p in "${out[@]}"; do result+="/$p"; done
  fi
  printf '%s' "${result:-/}"
}

# _wsr_realpath — physically resolves every symlink in $1's *existing*
# prefix, including $1 itself if it exists and is a symlink (bounded
# hop-count against a symlink cycle). Layered on top of _wsr_collapse
# (lexical `.`/`..` normalization is not enough on its own: a symlink
# doesn't need a `..` in it to point outside a confined tree). A path
# component that doesn't exist yet — the common case, a task about to
# create a new file — has no on-disk symlink-ness to resolve, so it's left
# exactly as _wsr_collapse already normalized it; only the existing prefix
# (ancestor directories, or the target itself if it's an existing file/
# symlink being overwritten) is canonicalized.
#
# Confirmed by direct repro this was a real gap, not a hypothetical one:
# a symlink planted *inside* a task folder pointing outside the project
# let phase-gate's containment check pass (the abs_path's string prefix
# was still "$task_dir/..." even though the write physically landed
# elsewhere); a symlink at an *unprotected*-looking name pointing *into* a
# protected path let path-escalate's glob check pass (the glob never saw
# the protected name, only the symlink's own). Both are invisible to
# _wsr_collapse alone since neither repro used a `..` segment.
_wsr_realpath() {
  local input hop=0 target dir base resolved_dir
  input="$(_wsr_collapse "$1")"
  while [[ -L "$input" && $hop -lt 40 ]]; do
    hop=$((hop + 1))
    target="$(readlink "$input" 2>/dev/null)"
    [[ -n "$target" ]] || break
    case "$target" in
      /*) input="$target" ;;
      *) input="$(dirname "$input")/$target" ;;
    esac
    input="$(_wsr_collapse "$input")"
  done
  if [[ -e "$input" ]]; then
    dir="$(cd -P "$(dirname "$input")" 2>/dev/null && pwd -P)"
    if [[ -n "$dir" ]]; then
      printf '%s' "$dir/$(basename "$input")"
    else
      printf '%s' "$input"
    fi
    return 0
  fi
  dir="$(dirname "$input")"
  base="$(basename "$input")"
  if [[ "$dir" == "$input" ]]; then
    printf '%s' "$input"
    return 0
  fi
  resolved_dir="$(_wsr_realpath "$dir")"
  printf '%s' "$resolved_dir/$base"
}

# _wsr_nfc <string> — Unicode-NFC-normalizes $1, or returns it unchanged if
# it's pure ASCII (the overwhelming common case — zero-cost fast path, no
# subprocess spawned) or if no normalizer is available. macOS APFS/HFS+ is
# normalization-insensitive: an NFC- and an NFD-encoded (byte-distinct) form
# of the same accented filename address the identical real file, but a bare
# bash glob comparison (`[[ "$rel" == $glob ]]`) is a byte comparison and
# _wsr_realpath's physical resolution (cd -P/pwd -P, readlink) preserves
# whichever byte form the caller supplied rather than canonicalizing it —
# confirmed by direct repro: a protected-paths.conf glob written in NFC form
# matched a file_path given in NFC form but silently missed the identical
# real file addressed via its NFD form. Bash 3.2 has no normalization
# primitive of its own, so this shells out to python3 (already how this
# machine's real environment is provisioned — confirmed present; no new
# core dependency is declared, since the ASCII fast path above means a
# python3-less system only loses coverage for the narrow non-ASCII case,
# never regresses the byte-identical-comparison behavior that predates this
# fix).
_wsr_nfc() {
  local s="$1"
  case "$s" in
    *[![:ascii:]]*) ;;
    *) printf '%s' "$s"; return 0 ;;
  esac
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys,unicodedata; sys.stdout.write(unicodedata.normalize("NFC", sys.stdin.read()))' <<<"$s" 2>/dev/null && return 0
  fi
  printf '%s' "$s"
}

# _wsr_glob_eq <rel> <glob> — true if <rel> matches the shell glob <glob>,
# trying a plain byte comparison first (fast path, and the only path a pure-
# ASCII $rel/$glob pair ever takes) and, only if that misses, retrying with
# both sides Unicode-NFC-normalized (_wsr_nfc) — closes the NFC/NFD bypass
# above without changing the result for any pair that already matched or
# already correctly didn't.
_wsr_glob_eq() {
  local rel="$1" glob="$2"
  [[ "$rel" == $glob ]] && return 0
  local rel_nfc glob_nfc
  rel_nfc="$(_wsr_nfc "$rel")"
  glob_nfc="$(_wsr_nfc "$glob")"
  [[ "$rel_nfc" == $glob_nfc ]]
}

# _wsr_owns <lexical-path> <resolved-path> <root> — true if <lexical-path>
# lexically falls under <root>, or (fallback — closes a real bypass: an
# absolute file_path reaching the project through a different real
# filesystem alias than $project was given in, e.g. macOS's /tmp vs.
# /private/tmp for the identical directory, defeated the lexical-only check
# below on its own, confirmed by direct repro) <resolved-path> falls under
# <root> once both sides are canonical. <root> must already be resolved
# (project_res, or a repo_path already passed through _wsr_realpath) —
# this never extends ownership to something merely reachable via an
# unrelated symlink from outside the tree, only recognizes the same real
# location addressed two different valid ways.
_wsr_owns() {
  local path="$1" path_res="$2" root="$3"
  case "$path" in "$root"|"$root"/*) return 0 ;; esac
  case "$path_res" in "$root"|"$root"/*) return 0 ;; esac
  return 1
}

workspace_route() {
  local project="$1" file_path="$2" project_res abs_path abs_path_res ws_conf best_root="" best_name="" i n repo_path repo_name

  # $project (CLAUDE_PROJECT_DIR, or a caller's $(pwd) fallback) must be
  # absolute. A relative value has no principled resolution here — this
  # runs in a hook subprocess whose cwd isn't reliably "the project" — and
  # every downstream comparison in this function assumes an absolute root
  # (a relative one gets silently mis-rooted to "/$project" by the leading
  # "/" _wsr_collapse always prepends, which previously produced a
  # confidently-wrong ownership decision rather than a refusal). Fail
  # closed instead of guessing.
  case "$project" in
    /*) ;;
    *)
      echo "_workspace-route: project root '$project' is not absolute — failing closed, cannot evaluate this write safely" >&2
      WSR_OWNER_ROOT=""; WSR_OWNER_NAME="(unknown)"; WSR_REL="$file_path"
      return 1
      ;;
  esac

  # project_res: the project root's own canonical location — resolves a
  # root-level alias (e.g. macOS's /tmp -> /private/tmp, or any project
  # reached through a symlinked ancestor directory) so the SAME project
  # reached two different ways is recognized as one project, not two.
  # This is the one place $project itself gets symlink-resolved; the loop
  # below then swaps that resolved root back into $abs_path's own prefix
  # (root-alias normalization only) rather than resolving $abs_path
  # wholesale, which matters for the reason in the next comment.
  project_res="$(_wsr_realpath "$project")"

  case "$file_path" in
    /*) abs_path="$file_path" ;;
    *) abs_path="$project/$file_path" ;;
  esac
  abs_path="$(_wsr_collapse "$abs_path")"
  case "$abs_path" in
    "$project"/*) abs_path="$project_res/${abs_path#"$project"/}" ;;
    "$project") abs_path="$project_res" ;;
  esac
  # Ownership (which root's .spine/ governs this write, WSR_OWNER_ROOT/NAME)
  # is decided from this root-alias-normalized-but-otherwise-LEXICAL path —
  # every symlink strictly inside the project tree (a task folder, a
  # protected path) is deliberately left unresolved here, never from the
  # fully symlink-resolved one. This is deliberate, not an oversight: a
  # file_path that's lexically outside $project (e.g. a path in the user's
  # home directory) is out of scope for every caller of this function
  # regardless of what a symlink somewhere might resolve to, and must keep
  # getting the disclosed out-of-project allowance. Ownership determined
  # from the *fully* resolved path instead would wrongly grant that same
  # allowance to a file_path that's lexically *inside* the project (or a
  # task folder) but symlinks its way out — exactly backwards, since
  # that's precisely the case a caller needs to see as "in scope, now go
  # check where it actually lands." WSR_REL below is the one place full
  # resolution matters: it's what protected-path globs and task_dir
  # containment actually compare against, so a symlink can't hide a
  # write's real destination once ownership has already placed it in
  # scope.
  abs_path_res="$(_wsr_realpath "$abs_path")"

  ws_conf="$project_res/workspace.json"
  if [[ ! -f "$ws_conf" ]]; then
    if _wsr_owns "$abs_path" "$abs_path_res" "$project_res"; then
      WSR_OWNER_ROOT="$project_res"; WSR_OWNER_NAME=""
      [[ "$abs_path_res" == "$project_res" ]] && WSR_REL="." || WSR_REL="${abs_path_res#"$project_res"/}"
    else
      WSR_OWNER_ROOT=""; WSR_OWNER_NAME="(unknown)"; WSR_REL="$file_path"
    fi
    return 0
  fi

  # Workspace mode. Longest-prefix match across repos[] so a repo nested
  # inside another repo's path (unusual, but not forbidden) resolves to the
  # more specific owner rather than whichever entry happened to come first.
  # Matched against the lexical $abs_path for the same reason as above.
  n="$(jq '(.repos // []) | length' "$ws_conf" 2>/dev/null || echo 0)"
  for ((i = 0; i < n; i++)); do
    repo_path="$(jq -r --argjson i "$i" '.repos[$i].path // empty' "$ws_conf")"
    repo_name="$(jq -r --argjson i "$i" '.repos[$i].name // empty' "$ws_conf")"
    [[ -n "$repo_path" ]] || continue
    # Fully resolved, not just lexically collapsed — repo_path is a whole
    # root by itself (trusted workspace.json config, not something built
    # by extending an untrusted file_path past it the way $abs_path's
    # interior is), so it needs the same root-alias normalization $project
    # gets via $project_res, for the same reason: a member repo registered
    # or reached through a symlinked ancestor directory must still be
    # recognized as itself.
    repo_path="$(_wsr_realpath "$repo_path")"
    if _wsr_owns "$abs_path" "$abs_path_res" "$repo_path"; then
      if [[ ${#repo_path} -gt ${#best_root} ]]; then
        best_root="$repo_path"
        best_name="$repo_name"
      fi
    fi
  done

  if [[ -n "$best_root" ]]; then
    WSR_OWNER_ROOT="$best_root"
    WSR_OWNER_NAME="${best_name:-$best_root}"
    if [[ "$abs_path_res" == "$best_root" ]]; then
      WSR_REL="."
    else
      WSR_REL="${abs_path_res#"$best_root"/}"
    fi
    return 0
  fi

  if _wsr_owns "$abs_path" "$abs_path_res" "$project_res"; then
    WSR_OWNER_ROOT="$project_res"; WSR_OWNER_NAME="(workspace)"
    [[ "$abs_path_res" == "$project_res" ]] && WSR_REL="." || WSR_REL="${abs_path_res#"$project_res"/}"
  else
    WSR_OWNER_ROOT=""; WSR_OWNER_NAME="(unknown)"; WSR_REL="$file_path"
  fi
  return 0
}
