# _bash-write-targets — shared library, sourced by phase-gate and
# path-escalate. Not a hook itself (no shebang execution path; nothing in
# .claude/settings.json wires it directly).
#
# Extracts candidate file-mutation targets from a Bash `tool_input.command`
# string, for the same hooks that already gate Edit/Write. This is a gate,
# not a shell parser: it recognizes common file-mutating shapes (output
# redirection, in-place editors, tee, cp/mv/install, truncate, dd, and —
# added after six audit rounds tested every *write* bypass shape but never
# a *delete* one — rm, unlink, git rm, git checkout -- <path>, and git
# restore <path>) via regex/token heuristics, not a real shell grammar.
# Deliberately conservative in one direction only — a write-shaped command
# whose target can't be confidently resolved is reported as UNRESOLVED
# rather than silently dropped, so the caller can fail closed.
#
# Deletion is not a lesser case of a write: `rm .spine/protected-paths.conf`
# or `rm -rf work/<task-id>/` previously sailed through phase-gate/
# path-escalate/dep-gate with zero scrutiny — no deny, no ask — despite
# being at least as consequential as an unauthorized write (destructive,
# unrecoverable without git). The fix routes every deletion target through
# the exact same PATH:/UNRESOLVED: emission every other block here already
# uses, so it gets the exact same containment/protected-path/manifest
# checks a write would — no new decision logic in any of the three hooks,
# only new target extraction here.
#
# Deliberately NOT covered by the new deletion detection (disclosed, not
# an oversight): a bare `git checkout <branch>` (no literal `--`) switches
# branches and can rewrite arbitrary tracked files project-wide, but isn't
# a per-path mutation this token-level extractor tries to model; neither is
# `git reset --hard` or `git clean`. Each is a whole-tree operation, a
# different class of risk than the per-path targets this file extracts
# elsewhere, and deserves its own consideration rather than being folded in
# here as an afterthought.
#
# `ln` is included (not just cp/mv/install) because a symlink's own
# destination path is itself a write target — direct repro showed
# `ln -s <target> work/T1/x` going completely unrecognized (no PATH, no
# UNRESOLVED, nothing) before this was added, after which a later
# Edit/Write to the new symlink's name walked straight past
# phase-gate/path-escalate's containment/glob checks since they compared
# strings, not resolved locations. _path-route's _pr_realpath closes
# the same gap for a symlink that already existed before this Bash call
# ran; this closes it for one created live, in the same task.
#
# Usage:
#   bash_write_targets "$command"
# Prints zero or more lines to stdout, each one of:
#   PATH:<resolved-or-relative-path>   — a concrete candidate target
#   UNRESOLVED:<reason>                — a write-shaped command whose
#                                         target(s) could not be confidently
#                                         extracted or whose working
#                                         directory is ambiguous (a `cd` was
#                                         found earlier in the same command)
#
# Known, disclosed gaps (see docs/tradeoffs.md, "Measured tradeoffs"):
#   - sed/perl -i with multiple trailing file arguments: only the last
#     token of the matched segment is taken as the target. A command
#     rewriting several files in one `sed -i ... f1 f2 f3` invocation is
#     only checked against f3.
#   - Chained commands are split naively on `;`, `&&`, `||`, `|`, and
#     newlines — a separator embedded inside a quoted string or a nested
#     `$(...)` will mis-split. This can only produce spurious UNRESOLVED
#     findings (fail closed), never a missed target being silently accepted
#     as a plain PATH.
#   - A relative target after a `cd` is resolved against that directory only
#     for the simple, exact case: a literal `cd <dir>` joined to what follows
#     by `&&` only (no `;`, `||`, `&`, groups, or substitutions anywhere in
#     the command, and every `cd` accounted for). Anything else marks every
#     later relative target UNRESOLVED. Targets before the first `cd` are
#     relative to the project, as they run first.
#   - A `$NAME` / `${NAME}` in a target is replaced only when the same command
#     earlier assigned NAME a plain literal (`T=20261001-x; ... > work/$T/class`)
#     and no `&&`, `||` or `|` came before that assignment; an assignment after
#     one of those, a command substitution, `read`/`for`/`eval`/`unset`... and
#     anything else leave the variable unknown and the target UNRESOLVED.
#   - Text inside single quotes, and inside double quotes without `$(` or a
#     backtick, is data (a `>` in a regex or an arrow in a string is not a
#     redirect), and the body of a `cat`/`tee` heredoc is data. Neither
#     applies when the command could execute that text: eval, source, awk,
#     xargs, find, a shell or interpreter given inline code (-c, -e, -p...), a
#     heredoc fed to an interpreter, or a pipe into a shell turns this masking
#     off and the old, stricter scan applies.

_bwt_is_devnull_like() {
  case "$1" in
    /dev/null|/dev/stdout|/dev/stderr|/dev/tty|/dev/console) return 0 ;;
    *) return 1 ;;
  esac
}

_bwt_is_confidently_resolvable() {
  # Rejects targets containing shell metacharacters we won't try to expand:
  # variable/command substitution, globs, tilde, quotes left dangling.
  case "$1" in
    *'$'*|*'`'*|*'*'*|*'?'*|*'['*|*'~'*|*'"'*|*"'"*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

_bwt_emit() {
  local target="$1"
  if _bwt_is_devnull_like "$target"; then
    return 0
  fi
  if ! _bwt_is_confidently_resolvable "$target"; then
    echo "UNRESOLVED:target '$target' contains a variable/glob/quote this gate won't expand"
    return 0
  fi
  echo "PATH:$target"
}

# The directory later relative targets resolve against within one call:
# "" = the project root, "?" = unknown, anything else = a literal directory.
_bwt_cwd=""
# Literal variables assigned earlier in the same command, one NAME=value per line.
_bwt_vars=""

_bwt_target() {
  # _bwt_target <what> <path> — report one write target, resolved against _bwt_cwd.
  local what="$1" t="$2" kv n v
  if [[ "$t" == *'$'* && -n "$_bwt_vars" ]]; then
    while IFS= read -r kv; do
      [[ -n "$kv" ]] || continue
      n="${kv%%=*}"; v="${kv#*=}"
      t="${t//\$\{$n\}/$v}"; t="${t//\$$n/$v}"
    done <<<"$_bwt_vars"
  fi
  if [[ "$t" != /* ]]; then
    if [[ "$_bwt_cwd" == "?" ]]; then
      echo "UNRESOLVED:relative $what '$t' after a 'cd' earlier in the same command — working directory can't be confidently determined"
      return 0
    fi
    [[ -z "$_bwt_cwd" ]] || t="$_bwt_cwd/$t"
  fi
  _bwt_emit "$t"
}

_bwt_mask() {
  # Blank out the inside of quoted strings so a `>` or a command-like word in
  # data is not mistaken for shell syntax. Quotes stay in place. A double-quoted
  # string holding `$(` or a backtick, or any unbalanced quote, is left as is.
  awk '{
    n = length($0); out = ""; q = ""; bad = 0
    for (i = 1; i <= n; i++) {
      c = substr($0, i, 1)
      if (q == "") {
        out = out c
        if (c == "\\") { i++; out = out substr($0, i, 1) }
        else if (c == "\047" || c == "\"") q = c
      } else if (q == "\047") {
        if (c == "\047") { q = ""; out = out c } else out = out "_"
      } else {
        if (c == "\\") { out = out "__"; i++ }
        else if (c == "\"") { q = ""; out = out c }
        else if (c == "`" || (c == "$" && substr($0, i + 1, 1) == "(")) { bad = 1; break }
        else out = out "_"
      }
    }
    if (bad || q != "") print $0; else print out
  }' <<<"$1"
}

_bwt_strip_heredocs() {
  # Drop the body of a heredoc whose command line is only `cat` and/or `tee`
  # (the usual way a file is written); the redirects on that line stay. A heredoc
  # fed to anything else, or with no closing delimiter, is kept untouched.
  awk '{ L[NR] = $0 } END {
    for (i = 1; i <= NR; i++) {
      line = L[i]; print line
      if (match(line, /<<-?[ \t]*["\047]?[A-Za-z_][A-Za-z0-9_]*["\047]?/)) {
        d = substr(line, RSTART, RLENGTH); sub(/^<<-?[ \t]*["\047]?/, "", d); sub(/["\047]$/, "", d)
        m = split(line, parts, /&&|\|\||;|\|/); ok = 1
        for (k = 1; k <= m; k++) {
          t = split(parts[k], w, /[ \t]+/); f = ""
          for (j = 1; j <= t; j++) if (w[j] != "" && w[j] !~ /^[A-Za-z_][A-Za-z0-9_]*=/) { f = w[j]; break }
          if (f != "cat" && f != "tee") ok = 0
        }
        if (!ok) continue
        for (e = i + 1; e <= NR; e++) { x = L[e]; sub(/^\t+/, "", x); if (x == d) break }
        if (e <= NR) i = e
      }
    }
  }' <<<"$1"
}

_bwt_runs_quoted_text() {
  # True when the command could run quoted or heredoc text as code. eval, source,
  # awk, xargs, find, watch and parallel always treat a string argument as code or
  # commands. A shell or language interpreter does so only in an inline form: a
  # flag that carries the program (-c, -e, -p...) right after it, a heredoc, or a
  # pipe into a shell. `python3 script.py "a > b"` runs a file; its quoted
  # arguments are data.
  local c="$1" w='(^|[;&|[:space:](`])'
  local interps='((ba|z|da|k|c)?sh|python[0-9.]*|node|nodejs|deno|bun|perl|ruby|php|lua|osascript)'
  grep -qE "${w}(eval|source|awk|gawk|xargs|find|watch|parallel)([[:space:]]|\$)|(^|[[:space:]])\.[[:space:]]" <<<"$c" && return 0
  grep -qE "${w}${interps}([[:space:]]+-[^[:space:]]+)*[[:space:]]+-[A-Za-z]*[ceEpr][A-Za-z]*([[:space:]]|\$)" <<<"$c" && return 0
  grep -qE "${w}${interps}([[:space:]]|\$)" <<<"$c" || return 1
  grep -qE '<<|\|[[:space:]]*(ba|z|da|k|c)?sh([[:space:]]|$)' <<<"$c"
}

bash_write_targets() {
  local command="$1"
  [[ -n "$command" ]] || return 0

  # A backslash at the end of a line continues the command on the next one; join
  # them so a target on a later line is read together with its command.
  command="$(awk '{ if (sub(/\\$/, "")) printf "%s ", $0; else print }' <<<"$command")"

  # Fast path: nothing about this command looks write-shaped. Keeps the
  # overwhelming majority of Bash calls (git status, flutter test, grep,
  # ls, ...) out of the extraction logic entirely — this is what keeps the
  # widened matcher from becoming a blanket deny.
  if ! grep -qE '(^|[^0-9&])[0-9]*>{1,2}|\b(sed|perl)\b.*([[:space:]]-[A-Za-z]*i|--in-place)|\btee\b|\bln\b|\bcp\b|\bmv\b|\binstall\b|\btruncate\b|\bdd\b[[:space:]].*\bof=|\brm\b|\bunlink\b|\bgit\b.*\b(rm|checkout|restore)\b' <<<"$command"; then
    return 0
  fi

  # Could this command execute text that sits inside quotes or a heredoc?
  local interp=0
  if _bwt_runs_quoted_text "$command"; then interp=1; fi
  [[ "$interp" -eq 1 ]] || command="$(_bwt_strip_heredocs "$command")"

  # Working directory. Only the exact `cd <literal> && ...` chain is tracked
  # (see the header); every other `cd`, pushd, popd, group, substitution or
  # background job leaves later relative targets unknown.
  _bwt_cwd=""; _bwt_vars=""
  local cd_words
  cd_words="$(grep -oE '(^|[;&|[:space:](`{])(cd|pushd|popd)([[:space:]]|$)' <<<"$command" | wc -l | tr -d ' ')"
  if [[ "$cd_words" -gt 0 ]] && { [[ "$interp" -eq 1 ]] || grep -qE '[(){}`]|(^|[^&>])&($|[^&>0-9])' <<<"$command"; }; then
    _bwt_cwd="?"
  fi

  # Split into segments on ; && || | and newlines — naive, best-effort. The
  # separators stay in the list as their own entries so a `cd` can be judged by
  # what joins it to its neighbours.
  local -a items=()
  local IFS_old="$IFS" normalized item
  normalized="$(printf '%s' "$command" | sed -E 's/(&&|\|\||;|\|)/\
\1\
/g')"
  while IFS= read -r item || [[ -n "$item" ]]; do items+=("$item"); done <<<"$normalized"

  local seg seg_m sep="start" sep_before next_sep idx=0 n=${#items[@]} w
  local cd_arg cd_seen=0 uncond=1 an av
  for ((idx = 0; idx < n; idx++)); do
    seg="${items[idx]}"
    case "$seg" in '&&'|'||'|';'|'|') sep="$seg"; continue ;; esac
    [[ -n "${seg// /}" ]] || continue
    sep_before="$sep"; sep=";"
    case "$sep_before" in '&&'|'||'|'|') uncond=0 ;; esac   # two segments with no marker between them were split by a newline
    next_sep=";"
    if [[ $((idx + 1)) -lt $n ]]; then
      case "${items[idx + 1]}" in '&&'|'||'|';'|'|') next_sep="${items[idx + 1]}" ;; esac
    else
      next_sep="end"
    fi

    # First two whitespace-separated tokens of this segment specifically —
    # used below to detect rm/unlink/git-rm/git-checkout/git-restore as the
    # segment's actual *command*, never as a \b-bounded substring match
    # inside an unrelated filename (\b treats a hyphen as a word boundary: a
    # `mv a.txt some-rm-thing.txt` segment must never read as an `rm`).
    local _bwt_cmd1 _bwt_cmd2
    _bwt_cmd1="$(printf '%s' "$seg" | sed -E 's/^[[:space:]]+//' | awk '{print $1}')"
    _bwt_cmd2="$(printf '%s' "$seg" | sed -E 's/^[[:space:]]+//' | awk '{print $2}')"

    # --- variables: a lone literal assignment before any conditional separator ---
    if [[ "$seg" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=([^[:space:]]*)[[:space:]]*$ ]]; then
      an="${BASH_REMATCH[2]}"; av="${BASH_REMATCH[3]}"
      _bwt_vars="$(grep -v "^$an=" <<<"$_bwt_vars" || true)"
      if [[ "$uncond" -eq 1 && -n "$av" ]] && _bwt_is_confidently_resolvable "$av" && [[ "$av" != *'{'* && "$av" != *'}'* ]]; then
        _bwt_vars="${_bwt_vars:+$_bwt_vars
}$an=$av"
      fi
      continue
    fi
    if [[ -n "$_bwt_vars" ]] && grep -qE '(^|[;&|[:space:](`])(read|for|unset|eval|declare|local|typeset|mapfile|readarray)([[:space:]]|$)|printf[[:space:]]+-v|\(\(' <<<"$seg"; then
      _bwt_vars=""
    fi

    # --- cd: tracked only in the exact case described in the header ---
    if [[ "$cd_words" -gt 0 && "$_bwt_cwd" != "?" ]]; then
      if [[ "$_bwt_cmd1" == "cd" ]]; then
        cd_arg="$(printf '%s' "$seg" | sed -E 's/^[[:space:]]*cd[[:space:]]+//; s/[[:space:]]+$//')"
        if [[ "$cd_arg" != *[[:space:]]* && "$cd_arg" != -* && -n "$cd_arg" && "$cd_arg" != "$seg" ]] \
           && _bwt_is_confidently_resolvable "$cd_arg" \
           && [[ "$sep_before" == "start" || "$sep_before" == "&&" ]] && [[ "$next_sep" == "&&" ]]; then
          case "$cd_arg" in
            /*) _bwt_cwd="$cd_arg" ;;
            *) _bwt_cwd="${_bwt_cwd:+$_bwt_cwd/}$cd_arg" ;;
          esac
        else
          _bwt_cwd="?"
        fi
        cd_seen=1
        continue
      fi
      if grep -qE '(^|[;&|[:space:](`{])(cd|pushd|popd)([[:space:]]|$)' <<<"$seg"; then
        _bwt_cwd="?"   # a cd the splitter did not see as a command of its own
      elif [[ "$cd_seen" -eq 1 ]]; then
        case "$sep_before" in ';'|'||') _bwt_cwd="?" ;; esac   # runs whether or not the cd worked
      fi
    fi

    seg_m="$seg"; [[ "$interp" -eq 1 ]] || seg_m="$(_bwt_mask "$seg")"

    # --- output redirection: >, >>, N>, N>>, but not N>&M (fd dup) ---
    local redir tgt
    while read -r redir; do
      [[ -n "$redir" ]] || continue
      tgt="${redir#*>}"
      tgt="${tgt#>}"
      tgt="$(printf '%s' "$tgt" | sed -E 's/^[[:space:]]+//; s/[[:space:]].*$//')"
      [[ -n "$tgt" ]] || continue
      [[ "$tgt" == "&"* ]] && continue
      _bwt_target "redirect target" "$tgt"
    done < <(grep -oE '[0-9]*>{1,2}[[:space:]]*[^[:space:];&|]+' <<<"$seg_m")

    # --- sed/perl -i: take the last whitespace token of the segment ---
    if grep -qE '\b(sed|perl)\b' <<<"$seg_m" && grep -qE '(^|[[:space:]])(-[A-Za-z]*i[A-Za-z0-9.]*|--in-place[^[:space:]]*)([[:space:]]|$)' <<<"$seg_m"; then
      _bwt_target "in-place-edit target" "$(printf '%s' "$seg" | awk '{print $NF}')"
    fi

    # --- tee: all non-flag trailing tokens, stopping at the next shell
    # operator (<, <<, <<<, >, >>, &, |, ;) since those aren't tee's file
    # arguments (redirection into/out of the tee command itself) ---
    if grep -qE '\btee\b' <<<"$seg_m"; then
      local seen_tee=0
      for w in $seg; do
        if [[ "$seen_tee" -eq 0 ]]; then
          [[ "$w" == "tee" ]] && seen_tee=1
          continue
        fi
        case "$w" in
          '<'*|'>'*|'&'*|'|'*|';'*) break ;;
        esac
        [[ "$w" == -* ]] && continue
        _bwt_target "tee target" "$w"
      done
    fi

    # --- ln/cp/mv/install: destination is the arg after -t, else the last
    # non-flag token. `ln -s TARGET LINKNAME` counts: planting a symlink with an
    # unremarkable name that a later Edit/Write resolves through is a bypass of
    # the containment and glob checks. Catching the `ln` here is the first of two
    # layers; the second is _path-route's _pr_realpath, which resolves an
    # already-existing symlink however it got there. ---
    if grep -qE '\b(ln|cp|mv|install)\b' <<<"$seg_m"; then
      local -a nonflag=()
      local dest="" take_next=0
      for w in $seg; do
        if [[ "$take_next" -eq 1 ]]; then
          dest="$w"; take_next=0; continue
        fi
        if [[ "$w" == "-t" ]]; then take_next=1; continue; fi
        [[ "$w" == -* ]] && continue
        nonflag+=("$w")
      done
      if [[ -z "$dest" && "${#nonflag[@]}" -gt 1 ]]; then
        dest="${nonflag[${#nonflag[@]}-1]}"
      fi
      [[ -z "$dest" ]] || _bwt_target "ln/cp/mv/install destination" "$dest"
    fi

    # --- truncate: all non-flag tokens, skipping -s/--size's argument ---
    if grep -qE '\btruncate\b' <<<"$seg_m"; then
      local skip_next=0
      for w in $seg; do
        if [[ "$skip_next" -eq 1 ]]; then skip_next=0; continue; fi
        if [[ "$w" == "-s" || "$w" == "--size" ]]; then skip_next=1; continue; fi
        [[ "$w" == -* ]] && continue
        [[ "$w" == "truncate" ]] && continue
        _bwt_target "truncate target" "$w"
      done
    fi

    # --- dd of=path ---
    if grep -qE '\bdd\b' <<<"$seg_m"; then
      local ofval
      ofval="$(grep -oE 'of=[^[:space:]]+' <<<"$seg" | head -1 | sed -E 's/^of=//')"
      [[ -z "$ofval" ]] || _bwt_target "dd of= target" "$ofval"
    fi

    # --- rm/unlink: every non-flag token is its own delete target — no
    # source/dest split the way cp/mv has, every argument names something
    # to remove. Requires the segment's literal first token, per _bwt_cmd1
    # above, not a substring match. ---
    if [[ "$_bwt_cmd1" == "rm" || "$_bwt_cmd1" == "unlink" ]]; then
      local seen_cmd=0
      for w in $seg; do
        if [[ "$seen_cmd" -eq 0 ]]; then seen_cmd=1; continue; fi
        [[ "$w" == -* ]] && continue
        _bwt_target "$_bwt_cmd1 target" "$w"
      done
    fi

    # --- git rm / git restore: every non-flag token after the subcommand is a
    # target (restore under --staged too — index-only, flagged anyway, the same
    # conservative bias this whole file states). A space-separated `--source
    # <ref>` value is a known, disclosed imprecision: that ref is emitted as a
    # spurious target. Requires the segment's literal first two tokens. ---
    if [[ "$_bwt_cmd1" == "git" && ( "$_bwt_cmd2" == "rm" || "$_bwt_cmd2" == "restore" ) ]]; then
      local seen_git=0 seen_sub=0
      for w in $seg; do
        if [[ "$seen_git" -eq 0 ]]; then seen_git=1; continue; fi
        if [[ "$seen_sub" -eq 0 ]]; then seen_sub=1; continue; fi
        [[ "$w" == -* ]] && continue
        _bwt_target "git $_bwt_cmd2 target" "$w"
      done
    fi

    # --- git checkout -- <path>...: only the unambiguous file-restore
    # form (a literal `--` token present) is treated as a write — a bare
    # `git checkout <branch>` switches branches and is a disclosed,
    # deliberate non-goal (see this file's own header). Every non-flag
    # token after `--` is a restore target. ---
    if [[ "$_bwt_cmd1" == "git" && "$_bwt_cmd2" == "checkout" ]] \
      && grep -qE '(^|[[:space:]])--([[:space:]]|$)' <<<"$seg"; then
      local after_dashdash=0
      for w in $seg; do
        if [[ "$after_dashdash" -eq 0 ]]; then
          [[ "$w" == "--" ]] && after_dashdash=1
          continue
        fi
        [[ "$w" == -* ]] && continue
        _bwt_target "git checkout -- target" "$w"
      done
    fi
  done
  IFS="$IFS_old"
}
