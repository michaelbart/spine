# _bash-write-targets — shared library, sourced by phase-gate and
# path-escalate. Not a hook itself (no shebang execution path; nothing in
# .claude/settings.json wires it directly).
#
# Extracts candidate file-mutation targets from a Bash `tool_input.command`
# string, for the same hooks that already gate Edit/Write. This is a gate,
# not a shell parser: it recognizes common file-mutating shapes (output
# redirection, in-place editors, tee, cp/mv/install, truncate, dd, and —
# added after six audit rounds tested every *write* bypass shape but never
# a *delete* one — rm, unlink, git rm, git checkout -- <path>, and git
# restore <path>) via regex/token heuristics, not a real shell grammar.
# Deliberately conservative in one direction only — a write-shaped command
# whose target can't be confidently resolved is reported as UNRESOLVED
# rather than silently dropped, so the caller can fail closed.
#
# Deletion is not a lesser case of a write: `rm .spine/protected-paths.conf`
# or `rm -rf work/<task-id>/` previously sailed through phase-gate/
# path-escalate/dep-gate with zero scrutiny — no deny, no ask — despite
# being at least as consequential as an unauthorized write (destructive,
# unrecoverable without git). The fix routes every deletion target through
# the exact same PATH:/UNRESOLVED: emission every other block here already
# uses, so it gets the exact same containment/protected-path/manifest
# checks a write would — no new decision logic in any of the three hooks,
# only new target extraction here.
#
# Deliberately NOT covered by the new deletion detection (disclosed, not
# an oversight): a bare `git checkout <branch>` (no literal `--`) switches
# branches and can rewrite arbitrary tracked files project-wide, but isn't
# a per-path mutation this token-level extractor tries to model; neither is
# `git reset --hard` or `git clean`. Each is a whole-tree operation, a
# different class of risk than the per-path targets this file extracts
# elsewhere, and deserves its own consideration rather than being folded in
# here as an afterthought.
#
# `ln` is included (not just cp/mv/install) because a symlink's own
# destination path is itself a write target — direct repro showed
# `ln -s <target> work/T1/x` going completely unrecognized (no PATH, no
# UNRESOLVED, nothing) before this was added, after which a later
# Edit/Write to the new symlink's name walked straight past
# phase-gate/path-escalate's containment/glob checks since they compared
# strings, not resolved locations. _workspace-route's _wsr_realpath closes
# the same gap for a symlink that already existed before this Bash call
# ran; this closes it for one created live, in the same task.
#
# Usage:
#   bash_write_targets "$command"
# Prints zero or more lines to stdout, each one of:
#   PATH:<resolved-or-relative-path>   — a concrete candidate target
#   UNRESOLVED:<reason>                — a write-shaped command whose
#                                         target(s) could not be confidently
#                                         extracted or whose working
#                                         directory is ambiguous (a `cd` was
#                                         found earlier in the same command)
#
# Known, disclosed gaps (see docs/tradeoffs.md residual risks):
#   - sed/perl -i with multiple trailing file arguments: only the last
#     token of the matched segment is taken as the target. A command
#     rewriting several files in one `sed -i ... f1 f2 f3` invocation is
#     only checked against f3.
#   - Chained commands are split naively on `;`, `&&`, `||`, `|`, and
#     newlines — a separator embedded inside a quoted string or a nested
#     `$(...)` will mis-split. This can only produce spurious UNRESOLVED
#     findings (fail closed), never a missed target being silently accepted
#     as a plain PATH.
#   - A `cd` appearing anywhere in the command marks every *relative*
#     target UNRESOLVED for the rest of the command, even ones that
#     execute before the `cd`. Conservative on purpose.

_bwt_is_devnull_like() {
  case "$1" in
    /dev/null|/dev/stdout|/dev/stderr|/dev/tty|/dev/console) return 0 ;;
    *) return 1 ;;
  esac
}

_bwt_is_confidently_resolvable() {
  # Rejects targets containing shell metacharacters we won't try to expand:
  # variable/command substitution, globs, tilde, quotes left dangling.
  case "$1" in
    *'$'*|*'`'*|*'*'*|*'?'*|*'['*|*'~'*|*'"'*|*"'"*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

_bwt_emit() {
  local target="$1"
  if _bwt_is_devnull_like "$target"; then
    return 0
  fi
  if ! _bwt_is_confidently_resolvable "$target"; then
    echo "UNRESOLVED:target '$target' contains a variable/glob/quote this gate won't expand"
    return 0
  fi
  echo "PATH:$target"
}

bash_write_targets() {
  local command="$1"
  [[ -n "$command" ]] || return 0

  # Fast path: nothing about this command looks write-shaped. Keeps the
  # overwhelming majority of Bash calls (git status, flutter test, grep,
  # ls, ...) out of the extraction logic entirely — this is what keeps the
  # widened matcher from becoming a blanket deny.
  if ! grep -qE '(^|[^0-9&])[0-9]*>{1,2}|\bsed\b.*-i|\bperl\b.*-i|\btee\b|\bln\b|\bcp\b|\bmv\b|\binstall\b|\btruncate\b|\bdd\b[[:space:]].*\bof=|\brm\b|\bunlink\b|\bgit\b.*\b(rm|checkout|restore)\b' <<<"$command"; then
    return 0
  fi

  local has_cd=0
  if grep -qE '(^|[;&|[:space:]])cd([[:space:]]|$)' <<<"$command"; then
    has_cd=1
  fi

  # Split into segments on ; && || | and newlines — naive, best-effort.
  local -a segments
  local IFS_old="$IFS"
  local normalized
  normalized="$(printf '%s' "$command" | sed -E 's/(&&|\|\||;|\|)/\n/g')"
  local seg
  while IFS= read -r seg || [[ -n "$seg" ]]; do
    [[ -n "${seg// /}" ]] || continue

    # First two whitespace-separated tokens of this segment specifically —
    # used below to detect rm/unlink/git-rm/git-checkout/git-restore as the
    # segment's actual *command*, never as a \b-bounded substring match
    # inside an unrelated filename. \b treats a hyphen as a word boundary
    # too, which the single-target blocks below (cp/mv/ln/tee/etc.) can
    # tolerate — they only ever take the *last* non-flag token, and the
    # command word is essentially never last — but an every-token-is-a-
    # target block cannot: a `mv a.txt some-rm-thing.txt` segment must
    # never be treated as an `rm` invocation just because "rm" appears,
    # hyphen-bounded, inside its destination filename.
    local _bwt_cmd1 _bwt_cmd2
    _bwt_cmd1="$(printf '%s' "$seg" | sed -E 's/^[[:space:]]+//' | awk '{print $1}')"
    _bwt_cmd2="$(printf '%s' "$seg" | sed -E 's/^[[:space:]]+//' | awk '{print $2}')"

    # --- output redirection: >, >>, N>, N>>, but not N>&M (fd dup) ---
    local redir
    while read -r redir; do
      [[ -n "$redir" ]] || continue
      local tgt="${redir#*>}"
      tgt="${tgt#>}"
      tgt="$(printf '%s' "$tgt" | sed -E 's/^[[:space:]]+//; s/[[:space:]].*$//')"
      [[ -n "$tgt" ]] || continue
      [[ "$tgt" == "&"* ]] && continue
      if [[ "$has_cd" -eq 1 && "$tgt" != /* ]]; then
        echo "UNRESOLVED:relative redirect target '$tgt' after a 'cd' earlier in the same command — working directory can't be confidently determined"
        continue
      fi
      _bwt_emit "$tgt"
    done < <(grep -oE '[0-9]*>{1,2}[[:space:]]*[^[:space:];&|]+' <<<"$seg")

    # --- sed/perl -i: take the last whitespace token of the segment ---
    if grep -qE '\b(sed|perl)\b.*-i' <<<"$seg"; then
      local last
      last="$(printf '%s' "$seg" | awk '{print $NF}')"
      if [[ "$has_cd" -eq 1 && "$last" != /* ]]; then
        echo "UNRESOLVED:relative in-place-edit target '$last' after a 'cd' earlier in the same command"
      else
        _bwt_emit "$last"
      fi
    fi

    # --- tee: all non-flag trailing tokens, stopping at the next shell
    # operator (<, <<, <<<, >, >>, &, |, ;) since those aren't tee's file
    # arguments (redirection into/out of the tee command itself) ---
    if grep -qE '\btee\b' <<<"$seg"; then
      local seen_tee=0 w
      for w in $seg; do
        if [[ "$seen_tee" -eq 0 ]]; then
          [[ "$w" == "tee" ]] && seen_tee=1
          continue
        fi
        case "$w" in
          '<'*|'>'*|'&'*|'|'*|';'*) break ;;
        esac
        [[ "$w" == -* ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative tee target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi

    # --- ln: destination is the arg after -t, else the last non-flag
    # token — same shape as cp/mv/install below, kept separate only so a
    # symlink creation (`ln -s TARGET LINKNAME`) is unambiguously reported
    # as its own write target rather than silently falling through
    # unrecognized. `ln -s` is the mechanism a stacked bypass of
    # phase-gate/path-escalate/dep-gate's containment/glob checks used in
    # direct repro: plant a symlink whose *name* looks unremarkable, then
    # a later Edit/Write to that name resolves through it. Catching the
    # `ln` call itself here is the first of two layers closing that gap —
    # the second is _workspace-route's _wsr_realpath, which also resolves
    # an already-existing symlink regardless of how it got there. ---
    if grep -qE '\bln\b' <<<"$seg"; then
      local -a ln_nonflag=()
      local ln_dest="" ln_take_next=0
      for w in $seg; do
        if [[ "$ln_take_next" -eq 1 ]]; then
          ln_dest="$w"; ln_take_next=0; continue
        fi
        if [[ "$w" == "-t" ]]; then ln_take_next=1; continue; fi
        [[ "$w" == -* ]] && continue
        ln_nonflag+=("$w")
      done
      if [[ -z "$ln_dest" && "${#ln_nonflag[@]}" -gt 1 ]]; then
        ln_dest="${ln_nonflag[${#ln_nonflag[@]}-1]}"
      fi
      if [[ -n "$ln_dest" ]]; then
        if [[ "$has_cd" -eq 1 && "$ln_dest" != /* ]]; then
          echo "UNRESOLVED:relative ln destination '$ln_dest' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$ln_dest"
        fi
      fi
    fi

    # --- cp/mv/install: destination is the arg after -t, else the last
    # non-flag token ---
    if grep -qE '\b(cp|mv|install)\b' <<<"$seg"; then
      local -a nonflag=()
      local dest="" prev="" take_next=0
      for w in $seg; do
        if [[ "$take_next" -eq 1 ]]; then
          dest="$w"; take_next=0; continue
        fi
        if [[ "$w" == "-t" ]]; then take_next=1; continue; fi
        [[ "$w" == -* ]] && continue
        nonflag+=("$w")
      done
      if [[ -z "$dest" && "${#nonflag[@]}" -gt 1 ]]; then
        dest="${nonflag[${#nonflag[@]}-1]}"
      fi
      if [[ -n "$dest" ]]; then
        if [[ "$has_cd" -eq 1 && "$dest" != /* ]]; then
          echo "UNRESOLVED:relative cp/mv/install destination '$dest' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$dest"
        fi
      fi
    fi

    # --- truncate: all non-flag tokens, skipping -s/--size's argument ---
    if grep -qE '\btruncate\b' <<<"$seg"; then
      local skip_next=0
      for w in $seg; do
        if [[ "$skip_next" -eq 1 ]]; then skip_next=0; continue; fi
        if [[ "$w" == "-s" || "$w" == "--size" ]]; then skip_next=1; continue; fi
        [[ "$w" == -* ]] && continue
        [[ "$w" == "truncate" ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative truncate target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi

    # --- dd of=path ---
    if grep -qE '\bdd\b' <<<"$seg"; then
      local ofval
      ofval="$(grep -oE 'of=[^[:space:]]+' <<<"$seg" | head -1 | sed -E 's/^of=//')"
      if [[ -n "$ofval" ]]; then
        if [[ "$has_cd" -eq 1 && "$ofval" != /* ]]; then
          echo "UNRESOLVED:relative dd of= target '$ofval' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$ofval"
        fi
      fi
    fi

    # --- rm/unlink: every non-flag token is its own delete target — no
    # source/dest split the way cp/mv has, every argument names something
    # to remove. Requires the segment's literal first token, per _bwt_cmd1
    # above, not a substring match. ---
    if [[ "$_bwt_cmd1" == "rm" || "$_bwt_cmd1" == "unlink" ]]; then
      local seen_cmd=0
      for w in $seg; do
        if [[ "$seen_cmd" -eq 0 ]]; then seen_cmd=1; continue; fi
        [[ "$w" == -* ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative $_bwt_cmd1 target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi

    # --- git rm: same every-token-is-a-target shape as rm/unlink above.
    # Requires the segment's literal first two tokens to be "git" then
    # "rm", per _bwt_cmd1/_bwt_cmd2 above. ---
    if [[ "$_bwt_cmd1" == "git" && "$_bwt_cmd2" == "rm" ]]; then
      local seen_git=0 seen_sub=0
      for w in $seg; do
        if [[ "$seen_git" -eq 0 ]]; then seen_git=1; continue; fi
        if [[ "$seen_sub" -eq 0 ]]; then seen_sub=1; continue; fi
        [[ "$w" == -* ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative git rm target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi

    # --- git checkout -- <path>...: only the unambiguous file-restore
    # form (a literal `--` token present) is treated as a write — a bare
    # `git checkout <branch>` switches branches and is a disclosed,
    # deliberate non-goal (see this file's own header). Every non-flag
    # token after `--` is a restore target. ---
    if [[ "$_bwt_cmd1" == "git" && "$_bwt_cmd2" == "checkout" ]] \
      && grep -qE '(^|[[:space:]])--([[:space:]]|$)' <<<"$seg"; then
      local after_dashdash=0
      for w in $seg; do
        if [[ "$after_dashdash" -eq 0 ]]; then
          [[ "$w" == "--" ]] && after_dashdash=1
          continue
        fi
        [[ "$w" == -* ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative git checkout -- target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi

    # --- git restore <path>...: every non-flag token after "restore" is a
    # target, including under --staged (index-only — flagged anyway, same
    # conservative-in-one-direction bias this whole file already states).
    # A space-separated `--source <ref>` value (rather than `--source=
    # <ref>`) is a known, disclosed imprecision — that ref name doesn't
    # start with '-' and gets emitted as a spurious target, same shape as
    # sed -i's own multi-file gap already disclosed above, not a new class
    # of risk. ---
    if [[ "$_bwt_cmd1" == "git" && "$_bwt_cmd2" == "restore" ]]; then
      local seen_git2=0 seen_sub2=0
      for w in $seg; do
        if [[ "$seen_git2" -eq 0 ]]; then seen_git2=1; continue; fi
        if [[ "$seen_sub2" -eq 0 ]]; then seen_sub2=1; continue; fi
        [[ "$w" == -* ]] && continue
        if [[ "$has_cd" -eq 1 && "$w" != /* ]]; then
          echo "UNRESOLVED:relative git restore target '$w' after a 'cd' earlier in the same command"
        else
          _bwt_emit "$w"
        fi
      done
    fi
  done <<<"$normalized"
  IFS="$IFS_old"
}
