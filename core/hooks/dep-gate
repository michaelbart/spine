#!/bin/bash
# dep-gate — PreToolUse, matcher: Edit|Write|Bash.
#
# Package-manifest edits (paths tagged `#manifest` in protected-paths.conf)
# and shell commands that look like a dependency install/change are forced
# to a human decision via permissionDecision: "ask" — never a hardcoded
# filename or package-manager list, since no file in spine may reference a
# language, framework, or tool by name. In a headless subprocess (no
# interactive user to ask) this fails closed: Claude Code blocks the call
# and surfaces the reason as an error rather than silently proceeding —
# verified empirically, since "ask" behavior under a missing user isn't
# documented.
#
# The manifest-tag check (below) applies to BOTH Edit/Write's file_path and
# every write target _bash-write-targets extracts from a Bash command — a
# direct repro once showed a Bash redirect/`sed -i`/`cp` onto a
# `#manifest`-tagged path going through unasked while the identical target
# via Edit/Write correctly asked, because only the Edit/Write branch ran
# the manifest check. Both branches now share check_manifest_target.
#
# Project state consulted:
#   .spine/protected-paths.conf          — lines tagged `#manifest` are
#     dependency manifests.
#   .spine/install-command-patterns.conf — one extended-regex fragment per
#     line (grep -E syntax), generated at install time from this project's
#     confirmed Layer 3 stack/commands (bootstrap/adopt SKILL.md §4). Any
#     line matching a Bash command is treated as a dependency install/change.
#     Absent file (not yet installed, or a stack with no recognizable
#     install-command shape) means the Bash-command check is a no-op — the
#     Edit/Write manifest-tag check above is unaffected either way.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_path-route"
source "$SCRIPT_DIR/_spine-event" 2>/dev/null
declare -F spine_cmd_fields >/dev/null || { spine_cmd_fields() { :; }; spine_unresolved_code() { :; }; }
declare -F project_route >/dev/null || { echo "dep-gate: _path-route did not load — failing closed, cannot evaluate this write safely" >&2; exit 2; }
input="$(cat)"
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"
tool_name="$(jq -r '.tool_name // empty' <<<"$input")"
SPINE_SESSION_ID="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
ev_target=""; ev_why=""

ask() {
  # ask <rule-id> <message> — rule-id is the stable reason recorded in the event log.
  local rule="$1"; shift
  declare -F spine_hook_event >/dev/null && spine_hook_event "$project" hook-ask dep-gate "$tool_name" "$rule" "$ev_target" "$ev_why"
  jq -n --arg reason "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse", permissionDecision:"ask", permissionDecisionReason:$reason}}'
  exit 0
}

check_manifest_target() {
  # check_manifest_target <file_path-as-given> — asks per the owning root's
  # protected-paths.conf #manifest tag (project_route resolves which root
  # that is; single-repo projects always resolve to $project itself).
  local file_path="$1" rel display conf line glob
  project_route "$project" "$file_path" || ask no-project-root "What happened: I'm about to edit a file, but I can't tell where the project root is, so I can't rule out that it changes the list of packages. What it means for you: nothing has changed yet, and any package change is always your call. To continue: allow the edit, or deny it and tell me what to do instead."
  [[ -n "$PR_ROOT" ]] || return 0
  conf="$PR_ROOT/.spine/protected-paths.conf"
  [[ -f "$conf" ]] || return 0
  rel="$PR_REL"
  display="$rel"
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="$raw"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *"#manifest"* ]] || continue
    glob="${line%%#*}"
    glob="$(printf '%s' "$glob" | sed -e 's/[[:space:]]*$//')"
    [[ -z "$glob" ]] && continue
    if _pr_glob_eq "$rel" "$glob"; then
      ev_target="$rel"
      ask manifest-path "What happened: I'm about to edit '$display', which lists the packages the project depends on. What it means for you: adding or changing a package is always your call — it affects security and how much the project has to maintain. Nothing has changed yet. To continue: allow this edit, or deny it and tell me what to do instead."
    fi
  done < "$conf"
}

case "$tool_name" in
  Edit|Write)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
    [[ -n "$file_path" ]] || exit 0
    check_manifest_target "$file_path"
    exit 0
    ;;
  Bash)
    command="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -n "$command" ]] || exit 0
    spine_cmd_fields "$command"

    source "$SCRIPT_DIR/_bash-write-targets"
    declare -F bash_write_targets >/dev/null || { echo "dep-gate: _bash-write-targets did not load — failing closed, cannot evaluate this Bash write safely" >&2; exit 2; }
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      case "$line" in
        UNRESOLVED:*)
          ev_why="$(spine_unresolved_code "$line")"
          ask unresolved-bash-target "What happened: I'm about to run '$command', and I can't tell which file it writes (${line#UNRESOLVED:}). What it means for you: I can't rule out that it changes the list of packages, which is always your call. Nothing has run yet. To continue: allow the command, or deny it and tell me what to do instead."
          ;;
        PATH:*)
          check_manifest_target "${line#PATH:}"
          ;;
      esac
    done < <(bash_write_targets "$command")

    pattern_files=("$project/.spine/install-command-patterns.conf")
    any_exist=0
    for pf in "${pattern_files[@]}"; do
      [[ -f "$pf" ]] || continue
      any_exist=1
      if grep -qEf "$pf" <<<"$command"; then
        ask install-command "What happened: I'm about to run '$command', which looks like it installs or changes a package. What it means for you: any package change is always your call — it affects security and how much the project has to maintain. Nothing has run yet. To continue: allow the command, or deny it and tell me what to do instead."
      fi
    done
    [[ "$any_exist" -eq 1 ]] || exit 0
    exit 0
    ;;
  *) exit 0 ;;
esac
