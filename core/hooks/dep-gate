#!/bin/bash
# dep-gate — PreToolUse, matcher: Edit|Write|Bash.
#
# Package-manifest edits (paths tagged `#manifest` in protected-paths.conf)
# and shell commands that look like a dependency install/change are forced
# to a human decision via permissionDecision: "ask" — never a hardcoded
# filename or package-manager list, per build prompt §2.3 and the "no file
# in the spine may reference a language, framework, or tool" rule (build
# prompt §3). In a headless subprocess (no interactive user to ask) this
# fails closed: Claude Code blocks the call and surfaces the reason as an
# error rather than silently proceeding — verified empirically in Phase B,
# since "ask" behavior under a missing user isn't documented.
#
# Project state consulted:
#   .spine/protected-paths.conf          — lines tagged `#manifest` are dependency manifests
#   .spine/install-command-patterns.conf — one extended-regex fragment per
#     line (grep -E syntax), generated at install time from this project's
#     confirmed Layer 3 stack/commands (bootstrap/adopt SKILL.md §4). Any
#     line matching a Bash command is treated as a dependency install/change.
#     Absent file (not yet installed, or a stack with no recognizable
#     install-command shape) means the Bash-command check is a no-op — the
#     Edit/Write manifest-tag check above is unaffected either way.
set -uo pipefail

input="$(cat)"
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"
tool_name="$(jq -r '.tool_name // empty' <<<"$input")"

ask() {
  jq -n --arg reason "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse", permissionDecision:"ask", permissionDecisionReason:$reason}}'
  exit 0
}

case "$tool_name" in
  Edit|Write)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
    [[ -n "$file_path" ]] || exit 0
    conf="$project/.spine/protected-paths.conf"
    [[ -f "$conf" ]] || exit 0
    case "$file_path" in
      "$project"/*) rel="${file_path#"$project"/}" ;;
      /*) rel="$file_path" ;;
      *) rel="$file_path" ;;
    esac
    while IFS= read -r raw || [[ -n "$raw" ]]; do
      line="$raw"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$line" == *"#manifest"* ]] || continue
      glob="${line%%#*}"
      glob="$(printf '%s' "$glob" | sed -e 's/[[:space:]]*$//')"
      [[ -z "$glob" ]] && continue
      if [[ "$rel" == $glob ]]; then
        ask "Editing dependency manifest '$rel' — package changes always require a human decision (supply-chain and accretion control, build prompt §2.3)."
      fi
    done < "$conf"
    exit 0
    ;;
  Bash)
    command="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -n "$command" ]] || exit 0
    patterns="$project/.spine/install-command-patterns.conf"
    [[ -f "$patterns" ]] || exit 0
    if grep -qEf "$patterns" <<<"$command"; then
      ask "Command looks like a dependency install/change: '$command' — forced to a human decision."
    fi
    exit 0
    ;;
  *) exit 0 ;;
esac
