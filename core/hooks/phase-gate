#!/bin/bash
# phase-gate — PreToolUse, matcher: Edit|Write|Bash.
#
# During an active task's research or plan phase, deny writes outside that
# task's own folder (work/<task-id>/). Silent no-op (exit 0) when there is
# no active task, or the task isn't in research/plan — this hook only gates
# those two phases, per build prompt §2.3.
#
# Bash is included in the matcher (Phase E fix) because a shell redirect,
# in-place editor, tee, cp/mv/install, truncate, or dd invoked via Bash
# mutates files exactly like Edit/Write would, and the pre-fix Edit|Write-
# only matcher let any of those bypass this gate entirely — see
# core/hooks/_bash-write-targets and docs/tradeoffs.md's self-red-team.
#
# Project state consulted:
#   .spine/current-task        — single line, the active task-id (or absent)
#   work/<task-id>/state        — single line, current phase name
#
# Workspace routing (build prompt §2, Extension B): task_dir is always
# $project/work/$task_id — for a multi-repo task that's the *workspace
# root's* own work/ (one task folder at the workspace), never a per-repo
# one. Every absolute path under any member repo is therefore already
# "outside task_dir" under the plain containment check below, with zero
# logic change — a workspace doesn't need its own containment rule, it
# falls out of the one that already existed. Workspace.json also supplies
# a friendlier, repo-qualified name in the denial message
# (_workspace-route, shared with path-escalate/dep-gate).
#
# **Out-of-project allowance (disclosed fix, not part of the original
# design)**: check_target now calls workspace_route first and allows
# outright (return 0) when WSR_OWNER_ROOT comes back empty — a file_path
# that resolves to nowhere under $project (or any registered member repo
# in workspace mode) at all, e.g. a path in the user's home directory
# unrelated to this project. This hook exists to restrict where a task's
# own artifacts land *inside a project it's actively gating*; a location
# outside that project entirely was never task_dir and was never meant to
# be denied by this hook — the pre-fix behavior denied it anyway, purely
# because _workspace-route's single-repo branch didn't yet distinguish
# "under $project" from "anywhere" (see that file's own header comment).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_workspace-route"
input="$(cat)"
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"

tool_name="$(jq -r '.tool_name // empty' <<<"$input")"

current_task_file="$project/.spine/current-task"
[[ -f "$current_task_file" ]] || exit 0
task_id="$(tr -d '[:space:]' < "$current_task_file")"
[[ -n "$task_id" ]] || exit 0

state_file="$project/work/$task_id/state"
[[ -f "$state_file" ]] || exit 0
phase="$(tr -d '[:space:]' < "$state_file")"

case "$phase" in
  research|plan) ;;
  *) exit 0 ;;
esac

task_dir="$project/work/$task_id"

check_target() {
  # check_target <file_path-as-given> — denies if outside task_dir, but
  # first allows outright if the path isn't even inside the project
  # (workspace_route's WSR_OWNER_ROOT empty — see its own header comment
  # on the out-of-project fix): this hook only ever governs artifacts
  # belonging to a project it recognizes, never arbitrary filesystem
  # locations like a user's own notes directory outside any project tree.
  local file_path="$1" abs_path display

  workspace_route "$project" "$file_path"
  [[ -n "$WSR_OWNER_ROOT" ]] || return 0

  case "$file_path" in
    /*) abs_path="$file_path" ;;
    *) abs_path="$project/$file_path" ;;
  esac
  case "$abs_path" in
    "$task_dir"/*) return 0 ;;
    *)
      if [[ -n "$WSR_OWNER_NAME" ]]; then display="$WSR_OWNER_NAME:$WSR_REL"; else display="$file_path"; fi
      echo "phase-gate: '$display' is outside work/$task_id/. During the $phase phase, only artifacts inside the task folder may be written — implementation hasn't been approved yet." >&2
      return 1
      ;;
  esac
}

case "$tool_name" in
  Edit|Write)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
    [[ -n "$file_path" ]] || exit 0
    check_target "$file_path" || exit 2
    exit 0
    ;;
  Bash)
    command="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -n "$command" ]] || exit 0
    source "$SCRIPT_DIR/_bash-write-targets"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      case "$line" in
        UNRESOLVED:*)
          echo "phase-gate: Bash command '$command' plausibly writes a file this gate can't confidently locate (${line#UNRESOLVED:}). During the $phase phase, only work/$task_id/ may be written — failing closed rather than passing an unresolvable write through." >&2
          exit 2
          ;;
        PATH:*)
          check_target "${line#PATH:}" || exit 2
          ;;
      esac
    done < <(bash_write_targets "$command")
    exit 0
    ;;
  *) exit 0 ;;
esac
