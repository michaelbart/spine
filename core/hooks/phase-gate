#!/bin/bash
# phase-gate — PreToolUse, matcher: Edit|Write|Bash.
#
# During an active task's research or plan phase, deny writes outside that
# task's own folder (work/<task-id>/). Silent no-op (exit 0) when there is
# no active task, or the task isn't in research/plan — this hook only gates
# those two phases.
#
# Bash is included in the matcher (Phase E fix) because a shell redirect,
# in-place editor, tee, cp/mv/install, truncate, dd, or a deletion (rm,
# unlink, git rm, git checkout -- <path>, git restore <path>) invoked via
# Bash mutates files exactly like Edit/Write would, and the pre-fix
# Edit|Write-only matcher let any of those bypass this gate entirely — see
# core/hooks/_bash-write-targets and docs/tradeoffs.md's "Measured tradeoffs"
# ("The write-blocking hooks don't see every way to write a file").
#
# Project state consulted:
#   .spine/current-task        — single line, the active task-id (or absent)
#   work/<task-id>/state        — single line, current phase name
#
# **Out-of-project allowance (disclosed fix, not part of the original
# design)**: check_target now calls project_route first and allows
# outright (return 0) when PR_ROOT comes back empty — a file_path
# that resolves to nowhere under $project at all, e.g. a path in the user's home directory
# unrelated to this project. This hook exists to restrict where a task's
# own artifacts land *inside a project it's actively gating*; a location
# outside that project entirely was never task_dir and was never meant to
# be denied by this hook — the pre-fix behavior denied it anyway, purely
# because _path-route's single-repo branch didn't yet distinguish
# "under $project" from "anywhere" (see that file's own header comment).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_path-route"
source "$SCRIPT_DIR/_spine-event" 2>/dev/null
declare -F spine_cmd_fields >/dev/null || { spine_cmd_fields() { :; }; spine_unresolved_code() { :; }; }
declare -F project_route >/dev/null || { echo "phase-gate: _path-route did not load — failing closed, cannot evaluate this write safely" >&2; exit 2; }
input="$(cat)"
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"

tool_name="$(jq -r '.tool_name // empty' <<<"$input")"
SPINE_SESSION_ID="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
ev_rule="internal"; ev_target=""; ev_why=""
declare -F spine_hook_event >/dev/null && trap '[[ $? -eq 2 ]] && spine_hook_event "$project" hook-block phase-gate "$tool_name" "$ev_rule" "$ev_target" "$ev_why"' EXIT

current_task_file="$project/.spine/current-task"
[[ -f "$current_task_file" ]] || exit 0
task_id="$(tr -d '[:space:]' < "$current_task_file")"
[[ -n "$task_id" ]] || exit 0

state_file="$project/work/$task_id/state"
[[ -f "$state_file" ]] || exit 0
phase="$(tr -d '[:space:]' < "$state_file")"

case "$phase" in
  research|plan) ;;
  *) exit 0 ;;
esac

task_dir="$(_pr_realpath "$project/work/$task_id")"

check_target() {
  # check_target <file_path-as-given> — denies if outside task_dir, but
  # first allows outright if the path isn't even inside the project
  # (project_route's PR_ROOT empty — see its own header comment
  # on the out-of-project fix): this hook only ever governs artifacts
  # belonging to a project it recognizes, never arbitrary filesystem
  # locations like a user's own notes directory outside any project tree.
  local file_path="$1" abs_path display

  project_route "$project" "$file_path" || return 1
  [[ -n "$PR_ROOT" ]] || return 0

  # Recomputed and resolved the same way project_route resolves its own
  # abs_path (_pr_realpath, same file) — this check_target does its own
  # task_dir containment test rather than reusing PR_REL, so it needs the
  # identical normalization applied here too, or a `../` OR a symlink in
  # file_path walks past this containment check the same way either did
  # against path-escalate/dep-gate before their shared helper was fixed
  # (lexical collapse for `../`; physical resolution for a symlink planted
  # inside task_dir that points outside the project entirely — both
  # confirmed by direct repro, not hypothetical).
  case "$file_path" in
    /*) abs_path="$file_path" ;;
    *) abs_path="$project/$file_path" ;;
  esac
  abs_path="$(_pr_realpath "$abs_path")"
  case "$abs_path" in
    "$task_dir"/*) return 0 ;;
    *)
      display="$file_path"
      ev_rule="pre-plan-write"; ev_target="$PR_REL"
      printf '%s\n' \
        "What happened: I tried to edit '$display' while the task is still in its $phase step." \
        "What it means for you: nothing was changed. Before you approve the plan, I may only write notes inside work/$task_id/, not project code." \
        "To continue: approve the plan so I can start implementing, or ask me to keep working on the notes." >&2
      return 1
      ;;
  esac
}

case "$tool_name" in
  Edit|Write)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
    [[ -n "$file_path" ]] || exit 0
    check_target "$file_path" || exit 2
    exit 0
    ;;
  Bash)
    command="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -n "$command" ]] || exit 0
    spine_cmd_fields "$command"
    source "$SCRIPT_DIR/_bash-write-targets"
    declare -F bash_write_targets >/dev/null || { echo "phase-gate: _bash-write-targets did not load — failing closed, cannot evaluate this Bash write safely" >&2; exit 2; }
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      case "$line" in
        UNRESOLVED:*)
          ev_rule="unresolved-bash-target"; ev_why="$(spine_unresolved_code "$line")"
          printf '%s\n' \
            "What happened: I tried to run '$command', and I can't tell which file it writes to (${line#UNRESOLVED:})." \
            "What it means for you: nothing was run. Before you approve the plan I may only write inside work/$task_id/, so I block a command I can't place." \
            "To continue: rewrite the command so it names the file plainly, or approve the plan first." >&2
          exit 2
          ;;
        PATH:*)
          check_target "${line#PATH:}" || exit 2
          ;;
      esac
    done < <(bash_write_targets "$command")
    exit 0
    ;;
  *) exit 0 ;;
esac
