#!/bin/bash
# path-escalate — PreToolUse, matcher: Edit|Write|Bash.
#
# A write matching a protected path halts (deny, exit 2) unless the active
# task is already confirmed Class 2. A write matching a path tagged
# `#migration` is denied flat regardless of class unless that class is
# exactly 2 — migrations don't get the softer "not yet escalated" framing:
# migration-path edits outside a Class 2 task are denied flat. With no
# active task, class defaults to 0, so the same
# not-class-2 branch applies — this is the Class 0 backstop from §2.2.
#
# Bash is included in the matcher (Phase E fix) because a shell redirect,
# in-place editor, tee, cp/mv/install, truncate, dd, or a deletion (rm,
# unlink, git rm, git checkout -- <path>, git restore <path>) targeting a
# protected path bypassed this gate entirely under the pre-fix Edit|Write-
# only matcher — see core/hooks/_bash-write-targets and docs/tradeoffs.md's
# "Known limits" ("The write-blocking hooks don't see every way to write a
# file"). A Bash write (or delete) whose target can't be confidently
# resolved is denied outright (not "no match found") — we cannot prove it
# doesn't touch a protected path, so this gate does not extend it the
# benefit of the doubt it would give a plain, resolvable path.
#
# Project state consulted:
#   .spine/protected-paths.conf — one glob per line; `#` starts a comment;
#                                  a trailing `#migration` tags the line.
#                                  In workspace mode (workspace.json present
#                                  at $project), the *owning repo's own*
#                                  .spine/protected-paths.conf governs a
#                                  target inside a member repo — see
#                                  _workspace-route. A plain single-repo
#                                  project (no workspace.json) is entirely
#                                  unaffected: workspace_route degenerates
#                                  to $project's own conf, exactly as before.
#   .spine/current-task         — active task-id (or absent -> class 0),
#                                  always read from $project (the workspace
#                                  root for a multi-repo task — one task
#                                  folder at the workspace)
#   work/<task-id>/class        — single line, "0"|"1"|"2", same rule: one
#                                  class for the whole multi-repo task, so
#                                  a protected path in *any* member repo is
#                                  gated by that one class, which is what
#                                  makes plan-time "max across repos"
#                                  escalation (core/skills/task/SKILL.md)
#                                  sufficient — this hook never itself
#                                  computes a max, it only ever reads one.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_workspace-route"
declare -F workspace_route >/dev/null || { echo "path-escalate: _workspace-route did not load — failing closed, cannot evaluate this write safely" >&2; exit 2; }
input="$(cat)"
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"

tool_name="$(jq -r '.tool_name // empty' <<<"$input")"

class="0"
current_task_file="$project/.spine/current-task"
if [[ -f "$current_task_file" ]]; then
  task_id="$(tr -d '[:space:]' < "$current_task_file")"
  class_file="$project/work/$task_id/class"
  [[ -f "$class_file" ]] && class="$(tr -d '[:space:]' < "$class_file")"
fi

check_target() {
  # check_target <file_path-as-given> — denies per the owning root's
  # protected-paths.conf (workspace_route resolves which root that is;
  # single-repo projects always resolve to $project itself).
  local file_path="$1" rel matched_glob="" is_migration=0 line tag glob conf display

  workspace_route "$project" "$file_path" || return 1
  [[ -n "$WSR_OWNER_ROOT" ]] || return 0
  conf="$WSR_OWNER_ROOT/.spine/protected-paths.conf"
  [[ -f "$conf" ]] || return 0
  rel="$WSR_REL"
  # Repo-qualified display form for messages only — glob matching below
  # always uses the plain $rel against that owner's own conf. Empty
  # WSR_OWNER_NAME (plain single-repo project, no workspace.json) means
  # display==rel, byte-identical to this hook's pre-Extension-B messages.
  if [[ -n "$WSR_OWNER_NAME" ]]; then display="$WSR_OWNER_NAME:$rel"; else display="$rel"; fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    tag=""
    [[ "$line" == *"#migration"* ]] && tag="migration"
    glob="${line%%#*}"
    glob="$(printf '%s' "$glob" | sed -e 's/[[:space:]]*$//')"
    [[ -z "$glob" ]] && continue
    if _wsr_glob_eq "$rel" "$glob"; then
      matched_glob="$glob"
      [[ "$tag" == "migration" ]] && is_migration=1
      break
    fi
  done < "$conf"

  [[ -n "$matched_glob" ]] || return 0

  if [[ "$is_migration" -eq 1 ]]; then
    if [[ "$class" != "2" ]]; then
      printf '%s\n' \
        "What happened: I tried to edit '$display', which is inside '$matched_glob' — a database-migration area you marked as protected." \
        "What it means for you: nothing was changed. Edits there are blocked unless the task is Class 2 (the highest-risk kind of change: needs a second person's approval), and this one is not. This is a hard block, not a question." \
        "To continue: tell me to raise this task to Class 2 (you confirm it), or drop the edit." >&2
      return 1
    fi
    return 0
  fi

  if [[ "$class" == "2" ]]; then
    return 0
  fi

  printf '%s\n' \
    "What happened: I tried to edit '$display', which is inside '$matched_glob' — a place you marked as needing extra care." \
    "What it means for you: nothing was changed. This task is not yet marked as Class 2 (the highest-risk kind of change: needs a second person's approval), and edits there require it." \
    "To continue: tell me to raise this task to Class 2 (you confirm it), or drop the edit." >&2
  return 1
}

case "$tool_name" in
  Edit|Write)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
    [[ -n "$file_path" ]] || exit 0
    check_target "$file_path" || exit 2
    exit 0
    ;;
  Bash)
    command="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -n "$command" ]] || exit 0
    source "$SCRIPT_DIR/_bash-write-targets"
    declare -F bash_write_targets >/dev/null || { echo "path-escalate: _bash-write-targets did not load — failing closed, cannot evaluate this Bash write safely" >&2; exit 2; }
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      case "$line" in
        UNRESOLVED:*)
          printf '%s\n' \
            "What happened: I tried to run '$command', and I can't tell which file it writes to (${line#UNRESOLVED:})." \
            "What it means for you: nothing was run. Because it might touch a protected file, I block it rather than guess." \
            "To continue: rewrite the command so it names the file plainly, or run it yourself if you know it is safe." >&2
          exit 2
          ;;
        PATH:*)
          check_target "${line#PATH:}" || exit 2
          ;;
      esac
    done < <(bash_write_targets "$command")
    exit 0
    ;;
  *) exit 0 ;;
esac
