#!/bin/bash
# render-task — reads one task's work/<task-id>/ folder and writes a
# single self-contained HTML report. Pure rendering, no new
# instrumentation: every field below comes from a file /task, /verify, or
# /ship already writes (core/ADAPTER-CONTRACT.md's structured artifacts,
# not re-derived prose). Never a gate — this is observational tooling,
# same posture as core/scripts/... feeding /costs, never invoked by
# /task/verify/ship themselves.
#
# Degradation discipline: a source file that doesn't exist yet (the task
# hasn't reached that phase) or a section that's genuinely absent (no
# deviations happened, no adversaries ran) is rendered as an explicit,
# labeled omission — never blank, never fabricated.
#
# Usage: render-task --task <task-id> --project <path> [--out <path>]
set -uo pipefail

usage() { echo "usage: render-task --task <task-id> --project <path> [--out <path>]" >&2; exit 2; }

task_id=""
project=""
out_path=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --task) task_id="$2"; shift 2 ;;
    --project) project="$2"; shift 2 ;;
    --out) out_path="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$task_id" && -n "$project" ]] || usage
project="$(cd "$project" && pwd)"
work_dir="$project/work/$task_id"
[[ -d "$work_dir" ]] || { echo "render-task: $work_dir not found" >&2; exit 2; }
[[ -n "$out_path" ]] || out_path="$work_dir/report.html"

plan_file="$work_dir/plan.md"
deviations_file="$work_dir/deviations.md"
verify_file="$work_dir/verify.md"
briefing_file="$work_dir/briefing.md"
ledger_file="$work_dir/ledger.json"
artifacts_dir="$work_dir/artifacts"

tmp_out="$(mktemp "${TMPDIR:-/tmp}/render-task.XXXXXX")"
trap 'rm -f "$tmp_out"' EXIT

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

render_paragraphs() {
  # render_paragraphs — takes prose on stdin (already HTML-escaped),
  # splits it into one <p> per sentence at ". " followed by a capital
  # letter or a backtick (a new code span almost always opens a new
  # clause worth its own line here). This is the wall-of-text fix:
  # core/templates/plan.md's own "## The gist" and briefing.md's "What &
  # why"/"six months" fields are deliberately written as 2-5 dense
  # sentences in one block — exactly the shape that renders unreadably as
  # a single paragraph however long the underlying prose legitimately
  # needs to be. Splitting at render time (not by rewriting the source
  # prose) means every past and future plan/briefing benefits without
  # asking the writing mandate to change what "one sentence, then 2-5
  # more" means.
  #
  # Flattens markdown's soft line-wrapping to one line FIRST (`tr` then
  # squeeze spaces) before sentence-splitting — a sentence boundary that
  # happens to fall at the end of a wrapped physical line (". " becomes
  # ".\n" in the raw source, not ". ") is otherwise invisible to a
  # single-line sed pattern; confirmed this is a real, not hypothetical,
  # case against this capability's own real fixtures (a plan.md gist
  # whose "...cross-repo contract." / "Rejected alternative:" boundary
  # sits exactly at a line wrap).
  #
  # Deliberately simple, not a real sentence tokenizer: this project's
  # real gist/briefing prose (checked against all four real tasks this
  # capability was built against) uses backtick-quoted code spans and
  # em-dash asides, never the classic false-split abbreviations ("e.g.",
  # "vs.", "Dr.") *inside* this specific field — those do appear
  # elsewhere in a plan.md (e.g. "## What I'll decide alone vs. stop and
  # ask"), which is exactly why this only ever touches the three fields
  # named above, never a whole file blindly.
  tr '\n' ' ' | sed -E 's/  +/ /g; s/\. ([A-Z`])/.\n\1/g' | sed -E '/^[[:space:]]*$/d' | \
    awk '{ gsub(/^[ \t]+|[ \t]+$/, ""); if ($0 != "") printf "<p>%s</p>\n", $0 }'
}

# --- metadata: plain single-value files /task writes. (ledger.json used
# to also carry a class_declared field for this — dropped: it was seen
# null in real fixtures even when the class file itself held the real
# value, and nothing else ever read it either.) ---
class_val="unknown"
[[ -f "$work_dir/class" ]] && class_val="$(cat "$work_dir/class")"
owner_val=""
[[ -f "$work_dir/owner" ]] && owner_val="$(cat "$work_dir/owner")"
# Drop the trailing "<email>" or bare email token — "Jane Doe
# jane.doe@example.com" reads as "Jane Doe" here; the plain-name
# form is what a report's header should show a human, not the raw
# git-identity string /task wrote for its own bookkeeping.
owner_val="$(sed -E 's/[[:space:]]*<[^>]*>[[:space:]]*$//; s/[[:space:]]+[^[:space:]]+@[^[:space:]]+[[:space:]]*$//' <<<"$owner_val")"
state_val=""
[[ -f "$work_dir/state" ]] && state_val="$(cat "$work_dir/state")"
milestone_val=""
[[ -f "$work_dir/milestone" ]] && milestone_val="$(cat "$work_dir/milestone")"

title="$task_id"
grounding_sha=""
grounding_decisions=""
research_rel=""
if [[ -f "$plan_file" ]]; then
  first_line="$(sed -n '1p' "$plan_file")"
  parsed_title="$(sed -E 's/^# Plan: `[^`]+` — //' <<<"$first_line")"
  [[ -n "$parsed_title" && "$parsed_title" != "$first_line" ]] && title="$parsed_title"
  # grounding: research `<sha>` (`work/<task-id>/research.md`)[, decisions D-1, D-2, ...]
  grounding_raw="$(grep -m1 '^grounding: ' "$plan_file" || true)"
  if [[ -n "$grounding_raw" ]]; then
    grounding_sha="$(sed -n 's/.*research `\([^`]*\)`.*/\1/p' <<<"$grounding_raw")"
    research_rel="$(sed -n 's/.*(`\([^`]*\)`).*/\1/p' <<<"$grounding_raw")"
    grounding_decisions="$(sed -n 's/.*, decisions \(.*\)$/\1/p' <<<"$grounding_raw")"
  fi
fi

# --- ledger: phase timestamps + summed token cost per human-facing phase.
# research/verify absorb their own delegated-agent cost lines
# (research-agent; falsifier, security) so the timeline reads as one
# strip of real work, not spine's internal phase-key bookkeeping. ---
ledger_present=0
[[ -f "$ledger_file" ]] && ledger_present=1

tokens_for() {
  # tokens_for <phase-key-or-prefix...> — sums input+output+cache_create+
  # cache_read across every ACTUAL ledger.json phase key that matches one
  # of the given names exactly, or starts with "<name>-" (e.g. "falsifier"
  # also matches a real "falsifier-round2" key). The prefix match is what
  # makes this backward-compatible with real installed-project ledger.json
  # files that predate `ledger harvest` becoming additive under the same
  # phase key (a re-dispatched adversary round used to silently overwrite
  # round 1's tokens, so some real sessions worked around it by inventing
  # a "-round2"-suffixed key instead — those historical files still need
  # to render correctly, not just newly-harvested ones).
  [[ "$ledger_present" -eq 1 ]] || { echo 0; return; }
  local phases_json
  phases_json="$(printf '%s\n' "$@" | jq -R . | jq -s .)"
  jq --argjson names "$phases_json" '
    .phases as $p
    | [ ($p | keys)[] as $k
        | select(any($names[]; . as $name | ($k == $name) or ($k | startswith($name + "-"))))
        | $k ]
    | map($p[.].tokens // {input:0,output:0,cache_create:0,cache_read:0})
    | map(.input + .output + .cache_create + .cache_read) | add // 0
  ' "$ledger_file"
}

marked_at_for() {
  [[ "$ledger_present" -eq 1 ]] || { echo ""; return; }
  jq -r --arg p "$1" '.phases[$p].marked_at // empty' "$ledger_file"
}

fmt_tokens() {
  awk -v n="$1" 'BEGIN{
    if (n >= 1000000) printf "%.1fM", n/1000000;
    else if (n >= 1000) printf "%.1fk", n/1000;
    else printf "%d", n;
  }'
}

to_epoch() {
  # to_epoch <ledger.json UTC "...Z" timestamp> — BSD date (macOS
  # /bin/bash 3.2 ships no GNU date -d); same parsing already proven in
  # core/scripts/render-dashboard, copied rather than re-derived.
  date -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" "+%s" 2>/dev/null
}

fmt_ts() {
  # fmt_ts <timestamp> — human-readable, e.g. "Aug 15, 2026 05:24 PM EDT".
  # Rendered in DASHBOARD_TZ (default America/New_York), always showing
  # the zone abbreviation, same fix and same env var as
  # core/scripts/render-dashboard's own fmt_ts (copied rather than
  # re-derived — see this function's own header comment above). Falls
  # back to the raw value if it doesn't parse rather than hiding it.
  local e
  e="$(to_epoch "$1")" || { printf '%s' "$1"; return; }
  TZ="${DASHBOARD_TZ:-America/New_York}" date -r "$e" "+%b %d, %Y %I:%M %p %Z" 2>/dev/null || printf '%s' "$1"
}

fmt_duration() {
  awk -v s="$1" 'BEGIN{
    if (s < 60) { printf "%ds", s; exit }
    m = int(s/60); h = int(m/60); m = m % 60;
    if (h > 0) printf "%dh %dm", h, m; else printf "%dm", m;
  }'
}

TIMELINE_PHASES=(classify research plan implement verify ship)
phase_source_keys() {
  # phase_source_keys <timeline-phase> — bash 3.2 has no associative
  # arrays (macOS's shipped /bin/bash); a case statement is the portable
  # equivalent. Absorbs each phase's own delegated-agent ledger keys
  # (research-agent; falsifier, security) into its human-facing phase.
  case "$1" in
    classify) echo "classify" ;;
    research) echo "research research-agent" ;;
    plan) echo "plan" ;;
    implement) echo "implement" ;;
    verify) echo "verify falsifier security" ;;
    ship) echo "ship" ;;
  esac
}

extract_bullets() {
  # extract_bullets <start-heading-regex> <end-regex> <file> — a `- ` line
  # starts a new bullet; any non-blank line after it that doesn't itself
  # start a new bullet is a wrapped continuation of the same one (plan.md's
  # prose wraps at ~72 chars per the writing mandate) and gets folded back
  # onto one line, not silently dropped.
  awk -v start="$1" -v endpat="$2" '
    $0 ~ start { f=1; next }
    f && $0 ~ endpat { exit }
    f && /^- / { if (buf != "") print buf; buf=$0; next }
    f && NF == 0 { next }
    f { sub(/^ +/, ""); buf = buf " " $0 }
    END { if (buf != "") print buf }
  ' "$3"
}

# --- plan.md: gist prose, predicted touch, decisions grounded on ---
gist=""
predicted_touch=""
grounds_decisions=""
if [[ -f "$plan_file" ]]; then
  gist="$(awk '/^## The gist/{f=1;next} f && /^## /{exit} f' "$plan_file" | sed '/./,$!d')"
  predicted_touch="$(extract_bullets '^## Predicted touch' '^<!-- /MACHINE' "$plan_file")"
  grounds_decisions="$(extract_bullets '^## Grounds on decisions' '^<!-- /MACHINE' "$plan_file")"
fi

# --- deviations.md: fixed-field records per core/templates/deviations.md.
# Absent file means no deviation ever happened — "the plan held," the same
# convention briefing.md itself uses, not a gap. ---
deviation_count=0
[[ -f "$deviations_file" ]] && deviation_count="$(grep -c '^## Deviation ' "$deviations_file" || true)"

extract_field() {
  # extract_field <block> <field-label> — a field's value runs from its
  # own "- Label:" line up to (not including) the next "- Word" bullet,
  # so a value that wraps onto a continuation line is still captured
  # whole rather than truncated at the first newline.
  local block="$1" field="$2"
  awk -v field="- $field:" '
    index($0, field) == 1 { sub("^" field " *", ""); buf = $0; collecting = 1; next }
    collecting && /^- [A-Za-z]/ { exit }
    collecting { sub(/^ +/, ""); buf = buf " " $0 }
    END { print buf }
  ' <<<"$block" | tr -s ' '
}

deviation_block() {
  local n="$1"
  awk -v target="## Deviation $n" '
    $0 == target { f=1; next }
    f && /^## Deviation / { exit }
    f { print }
  ' "$deviations_file"
}

# --- verify.md: overall result line + per-adversary kept/dropped counts.
# Floor results and capability/tooling gaps come from the structured JSON
# artifacts below instead of re-parsing verify.md's prose tables. ---
verify_present=0
[[ -f "$verify_file" ]] && verify_present=1
verify_result=""
floor_run_ts=""
if [[ "$verify_present" -eq 1 ]]; then
  header_line="$(grep -m1 '^Class: ' "$verify_file" || true)"
  verify_result="$(sed -n 's/.*Result: `\([A-Za-z]*\)`.*/\1/p' <<<"$header_line")"
  floor_run_ts="$(sed -n 's/.*Floor run: `\([^`]*\)`.*/\1/p' <<<"$header_line")"
fi

adversary_dropped_for() {
  # adversary_dropped_for <Agent-name-as-in-heading> — reads verify.md's
  # own "Verdicts kept: `N` · dropped: `N`" line for that ### subsection.
  [[ "$verify_present" -eq 1 ]] || { echo ""; return; }
  awk -v h="### $1" '
    $0 == h { f=1; next }
    f && /^### / { exit }
    f && /Verdicts kept:/ { print; exit }
  ' "$verify_file" | sed -n 's/.*dropped: `\([0-9]*\)`.*/\1/p'
}

# --- floor: prefer the structured artifact floor writes over re-parsing
# verify.md's markdown table. ---
floor_json="$artifacts_dir/floor-result.json"
floor_present=0
[[ -f "$floor_json" ]] && floor_present=1
floor_could_not_run=0
if [[ "$verify_present" -eq 1 && "$floor_present" -eq 0 ]]; then
  grep -q 'COULD NOT RUN' "$verify_file" && floor_could_not_run=1
fi

# --- adversary verdicts: the actual filtered, schema-validated objects
# verdict-filter wrote (core/ADAPTER-CONTRACT.md §5), never the raw
# pre-filter file. ---
adversary_files=()
if [[ -d "$artifacts_dir" ]]; then
  while IFS= read -r f; do
    [[ -n "$f" ]] && adversary_files+=("$f")
  done < <(find "$artifacts_dir" -maxdepth 1 -name '*-verdict.json' ! -name '*-raw.json' 2>/dev/null | sort)
fi

# --- briefing.md: the two floors this document may never compress below
# (core/templates/briefing.md) — What & why, and the six-months line. ---
briefing_present=0
[[ -f "$briefing_file" ]] && briefing_present=1
what_why=""
six_months=""
if [[ "$briefing_present" -eq 1 ]]; then
  what_why="$(awk '/^\*\*What & why:\*\*/{f=1} f{print} f && /^\*\*What surprised us:/{exit}' "$briefing_file" | sed '$d' | sed 's/^\*\*What & why:\*\* *//')"
  six_months="$(awk '/^\*\*In six months/{f=1} f{print} f && /^$/{exit}' "$briefing_file" | sed 's/^\*\*In six months you.ll want to know:\*\* *//')"
fi

# ============================== render ==============================

{
cat <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>$(html_escape <<<"$task_id") — task report</title>
<style>
  :root {
    --bg: #f7f7f8; --panel: #ffffff; --border: #e0e0e3; --text: #1a1a1e;
    --muted: #6b6b76; --accent: #2f5fdb;
    --pass: #1a7f37; --fail: #cf222e; --degraded: #9a6700;
    --tier-halt: #cf222e; --tier-record: #9a6700; --tier-decide: #6b6b76;
    --sev-high: #cf222e; --sev-medium: #9a6700; --sev-low: #6b6b76;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 920px; margin: 0 auto; padding: 32px 24px 80px; }
  header.page { margin-bottom: 28px; }
  header.page h1 { margin: 0 0 6px; font-size: 1.6em; }
  header.page .meta { color: var(--muted); font-size: 0.92em; }
  header.page .meta code { background: var(--panel); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 0.8em; font-weight: 600; color: #fff; }
  .badge.pass { background: var(--pass); }
  .badge.fail { background: var(--fail); }
  .badge.degraded { background: var(--degraded); }
  .badge.neutral { background: var(--muted); }
  nav.timeline { display: flex; gap: 8px; overflow-x: auto; margin-bottom: 32px; padding-bottom: 4px; }
  nav.timeline a {
    flex: 0 0 auto; display: block; min-width: 108px; padding: 10px 12px;
    background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
    text-decoration: none; color: var(--text);
  }
  nav.timeline a .phase { font-weight: 600; font-size: 0.9em; }
  nav.timeline a .ts { color: var(--muted); font-size: 0.76em; display: block; margin-top: 3px; }
  nav.timeline a .dur { color: var(--muted); font-size: 0.76em; display: block; margin-top: 1px; }
  nav.timeline a .cost { color: var(--accent); font-size: 0.76em; display: block; margin-top: 1px; }
  nav.timeline a.empty { opacity: 0.4; }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 20px 22px; margin-bottom: 20px; }
  section > h2 { margin: 0 0 14px; font-size: 1.05em; }
  section p.omitted { color: var(--muted); font-style: italic; margin: 0; }
  .gist-text p { margin: 0 0 10px; }
  .gist-text p:last-child { margin-bottom: 0; }
  ul.touch-list, ul.grounds-list { margin: 8px 0 0; padding-left: 20px; }
  ul.touch-list li, ul.grounds-list li { margin-bottom: 4px; }
  table.floor { width: 100%; border-collapse: collapse; font-size: 0.92em; }
  table.floor th, table.floor td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  table.floor code { font-size: 0.95em; }
  .card { border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; }
  .card:last-child { margin-bottom: 0; }
  .card .tier { font-weight: 600; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.02em; }
  .tier-halt { color: var(--tier-halt); }
  .tier-record-and-proceed { color: var(--tier-record); }
  .tier-decide-alone { color: var(--tier-decide); }
  .card dl { margin: 8px 0 0; }
  .card dt { font-weight: 600; font-size: 0.85em; color: var(--muted); margin-top: 8px; }
  .card dd { margin: 2px 0 0; }
  .verdict { border-left: 3px solid var(--sev-low); padding: 8px 0 8px 12px; margin-bottom: 10px; }
  .verdict.sev-high { border-left-color: var(--sev-high); }
  .verdict.sev-medium { border-left-color: var(--sev-medium); }
  .verdict.sev-low { border-left-color: var(--sev-low); }
  .verdict .sev-label { font-weight: 600; font-size: 0.78em; text-transform: uppercase; }
  .verdict .sev-label.sev-high { color: var(--sev-high); }
  .verdict .sev-label.sev-medium { color: var(--sev-medium); }
  .verdict .sev-label.sev-low { color: var(--sev-low); }
  .verdict .claim { margin: 4px 0; }
  .verdict .evidence { font-size: 0.88em; color: var(--muted); }
  .verdict .evidence code { color: var(--text); }
  details.evidence-cmd summary { cursor: pointer; }
  details.evidence-cmd pre { background: var(--bg); border-radius: 6px; padding: 8px 10px; overflow-x: auto; margin: 6px 0 0; }
  .attacked-list { font-size: 0.88em; color: var(--muted); margin: 0 0 14px; padding-left: 20px; }
  .summary-badge { font-size: 0.85em; color: var(--muted); margin-bottom: 10px; }
  .gap-list { margin: 0; padding-left: 20px; font-size: 0.92em; }
  footer.page { color: var(--muted); font-size: 0.85em; margin-top: 20px; }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171a; --panel: #1e1f23; --border: #33343a; --text: #e8e8ea;
      --muted: #8b8b96;
    }
  }
</style>
</head>
<body>
<div class="wrap">
<header class="page">
  <h1>$(html_escape <<<"$title")</h1>
  <div class="meta">
    <code>$(html_escape <<<"$task_id")</code>
    · class $(html_escape <<<"$class_val")
    $( [[ -n "$state_val" ]] && echo "· state $(html_escape <<<"$state_val")" )
    $( [[ -n "$milestone_val" && "$milestone_val" != "none" ]] && echo "· milestone $(html_escape <<<"$milestone_val")" )
    $( [[ -n "$owner_val" ]] && echo "· $(html_escape <<<"$owner_val")" )
    $( [[ -n "$verify_result" ]] && {
         cls="neutral"; [[ "$verify_result" == "PASS" ]] && cls="pass"; [[ "$verify_result" == "FAIL" ]] && cls="fail"
         echo "· <span class=\"badge $cls\">verify: $(html_escape <<<"$verify_result")</span>"
       } )
  </div>
  $( [[ -n "$grounding_sha" || -n "$grounding_decisions" ]] && {
       research_link=""
       if [[ -n "$grounding_sha" && -f "$work_dir/research.md" ]]; then
         research_link="<a href=\"research.md\" title=\"research commit $(html_escape <<<"$grounding_sha")\">research notes</a>"
       elif [[ -n "$grounding_sha" ]]; then
         research_link="research notes"
       fi
       sentence=""
       [[ -n "$research_link" ]] && sentence="Grounded in $research_link"
       if [[ -n "$grounding_decisions" ]]; then
         [[ -n "$sentence" ]] && sentence="$sentence and decisions $(html_escape <<<"$grounding_decisions")" \
           || sentence="Grounded in decisions $(html_escape <<<"$grounding_decisions")"
       fi
       [[ -n "$sentence" ]] && echo "<div class=\"meta\">$sentence.</div>"
     } )
</header>

<nav class="timeline">
HTML

prev_ts=""
for phase in "${TIMELINE_PHASES[@]}"; do
  ts="$(marked_at_for "$phase")"
  cost="$(tokens_for $(phase_source_keys "$phase"))"
  if [[ -z "$ts" ]]; then
    # A phase can have real recorded cost with no `marked_at` of its own —
    # e.g. `verify` absorbing falsifier/security tokens (see
    # phase_source_keys above) when the session harvested those subagent
    # phases but never itself called `ledger mark <task-id> verify` (a
    # real, confirmed gap in practice: 65% of a sample of real installed-
    # project tasks). Silently showing "not reached" then hid genuine,
    # often expensive, adversary-review spend. Show the cost with an
    # honest caveat instead of dropping it.
    if [[ "$cost" != "0" ]]; then
      printf '<a class="empty" href="#%s"><span class="phase">%s</span><span class="ts">not reached (%s tok recorded under a subagent phase)</span></a>\n' \
        "$phase" "$phase" "$(fmt_tokens "$cost")"
    else
      printf '<a class="empty" href="#%s"><span class="phase">%s</span><span class="ts">not reached</span></a>\n' \
        "$phase" "$phase"
    fi
  else
    dur=""
    if [[ -n "$prev_ts" ]]; then
      e_ts="$(to_epoch "$ts")"; e_prev="$(to_epoch "$prev_ts")"
      [[ -n "$e_ts" && -n "$e_prev" ]] && dur="$(fmt_duration $((e_ts - e_prev)))"
    fi
    printf '<a href="#%s" title="%s"><span class="phase">%s</span><span class="ts">%s</span>%s<span class="cost">%s tok</span></a>\n' \
      "$phase" "$(html_escape <<<"$ts")" "$phase" "$(html_escape <<<"$(fmt_ts "$ts")")" \
      "$( [[ -n "$dur" ]] && printf '<span class="dur">took %s</span>' "$(html_escape <<<"$dur")" )" \
      "$(fmt_tokens "$cost")"
    prev_ts="$ts"
  fi
done

cat <<'HTML'
</nav>

<section id="research">
<h2>The gist</h2>
HTML

if [[ -n "$gist" ]]; then
  printf '<div class="gist-text">\n%s</div>\n' "$(html_escape <<<"$gist" | render_paragraphs)"
else
  echo '<p class="omitted">plan.md not yet written — task has not reached /task'"'"'s plan phase.</p>'
fi

if [[ -n "$predicted_touch" ]]; then
  echo '<h2 style="margin-top:20px;">Predicted touch</h2><ul class="touch-list">'
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    printf '<li>%s</li>\n' "$(sed 's/^- //' <<<"$line" | html_escape)"
  done <<<"$predicted_touch"
  echo '</ul>'
fi

if [[ -n "$grounds_decisions" ]]; then
  echo '<h2 style="margin-top:20px;">Grounds on decisions</h2><ul class="grounds-list">'
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    printf '<li>%s</li>\n' "$(sed 's/^- //' <<<"$line" | html_escape)"
  done <<<"$grounds_decisions"
  echo '</ul>'
fi

echo '</section>'

# ---- deviations ----
cat <<'HTML'
<section id="plan">
<h2>Deviations</h2>
HTML

if [[ "$deviation_count" -eq 0 ]]; then
  echo '<p class="omitted">No deviations — the plan held.</p>'
else
  for n in $(seq 1 "$deviation_count"); do
    block="$(deviation_block "$n")"
    tier="$(extract_field "$block" "Tier" | sed 's/^ *//;s/ *$//')"
    status="$(extract_field "$block" "Status" | sed 's/^ *//;s/ *$//')"
    plan_assumed="$(extract_field "$block" "Plan assumed")"
    actually_true="$(extract_field "$block" "Actually true")"
    resolution="$(extract_field "$block" "Resolution")"
    tier_class="tier-decide-alone"
    [[ "$tier" == "halt" ]] && tier_class="tier-halt"
    [[ "$tier" == "record-and-proceed" ]] && tier_class="tier-record-and-proceed"
    printf '<div class="card">\n'
    printf '<span class="tier %s">%s</span> · %s\n' "$tier_class" "$(html_escape <<<"$tier")" "$(html_escape <<<"$status")"
    printf '<dl>\n'
    [[ -n "$plan_assumed" ]] && printf '<dt>Plan assumed</dt><dd>%s</dd>\n' "$(html_escape <<<"$plan_assumed")"
    [[ -n "$actually_true" ]] && printf '<dt>Actually true</dt><dd>%s</dd>\n' "$(html_escape <<<"$actually_true")"
    [[ -n "$resolution" ]] && printf '<dt>Resolution</dt><dd>%s</dd>\n' "$(html_escape <<<"$resolution")"
    printf '</dl></div>\n'
  done
fi
echo '</section>'

# ---- floor results ----
cat <<'HTML'
<section id="verify">
<h2>Floor results</h2>
HTML

if [[ "$floor_present" -eq 1 ]]; then
  echo '<table class="floor"><tr><th>Capability</th><th>Result</th><th>Detail</th></tr>'
  while IFS=$'\t' read -r cap status detail; do
    badge="degraded"
    [[ "$status" == "pass" ]] && badge="pass"
    [[ "$status" == "fail" ]] && badge="fail"
    # floor's own floor-result.json writes detail strings with a full
    # absolute filesystem path baked in (e.g. "...(artifact: /Users/.../
    # work/<task-id>/artifacts/dep-diff.md)") — real structured data, not
    # something this script invented, so the fix happens here at render
    # time: strip this task's own work_dir (and, as a fallback, the
    # project root) prefix so the path reads relative and doubles as a
    # working link from report.html's own location.
    short="${detail//$work_dir\//}"
    short="${short//$project\//}"
    detail_html="$(sed -E 's#(artifacts/[A-Za-z0-9._/-]+)#<a href="\1">\1</a>#g' <<<"$(html_escape <<<"$short")")"
    printf '<tr><td><code>%s</code></td><td><span class="badge %s">%s</span></td><td>%s</td></tr>\n' \
      "$(html_escape <<<"$cap")" "$badge" "$(html_escape <<<"$status")" "$detail_html"
  done < <(jq -r '.results[] | [.capability, .status, .detail] | @tsv' "$floor_json")
  echo '</table>'
  [[ -n "$floor_run_ts" ]] && printf '<p class="omitted" style="margin-top:10px;">Floor run: %s</p>\n' "$(html_escape <<<"$(fmt_ts "$floor_run_ts")")"
elif [[ "$floor_could_not_run" -eq 1 ]]; then
  echo '<p class="omitted">Floor could not run this task — see verify.md Tooling gaps.</p>'
elif [[ "$verify_present" -eq 1 ]]; then
  echo '<p class="omitted">No floor-result.json artifact found for this task.</p>'
else
  echo '<p class="omitted">verify.md not yet written — task has not reached /verify.</p>'
fi
echo '</section>'

# ---- adversary verdicts ----
cat <<'HTML'
<section id="adversaries">
<h2>Adversary activity</h2>
HTML

if [[ "${#adversary_files[@]}" -eq 0 ]]; then
  if [[ "$verify_present" -eq 1 ]]; then
    echo '<p class="omitted">Not run — floor failed before the adversary phase, or this task'"'"'s verify run never reached it.</p>'
  else
    echo '<p class="omitted">verify.md not yet written — task has not reached /verify.</p>'
  fi
else
  for f in "${adversary_files[@]}"; do
    agent="$(jq -r '.agent' "$f")"
    agent_title="$(tr '[:lower:]' '[:upper:]' <<<"${agent:0:1}")${agent:1}"
    dropped="$(adversary_dropped_for "$agent_title")"
    kept_count="$(jq '.verdicts | length' "$f")"
    max_sev="none"
    for s in high medium low; do
      if jq -e --arg s "$s" '.verdicts[] | select(.severity == $s)' "$f" >/dev/null 2>&1; then
        max_sev="$s"; break
      fi
    done
    printf '<h3>%s</h3>\n' "$(html_escape <<<"$agent_title")"
    printf '<div class="summary-badge">%s kept%s · max severity: %s</div>\n' \
      "$kept_count" "$( [[ -n "$dropped" ]] && echo ", $dropped dropped" )" "$(html_escape <<<"$max_sev")"
    echo '<div class="attacked-list"><strong>Attacked:</strong><ul>'
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      printf '<li>%s</li>\n' "$(html_escape <<<"$item")"
    done < <(jq -r '.attacked[]' "$f")
    echo '</ul></div>'

    while IFS= read -r verdict; do
      [[ -n "$verdict" ]] || continue
      sev="$(jq -r '.severity' <<<"$verdict")"
      claim="$(jq -r '.claim' <<<"$verdict")"
      ev_kind="$(jq -r '.evidence.kind' <<<"$verdict")"
      printf '<div class="verdict sev-%s">\n' "$sev"
      printf '<span class="sev-label sev-%s">%s</span>\n' "$sev" "$(html_escape <<<"$sev")"
      printf '<p class="claim">%s</p>\n' "$(html_escape <<<"$claim")"
      if [[ "$ev_kind" == "file_line" ]]; then
        ev_file="$(jq -r '.evidence.file' <<<"$verdict")"
        ev_line="$(jq -r '.evidence.line' <<<"$verdict")"
        printf '<div class="evidence">evidence: <code>%s:%s</code></div>\n' "$(html_escape <<<"$ev_file")" "$ev_line"
      elif [[ "$ev_kind" == "command" ]]; then
        ev_cmd="$(jq -r '.evidence.command' <<<"$verdict")"
        ev_out="$(jq -r '.evidence.output' <<<"$verdict")"
        printf '<details class="evidence-cmd"><summary><code>%s</code></summary><pre>%s</pre></details>\n' \
          "$(html_escape <<<"$ev_cmd")" "$(html_escape <<<"$ev_out")"
      elif [[ "$ev_kind" == "decision" ]]; then
        ev_did="$(jq -r '.evidence.decision_id' <<<"$verdict")"
        ev_quote="$(jq -r '.evidence.quote' <<<"$verdict")"
        printf '<div class="evidence">evidence: <code>%s</code> — "%s"</div>\n' "$(html_escape <<<"$ev_did")" "$(html_escape <<<"$ev_quote")"
      fi
      echo '</div>'
    done < <(jq -c '.verdicts[]' "$f")
  done
fi
echo '</section>'

# ---- capability / tooling gaps (from ledger.json, structured) ----
cat <<'HTML'
<section id="gaps">
<h2>Capability &amp; tooling gaps</h2>
HTML

if [[ "$ledger_present" -eq 1 ]]; then
  cap_gaps="$(jq -r '.capability_gaps[]?' "$ledger_file")"
  tooling_gaps_count="$(jq '.tooling_gaps | length' "$ledger_file")"
  if [[ -z "$cap_gaps" ]]; then
    echo '<p class="omitted">No capability gaps recorded.</p>'
  else
    echo '<ul class="gap-list">'
    while IFS= read -r g; do [[ -n "$g" ]] && printf '<li>%s</li>\n' "$(html_escape <<<"$g")"; done <<<"$cap_gaps"
    echo '</ul>'
  fi
  if [[ "$tooling_gaps_count" -gt 0 ]]; then
    echo '<h3 style="margin-top:14px;">Tooling gaps</h3><ul class="gap-list">'
    while IFS=$'\t' read -r script consequence; do
      printf '<li><code>%s</code> — %s</li>\n' "$(html_escape <<<"$script")" "$(html_escape <<<"$consequence")"
    done < <(jq -r '.tooling_gaps[] | [.script, .consequence] | @tsv' "$ledger_file")
    echo '</ul>'
  fi
else
  echo '<p class="omitted">ledger.json not found.</p>'
fi
echo '</section>'

# ---- conformance, approval, and ship-time re-grounding (from ledger.json)
# ---- these are recorded by /verify and /ship but had no reader anywhere
# ---- until this section (spine audit finding, 2026-08-22) ----
cat <<'HTML'
<section id="regrounding">
<h2>Conformance, approval &amp; re-grounding</h2>
HTML

if [[ "$ledger_present" -eq 1 ]]; then
  conformance_score="$(jq -r '.conformance_score // empty' "$ledger_file")"
  second_approver="$(jq -r '.second_approver // empty' "$ledger_file")"
  rg_check_stale="$(jq -r '.ship_time_regrounding_check_stale // empty' "$ledger_file")"
  rg_floor="$(jq -r '.ship_time_regrounding_floor // empty' "$ledger_file")"
  rg_claims="$(jq -r '.ship_time_regrounding_claims // empty' "$ledger_file")"
  rg_index="$(jq -r '.ship_time_regrounding_index // empty' "$ledger_file")"
  plan_lines="$(jq -r '.plan_line_count // empty' "$ledger_file")"
  briefing_lines="$(jq -r '.briefing_line_count // empty' "$ledger_file")"
  briefing_words="$(jq -r '.briefing_word_count // empty' "$ledger_file")"
  items=""
  # Both counts are meant to be written via `ledger set <task-id>
  # plan_line_count <n>` with a clean `wc -l` integer. An earlier version
  # of task/SKILL.md and ship/SKILL.md didn't specify `wc -l <file`
  # (redirect stdin) vs. `wc -l file` — the latter (natural to type)
  # prints "<n> <filename>", which `ledger set` stores verbatim as a
  # string when it isn't valid JSON, and a raw `-gt` comparison against
  # that string killed this whole render under `set -uo pipefail` (bash
  # 3.2 nounset abort mid-arithmetic) with exit 0 and no output file —
  # reproduced directly. Both skill files now specify the redirect form,
  # but this guard stays as defense in depth against a hand-authored or
  # older-session value in the same shape.
  # The digits-only guard renders the raw value without the cap check
  # instead of crashing when it isn't a clean integer.
  if [[ -n "$plan_lines" ]]; then
    over=""
    [[ "$plan_lines" =~ ^[0-9]+$ && "$plan_lines" -gt 200 ]] && over=" — over the 200-line cap"
    items+="<li><strong>plan.md length:</strong> $(html_escape <<<"$plan_lines") lines$over</li>"$'\n'
  fi
  if [[ -n "$briefing_lines" ]]; then
    over=""
    [[ "$briefing_lines" =~ ^[0-9]+$ && "$briefing_lines" -gt 60 ]] && over=" — over the ~1-page cap"
    # briefing.md is one unwrapped paragraph per label, so a line count
    # alone under-detects an over-length briefing (unlike plan.md's
    # wrapped-bullet style, where line count tracks page length) — the
    # word count is the signal that actually catches it.
    if [[ -n "$briefing_words" && "$briefing_words" =~ ^[0-9]+$ && "$briefing_words" -gt 600 && -z "$over" ]]; then
      over=" — over the ~1-page cap ($(html_escape <<<"$briefing_words") words)"
    fi
    items+="<li><strong>briefing.md length:</strong> $(html_escape <<<"$briefing_lines") lines$over</li>"$'\n'
  fi
  [[ -n "$conformance_score" ]] && items+="<li><strong>Conformance (plan vs. actual, F1):</strong> $(html_escape <<<"$conformance_score")</li>"$'\n'
  [[ -n "$second_approver" ]] && items+="<li><strong>Second approver (Class 2):</strong> $(html_escape <<<"$second_approver")</li>"$'\n'
  [[ -n "$rg_check_stale" ]] && items+="<li><strong>Ship-time re-grounding — check-stale:</strong> $(html_escape <<<"$rg_check_stale")</li>"$'\n'
  [[ -n "$rg_floor" ]] && items+="<li><strong>Ship-time re-grounding — floor re-run:</strong> $(html_escape <<<"$rg_floor")</li>"$'\n'
  [[ -n "$rg_claims" ]] && items+="<li><strong>Ship-time re-grounding — claims-check:</strong> $(html_escape <<<"$rg_claims")</li>"$'\n'
  [[ -n "$rg_index" ]] && items+="<li><strong>Ship-time re-grounding — decision-index:</strong> $(html_escape <<<"$rg_index")</li>"$'\n'
  if [[ -n "$items" ]]; then
    printf '<ul class="gap-list">\n%s</ul>\n' "$items"
  else
    echo '<p class="omitted">Not yet recorded — task has not reached /verify or /ship.</p>'
  fi
else
  echo '<p class="omitted">ledger.json not found.</p>'
fi
echo '</section>'

# ---- briefing ----
cat <<'HTML'
<section id="ship">
<h2>Briefing</h2>
HTML

if [[ "$briefing_present" -eq 1 ]]; then
  if [[ -n "$what_why" ]]; then
    # render_paragraphs splits multi-sentence fields into one <p> per
    # sentence (see its own header comment) — the field's bold label
    # belongs only on the first paragraph, injected into that one <p>
    # tag rather than prefixed to the raw text before splitting (which
    # would leave the label's own sentence-ending punctuation, if any,
    # at risk of triggering a false split).
    what_why_html="$(html_escape <<<"$what_why" | render_paragraphs)"
    printf '%s\n' "$what_why_html" | sed '1s|^<p>|<p><strong>What \&amp; why:</strong> |'
  fi
  if [[ -n "$six_months" ]]; then
    six_months_html="$(html_escape <<<"$six_months" | render_paragraphs)"
    printf '%s\n' "$six_months_html" | sed '1s|^<p>|<p><strong>In six months you'"'"'ll want to know:</strong> |'
  fi
else
  echo '<p class="omitted">briefing.md not yet written — task has not reached /ship.</p>'
fi
echo '</section>'

cat <<HTML
<footer class="page">
  Generated $(fmt_ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)") from <code>work/$(html_escape <<<"$task_id")/</code>.
  Regenerate with <code>render-task --task $(html_escape <<<"$task_id") --project $(html_escape <<<"$project")</code>.
</footer>
</div>
</body>
</html>
HTML
} > "$tmp_out"

mv "$tmp_out" "$out_path"
trap - EXIT
echo "render-task: wrote $out_path"
