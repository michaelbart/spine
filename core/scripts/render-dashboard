#!/bin/bash
# render-dashboard — reads a spine-installed project's entire history
# (every work/<task-id>/, docs/decisions/, .spine/capabilities.json,
# work/M*/milestone.md, work/design/design-review.md, git log, and
# core/scripts/ledger's own aggregates) and writes one self-contained
# project-wide HTML dashboard: a Gantt strip across every task, a
# chronological event feed (one row per real ledger phase transition,
# with its own duration/cost/outcome, interleaved with non-task project
# events), the decision store with supersession chains, a grouped
# capability matrix, milestone progress, and the /costs-style drift
# instrument. Pure aggregation of what /task/verify/ship/design already
# write — no new instrumentation. Never a gate.
#
# Usage: render-dashboard --project <path> [--out <path>] [--since <date> | --all]
#
# Windowing (Phase 9, "dashboard at scale"): after months of multi-engineer
# use a flat Gantt + event feed + task list grow unbounded and stop being
# usable. By default this renders a BOUNDED window — every not-yet-done task
# plus any task with ledger activity in the last ~14 days — so a fresh render
# stays legible. --since <date> widens that window back to <date>; --all
# reproduces the full historical render (every task, every event) exactly as
# before, so any windowing regression is detectable by diffing against --all.
# The window is applied server-side to the task-derived sections (Gantt strip,
# event feed, traced-trivial). Everything the window keeps is then further
# sliceable client-side (facet/filter/search/collapse) with no re-render.
set -uo pipefail

usage() { echo "usage: render-dashboard --project <path> [--out <path>] [--since <date> | --all]" >&2; exit 2; }

project=""
out_path=""
window_mode="default"   # default | since | all
since_date=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --out) out_path="$2"; shift 2 ;;
    --since) window_mode="since"; since_date="$2"; shift 2 ;;
    --all) window_mode="all"; shift ;;
    *) usage ;;
  esac
done
[[ -n "$project" ]] || usage
project="$(cd "$project" && pwd)"
[[ -f "$project/.spine/capabilities.json" ]] || { echo "render-dashboard: $project is not spine-installed (no .spine/capabilities.json)" >&2; exit 2; }
[[ -n "$out_path" ]] || out_path="$project/docs/dashboard.html"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
render_task_bin="$SCRIPT_DIR/render-task"
ledger_bin="$SCRIPT_DIR/ledger"

# Every generated link is relative to $out_path's own directory. The one
# supported layout is docs/dashboard.html (one level under the project
# root) — link_prefix is what closes that one-level gap back to root so
# work/<task-id>/report.html actually resolves instead of 404ing under
# docs/. A caller passing --out somewhere else still gets a dashboard,
# just with links computed for the documented default depth.
out_dir="$(cd "$(dirname "$out_path")" 2>/dev/null && pwd || echo "$project")"
if [[ "$out_dir" == "$project" ]]; then
  link_prefix=""
else
  link_prefix="../"
fi

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

is_git_repo=0
git -C "$project" rev-parse --git-dir >/dev/null 2>&1 && is_git_repo=1

to_epoch() {
  # to_epoch <timestamp> — accepts both shapes this dashboard reads:
  # ledger.json's UTC "...Z" (marked_at) and git %aI's "...+HH:MM" offset
  # form. BSD date (macOS /bin/bash 3.2 ships no GNU date -d) needs a
  # fixed -f format per shape, and the offset form needs its colon
  # stripped first (BSD strptime doesn't accept "+04:00", only "+0400").
  local ts="$1" stripped
  date -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" "+%s" 2>/dev/null && return
  stripped="$(printf '%s' "$ts" | sed -E 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')"
  date -j -f "%Y-%m-%dT%H:%M:%S%z" "$stripped" "+%s" 2>/dev/null && return
  return 1
}

fmt_ts() {
  # fmt_ts <timestamp> — human-readable, e.g. "Aug 15, 2026 05:24 PM EST".
  # Rendered in DASHBOARD_TZ (default America/New_York) rather than
  # whatever TZ the rendering machine happens to have, and always shows
  # the zone abbreviation so a reader never has to guess which timezone
  # a timestamp is in. Falls back to the raw value if it doesn't parse
  # rather than hiding it.
  local e
  e="$(to_epoch "$1")" || { printf '%s' "$1"; return; }
  TZ="${DASHBOARD_TZ:-America/New_York}" date -r "$e" "+%b %d, %Y %I:%M %p %Z" 2>/dev/null || printf '%s' "$1"
}

fmt_day() {
  # fmt_day <timestamp> — the calendar day a timestamp falls on, in
  # DASHBOARD_TZ, e.g. "Aug 15, 2026". Used to group the event feed into
  # per-day collapsible sections. Falls back to the raw value if unparseable.
  local e
  e="$(to_epoch "$1")" || { printf '%s' "$1"; return; }
  TZ="${DASHBOARD_TZ:-America/New_York}" date -r "$e" "+%b %d, %Y" 2>/dev/null || printf '%s' "$1"
}

parse_since_epoch() {
  # parse_since_epoch <git-date> — resolve a --since argument to an epoch.
  # Mirrors the flexible date forms `/costs --since` (core/scripts/ledger)
  # accepts. GNU date parses every git-date shape natively; BSD date (macOS
  # /bin/bash 3.2) does not, so fall through a fixed set of the shapes a
  # human actually types: ISO with zone (reuse to_epoch), a bare YYYY-MM-DD,
  # and "N days|weeks|months ago" relative forms. Prints epoch, or fails.
  local s="$1" e
  date -d "$s" +%s 2>/dev/null && return          # GNU date (no-op on BSD)
  e="$(to_epoch "$s")" && { printf '%s' "$e"; return; }
  date -j -f "%Y-%m-%d %H:%M:%S" "$s 00:00:00" "+%s" 2>/dev/null && return
  if [[ "$s" =~ ^([0-9]+)[[:space:]]+(day|days|week|weeks|month|months)[[:space:]]+ago$ ]]; then
    local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}" flag=""
    case "$unit" in
      day|days) flag="-${n}d" ;;
      week|weeks) flag="-$((n * 7))d" ;;
      month|months) flag="-${n}m" ;;
    esac
    date -v"$flag" "+%s" 2>/dev/null && return
  fi
  return 1
}

# --- resolve the window cutoff once. Empty cutoff == no windowing (--all):
# every task and event renders, reproducing the pre-Phase-9 full history so a
# regression is detectable by diffing --all against the old output. In the
# windowed modes the cutoff is an epoch; a done task is kept only if its last
# ledger activity is at or after it (open tasks are always kept regardless). ---
now_epoch="$(date +%s)"
window_cutoff=""
window_words=""
case "$window_mode" in
  all)
    window_words="all tasks (full history)"
    ;;
  since)
    if window_cutoff="$(parse_since_epoch "$since_date")"; then
      window_words="open tasks + activity since $since_date"
    else
      echo "render-dashboard: could not parse --since date '$since_date' (try YYYY-MM-DD or 'N days ago')" >&2
      exit 2
    fi
    ;;
  *)
    window_cutoff=$((now_epoch - 14 * 86400))
    window_words="open tasks + activity in the last 14 days"
    ;;
esac

task_in_window() {
  # task_in_window <state> <last_ts> — 0 (in) / 1 (out) for the default and
  # --since modes; always 0 under --all (empty cutoff). Open tasks (state !=
  # done) are always in. A done task is in only if its last ledger mark is at
  # or after the cutoff. A done task with no datable ledger mark is treated as
  # older-than-window (out) — it cannot be proven recent, and the "showing N
  # of M" banner + --all disclose exactly what the window drops.
  local st="$1" last="$2" le
  [[ -z "$window_cutoff" ]] && return 0
  [[ "$st" != "done" ]] && return 0
  [[ -n "$last" ]] || return 1
  le="$(to_epoch "$last")" || return 1
  [[ "$le" -ge "$window_cutoff" ]] && return 0
  return 1
}

fmt_duration() {
  awk -v s="$1" 'BEGIN{
    if (s < 60) { printf "%ds", s; exit }
    m = int(s/60); h = int(m/60); m = m % 60;
    if (h > 0) printf "%dh %dm", h, m; else printf "%dm", m;
  }'
}

fmt_tokens() {
  awk -v n="$1" 'BEGIN{
    if (n >= 1000000) printf "%.1fM tokens", n/1000000;
    else if (n >= 1000) printf "%.1fk tokens", n/1000;
    else printf "%d tokens", n;
  }'
}

gloss_for_commit() {
  # gloss_for_commit <subject> — a short, plain-language "what actually
  # happened" line for spine's own fixed bookkeeping commit-message
  # vocabulary (core/skills/task/SKILL.md's registry-sync calls,
  # core/skills/design/SKILL.md's/bootstrap's own commit messages — see
  # each skill's own literal message strings; never free text a human
  # typed, so pattern-matching against them is stable). Returns empty for
  # anything that doesn't match a known shape — a feature/fix commit's
  # own subject line already explains itself, and an unrecognized
  # bookkeeping shape should stay silent rather than mis-gloss it.
  # Purely additive: the raw commit subject always renders too, this is
  # never a replacement.
  local s="$1"
  case "$s" in
    "spine: bootstrap install"*)
      echo "Project installed: charter drafted, floor calibrated, adapters generated." ;;
    "spine: stamp map.md"*)
      echo "Architecture map stamped with a starting commit — the baseline future staleness checks compare against." ;;
    "spine: design stage"*)
      echo "Design session complete — foundational decisions adopted, first milestone scoped, before any feature code existed." ;;
    "task: open "*)
      echo "New task opened — work begins." ;;
    "task: begin research"|"task: research complete"*|"task: research header corrected"*)
      echo "Research phase — grounding the change in how the system actually works today." ;;
    "task: plan drafted"*)
      echo "Implementation plan drafted, ready for human approval." ;;
    "task: plan approved"*)
      if [[ "$s" == *override* ]]; then
        echo "Plan approved — self-approved override (solo/on-call), recorded loudly, not silently."
      else
        echo "Plan approved — code changes can now begin."
      fi ;;
    "task: begin implement"|"task: entering implement"*)
      echo "Implementation phase begins, against the approved plan." ;;
    "task: deviation "*)
      echo "Plan met reality — the gap, the options considered, and the resolution were all written down before continuing." ;;
    "task: implementation complete"*)
      echo "Implementation finished — ready for independent verification." ;;
    "task: log tooling gap"*)
      echo "A tooling limitation was hit and recorded plainly, rather than silently skipped." ;;
    "task: verify complete, PASS"*)
      echo "Independent adversarial review and the mechanical floor both passed." ;;
    "task: verify complete, FAIL"*)
      echo "Independent adversarial review or the mechanical floor found a real problem — back to implementation." ;;
    "task: post-verify fixes"*)
      echo "Findings from the adversarial review were fixed and re-verified before shipping." ;;
    "task: done")
      echo "Task shipped and closed out." ;;
    "task: milestone "*"assigned to"*)
      echo "Milestone bookkeeping — this task assigned as a member task of the milestone." ;;
    "deps: add "*)
      echo "A new dependency was added — every install/dependency command runs under this project's own manifest-change discipline." ;;
    "chore: clear active task pointer"*)
      echo "Task pointer cleared — this project is no longer mid-task." ;;
  esac
}

phase_source_keys() {
  # phase_source_keys <timeline-phase> — bash 3.2 has no associative
  # arrays; a case statement is the portable equivalent (same pattern
  # already proven in core/scripts/render-task). Absorbs each phase's own
  # delegated-agent ledger keys (research-agent; falsifier, security)
  # into its human-facing phase so a task's real cost isn't undercounted.
  case "$1" in
    classify) echo "classify" ;;
    research) echo "research research-agent" ;;
    plan) echo "plan" ;;
    implement) echo "implement" ;;
    verify) echo "verify falsifier security" ;;
    ship) echo "ship" ;;
  esac
}

TIMELINE_PHASES="classify research plan implement verify ship"

# --- discover real tasks: <YYYYMMDD>-<kebab-slug> dirs under work/,
# per core/ADAPTER-CONTRACT.md §6's own task-id shape — excludes
# work/design, work/M<n>, work/.build and any other non-task bookkeeping
# dir a milestone or design stage leaves behind. ---
task_ids=()
if [[ -d "$project/work" ]]; then
  while IFS= read -r d; do
    name="$(basename "$d")"
    [[ "$name" =~ ^[0-9]{8}-[a-z0-9-]+$ ]] && task_ids+=("$name")
  done < <(find "$project/work" -maxdepth 1 -mindepth 1 -type d | sort)
fi

# --- per-task summary: class, state, verify result, first/last ledger
# timestamp (for the Gantt span), token total, report.html presence,
# owner (for multi-engineer visibility — see "who did what" additions
# below). ---
owner_display() {
  # owner_display <task-id> — work/<task-id>/owner is "<name> <email>"
  # (core/skills/task/SKILL.md §"registry-sync: resolve owner identity");
  # strip the email/angle-bracket tail the same way render-task's own
  # owner_val already does, so a dashboard reader sees a plain name, not
  # a raw git identity string. Empty (never "unknown") if the file is
  # absent — a task predating this field, or one degraded to
  # hand-tracked, is a real absence to show as absent, not invented.
  local wd="$project/work/$1" raw=""
  [[ -f "$wd/owner" ]] && raw="$(cat "$wd/owner")"
  [[ -n "$raw" ]] || { echo ""; return; }
  sed -E 's/[[:space:]]*<[^>]*>[[:space:]]*$//; s/[[:space:]]+[^[:space:]]+@[^[:space:]]+[[:space:]]*$//' <<<"$raw"
}

declare_task_summary() {
  local t="$1" wd="$project/work/$t"
  local class="unknown" state="" verify_result="" first_ts="" last_ts="" tokens=0 has_report=0
  local autonomy="guided" ticket="" milestone=""
  [[ -f "$wd/class" ]] && class="$(cat "$wd/class")"
  [[ -f "$wd/state" ]] && state="$(cat "$wd/state")"
  [[ -f "$wd/report.html" ]] && has_report=1
  # autonomy/ticket are Phase 2/4 fields — a task predating them is a real
  # absence: autonomy defaults to the most-supervised mode (guided), ticket
  # to empty (off-ticket / no linkage), never invented.
  [[ -f "$wd/autonomy" ]] && autonomy="$(cat "$wd/autonomy")"
  [[ -n "$autonomy" ]] || autonomy="guided"
  [[ -f "$wd/ticket" ]] && ticket="$(cat "$wd/ticket")"
  [[ -f "$wd/milestone" ]] && milestone="$(cat "$wd/milestone")"
  if [[ -f "$wd/verify.md" ]]; then
    verify_result="$(sed -n 's/.*Result: `\([A-Za-z]*\)`.*/\1/p' "$wd/verify.md" | head -1)"
  fi
  if [[ -f "$wd/ledger.json" ]]; then
    first_ts="$(jq -r '[.phases[].marked_at] | map(select(. != null)) | sort | .[0] // empty' "$wd/ledger.json")"
    last_ts="$(jq -r '[.phases[].marked_at] | map(select(. != null)) | sort | .[-1] // empty' "$wd/ledger.json")"
    tokens="$(jq '[.phases[] | .tokens // {input:0,output:0,cache_create:0,cache_read:0} | (.input+.output+.cache_create+.cache_read)] | add // 0' "$wd/ledger.json")"
  fi
  local owner; owner="$(owner_display "$t")"
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$t" "$class" "$state" "$verify_result" "$first_ts" "$last_ts" "$tokens" "$has_report" "$owner" "$autonomy" "$ticket" "$milestone"
}

task_rows=()
for t in "${task_ids[@]}"; do
  task_rows+=("$(declare_task_summary "$t")")
done

# --- overall time span for the Gantt strip's percentage-of-span positioning.
# Computed over the WINDOWED set only, so bars spread across the visible span
# rather than being crushed against months of hidden history; under --all the
# windowed set is every task, so the span (and every downstream position)
# reproduces the pre-Phase-9 render exactly. task_shown/task_total also feed
# the "showing N of M" banner. ---
span_min=""
span_max=""
task_total="${#task_rows[@]}"
task_shown=0
for row in "${task_rows[@]}"; do
  IFS=$'\x1f' read -r t cls st vr first last tok rep own auto tkt ms <<<"$row"
  task_in_window "$st" "$last" || continue
  task_shown=$((task_shown + 1))
  [[ -n "$first" ]] || continue
  e_first="$(to_epoch "$first")"
  e_last="$(to_epoch "${last:-$first}")"
  [[ -n "$e_first" ]] || continue
  [[ -z "$span_min" || "$e_first" -lt "$span_min" ]] && span_min="$e_first"
  [[ -z "$span_max" || "$e_last" -gt "$span_max" ]] && span_max="$e_last"
done

gantt_pos() {
  local e="$1"
  [[ -n "$span_min" && -n "$span_max" && "$span_max" -gt "$span_min" ]] || { echo 0; return; }
  awk -v e="$e" -v lo="$span_min" -v hi="$span_max" 'BEGIN{
    p = (e - lo) / (hi - lo) * 100;
    if (p < 0) p = 0; if (p > 100) p = 100;
    printf "%.2f", p;
  }'
}

commit_trailer() {
  # commit_trailer <sha> <trailer-name> — first match, or empty.
  git -C "$project" log -1 --format='%B' "$1" 2>/dev/null | sed -n "s/^${2}: //p" | head -1
}

# --- decisions: fixed frontmatter fields per core/templates/decision.md's
# own grammar. DEFERRED.md is explicitly not a decision record. Sorted
# numerically by decision id, not lexically (D-10 must sort after D-9,
# not after D-1) — done by pairing basename with full path so `sort`'s
# field split never lands on a hyphen earlier in the absolute path. ---
decision_files=()
if [[ -d "$project/docs/decisions" ]]; then
  while IFS= read -r f; do
    [[ "$(basename "$f")" == "DEFERRED.md" ]] && continue
    decision_files+=("$f")
  done < <(find "$project/docs/decisions" -maxdepth 1 -name 'D-*.md' -exec basename {} \; -print 2>/dev/null \
    | paste -d'\t' - - | sort -t'-' -k2,2n | cut -f2)
fi

decision_field() { sed -n "s/^- $2: //p" "$1" | head -1; }
decision_title() { sed -n '1s/^# //p' "$1"; }

# --- milestones: work/M<n>/milestone.md. ---
milestone_files=()
if [[ -d "$project/work" ]]; then
  while IFS= read -r f; do milestone_files+=("$f"); done < <(find "$project/work" -maxdepth 2 -name 'milestone.md' -path '*/M*/*' 2>/dev/null | sort)
fi

# --- design-stage review, if this project went through /design. ---
design_review="$project/work/design/design-review.md"
has_design_review=0
[[ -f "$design_review" ]] && has_design_review=1

# --- active team strictness profile (Phase 5). Absent file == the built-in
# `standard` default. Shown in the header so the drift numbers below have
# context — a team running `prototype` (one adversary, auto allowed) is
# expected to look lighter than one running `regulated`. ---
profile_file="$project/.spine/profile.json"
profile_name="standard (default)"
profile_adv=""
profile_ceil=""
if [[ -f "$profile_file" ]]; then
  profile_name="$(jq -r '.profile // "standard"' "$profile_file" 2>/dev/null || echo "standard")"
  profile_adv="$(jq -r '.class1_adversaries // empty' "$profile_file" 2>/dev/null)"
  profile_ceil="$(jq -r '.autonomy_ceiling // empty' "$profile_file" 2>/dev/null)"
fi

# --- traced-trivial (Class 0) entries — .spine/trace.jsonl, one JSON object
# per line ({ticket, note, class, at, engineer}, written by `ledger trace`).
# This is how trivial committed work becomes visible on the dashboard at all.
# Windowed by `at` under the same rule as tasks (kept if at >= cutoff; all
# kept under --all). Absent file => the section is omitted entirely. ---
trace_file="$project/.spine/trace.jsonl"
trace_rows=()
trace_total=0
trace_present=0
if [[ -f "$trace_file" ]]; then
  trace_present=1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    tk="$(jq -r '.ticket // ""' <<<"$line" 2>/dev/null)" || continue
    nt="$(jq -r '.note // ""' <<<"$line" 2>/dev/null)"
    at="$(jq -r '.at // ""' <<<"$line" 2>/dev/null)"
    eng="$(jq -r '.engineer // ""' <<<"$line" 2>/dev/null)"
    # strip the "<email>" tail the same way owner_display does, for a plain name
    eng="$(sed -E 's/[[:space:]]*<[^>]*>[[:space:]]*$//' <<<"$eng")"
    trace_total=$((trace_total + 1))
    # window by `at`
    if [[ -n "$window_cutoff" ]]; then
      ate="$(to_epoch "$at")" || ate=""
      [[ -n "$ate" && "$ate" -ge "$window_cutoff" ]] || continue
    fi
    esrch="$(printf '%s %s' "$tk" "$nt" | tr '[:upper:]' '[:lower:]')"
    trace_rows+=("$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s' "$tk" "$nt" "$at" "$eng" "$esrch")")
  done < "$trace_file"
fi

# --- cost/drift instrument: shell out to the existing ledger script
# itself, same numbers /costs reports, never re-derived by hand. ---
ledger_aggregate_json="{}"
ledger_by_engineer_json="[]"
untracked_line=""
ledger_reachable=1
if [[ -x "$ledger_bin" ]]; then
  ledger_aggregate_json="$($ledger_bin aggregate --project "$project" 2>/dev/null)"
  [[ -n "$ledger_aggregate_json" ]] || ledger_aggregate_json="{}"
  ledger_by_engineer_json="$($ledger_bin aggregate --project "$project" --by-engineer 2>/dev/null)"
  [[ -n "$ledger_by_engineer_json" ]] || ledger_by_engineer_json="[]"
  untracked_line="$($ledger_bin scan-untracked-ratio --project "$project" 2>/dev/null)"
else
  ledger_reachable=0
fi

# --- generate any missing per-task report.html so every dashboard link
# resolves — reuses render-task, never a second parser. ---
if [[ -x "$render_task_bin" ]]; then
  for row in "${task_rows[@]}"; do
    IFS=$'\x1f' read -r t cls st vr first last tok rep own auto tkt ms <<<"$row"
    [[ "$rep" -eq 0 ]] && "$render_task_bin" --task "$t" --project "$project" >/dev/null 2>&1 || true
  done
fi

# --- event feed: one row per real ledger phase transition per task
# (duration since the previous phase, token cost, outcome), interleaved
# chronologically with non-task git commits (bootstrap, design-stage,
# milestone bookkeeping — anything with no Spine-Task: trailer, since a
# Spine-Task-trailered commit's own moment is already represented by
# that task's ship-phase row). Columns, tab-separated:
#   epoch \t kind(phase|commit) \t ts_iso \t subject \t href \t
#   duration_secs \t tokens \t outcome \t is_bypass \t bypass_detail
event_rows=()

for t in "${task_ids[@]}"; do
  wd="$project/work/$t"
  [[ -f "$wd/ledger.json" ]] || continue
  # A task's phase rows are windowed as a unit — a task in the window shows
  # its whole timeline; a task out of it contributes no feed rows at all.
  ev_state=""; [[ -f "$wd/state" ]] && ev_state="$(cat "$wd/state")"
  ev_last="$(jq -r '[.phases[].marked_at] | map(select(. != null)) | sort | .[-1] // empty' "$wd/ledger.json")"
  task_in_window "$ev_state" "$ev_last" || continue
  ev_class="unknown"; [[ -f "$wd/class" ]] && ev_class="$(cat "$wd/class")"
  ev_autonomy="guided"; [[ -f "$wd/autonomy" ]] && ev_autonomy="$(cat "$wd/autonomy")"; [[ -n "$ev_autonomy" ]] || ev_autonomy="guided"
  ev_ticket=""; [[ -f "$wd/ticket" ]] && ev_ticket="$(cat "$wd/ticket")"
  ev_milestone=""; [[ -f "$wd/milestone" ]] && ev_milestone="$(cat "$wd/milestone")"
  ev_search="$(printf '%s %s' "$t" "$ev_ticket" | tr '[:upper:]' '[:lower:]')"
  href="${link_prefix}work/$t/report.html"
  prev_ts=""
  verify_result_for_t=""
  [[ -f "$wd/verify.md" ]] && verify_result_for_t="$(sed -n 's/.*Result: `\([A-Za-z]*\)`.*/\1/p' "$wd/verify.md" | head -1)"
  adversary_kept=0
  if [[ -d "$wd/artifacts" ]]; then
    while IFS= read -r af; do
      [[ -n "$af" ]] || continue
      n="$(jq '.verdicts | length' "$af" 2>/dev/null || echo 0)"
      adversary_kept=$((adversary_kept + n))
    done < <(find "$wd/artifacts" -maxdepth 1 -name '*-verdict.json' ! -name '*-raw.json' 2>/dev/null)
  fi
  bypass_reason="$(jq -r '.bypass // empty' "$wd/ledger.json" 2>/dev/null)"
  task_owner="$(owner_display "$t")"

  for phase in $TIMELINE_PHASES; do
    ts="$(jq -r --arg p "$phase" '.phases[$p].marked_at // empty' "$wd/ledger.json")"
    [[ -n "$ts" ]] || continue
    e="$(to_epoch "$ts")"
    [[ -n "$e" ]] || continue
    keys="$(phase_source_keys "$phase")"
    keys_json="$(printf '%s\n' $keys | jq -R . | jq -s .)"
    tok="$(jq --argjson ks "$keys_json" '
      [ .phases as $p | $ks[] | $p[.].tokens // {input:0,output:0,cache_create:0,cache_read:0} ]
      | map(.input + .output + .cache_create + .cache_read) | add // 0
    ' "$wd/ledger.json")"
    dur=""
    if [[ -n "$prev_ts" ]]; then
      prev_e="$(to_epoch "$prev_ts")"
      [[ -n "$prev_e" ]] && dur=$((e - prev_e))
    fi
    outcome=""
    case "$phase" in
      verify)
        [[ -n "$verify_result_for_t" ]] && outcome="verify: $verify_result_for_t"
        [[ "$adversary_kept" -gt 0 ]] && outcome="$outcome ($adversary_kept adversary finding(s) kept)"
        ;;
      ship)
        if [[ -n "$bypass_reason" ]]; then
          outcome="shipped via bypass"
        else
          outcome="shipped"
        fi
        ;;
    esac
    is_bypass=0
    bypass_detail=""
    if [[ "$phase" == "ship" && -n "$bypass_reason" ]]; then
      is_bypass=1
      bypass_detail="$(printf '%s' "$bypass_reason" | cut -c1-160)"
    fi
    subject="$t — $phase"
    event_rows+=("$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' \
      "$e" "phase" "$ts" "$subject" "$href" "${dur:-}" "$tok" "$outcome" "$is_bypass" "$bypass_detail" "$task_owner" \
      "$ev_class" "$ev_autonomy" "$phase" "$ev_milestone" "$ev_ticket" "$ev_search")")
    prev_ts="$ts"
  done
done

if [[ "$is_git_repo" -eq 1 ]]; then
  while IFS=$'\t' read -r sha ts author subject; do
    [[ -n "$sha" ]] || continue
    task_trailer="$(commit_trailer "$sha" "Spine-Task")"
    [[ -n "$task_trailer" ]] && continue
    e="$(to_epoch "$ts")"
    [[ -n "$e" ]] || continue
    # Non-task project commits (bootstrap, design, milestone bookkeeping) are
    # windowed by their own timestamp: a months-old bootstrap commit is out of
    # a 14-day view, present under --all. Under --all window_cutoff is empty.
    [[ -z "$window_cutoff" || "$e" -ge "$window_cutoff" ]] || continue
    bypass="$(commit_trailer "$sha" "Spine-Bypass")"
    is_bypass=0; bypass_detail=""
    if [[ -n "$bypass" ]]; then is_bypass=1; bypass_detail="$(printf '%s' "$bypass" | cut -c1-160)"; fi
    commit_ticket="$(commit_trailer "$sha" "Spine-Ticket")"
    commit_search="$(printf '%s %s' "$subject" "$commit_ticket" | tr '[:upper:]' '[:lower:]')"
    event_rows+=("$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' \
      "$e" "commit" "$ts" "$subject" "" "" "" "" "$is_bypass" "$bypass_detail" "$author" \
      "" "" "commit" "" "$commit_ticket" "$commit_search")")
  done < <(git -C "$project" log --format='%H%x09%aI%x09%an%x09%s' --reverse 2>/dev/null)
fi

# Chronological sort — epoch is field 1. \x1f (unit separator), not tab:
# bash 3.2's `read` treats tab as a default-whitespace IFS character and
# collapses adjacent/leading/trailing tabs even when IFS is set to tab
# alone, silently misaligning any row with an empty middle field (href,
# duration, outcome, bypass_detail are all legitimately empty on plenty
# of real rows here) — confirmed empirically, not a style preference.
sorted_events=()
if [[ "${#event_rows[@]}" -gt 0 ]]; then
  while IFS= read -r line; do sorted_events+=("$line"); done < <(printf '%s\n' "${event_rows[@]}" | sort -t $'\x1f' -k1,1n)
fi

tmp_out="$(mktemp "${TMPDIR:-/tmp}/render-dashboard.XXXXXX")"
trap 'rm -f "$tmp_out"' EXIT
mkdir -p "$(dirname "$out_path")"

