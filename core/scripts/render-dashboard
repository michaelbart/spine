# ---- Gantt strip ----
# gantt_data_attrs — the data-* blob the client filter matches every task row
# on (Gantt rows and, below, the milestone list reuse the same shape). Emitted
# per row so facet/search hides rows without a re-render.
gantt_data_attrs() {
  local t="$1" cls="$2" st="$3" auto="$4" ms="$5" tkt="$6" own="$7"
  local search; search="$(printf '%s %s' "$t" "$tkt" | tr '[:upper:]' '[:lower:]')"
  printf 'data-owner="%s" data-class="%s" data-autonomy="%s" data-status="%s" data-milestone="%s" data-ticket="%s" data-search="%s"' \
    "$(html_escape <<<"$own")" "$(html_escape <<<"$cls")" "$(html_escape <<<"$auto")" \
    "$(html_escape <<<"$st")" "$(html_escape <<<"$ms")" "$(html_escape <<<"$tkt")" "$(html_escape <<<"$search")"
}

echo '<section id="gantt"><h2>Task timeline</h2>'
if [[ "${#task_rows[@]}" -eq 0 ]]; then
  echo '<p class="omitted">No tasks found under work/.</p>'
elif [[ -z "$span_min" ]]; then
  echo '<p class="omitted">No task in this window has a ledger.json with phase timestamps yet — nothing to position on a timeline.</p>'
else
  echo '<div class="scroll-x"><div class="gantt">'
  for row in "${task_rows[@]}"; do
    IFS=$'\x1f' read -r t cls st vr first last tok rep own auto tkt ms <<<"$row"
    task_in_window "$st" "$last" || continue
    done_cls=""; [[ "$st" == "done" ]] && done_cls=" task-done"
    dattrs="$(gantt_data_attrs "$t" "$cls" "$st" "$auto" "$ms" "$tkt" "$own")"
    label="$t"
    [[ -n "$own" ]] && label="$t <span class=\"gantt-owner\">$(html_escape <<<"$own")</span>"
    if [[ -n "$first" ]]; then
      e_first="$(to_epoch "$first")"
      e_last="$(to_epoch "${last:-$first}")"
      left="$(gantt_pos "$e_first")"
      width="$(gantt_pos "$e_last")"
      width="$(awk -v w="$width" -v l="$left" 'BEGIN{d=w-l; if (d<0.6) d=0.6; printf "%.2f", d}')"
      bar_class="ok"
      [[ "$vr" == "FAIL" ]] && bar_class="fail"
      href="${link_prefix}work/$t/report.html"
      tip="class $cls · $st · verify: ${vr:-n/a}$( [[ -n "$own" ]] && echo " · $own" ) · $(fmt_ts "$first") – $(fmt_ts "${last:-$first}")"
      # Every fact the hover tip carries also renders as permanent, visible
      # text below the bar — a bar's own width is often too narrow to hold
      # a label, and hovering isn't how this dashboard is meant to be read.
      caption="$(fmt_ts "$first") – $(fmt_ts "${last:-$first}") · took $(fmt_duration $((e_last - e_first)))"
      [[ -n "$vr" ]] && caption="$caption · verify: $vr"
      printf '<div class="gantt-row task-row%s" %s>\n<span class="gantt-label">%s</span>\n<div class="gantt-track">\n<div class="gantt-bar %s" style="left:%s%%;width:%s%%;">\n<a href="%s" title="%s"></a>\n</div>\n</div>\n<div class="gantt-caption">%s</div>\n</div>\n' \
        "$done_cls" "$dattrs" "$label" "$bar_class" "$left" "$width" "$(html_escape <<<"$href")" "$(html_escape <<<"$tip")" "$(html_escape <<<"$caption")"
    else
      printf '<div class="gantt-row task-row%s" %s><span class="gantt-label">%s</span><div class="gantt-track"></div></div>\n' \
        "$done_cls" "$dattrs" "$label"
    fi
  done
  echo '</div></div>'
fi
echo '</section>'

# ---- Event feed (grouped by day, each day collapsible) ----
echo '<section id="events"><h2>Event feed</h2>'
if [[ "${#sorted_events[@]}" -eq 0 ]]; then
  echo '<p class="omitted">No events in this window. Run with <code>--all</code> or <code>--since &lt;date&gt;</code> to see older activity.</p>'
else
  feed_prev_epoch=""
  cur_day=""
  for ev in "${sorted_events[@]}"; do
    IFS=$'\x1f' read -r e kind ts subject href dur tok outcome is_bypass bypass_detail author ecls eauto estatus ems etkt esearch <<<"$ev"
    day="$(fmt_day "$ts")"
    if [[ "$day" != "$cur_day" ]]; then
      [[ -n "$cur_day" ]] && echo '</div></div></div>'
      cur_day="$day"
      printf '<div class="feed-day"><div class="feed-day-header collapse-toggle" role="button" tabindex="0">%s</div><div class="feed-day-body"><div class="feed">\n' \
        "$(html_escape <<<"$day")"
    fi
    item_class="$kind-event"
    [[ "$is_bypass" == "1" ]] && item_class="$item_class bypass"
    printf '<div class="feed-item feed-row %s" data-owner="%s" data-class="%s" data-autonomy="%s" data-status="%s" data-milestone="%s" data-ticket="%s" data-search="%s">\n<div class="feed-ts">%s%s</div>\n<div class="feed-subject">' \
      "$item_class" "$(html_escape <<<"$author")" "$(html_escape <<<"$ecls")" "$(html_escape <<<"$eauto")" \
      "$(html_escape <<<"$estatus")" "$(html_escape <<<"$ems")" "$(html_escape <<<"$etkt")" "$(html_escape <<<"$esearch")" \
      "$(html_escape <<<"$(fmt_ts "$ts")")" \
      "$( [[ -n "$author" ]] && printf ' <span class=\"feed-author\">%s</span>' "$(html_escape <<<"$author")" )"
    if [[ -n "$href" ]]; then
      printf '<a href="%s">%s</a>' "$(html_escape <<<"$href")" "$(html_escape <<<"$subject")"
    else
      printf '%s' "$(html_escape <<<"$subject")"
    fi
    echo '</div>'
    if [[ "$kind" == "phase" ]]; then
      meta=""
      [[ -n "$dur" ]] && meta="<span class=\"chip\">took $(html_escape <<<"$(fmt_duration "$dur")")</span>"
      [[ -n "$tok" && "$tok" != "0" ]] && meta="$meta<span class=\"chip\">$(html_escape <<<"$(fmt_tokens "$tok")")</span>"
      [[ -n "$meta" ]] && printf '<div class="feed-meta">%s</div>\n' "$meta"
      [[ -n "$outcome" ]] && printf '<div class="feed-outcome">%s</div>\n' "$(html_escape <<<"$outcome")"
    else
      # Commit-kind events carry no per-task ledger duration ($dur is
      # always empty for them — see the event-collection loop above,
      # which only ever sets it for phase rows). Elapsed-since-the-
      # previous-visible-event is real, mechanically computable data
      # (git commit timestamps), just not the same "cost of one phase"
      # number a phase row shows — labeled "since previous" so the two
      # never read as the same measurement.
      if [[ -n "$feed_prev_epoch" ]]; then
        commit_gap=$((e - feed_prev_epoch))
        printf '<div class="feed-meta"><span class="chip">%s since previous</span></div>\n' \
          "$(html_escape <<<"$(fmt_duration "$commit_gap")")"
      fi
      gloss="$(gloss_for_commit "$subject")"
      [[ -n "$gloss" ]] && printf '<div class="feed-outcome">%s</div>\n' "$(html_escape <<<"$gloss")"
    fi
    [[ "$is_bypass" == "1" ]] && printf '<div class="feed-outcome" style="color:var(--fail);">bypass: %s</div>\n' "$(html_escape <<<"$bypass_detail")"
    echo '</div>'
    feed_prev_epoch="$e"
  done
  [[ -n "$cur_day" ]] && echo '</div></div></div>'
fi
echo '</section>'

# ---- Traced-trivial (Class 0) ----
# Only rendered when .spine/trace.jsonl exists — this is how trivial committed
# work (no work folder, no phases) becomes visible on the dashboard at all.
# Collapsed by default; rows carry the same data-* shape as tasks so the one
# filter bar drives them too. Windowed by each entry's `at` timestamp.
if [[ "$trace_present" -eq 1 ]]; then
  echo '<section id="traced"><h2 class="collapse-toggle collapsed" role="button" tabindex="0">Traced-trivial (Class 0) <span class="count-note" id="traced-count"></span></h2>'
  echo '<div class="collapsible-body is-hidden">'
  if [[ "${#trace_rows[@]}" -eq 0 ]]; then
    if [[ "$trace_total" -gt 0 ]]; then
      printf '<p class="omitted">%s Class 0 trace(s) recorded, none in this window. Run with <code>--all</code> or <code>--since &lt;date&gt;</code> to see them.</p>\n' "$trace_total"
    else
      echo '<p class="omitted">No Class 0 traces recorded yet.</p>'
    fi
  else
    echo '<div class="scroll-x"><table class="trace"><thead><tr><th>Ticket</th><th>Note</th><th>When</th><th>Who</th></tr></thead><tbody>'
    for trow in "${trace_rows[@]}"; do
      IFS=$'\x1f' read -r tk nt at eng esrch <<<"$trow"
      printf '<tr class="task-row trace-row" data-owner="%s" data-class="0" data-autonomy="" data-status="traced" data-milestone="" data-ticket="%s" data-search="%s"><td><code>%s</code></td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
        "$(html_escape <<<"$eng")" "$(html_escape <<<"$tk")" "$(html_escape <<<"$esrch")" \
        "$(html_escape <<<"${tk:-—}")" "$(html_escape <<<"$nt")" "$(html_escape <<<"$(fmt_ts "$at")")" "$(html_escape <<<"${eng:-—}")"
    done
    echo '</tbody></table></div>'
  fi
  echo '</div></section>'
fi

# ---- Decision store ----
echo '<section id="decisions"><h2>Decision store</h2>'
if [[ "${#decision_files[@]}" -eq 0 ]]; then
  echo '<p class="omitted">No docs/decisions/ records found.</p>'
else
  for f in "${decision_files[@]}"; do
    id="$(decision_field "$f" "Id")"
    status="$(decision_field "$f" "Status")"
    supersedes="$(decision_field "$f" "Supersedes")"
    superseded_by="$(decision_field "$f" "Superseded-by")"
    title="$(decision_title "$f")"
    badge="neutral"
    [[ "$status" == "implemented" ]] && badge="pass"
    [[ "$status" == "superseded" ]] && badge="degraded"
    [[ "$status" == "proposed" ]] && badge="neutral"
    chain=""
    [[ -n "$supersedes" && "$supersedes" != "none" ]] && chain="supersedes $supersedes"
    if [[ -n "$superseded_by" && "$superseded_by" != "none" ]]; then
      [[ -n "$chain" ]] && chain="$chain · "
      chain="${chain}superseded by $superseded_by"
    fi
    dsearch="$(printf '%s %s' "$id" "$title" | tr '[:upper:]' '[:lower:]')"
    printf '<div class="decision-row search-only" data-search="%s">\n<span class="decision-id">%s</span>\n<span class="decision-title">%s</span>\n<span class="badge %s">%s</span>\n' \
      "$(html_escape <<<"$dsearch")" "$(html_escape <<<"$id")" "$(html_escape <<<"$title")" "$badge" "$(html_escape <<<"$status")"
    [[ -n "$chain" ]] && printf '<span class="decision-chain">%s</span>\n' "$(html_escape <<<"$chain")"
    echo '</div>'
  done
fi
if [[ "$has_design_review" -eq 1 ]]; then
  printf '<p class="instrument-note">Design-stage adversary review ran against the charter/decisions before implementation — see <a href="%swork/design/design-review.md">work/design/design-review.md</a>.</p>\n' "$link_prefix"
fi
echo '</section>'

# ---- Capability matrix (grouped, plain language) ----
echo '<section id="capabilities"><h2>Capability matrix</h2>'
impl_cells=""; unavail_cells=""; na_cells=""
while IFS=$'\t' read -r name status reason; do
  cell="$(printf '<div class="cap-cell"><span class="cap-name">%s</span><div class="cap-reason">%s</div></div>\n' \
    "$(html_escape <<<"$name")" "$(html_escape <<<"$reason")")"
  case "$status" in
    implemented) impl_cells="$impl_cells$cell" ;;
    unavailable) unavail_cells="$unavail_cells$cell" ;;
    *) na_cells="$na_cells$cell" ;;
  esac
done < <(jq -r 'to_entries[] | [.key, .value.status, .value.reason] | @tsv' "$project/.spine/capabilities.json")
if [[ -n "$impl_cells" ]]; then
  printf '<div class="cap-group"><h3>Working today</h3><div class="cap-grid">%s</div></div>\n' "$impl_cells"
fi
if [[ -n "$unavail_cells" ]]; then
  printf '<div class="cap-group"><h3>Not yet available</h3><div class="cap-grid">%s</div></div>\n' "$unavail_cells"
fi
if [[ -n "$na_cells" ]]; then
  printf '<div class="cap-group"><h3>Doesn'"'"'t apply here</h3><div class="cap-grid">%s</div></div>\n' "$na_cells"
fi
echo '</section>'

# ---- Milestones (plain-language summary first) ----
echo '<section id="milestones"><h2>Milestone progress</h2>'
if [[ "${#milestone_files[@]}" -eq 0 ]]; then
  echo '<p class="omitted">No work/M*/milestone.md found — this project has no milestone yet.</p>'
else
  for mf in "${milestone_files[@]}"; do
    ms_id="$(basename "$(dirname "$mf")")"
    ms_title="$(sed -n '1s/^# Milestone `[^`]*`: //p' "$mf")"
    printf '<h3 style="margin-top:0;">%s%s</h3>\n' "$(html_escape <<<"$ms_id")" "$( [[ -n "$ms_title" ]] && echo ": $(html_escape <<<"$ms_title")" )"

    member_lines="$(awk '
      /^## Member tasks/ { f=1; next }
      f && /^## / { if (buf != "") print buf; buf=""; exit }
      f && /^[0-9]+\. / { if (buf != "") print buf; buf=$0; next }
      f && NF == 0 { next }
      f { sub(/^ +/, ""); buf = buf " " $0 }
      END { if (buf != "") print buf }
    ' "$mf")"

    total=0; done_count=0
    li_html=""
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      total=$((total+1))
      tid="$(sed -n 's/^[0-9]*\. `\([^`]*\)`.*/\1/p' <<<"$line")"
      rest="$(sed -n 's/^[0-9]*\. `[^`]*` — //p' <<<"$line")"
      badge="neutral"; status_word="TBD"; label="$tid"
      if [[ "$tid" == "TBD" ]]; then
        badge="degraded"
      else
        real_state=""
        [[ -f "$project/work/$tid/state" ]] && real_state="$(cat "$project/work/$tid/state")"
        status_word="${real_state:-unknown}"
        if [[ "$real_state" == "done" ]]; then badge="pass"; done_count=$((done_count+1)); fi
        label="<a href=\"${link_prefix}work/$tid/report.html\">$tid</a>"
      fi
      li_html="$li_html$(printf '<li><span class="badge %s">%s</span> %s — %s</li>\n' "$badge" "$(html_escape <<<"$status_word")" "$label" "$(html_escape <<<"$rest")")"
    done <<<"$member_lines"

    caps_table="$(awk '/^## Capability targets/{f=1;next} f && /^\| [a-z]/{print} f && /^## /{exit}' "$mf")"
    cap_mismatch=0; cap_total=0
    cap_rows_html=""
    if [[ -n "$caps_table" ]]; then
      while IFS='|' read -r _ cap planned _; do
        cap="$(sed 's/^ *//;s/ *$//' <<<"$cap")"
        planned="$(sed 's/^ *//;s/ *$//' <<<"$planned")"
        actual="$(jq -r --arg c "$cap" '.[$c].status // "missing"' "$project/.spine/capabilities.json")"
        cap_total=$((cap_total+1))
        drift_cls="pass"
        if [[ "$actual" != "implemented" ]]; then drift_cls="degraded"; cap_mismatch=$((cap_mismatch+1)); fi
        cap_rows_html="$cap_rows_html$(printf '<tr><td><code>%s</code></td><td>%s</td><td><span class="badge %s">%s</span></td></tr>\n' \
          "$(html_escape <<<"$cap")" "$(html_escape <<<"$planned")" "$drift_cls" "$(html_escape <<<"$actual")")"
      done <<<"$caps_table"
    fi

    summary="$done_count of $total member task(s) done"
    if [[ "$cap_total" -gt 0 ]]; then
      if [[ "$cap_mismatch" -eq 0 ]]; then
        summary="$summary; every targeted capability is already at its planned status."
      else
        summary="$summary; $cap_mismatch of $cap_total targeted capabilit$([[ $cap_mismatch -eq 1 ]] && echo y || echo ies) still short of plan."
      fi
    else
      summary="$summary."
    fi
    printf '<p class="lead">%s</p>\n' "$(html_escape <<<"$summary")"

    echo '<ul class="ms-tasks">'
    printf '%s' "$li_html"
    echo '</ul>'
    if [[ -n "$cap_rows_html" ]]; then
      echo '<table class="simple"><tr><th>Capability</th><th>Planned</th><th>Actual</th></tr>'
      printf '%s' "$cap_rows_html"
      echo '</table>'
    fi
  done
fi
echo '</section>'

# ---- Cost / drift instrument ----
echo '<section id="drift"><h2>Cost &amp; drift instrument</h2>'
if [[ "$ledger_reachable" -eq 0 ]]; then
  echo '<p class="omitted">core/scripts/ledger not reachable — cost/drift numbers unavailable.</p>'
else
  task_count="$(jq -r '.task_count // 0' <<<"$ledger_aggregate_json")"
  total_tokens="$(jq -r '.total_tokens // 0' <<<"$ledger_aggregate_json")"
  avg_dev="$(jq -r '.avg_deviation_count // 0' <<<"$ledger_aggregate_json")"
  bypass_count="$(jq -r '.bypass_count // 0' <<<"$ledger_aggregate_json")"
  tooling_gap_count="$(jq -r '.tooling_gap_count // 0' <<<"$ledger_aggregate_json")"
  hand_tracked="$(jq -r '.hand_tracked_task_count // 0' <<<"$ledger_aggregate_json")"
  # avg_conformance_score/second_approver_count: added to `ledger aggregate`
  # (both plain and --by-engineer) alongside the other cross-task quality
  # signals above, but this dashboard has its own independent call to
  # `ledger aggregate` and its own stat-grid rendering, so it needed its
  # own wiring too — missed the first time these two were added elsewhere.
  avg_conf="$(jq -r '.avg_conformance_score' <<<"$ledger_aggregate_json")"
  second_approver_count="$(jq -r '.second_approver_count // 0' <<<"$ledger_aggregate_json")"
  fmt_dev="$(awk -v n="$avg_dev" 'BEGIN{printf "%.2f", n}')"
  ratio="$(sed -n 's/^untracked-commit ratio: \([0-9.]*\).*/\1/p' <<<"$untracked_line")"
  echo '<div class="stat-grid">'
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">tasks</div></div>\n' "$task_count"
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">total cost</div></div>\n' "$(fmt_tokens "$total_tokens")"
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">avg deviations/task</div></div>\n' "$fmt_dev"
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">bypasses</div></div>\n' "$bypass_count"
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">tooling gaps</div></div>\n' "$tooling_gap_count"
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">hand-tracked tasks</div></div>\n' "$hand_tracked"
  if [[ "$avg_conf" != "null" ]]; then
    fmt_conf="$(awk -v n="$avg_conf" 'BEGIN{printf "%.2f", n}')"
    printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">avg conformance score</div></div>\n' "$fmt_conf"
  fi
  printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">second-approver reviews</div></div>\n' "$second_approver_count"
  [[ -n "$ratio" ]] && printf '<div class="stat"><div class="stat-val">%s</div><div class="stat-label">untracked-commit ratio</div></div>\n' "$ratio"
  echo '</div>'

  # Per-engineer breakdown (Extension C §2.7) — same instrument, split by
  # who owned each task's ledger.json. "unknown" groups any ledger
  # predating the engineer field (never silently dropped, see
  # core/scripts/ledger's own --by-engineer header comment). Rendered
  # only when there's more than one real engineer to compare, or the
  # single row would just restate the aggregate stats above with no new
  # information.
  eng_rows="$(jq -r 'length' <<<"$ledger_by_engineer_json" 2>/dev/null || echo 0)"
  if [[ "$eng_rows" -gt 1 ]]; then
    echo '<h3 style="margin-top:20px;">By engineer</h3>'
    echo '<table class="simple"><tr><th>Engineer</th><th>Tasks</th><th>Total cost</th><th>Avg deviations/task</th><th>Bypasses</th><th>Tooling gaps</th><th>Avg conformance</th><th>2nd-approver reviews</th></tr>'
    while IFS=$'\t' read -r eng tc tk ad bc tg ac sac; do
      [[ -n "$eng" ]] || continue
      fmt_ad="$(awk -v n="$ad" 'BEGIN{printf "%.2f", n}')"
      fmt_ac="$([[ "$ac" == "null" || -z "$ac" ]] && echo "—" || awk -v n="$ac" 'BEGIN{printf "%.2f", n}')"
      printf '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
        "$(html_escape <<<"$eng")" "$tc" "$(fmt_tokens "$tk")" "$fmt_ad" "$bc" "$tg" "$fmt_ac" "${sac:-0}"
    done < <(jq -r '.[] | [.engineer, .task_count, .total_tokens, .avg_deviation_count, .bypass_count, .tooling_gap_count, (.avg_conformance_score // "null"), (.second_approver_count // 0)] | @tsv' <<<"$ledger_by_engineer_json" 2>/dev/null)
    echo '</table>'
  fi

  echo '<p class="instrument-note">An instrument for spotting drift early, not a leaderboard — same framing /costs itself uses.</p>'
  echo '<p class="instrument-note">A high untracked-commit ratio on a solo/no-remote project is expected: only the final /ship commit carries a Spine-Task: trailer, every intermediate task-bookkeeping commit does not. Read it alongside bypass count and tooling gaps, not in isolation.</p>'
fi
echo '</section>'

# ---- client-side facet / filter / search / collapse ----
# Self-contained, no network, no external scripts (strict CSP). Operates only
# on the already-rendered (server-windowed) rows: shows/hides by matching
# data-* attributes + a lowercased search blob, and keeps the landing summary
# in sync. Never re-fetches or re-renders.
cat <<'JS'
<script>
(function () {
  var facets = ['owner', 'class', 'autonomy', 'status', 'milestone', 'ticket'];
  var selects = {};
  facets.forEach(function (f) { selects[f] = document.getElementById('f-' + f); });
  var searchBox = document.getElementById('f-search');
  var showDone = document.getElementById('f-showdone');
  var resetBtn = document.getElementById('f-reset');
  var summary = document.getElementById('summary');
  var slice = function (nl) { return Array.prototype.slice.call(nl); };

  var taskRows = slice(document.querySelectorAll('.task-row'));
  var feedRows = slice(document.querySelectorAll('.feed-row'));
  var searchOnly = slice(document.querySelectorAll('.search-only'));

  // Populate each facet <select> only with values that actually occur, so the
  // menu never offers a value that would match nothing in this window.
  facets.forEach(function (f) {
    var sel = selects[f];
    if (!sel) return;
    var seen = {};
    taskRows.concat(feedRows).forEach(function (el) {
      var v = el.getAttribute('data-' + f);
      if (v) seen[v] = true;
    });
    Object.keys(seen).sort().forEach(function (v) {
      var o = document.createElement('option');
      o.value = v; o.textContent = f + ': ' + v;
      sel.appendChild(o);
    });
  });

  function matchFacets(el) {
    for (var i = 0; i < facets.length; i++) {
      var f = facets[i], want = selects[f] ? selects[f].value : '';
      if (want && el.getAttribute('data-' + f) !== want) return false;
    }
    return true;
  }
  function matchSearch(el) {
    var q = (searchBox.value || '').trim().toLowerCase();
    if (!q) return true;
    return ((el.getAttribute('data-search') || '').indexOf(q) !== -1);
  }
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function apply() {
    var statusFilterOn = selects.status && selects.status.value;
    var counts = { total: 0, byClass: {}, byStatus: {}, byOwner: {} };
    taskRows.forEach(function (el) {
      var isDone = el.classList.contains('task-done');
      var vis = matchFacets(el) && matchSearch(el);
      // Completed tasks collapsed by default — revealed by the toggle, or when
      // a status/phase facet is explicitly selected.
      if (isDone && !showDone.checked && !statusFilterOn) vis = false;
      el.classList.toggle('is-hidden', !vis);
      if (vis && !el.classList.contains('trace-row')) {
        counts.total++;
        var c = el.getAttribute('data-class') || '?'; counts.byClass[c] = (counts.byClass[c] || 0) + 1;
        var s = el.getAttribute('data-status') || '?'; counts.byStatus[s] = (counts.byStatus[s] || 0) + 1;
        var o = el.getAttribute('data-owner') || ''; if (o) counts.byOwner[o] = (counts.byOwner[o] || 0) + 1;
      }
    });
    feedRows.forEach(function (el) {
      el.classList.toggle('is-hidden', !(matchFacets(el) && matchSearch(el)));
    });
    // Decisions respond to free-text search only (they carry no task facets).
    searchOnly.forEach(function (el) {
      el.classList.toggle('is-hidden', !matchSearch(el));
    });
    // Collapse day groups that have no visible rows left.
    slice(document.querySelectorAll('.feed-day')).forEach(function (day) {
      var visible = 0;
      slice(day.querySelectorAll('.feed-row')).forEach(function (r) {
        if (!r.classList.contains('is-hidden')) visible++;
      });
      day.classList.toggle('is-hidden', visible === 0);
    });
    renderSummary(counts);
    updateTracedCount();
  }

  function renderSummary(c) {
    var parts = ['<span class="pill"><b>' + c.total + '</b> task(s) shown</span>'];
    ['0', '1', '2'].forEach(function (k) {
      if (c.byClass[k]) parts.push('<span class="pill">class ' + k + ': <b>' + c.byClass[k] + '</b></span>');
    });
    Object.keys(c.byStatus).sort().forEach(function (k) {
      parts.push('<span class="pill">' + esc(k) + ': <b>' + c.byStatus[k] + '</b></span>');
    });
    var owners = Object.keys(c.byOwner);
    if (owners.length > 1) owners.sort().forEach(function (o) {
      parts.push('<span class="pill">' + esc(o) + ': <b>' + c.byOwner[o] + '</b></span>');
    });
    summary.innerHTML = parts.join(' ');
  }

  function updateTracedCount() {
    var el = document.getElementById('traced-count');
    if (!el) return;
    var vis = 0;
    slice(document.querySelectorAll('.trace-row')).forEach(function (r) {
      if (!r.classList.contains('is-hidden')) vis++;
    });
    el.textContent = '(' + vis + ')';
  }

  facets.forEach(function (f) { if (selects[f]) selects[f].addEventListener('change', apply); });
  searchBox.addEventListener('input', apply);
  showDone.addEventListener('change', apply);
  resetBtn.addEventListener('click', function () {
    facets.forEach(function (f) { if (selects[f]) selects[f].value = ''; });
    searchBox.value = ''; showDone.checked = false; apply();
  });

  // Collapse toggles: per-day feed groups and the traced-trivial section.
  slice(document.querySelectorAll('.collapse-toggle')).forEach(function (t) {
    function toggle() {
      var day = t.parentNode && t.classList.contains('feed-day-header') ? t.parentNode : null;
      if (day && day.classList.contains('feed-day')) { day.classList.toggle('collapsed'); return; }
      t.classList.toggle('collapsed');
      var body = t.nextElementSibling;
      if (body && body.classList.contains('collapsible-body')) body.classList.toggle('is-hidden');
    }
    t.addEventListener('click', toggle);
    t.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });

  apply();
})();
</script>
JS

cat <<HTML
<footer class="page">
  Generated $(fmt_ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)") from <code>$(html_escape <<<"$project")</code>.
  Regenerate with <code>render-dashboard --project $(html_escape <<<"$project")</code>.
</footer>
</div>
</body>
</html>
HTML
} > "$tmp_out"

mv "$tmp_out" "$out_path"
trap - EXIT
echo "render-dashboard: wrote $out_path"
