  printf '<div class="coverage"><strong>Covers %s</strong> — showing all %s task(s). This is the full historical render.</div>\n' \
    "$(html_escape <<<"$window_words")" "$task_total"
else
  printf '<div class="coverage"><strong>Covers %s</strong> — showing %s of %s task(s). Run with <code>--all</code> (or <code>--since &lt;date&gt;</code>) to include older, already-done work.</div>\n' \
    "$(html_escape <<<"$window_words")" "$task_shown" "$task_total"
