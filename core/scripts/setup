#!/bin/bash
# setup — the one per-machine step the portable install mechanism needs.
# Idempotent: safe to re-run on every machine, including the first,
# including a machine that already ran it.
#
# What "machine-absolute" broke, reproduced before this script existed:
# core/skills/bootstrap and
# core/skills/adopt used to *commit* `.claude/skills/<name>`,
# `.claude/agents/<name>.md`, `.claude/rules/<name>.md`, `.claude/hooks`
# as symlinks whose target is this checkout's absolute path, plus a
# `permissions.allow` entry in the committed `.claude/settings.json`
# naming that same absolute path. A second engineer cloning the project
# gets dangling symlinks and a Bash-allow pattern that matches nothing —
# every hook and skill silently fails to resolve. This script is what
# replaces "commit the machine-specific answer" with "compute it locally,
# every machine, from a stable manifest."
#
# What's still committed (the manifest side): the *set* of skill/agent/
# rule names a project needs never changes per-machine, so it stays
# ordinary project state this script reads, not something this script
# invents. Concretely: this script always mirrors spine's own full
# core/skills, core/agents, core/rules directories — the same "install
# everything, a project uses what it uses" convention
# core/skills/bootstrap/SKILL.md §5 already documented; nothing here
# narrows that per-project.
#
# What becomes machine-local (never committed) after this script exists:
#   .claude/skills/*, .claude/agents/*, .claude/rules/*, .claude/hooks
#     — regenerated symlinks, added to the project's own .gitignore by
#       this script the first time it runs against a project that still
#       has them tracked (git rm --cached, working-tree files untouched).
#   .claude/settings.local.json — gains the Bash-allow pattern for this
#       machine's resolved spine location, merged in via jq (never
#       overwrites an engineer's own pre-existing local entries).
# .claude/settings.json keeps only what already was portable: the three
# ${CLAUDE_PROJECT_DIR}-relative hook paths and the .spine/adapters/*
# allow patterns — both already project-relative, confirmed by direct
# inspection in Phase A, untouched by this script.
#
# Usage:
#   setup --project <path> [--spine <path>] [--check]
#
# --check: read-only. No symlink/.gitignore/.claude writes. Reports whether
#   .claude/hook-guard is current and whether .spine/profile.json is valid.
#   This is the cheap session-start check wired into core/skills/task/SKILL.md
#   step 0 and core/skills/spine/SKILL.md, not a hook.
#
# Exit codes: 0 ok. 1 an invalid .spine/profile.json (a broken gate config).
# 2 usage or hard failure (spine checkout not found, project not installed yet).
set -uo pipefail

usage() {
  echo "usage: setup --project <path> [--spine <path>] [--check]" >&2
  exit 2
}

project=""
spine_override=""
check_only=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --spine) spine_override="$2"; shift 2 ;;
    --check) check_only=1; shift ;;
    *) usage ;;
  esac
done
[[ -n "$project" ]] || usage
[[ -d "$project" ]] || { echo "setup: project $project does not exist" >&2; exit 2; }
project="$(cd "$project" && pwd)"

# Self-location: this script lives at <spine>/core/scripts/setup. Same
# ${BASH_SOURCE[0]} trick core/hooks/* already use — confirmed the one
# portable way to find "where am I really" regardless of how this project
# reached this script (a symlink resolution, an absolute invocation, a
# relative one from a different cwd).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resolved_spine="${spine_override:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
[[ -d "$resolved_spine/core/skills" ]] || {
  echo "setup: $resolved_spine does not look like a spine checkout (no core/skills)" >&2
  exit 2
}
# When spine installs itself as a project, the symlinks are committed as
# relative paths (portable across machines), so the install-time steps that
# create absolute symlinks and gitignore them must be skipped. Only
# settings.local.json (machine-specific allow pattern) is
# written — everything else is already in the committed repo state.
is_self_install=0
[[ "$project" == "$resolved_spine" ]] && is_self_install=1

check_hook_guard_staleness() {
  # The guard is committed project content, not generated/gitignored like
  # .claude/hooks itself, so it can be hand-edited or predate a spine update.
  # Check its actual bytes against this machine's resolved spine template.
  local guard="$project/.claude/hook-guard"
  local template="$resolved_spine/core/templates/hook-guard"
  [[ -f "$template" ]] || return 0
  if [[ ! -f "$guard" ]]; then
    echo "setup: $project has no .claude/hook-guard yet — every Edit/Write/Bash is" \
         "unenforced until a full 'setup' run (not --check) writes it." >&2
    return 0
  fi
  if ! cmp -s "$guard" "$template"; then
    echo "setup: .claude/hook-guard in $project differs from this machine's spine" \
         "template — stale (or hand-edited). Run 'setup' (not --check) to refresh it," \
         "then commit the change; it will not update itself."
  fi
}

if [[ "$check_only" -eq 1 ]]; then
  check_hook_guard_staleness
  # Team strictness profile (Phase 5): a broken/illegal profile is a broken
  # gate config, caught here loudly rather than silently enforced.
  profile_bad=0
  "$resolved_spine/core/scripts/profile-check" --project "$project" || profile_bad=1
  [[ "$profile_bad" -eq 1 ]] && exit 1
  exit 0
fi

if [[ "$is_self_install" -eq 0 ]]; then
  [[ -f "$project/.spine/capabilities.json" ]] || {
    echo "setup: $project/.spine/capabilities.json not found — this project isn't" \
         "spine-installed yet (run /bootstrap or /adopt first, from a session in" \
         "$resolved_spine)" >&2
    exit 2
  }
fi

if [[ "$is_self_install" -eq 0 ]]; then
  mkdir -p "$project/.claude/skills" "$project/.claude/agents" "$project/.claude/rules"

  sync_symlink() {
    # sync_symlink <link-path> <target-path>
    local link="$1" target="$2"
    if [[ -L "$link" ]]; then
      [[ "$(readlink "$link")" == "$target" ]] && return 0
      rm -f "$link"
    elif [[ -e "$link" ]]; then
      echo "setup: $link exists and is not a symlink — refusing to overwrite, remove it by hand" >&2
      return 1
    fi
    ln -s "$target" "$link"
  }

  fail=0
  for dir in "$resolved_spine"/core/skills/*/; do
    name="$(basename "$dir")"
    sync_symlink "$project/.claude/skills/$name" "$resolved_spine/core/skills/$name" || fail=1
  done
  for f in "$resolved_spine"/core/agents/*.md; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f")"
    sync_symlink "$project/.claude/agents/$name" "$f" || fail=1
  done
  for f in "$resolved_spine"/core/rules/*.md; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f")"
    sync_symlink "$project/.claude/rules/$name" "$f" || fail=1
  done
  sync_symlink "$project/.claude/hooks" "$resolved_spine/core/hooks" || fail=1
  [[ "$fail" -eq 0 ]] || { echo "setup: symlink sync failed, see above" >&2; exit 2; }
fi

# Strip any absolute-path Bash-allow entry a pre-Extension-C install left
# in the *committed* settings.json — that's the exact residue this script
# exists to eliminate; the machine-local equivalent now lives in
# settings.local.json instead (below). A relative entry (.spine/adapters/*
# and friends) is left untouched — those were always portable.
# `.permissions.allow // []` guards a project whose committed settings.json
# has no `permissions` key at all — the normal shape for anything installed
# by the current bootstrap/adopt (§5: only `hooks` is written) — without it
# `map` throws "Cannot iterate over null (null)" on every first setup run.
committed_settings="$project/.claude/settings.json"
if [[ -f "$committed_settings" ]]; then
  tmp="$(mktemp)"
  jq '.permissions.allow |= ((. // []) | map(select(test("^Bash\\(/") | not)))' \
    "$committed_settings" >"$tmp" && mv "$tmp" "$committed_settings"
fi

# hook-guard (Extension C Phase C, fresh-clone enforcement-state finding):
# a PreToolUse command pointing at a not-yet-generated .claude/hooks/<name>
# is silently *skipped*, not blocked, by Claude Code's own hook runner —
# confirmed empirically, see core/templates/hook-guard's own header. Always
# rewrite the committed guard file (deterministic content, safe to
# overwrite every run) and route settings.json's hook commands through it.
cp "$resolved_spine/core/templates/hook-guard" "$project/.claude/hook-guard"
chmod +x "$project/.claude/hook-guard"
if [[ -f "$committed_settings" ]]; then
  tmp="$(mktemp)"
  jq '
    .hooks.PreToolUse = [{
      matcher: "Edit|Write|Bash",
      hooks: [
        {type:"command", command:"${CLAUDE_PROJECT_DIR}/.claude/hook-guard phase-gate"},
        {type:"command", command:"${CLAUDE_PROJECT_DIR}/.claude/hook-guard path-escalate"},
        {type:"command", command:"${CLAUDE_PROJECT_DIR}/.claude/hook-guard dep-gate"}
      ]
    }]
  ' "$committed_settings" >"$tmp" && mv "$tmp" "$committed_settings"
fi

# Untrack any of these paths a pre-Extension-C install committed as real
# symlinks (working-tree files are left exactly as sync_symlink just made
# them — this only removes them from the git index). Skipped for self-install:
# spine's own .claude/skills etc. ARE committed (as relative symlinks) and
# must stay tracked.
if [[ "$is_self_install" -eq 0 ]] && { [[ -d "$project/.git" ]] || git -C "$project" rev-parse --git-dir >/dev/null 2>&1; }; then
  tracked=()
  while IFS= read -r p; do tracked+=("$p"); done < <(
    cd "$project" && git ls-files .claude/skills .claude/agents .claude/rules .claude/hooks 2>/dev/null
  )
  if [[ ${#tracked[@]} -gt 0 ]]; then
    (cd "$project" && git rm -r --cached --quiet -- .claude/skills .claude/agents .claude/rules .claude/hooks) \
      || echo "setup: warning — could not untrack pre-existing committed symlinks, remove them from git by hand" >&2
    echo "setup: untracked ${#tracked[@]} pre-existing committed symlink path(s) — commit this to finish the migration"
  fi

  gitignore="$project/.gitignore"
  touch "$gitignore"
  for pattern in ".claude/skills/" ".claude/agents/" ".claude/rules/" ".claude/hooks" ".claude/settings.local.json" ".claude/worktrees/" ".spine/.smoke-runtime-seconds" ".spine/current-task" ".spine/current-intake" ".spine/autopilot-active" ".spine/events.jsonl"; do
    grep -qxF "$pattern" "$gitignore" || echo "$pattern" >>"$gitignore"
  done
fi

# .claude/settings.local.json: merge, never overwrite an engineer's own
# pre-existing local entries (§2.1's known cost — this file is genuinely
# machine-local, this is the one thing this script legitimately owns a
# slice of rather than the whole file).
settings_local="$project/.claude/settings.local.json"
[[ -f "$settings_local" ]] || echo '{"permissions":{"allow":[]}}' >"$settings_local"
allow_pattern="Bash($resolved_spine/core/scripts/*:*)"
tmp="$(mktemp)"
jq --arg p "$allow_pattern" '
  .permissions //= {} | .permissions.allow //= [] |
  if (.permissions.allow | index($p)) then . else .permissions.allow += [$p] end
' "$settings_local" >"$tmp" && mv "$tmp" "$settings_local"

echo "setup: ok — $project's hooks/skills/agents/rules resolve to $resolved_spine"
exit 0
