#!/bin/bash
# verdict-filter — schema-validates adversary verdicts (core/ADAPTER-CONTRACT.md
# §5) and drops evidence-free or malformed entries before /verify ever reads
# them. A script decides what counts as evidence; a model only triages what
# survives. Never fails the run because verdicts were dropped — that's this
# script working correctly — only fails on a structurally unreadable input.
#
# Evidence kinds: `file_line`, `command` (both shape-checked only — the
# claim's *truth* is still a human/model judgment, per ADAPTER-CONTRACT.md
# §5's own self-red-team entry), and `decision` (design-stage extension):
# `{"kind":"decision","decision_id":"D-3","quote":"<verbatim span>"}`. Unlike
# the other two kinds, `decision` gets a second, stronger check beyond
# shape: `decision_id` must resolve to a real `docs/decisions/<id>-*.md`
# record and `quote` must appear verbatim in it, or the verdict is dropped
# just as if it were malformed. This is still shape-and-resolution
# validation, not truth validation — a real quote lifted out of context
# still passes — but it's a strictly higher bar than the other two kinds
# get, because a decision id is trivially cheap to fabricate compared to a
# real file:line or a real command's captured output.
#
# `render` (ui-fidelity, ADAPTER-CONTRACT.md §5):
# `{"kind":"render","screen_id":"<id>","state":"<state>","artifact":"<path
# relative to work/<task-id>/artifacts/ui-fidelity/>","quote":"<verbatim
# span>"}` — same second-pass bar as `decision`: `artifact` must resolve to
# a real file inside that capture directory (no absolute path, no `..`) and
# `quote` must appear verbatim in it, or the verdict is dropped. A model
# can still misread a captured fact, but cannot cite one the capture never
# recorded.
#
# Usage: verdict-filter <verdicts.json> [--out <filtered.json>] [--project <path>]
set -uo pipefail

usage() { echo "usage: verdict-filter <verdicts.json> [--out <filtered.json>] [--project <path>]" >&2; exit 2; }

[[ $# -ge 1 ]] || usage
input="$1"; shift
out_path=""
project="$(pwd)"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out) out_path="$2"; shift 2 ;;
    --project) project="$2"; shift 2 ;;
    *) usage ;;
  esac
done

[[ -f "$input" ]] || { echo "verdict-filter: $input not found" >&2; exit 2; }
if ! jq -e . "$input" >/dev/null 2>&1; then
  echo "verdict-filter: $input is not valid JSON" >&2
  exit 2
fi

agent="$(jq -r '.agent // empty' "$input")"
task_id="$(jq -r '.task_id // empty' "$input")"
attacked_count="$(jq '(.attacked // []) | length' "$input")"

if [[ -z "$agent" || -z "$task_id" ]]; then
  echo "verdict-filter: $input missing required top-level agent/task_id" >&2
  exit 2
fi
if [[ "$attacked_count" -eq 0 ]]; then
  echo "verdict-filter: $input has an empty 'attacked' list — every run must enumerate what it attacked, even a clean bill" >&2
  exit 2
fi

# Pass 1 — shape validation (jq only; kind=="decision" checked for
# non-empty decision_id/quote here, resolution happens in pass 2 below).
filtered_and_report="$(jq '
  def valid_evidence:
    if .evidence.kind == "file_line" then
      (.evidence.file // "" | length > 0) and (.evidence.line != null)
    elif .evidence.kind == "command" then
      (.evidence.command // "" | length > 0) and (.evidence.output // "" | length > 0)
    elif .evidence.kind == "decision" then
      (.evidence.decision_id // "" | length > 0) and (.evidence.quote // "" | length > 0)
    elif .evidence.kind == "render" then
      (.evidence.screen_id // "" | length > 0) and (.evidence.state // "" | length > 0)
      and (.evidence.artifact // "" | length > 0) and (.evidence.quote // "" | length > 0)
    else false end;
  def valid_verdict:
    (.claim // "" | length > 0)
    and (.severity as $s | ["high","medium","low"] | index($s) != null)
    and valid_evidence;
  {
    kept: [ (.verdicts // [])[] | select(valid_verdict) ],
    dropped: [ (.verdicts // [])[] | select(valid_verdict | not) ]
  }
' "$input")"

# Pass 2 — resolution check for kind=="decision" and kind=="render" survivors of pass 1. A
# shape-valid decision verdict whose id doesn't resolve to exactly one
# docs/decisions/ record, or whose quote isn't found verbatim in it, moves
# from kept to dropped here — plain bash + grep, not something jq alone
# can do against a filename it doesn't already have open.
final_kept="[]"
resolution_dropped="[]"
while IFS= read -r verdict; do
  [[ -n "$verdict" ]] || continue
  kind="$(jq -r '.evidence.kind // empty' <<<"$verdict")"
  if [[ "$kind" == "render" ]]; then
    artifact="$(jq -r '.evidence.artifact' <<<"$verdict")"
    quote="$(jq -r '.evidence.quote' <<<"$verdict")"
    afile="$project/work/$task_id/artifacts/ui-fidelity/$artifact"
    if [[ "$artifact" != /* && "$artifact" != *..* && -f "$afile" ]] \
       && [[ "$(tr '\n\t' '  ' <"$afile" | tr -s ' ')" == *"$(printf '%s' "$quote" | tr '\n\t' '  ' | tr -s ' ')"* ]]; then
      final_kept="$(jq --argjson v "$verdict" '. + [$v]' <<<"$final_kept")"
    else
      resolution_dropped="$(jq --argjson v "$verdict" '. + [$v]' <<<"$resolution_dropped")"
    fi
    continue
  fi
  if [[ "$kind" != "decision" ]]; then
    final_kept="$(jq --argjson v "$verdict" '. + [$v]' <<<"$final_kept")"
    continue
  fi
  did="$(jq -r '.evidence.decision_id' <<<"$verdict")"
  quote="$(jq -r '.evidence.quote' <<<"$verdict")"
  matches=("$project"/docs/decisions/"$did"-*.md)
  # Whitespace-normalized containment, not a raw line-bound grep -F: a
  # decision record is hand-wrapped prose, and an accurate quote spanning
  # a source line-wrap would otherwise be a false negative — dropping a
  # true finding is a worse failure than the marginal risk that collapsing
  # whitespace lets through a quote that only fuzzily matches. Still exact
  # on every non-whitespace character; only run-of-whitespace differences
  # (including newlines) are treated as equivalent.
  normalize() { tr '\n\t' '  ' | tr -s ' '; }
  if [[ -e "${matches[0]}" && ${#matches[@]} -eq 1 ]]; then
    norm_quote="$(printf '%s' "$quote" | normalize)"
    norm_file="$(normalize <"${matches[0]}")"
    if [[ "$norm_file" == *"$norm_quote"* ]]; then
      final_kept="$(jq --argjson v "$verdict" '. + [$v]' <<<"$final_kept")"
    else
      resolution_dropped="$(jq --argjson v "$verdict" '. + [$v]' <<<"$resolution_dropped")"
    fi
  else
    resolution_dropped="$(jq --argjson v "$verdict" '. + [$v]' <<<"$resolution_dropped")"
  fi
done < <(jq -c '.kept[]' <<<"$filtered_and_report")

dropped_all="$(jq -n --argjson a "$(jq '.dropped' <<<"$filtered_and_report")" --argjson b "$resolution_dropped" '$a + $b')"

kept_count="$(jq 'length' <<<"$final_kept")"
dropped_count="$(jq 'length' <<<"$dropped_all")"

if [[ "$dropped_count" -gt 0 ]]; then
  echo "verdict-filter: dropped $dropped_count non-conforming verdict(s):" >&2
  jq -c '.[]' <<<"$dropped_all" >&2
fi

output="$(jq --arg agent "$agent" --arg task_id "$task_id" \
  --argjson attacked "$(jq '.attacked' "$input")" \
  --argjson kept "$final_kept" \
  -n '{agent:$agent, task_id:$task_id, attacked:$attacked, verdicts:$kept}')"

if [[ -n "$out_path" ]]; then
  echo "$output" >"$out_path"
else
  echo "$output"
fi

echo "verdict-filter: kept $kept_count/$((kept_count+dropped_count)) verdicts"
exit 0
