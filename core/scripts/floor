#!/bin/bash
# floor — dispatcher over the capability manifest. Runs the Layer 1
# deterministic floor (plus Layer 2 mutate / Layer 5 smoke where the class
# and calibration call for it, and migrate-rehearse where the class is 2
# and the diff touches a migration path — ADAPTER-CONTRACT.md §3.7) against
# a project's .spine/adapters/, per core/ADAPTER-CONTRACT.md. Never names a
# language, framework, or tool.
#
# Usage: floor <class:1|2> [--project <path>] [--task <task-id>] [--out <json-path>] [--base <ref>] [--full]
#
# Exit 0 iff every capability that ran passed. Fail-fast: stops at the first
# failing capability and prints its full diagnostics. A capability marked
# unavailable/not-applicable never fails the run — it is recorded as an
# explicit degradation instead ("no silently skipped gate").
#
# --full: whole-tree mode (Phase E). `lint` and `typecheck` are, by
# default, changed-file-set capabilities (ADAPTER-CONTRACT.md §3.1) — a
# per-task floor run must reflect the task's own diff, not the repo's
# accumulated history. --full bypasses that scoping and invokes both
# adapters with `--full` instead, for CI or a dedicated whole-tree cleanup
# task. Never pass --full from a per-task `/task` run.
#
# Changed-file set excludes spine's own task bookkeeping (work/**,
# .spine/current-task) and spine's own installed tooling config
# (.spine/adapters/**, .spine/capabilities.json, and siblings — see
# is_bookkeeping below) — same exclusion core/scripts/conformance already
# applies to its own diff, for the identical reason: a task's own
# flags.json/deviations.md/artifacts/ writes, and a task's own edits to
# its adapters/capabilities manifest, are never reviewable application
# source, and left in, they reach every diff-scoped capability (lint,
# typecheck, secret-scan, clone-scan, callers) as literal input. `callers`
# is the one this bites hardest — it greps the changed-file set as literal
# symbol strings, so a bookkeeping or tooling-config path with no code
# relationship to anything fails it outright. Disclosed fix.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "usage: floor <class:1|2> [--project <path>] [--task <task-id>] [--out <json-path>] [--base <ref>] [--full]" >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
class="$1"; shift
project="$(pwd)"
task_id=""
out_path=""
base_ref="HEAD"
full_mode=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --task) task_id="$2"; shift 2 ;;
    --out) out_path="$2"; shift 2 ;;
    --base) base_ref="$2"; shift 2 ;;
    --full) full_mode=1; shift ;;
    *) usage ;;
  esac
done

if [[ "$class" != "1" && "$class" != "2" ]]; then
  echo "floor: class must be 1 or 2 — Class 0 tasks run no floor" >&2
  exit 2
fi

caps_json="$project/.spine/capabilities.json"
if [[ ! -f "$caps_json" ]]; then
  echo "floor: no $caps_json — project is not spine-installed" >&2
  exit 2
fi

adapters_dir="$project/.spine/adapters"

if [[ -n "$task_id" ]]; then
  artifacts_dir="$project/work/$task_id/artifacts"
else
  artifacts_dir="$project/.spine/floor-artifacts"
fi
mkdir -p "$artifacts_dir"

status_of() { jq -r --arg c "$1" '.[$c].status // "missing"' "$caps_json"; }
reason_of() { jq -r --arg c "$1" '.[$c].reason // ""' "$caps_json"; }

# M0 bootstrap waiver for the Class 2 smoke hard gate (ADAPTER-CONTRACT.md
# §3.8, docs/tradeoffs.md "The M0 bootstrap waiver"). The hard gate is
# circular for a walking skeleton: milestone 0's own job is to *build* the
# smoke capability, yet its first tasks are Class 2 by necessity (dependency
# manifests, db, auth are protected paths) and so cannot pass a floor whose
# smoke layer doesn't exist yet. Returns 0 only when EVERY one of these
# independently-declared facts holds — any one missing and the hard gate
# stays a hard gate:
#   1. the run names a task (--task) that belongs to milestone M0
#      (work/<task-id>/milestone reads exactly `M0` — the id design-gate
#      reserves for the walking skeleton; never M1+),
#   2. capabilities.json marks smoke-run `unavailable` with a reason
#      containing "skeleton target" (the marker /design §2 writes) — not
#      `missing`, not `not-applicable`, the wrong-shape cases the hard
#      gate's own audit rounds hardened it against,
#   3. work/M0/milestone.md's Capability targets table has a smoke-run row
#      whose planned status starts with "unavailable" — the milestone itself
#      declares smoke as a not-yet-built target.
# The waiver is never a pass: the caller records a degraded result and
# prints a DEGRADED line, and it evaporates on its own the moment smoke-run
# reads `implemented` (the gate then applies in full).
bootstrap_smoke_waiver() {
  [[ -n "$task_id" ]] || return 1
  local st reason ms_task ms_file planned
  st="$(status_of smoke-run)"
  [[ "$st" == "unavailable" ]] || return 1
  reason="$(reason_of smoke-run)"
  [[ "$reason" == *"skeleton target"* ]] || return 1
  ms_task="$project/work/$task_id/milestone"
  [[ -f "$ms_task" && "$(head -n1 "$ms_task" | tr -d '[:space:]')" == "M0" ]] || return 1
  ms_file="$project/work/M0/milestone.md"
  [[ -f "$ms_file" ]] || return 1
  planned="$(grep -E '^\| smoke-run \|' "$ms_file" | head -n1 | awk -F'|' '{print $3}' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [[ "$planned" == unavailable* ]] || return 1
  return 0
}

results="[]"
add_result() {
  # add_result <capability> <status: pass|fail|degraded> <detail>
  results="$(jq -c --arg cap "$1" --arg st "$2" --arg detail "$3" \
    '. + [{"capability":$cap,"status":$st,"detail":$detail}]' <<<"$results")"
}

overall_fail=0
changed_files=""
# Spine's own bookkeeping (the task folder tree, the one-line
# active-task pointer) and spine's own installed tooling config (a task
# editing its own generated adapters or capabilities manifest, e.g. to fix
# an adapter bug found mid-verify) are never reviewable application code —
# same exclusion core/scripts/conformance already applies to its own
# "actual" diff, and for the identical reason: left in, a task's own
# work/<task-id>/** writes (flags.json, deviations.md, artifacts/, the
# task's own milestone.md bookkeeping edit) or .spine/** tooling-config
# edits reach diff-scoped capabilities like `callers` as literal grep
# targets, which fails them outright on content that was never meant to
# be treated as source. Disclosed fix.
is_bookkeeping() {
  case "$1" in
    work/*) return 0 ;;
    .spine/current-task) return 0 ;;
    .spine/adapters/*) return 0 ;;
    .spine/capabilities.json) return 0 ;;
    .spine/protected-paths.conf) return 0 ;;
    .spine/install-command-patterns.conf) return 0 ;;
    .spine/core-pin.json) return 0 ;;
    # Claude Code meta-tooling config (settings, hooks, skills, scripts) is
    # never reviewable application source — same rationale as .spine/** above.
    # Real example that motivated this: .claude/settings.json flagged as
    # zero-callers during a confirm/decline-mutation task when the user
    # added an additionalDirectory mid-task (the edit was uncommitted at
    # floor time).
    .claude/*) return 0 ;;
    *) return 1 ;;
  esac
}
compute_changed_files() {
  if [[ -z "$changed_files" ]]; then
    # git diff --name-only alone only ever shows *tracked* file changes — a
    # task that creates genuinely new files (the common case) never gets
    # them staged by anything in the /task flow before /verify runs, so
    # those new files (e.g. a brand-new migration, a new source file with a
    # secret or a type error) were invisible to every diff-scoped
    # capability below. git ls-files --others (untracked, respecting
    # .gitignore) closes that gap — same fix core/scripts/conformance,
    # contract-touch, and claims-check already apply to their own
    # changed-file sets.
    changed_files="$(cd "$project" && { git diff --name-only "$base_ref" -- .; git ls-files --others --exclude-standard -- .; } 2>/dev/null | sort -u | while IFS= read -r f; do is_bookkeeping "$f" || printf '%s\n' "$f"; done || true)"
  fi
}

# touches_migration_path — true iff $changed_files (compute_changed_files
# must already have run) contains a path under a migrations/- or
# migration/-named directory, the same glob core/rules/migrations.md's own
# frontmatter uses (**/migrations/** / **/migration/**).
touches_migration_path() {
  local f
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    case "$f" in
      */migrations/*|migrations/*|*/migration/*|migration/*) return 0 ;;
    esac
  done <<<"$changed_files"
  return 1
}

run_simple() {
  # run_simple <capability> — no stdin, no args
  local cap="$1" st reason adapter out code
  st="$(status_of "$cap")"
  if [[ "$st" == "implemented" ]]; then
    adapter="$adapters_dir/$cap"
    if [[ ! -x "$adapter" ]]; then
      echo "FAIL: $cap — marked implemented but $adapter is missing or not executable" >&2
      add_result "$cap" "fail" "adapter missing/not executable"
      overall_fail=1; return 1
    fi
    out="$(cd "$project" && "$adapter" 2>&1)"; code=$?
    if [[ $code -eq 0 ]]; then
      echo "PASS: $cap — $out"
      add_result "$cap" "pass" "$out"
    else
      echo "FAIL: $cap"
      echo "$out"
      add_result "$cap" "fail" "$out"
      overall_fail=1; return 1
    fi
  else
    reason="$(reason_of "$cap")"
    echo "DEGRADED: $cap ($st) — ${reason:-no reason recorded}"
    add_result "$cap" "degraded:$st" "${reason:-no reason recorded}"
  fi
  return 0
}

run_with_stdin() {
  # run_with_stdin <capability> — feeds $changed_files on stdin
  local cap="$1" st reason adapter out code
  st="$(status_of "$cap")"
  if [[ "$st" == "implemented" ]]; then
    adapter="$adapters_dir/$cap"
    if [[ ! -x "$adapter" ]]; then
      echo "FAIL: $cap — marked implemented but $adapter is missing or not executable" >&2
      add_result "$cap" "fail" "adapter missing/not executable"
      overall_fail=1; return 1
    fi
    compute_changed_files
    out="$(cd "$project" && printf '%s\n' "$changed_files" | "$adapter" 2>&1)"; code=$?
    if [[ $code -eq 0 ]]; then
      echo "PASS: $cap — $out"
      add_result "$cap" "pass" "$out"
    else
      echo "FAIL: $cap"
      echo "$out"
      add_result "$cap" "fail" "$out"
      overall_fail=1; return 1
    fi
  else
    reason="$(reason_of "$cap")"
    echo "DEGRADED: $cap ($st) — ${reason:-no reason recorded}"
    add_result "$cap" "degraded:$st" "${reason:-no reason recorded}"
  fi
  return 0
}

run_scoped() {
  # run_scoped <capability> — changed-file-set capability (lint, typecheck).
  # Normal mode: feeds $changed_files on stdin, same as run_with_stdin.
  # --full mode: invokes the adapter with `--full`, no stdin, whole-tree.
  local cap="$1" st reason adapter out code
  st="$(status_of "$cap")"
  if [[ "$st" == "implemented" ]]; then
    adapter="$adapters_dir/$cap"
    if [[ ! -x "$adapter" ]]; then
      echo "FAIL: $cap — marked implemented but $adapter is missing or not executable" >&2
      add_result "$cap" "fail" "adapter missing/not executable"
      overall_fail=1; return 1
    fi
    if [[ "$full_mode" -eq 1 ]]; then
      out="$(cd "$project" && "$adapter" --full 2>&1)"; code=$?
    else
      compute_changed_files
      out="$(cd "$project" && printf '%s\n' "$changed_files" | "$adapter" 2>&1)"; code=$?
    fi
    if [[ $code -eq 0 ]]; then
      echo "PASS: $cap — $out"
      add_result "$cap" "pass" "$out"
    else
      echo "FAIL: $cap"
      echo "$out"
      add_result "$cap" "fail" "$out"
      overall_fail=1; return 1
    fi
  else
    reason="$(reason_of "$cap")"
    echo "DEGRADED: $cap ($st) — ${reason:-no reason recorded}"
    add_result "$cap" "degraded:$st" "${reason:-no reason recorded}"
  fi
  return 0
}

run_artifact() {
  # run_artifact <capability> [stdin: changed_files|none] — takes output-path arg
  local cap="$1" needs_stdin="$2" st reason adapter out code art_path
  st="$(status_of "$cap")"
  art_path="$artifacts_dir/$cap.md"
  if [[ "$st" == "implemented" ]]; then
    adapter="$adapters_dir/$cap"
    if [[ ! -x "$adapter" ]]; then
      echo "FAIL: $cap — marked implemented but $adapter is missing or not executable" >&2
      add_result "$cap" "fail" "adapter missing/not executable"
      overall_fail=1; return 1
    fi
    if [[ "$needs_stdin" == "yes" ]]; then
      compute_changed_files
      out="$(cd "$project" && SPINE_BASE_REF="$base_ref" printf '%s\n' "$changed_files" | "$adapter" "$art_path" 2>&1)"; code=$?
    else
      out="$(cd "$project" && SPINE_BASE_REF="$base_ref" "$adapter" "$art_path" 2>&1)"; code=$?
    fi
    if [[ $code -eq 0 ]]; then
      echo "PASS: $cap — $out (artifact: $art_path)"
      add_result "$cap" "pass" "$out (artifact: $art_path)"
    else
      echo "FAIL: $cap"
      echo "$out"
      add_result "$cap" "fail" "$out"
      overall_fail=1; return 1
    fi
  else
    reason="$(reason_of "$cap")"
    echo "DEGRADED: $cap ($st) — ${reason:-no reason recorded}"
    add_result "$cap" "degraded:$st" "${reason:-no reason recorded}"
  fi
  return 0
}

echo "floor: class $class, project $project$([[ "$full_mode" -eq 1 ]] && echo " (--full: whole-tree lint/typecheck)")"

# Layer 1 — deterministic floor, always for class >= 1. Fail-fast: stop at
# the first failing capability. typecheck/lint are changed-file-set
# capabilities (ADAPTER-CONTRACT.md §3.1) unless --full was passed.
for cap in typecheck lint; do
  run_scoped "$cap" || { finish=1; break; }
done
if [[ "${finish:-0}" -ne 1 ]]; then
  run_simple test || finish=1
fi
if [[ "${finish:-0}" -ne 1 ]]; then
  # secret-scan takes the changed-file set as a scope-narrowing option
  # (ADAPTER-CONTRACT.md §3) — feeding it here, not via run_simple's no-
  # stdin path, is what keeps a per-task floor run from falling back to
  # a full-tree scan (and, e.g., flagging an adapter's own self-test
  # fixture for embedding a fake secret shape, a real cross-stack finding
  # from this project's own build). A capability with no stdin content
  # still runs correctly — secret-scan's own empty-stdin fallback is the
  # full-tree scan, unchanged for --full-style whole-repo use elsewhere.
  run_with_stdin secret-scan || finish=1
fi
if [[ "${finish:-0}" -ne 1 ]]; then
  run_artifact dep-diff no || finish=1
fi
if [[ "${finish:-0}" -ne 1 ]]; then
  run_with_stdin clone-scan || finish=1
fi
if [[ "${finish:-0}" -ne 1 ]]; then
  run_artifact callers yes || finish=1
fi

# Layer 2 (mutate) and Layer 5 (smoke) — class-conditional.
if [[ "${finish:-0}" -ne 1 ]]; then
  user_cfg="$HOME/.spine/user-config.json"
  smoke_budget=60
  mutate_class1_optin=false
  if [[ -f "$user_cfg" ]]; then
    smoke_budget="$(jq -r '.smoke_runtime_budget_seconds // 60' "$user_cfg")"
    mutate_class1_optin="$(jq -r '.mutate_class1_optin // false' "$user_cfg")"
  fi

  run_mutate=0
  if [[ "$class" == "2" ]]; then run_mutate=1; fi
  if [[ "$class" == "1" && "$mutate_class1_optin" == "true" ]]; then run_mutate=1; fi
  if [[ "$run_mutate" -eq 1 ]]; then
    run_simple mutate || finish=1
  fi

  if [[ "${finish:-0}" -ne 1 && "$class" == "2" ]]; then
    compute_changed_files
    if touches_migration_path; then
      run_simple migrate-rehearse || finish=1
    fi
  fi

  if [[ "${finish:-0}" -ne 1 ]]; then
    smoke_status="$(status_of smoke-run)"
    include_smoke=0
    if [[ "$class" == "2" ]]; then
      if [[ "$smoke_status" != "implemented" ]] && bootstrap_smoke_waiver; then
        echo "DEGRADED: smoke-run (waived: M0 bootstrap) — Class 2 smoke hard gate waived for milestone M0 task ${task_id}: smoke-run is a declared skeleton target in capabilities.json and work/M0/milestone.md, not yet built. NOT a pass — smoke did not run. Lapses automatically once smoke-run is implemented."
        add_result "smoke-run" "degraded:waived-bootstrap" "Class 2 smoke hard gate waived (M0 bootstrap, task ${task_id}); smoke did not run"
        include_smoke=0
      elif [[ "$smoke_status" != "implemented" ]]; then
        echo "FAIL: smoke — not implemented ($smoke_status) at Class 2 — smoke is a hard gate at this class, not a soft skip" >&2
        add_result "smoke-run" "fail" "smoke not implemented at Class 2 (hard gate): ${smoke_status}"
        overall_fail=1
        finish=1
        include_smoke=0
      else
        include_smoke=1
      fi
    else
      # smoke_in_floor (.spine/profile.json, default true) is the team's
      # own opt-out of Class 1 smoke ceremony (ADAPTER-CONTRACT.md's
      # documented "team profile wins" precedence over the personal
      # smoke_runtime_budget_seconds setting below) — the `prototype`
      # preset ships it `false` specifically to keep Class 1 lightweight.
      # Direct repro before this check existed: profile.json set to
      # false, smoke implemented and cached well under budget, floor
      # still ran and passed smoke-seed/run/golden anyway — a real,
      # avoidable cost for a team that explicitly opted out.
      # NOT `.smoke_in_floor // true` — jq's `//` treats a present-but-
      # `false` value as falsy too, same as a missing key, so that
      # spelling would silently coerce an explicit `false` back to
      # `true` and never actually skip smoke. `if . == null` is the one
      # that only fires on missing/null, not on a real `false`.
      profile_file="$project/.spine/profile.json"
      smoke_in_floor=true
      if [[ -f "$profile_file" ]]; then
        smoke_in_floor="$(jq -r '.smoke_in_floor | if . == null then true else . end' "$profile_file")"
      fi
      if [[ "$smoke_in_floor" != "true" ]]; then
        include_smoke=0
      else
        cache_file="$project/.spine/.smoke-runtime-seconds"
        if [[ -f "$cache_file" ]]; then
          cached="$(cat "$cache_file" 2>/dev/null || echo 999999)"
          if [[ "$smoke_status" == "implemented" && "$cached" -le "$smoke_budget" ]]; then
            include_smoke=1
          fi
        elif [[ "$smoke_status" == "implemented" ]]; then
          echo "floor: smoke runtime not yet measured — measuring now to establish the Class 1 inclusion threshold (budget: ${smoke_budget}s)"
          include_smoke=1
        fi
      fi
    fi
    if [[ "$include_smoke" -eq 1 ]]; then
      # floor does not, and must not, manage stack lifecycle between these
      # three (or between migrate-rehearse above and this loop) — it never
      # inspects or restores environment state, only exit codes (§2). Each
      # of smoke-seed/smoke-run/smoke-golden must self-heal a torn-down
      # stack on its own (ADAPTER-CONTRACT.md §2.2, §3.8); relying on
      # sequence order to guarantee the stack is already up is what
      # produced a deterministic smoke-seed failure right after a
      # migrate-rehearse that tore the stack down as its own cleanup.
      smoke_start=$(date +%s)
      for cap in smoke-seed smoke-run smoke-golden; do
        run_simple "$cap" || { finish=1; break; }
      done
      smoke_end=$(date +%s)
      echo $(( smoke_end - smoke_start )) > "$project/.spine/.smoke-runtime-seconds" 2>/dev/null || true
    fi
  fi
fi

if [[ -n "$out_path" ]]; then
  jq -n --arg class "$class" --arg project "$project" --argjson results "$results" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{class:($class|tonumber), project:$project, ran_at:$ts, results:$results}' >"$out_path"
fi

if [[ "${finish:-0}" -eq 1 ]]; then
  echo "floor: FAIL"
  exit 1
fi
echo "floor: PASS"
exit 0
