#!/bin/bash
# core-selftest — synthetic-fixture regression coverage for spine core's
# own scripts, as opposed to core/scripts/adapter-conformance which tests
# a project's adapters. Every case below builds a throwaway project under
# a temp dir (never this checkout, never a real installed project) and
# asserts on floor's/adapter-conformance's actual behavior against it.
#
# Currently covers:
#   - floor's migrate-rehearse dispatch (ADAPTER-CONTRACT.md §3.7): runs
#     only at Class 2 when the diff touches a migration path, records a
#     degraded gap when the capability isn't implemented, never appears
#     otherwise.
#   - floor's smoke_in_floor Class 1 opt-out (.spine/profile.json):
#     defaults true, an explicit false skips smoke even when implemented
#     and cached under budget, an explicit true behaves like the default.
#   - adversary-cache-tier's REUSED/FOCUSED/FULL decision (content-hash
#     match against blast radius, severity of the prior verdict).
#   - adapter-conformance's shell-strictness lint (ADAPTER-CONTRACT.md
#     §2.1): flags a bash adapter missing `set -euo pipefail` and a
#     bash-4-only construct with no $BASH_VERSINFO guard.
#   - adapter-conformance's SELF-TEST-FAIL-FIXTURE-BROKEN marker
#     (ADAPTER-CONTRACT.md §4): a --self-test fail fixture with no marker
#     stays an ordinary conformant fail; one whose own unexpected-success
#     path fired and emits the marker fails conformance distinctly instead
#     of reading as an identical clean pass.
#   - adapter-conformance's `--self-test cold` requirement for
#     smoke-seed/smoke-run/smoke-golden (ADAPTER-CONTRACT.md §2.2, §3.8):
#     a self-healing adapter passes conformance, a non-self-healing one
#     (the real shape found in the wild — assumes the stack is already
#     up) fails it, and a capability with no environment assumption is
#     never asked for `--self-test cold` at all.
#   - floor's Class 2 smoke hard-gate: an unimplemented smoke-run fails
#     floor outright, not a soft skip (a prior audit round found this used
#     to log "HARD GATE" but never actually fail).
#   - phase-gate/path-escalate/dep-gate direct repro coverage: a protected
#     path reached through a real symlinked alias of the project root still
#     denies (three separate real bypasses of this shape — a lexical `../`,
#     a planted symlink, and a project-root alias mismatch — have each been
#     found in this layer by direct testing after code review alone missed
#     them), a `../` traversal, a planted symlink into a protected path,
#     and dep-gate asking on a Bash write to a `#manifest` path (previously
#     checked only for Edit/Write).
#   - fuzz coverage for _workspace-route's path functions (_wsr_collapse,
#     _wsr_realpath, workspace_route, _wsr_glob_eq): thousands of randomly
#     generated path strings (fixed seed, reproducible) checked against
#     invariants — never-empty/idempotent/no-dot-segments for collapse,
#     always-terminates for realpath, always-absolute-or-empty ownership
#     root for workspace_route, NFC/NFD symmetry for glob_eq — each run
#     bounded so a reintroduced runaway fails loudly instead of hanging.
#   - second-approver-check's Class 2 approval gate: no approval.json, a
#     missing approver field, self-approval without an override, a
#     recorded self-approval override, and a genuine different-identity
#     approver — each the correct exit code and message.
#   - contract-touch's additive/breaking spec classification, blast-radius
#     aggregation, and registry-staleness detection (a stale registry
#     alone, with nothing else touched, still marks a contract touched) —
#     plus its two precondition failures (missing/malformed workspace.json).
#   - claims-check's asymmetric write/write vs write/read vs read/read
#     collision matrix (only the first two ever block), done-task
#     exclusion, and --diff mode's DECLARED/UNDECLARED tagging.
#   - check-stale's grounding-file drift, quarantine-banner writing (once,
#     not duplicated on re-run), the own-task-folder exemption, and
#     grounding-decisions status/content drift — including the specific
#     disclosed fix that a decision already `superseded` at citation time
#     is never drift, however many times this re-runs.
#   - registry-sync's commit-scope discipline (stages only work/<task-id>/,
#     never an unrelated dirty file elsewhere in the tree) and the push /
#     pull-rebase-retry sequence against a real local remote, including a
#     genuine concurrent-push scenario with no real conflict.
#   - decision-hash (excludes Status, deterministic, reacts to real content
#     drift), profile-check (unrepresentable-floor-off, bounded fields), q
#     (one-line-ok vs full-diagnostics-plus-real-exit-code), ui-touch
#     (conditional ui-render dispatch), verdict-filter (schema validation
#     plus decision-kind's stronger resolution check), next-milestone-task
#     (TBD/BLOCKED/WAITING/NONE, numeric milestone ordering), design-gate
#     (all four /design stopping-rule checks incl. the DEFERRED.md escape
#     hatch), decision-index (regenerated INDEX.md, numeric id ordering,
#     --check staleness with no disk write), propagate (flags every OTHER
#     open task grounding on what changed, severity from its own phase,
#     self/done exclusion), setup (real symlinks into this checkout, pin
#     init/warn/strict comparison, settings.local.json merge discipline),
#     and wayfinder-frontier (FRONTIER/CLEARED/STALLED resolution derived
#     from Status+Blocked-by, never a stored "blocked" label; a resolved
#     blocker un-stalls its dependent without anything hand-flipping it; a
#     dangling Blocked-by reference fails loudly instead of being treated
#     as unblocked).
#     This closes the round-5 audit's scripts-coverage backlog: every
#     script in core/scripts/* now has permanent regression coverage.
#
# Usage: core-selftest
# Exit 0 iff every case passes.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLOOR="$SCRIPT_DIR/floor"
ADAPTER_CONFORMANCE="$SCRIPT_DIR/adapter-conformance"

tmp_root="$(mktemp -d)"
trap 'rm -rf "$tmp_root"' EXIT
mkdir -p "$tmp_root/logs"

overall=0
fail() { echo "FAIL: $1"; overall=1; }
pass() { echo "PASS: $1"; }

result_status() { jq -r --arg c "$2" '.results[]? | select(.capability==$c) | .status' "$1" 2>/dev/null || true; }
result_present() { jq -e --arg c "$2" '.results[]? | select(.capability==$c)' "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# floor: migrate-rehearse dispatch
# ---------------------------------------------------------------------------

new_migrate_fixture() {
  # new_migrate_fixture <migrate-status> <migrate-behavior:pass|fail>
  local status="$1" behavior="$2" proj
  proj="$(mktemp -d "$tmp_root/proj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"implemented"},
  "smoke-golden": {"status":"implemented"},
  "migrate-rehearse": {"status":"$status","reason":"selftest: not wired"}
}
EOF
  # A real class-2 floor run hard-gates on smoke-run being "implemented"
  # (ADAPTER-CONTRACT.md §3.8, floor's own Class-2 gate) — the migrate-
  # rehearse cases below are only exercising migration dispatch, so the
  # smoke trio here just needs to pass cleanly, not test anything itself.
  for cap in smoke-seed smoke-run smoke-golden; do
    cat >"$proj/.spine/adapters/$cap" <<EOF
#!/bin/bash
set -euo pipefail
echo "$cap selftest stub: ok"
EOF
    chmod +x "$proj/.spine/adapters/$cap"
  done
  cat >"$proj/.spine/adapters/migrate-rehearse" <<'EOF'
#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
behavior="pass"
[[ -f "$root/migrate-behavior" ]] && behavior="$(cat "$root/migrate-behavior")"
if [[ "$behavior" == "fail" ]]; then
  echo "selftest: forced migrate-rehearse failure" >&2
  exit 1
fi
echo "migrate-rehearse selftest stub: ok"
EOF
  chmod +x "$proj/.spine/adapters/migrate-rehearse"
  echo "$behavior" >"$proj/.spine/migrate-behavior"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

run_floor_case() {
  # run_floor_case <name> <class> <status> <behavior> <touch-migration:yes|no>
  local name="$1" class="$2" status="$3" behavior="$4" touch="$5" proj out log code
  proj="$(new_migrate_fixture "$status" "$behavior")"
  if [[ "$touch" == "yes" ]]; then
    mkdir -p "$proj/migrations"
    echo "up" >"$proj/migrations/0001_init.sql"
  else
    echo "more" >>"$proj/src/app.js"
  fi
  git -C "$proj" add -A
  out="$tmp_root/${name}.json"
  log="$tmp_root/logs/${name}.log"
  if ( cd "$proj" && "$FLOOR" "$class" --out "$out" >"$log" 2>&1 ); then code=0; else code=$?; fi
  echo "$code|$out"
}

# Case 1: Class 2, migration touched, migrate-rehearse implemented+passing
# -> runs, recorded pass, floor exits 0.
r="$(run_floor_case case1 2 implemented pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" migrate-rehearse)" == "pass" ]]; then
  pass "floor: class 2 + migration touched + implemented -> runs and passes"
else
  fail "floor: class 2 + migration touched + implemented -> runs and passes (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 2: Class 2, migration touched, migrate-rehearse implemented+failing
# -> fail-fast, recorded fail, floor exits non-zero.
r="$(run_floor_case case2 2 implemented fail yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" != "0" && "$(result_status "$out" migrate-rehearse)" == "fail" ]]; then
  pass "floor: class 2 + migration touched + implemented, adapter fails -> floor fails"
else
  fail "floor: class 2 + migration touched + implemented, adapter fails -> floor fails (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 3: Class 2, migration touched, migrate-rehearse NOT implemented
# -> recorded as a degraded capability gap, never silently absent, floor
# still exits 0 (a degradation never fails floor by itself).
r="$(run_floor_case case3 2 unavailable pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" migrate-rehearse)" == "degraded:unavailable" ]]; then
  pass "floor: class 2 + migration touched + unavailable -> degraded gap, floor still passes"
else
  fail "floor: class 2 + migration touched + unavailable -> degraded gap, floor still passes (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 4: Class 2, migrate-rehearse implemented, but no migration path
# touched -> never invoked, no gap recorded at all.
r="$(run_floor_case case4 2 implemented pass no)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" migrate-rehearse; then
  pass "floor: class 2 + no migration path touched -> migrate-rehearse never dispatched"
else
  fail "floor: class 2 + no migration path touched -> migrate-rehearse never dispatched (exit=$code present=$(result_present "$out" migrate-rehearse && echo yes || echo no))"
fi

# Case 5: Class 1, migration path touched, migrate-rehearse implemented
# -> migrate-rehearse is a Class 2 gate only, never dispatched at Class 1.
r="$(run_floor_case case5 1 implemented pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" migrate-rehearse; then
  pass "floor: class 1 + migration path touched -> migrate-rehearse never dispatched (Class 2 gate only)"
else
  fail "floor: class 1 + migration path touched -> migrate-rehearse never dispatched (exit=$code present=$(result_present "$out" migrate-rehearse && echo yes || echo no))"
fi

# ---------------------------------------------------------------------------
# floor: smoke_in_floor (.spine/profile.json) Class 1 opt-out
# ---------------------------------------------------------------------------
# Direct repro that motivated this coverage: with smoke implemented, cached
# well under budget, and profile.json's smoke_in_floor explicitly false,
# floor still ran smoke-seed/run/golden anyway before this was wired in —
# ADAPTER-CONTRACT.md's documented "team profile wins" precedence was pure
# prose with nothing behind it. This also guards the jq idiom itself: a
# naive `.smoke_in_floor // true` silently coerces an explicit `false` back
# to `true` (jq's `//` treats `false` as falsy, same as missing/null), so
# case 7 below fails loudly if that regresses.

new_smoke_profile_fixture() {
  # new_smoke_profile_fixture <profile.json-content-or-empty>
  local profile_json="$1" proj
  proj="$(mktemp -d "$tmp_root/smokeproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"implemented"},
  "smoke-golden": {"status":"implemented"}
}
EOF
  for cap in smoke-seed smoke-run smoke-golden; do
    cat >"$proj/.spine/adapters/$cap" <<EOF2
#!/bin/bash
set -euo pipefail
echo "$cap selftest stub: ok"
EOF2
    chmod +x "$proj/.spine/adapters/$cap"
  done
  [[ -n "$profile_json" ]] && echo "$profile_json" >"$proj/.spine/profile.json"
  # Pre-cache a runtime well under the 60s default budget so Class 1 would
  # include smoke on its own merits if smoke_in_floor didn't override it.
  echo 1 >"$proj/.spine/.smoke-runtime-seconds"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  echo "more" >>"$proj/src/app.js"
  git -C "$proj" add -A
  printf '%s' "$proj"
}

run_smoke_profile_case() {
  # run_smoke_profile_case <name> <profile.json-content-or-empty>
  local name="$1" profile_json="$2" proj out log code
  proj="$(new_smoke_profile_fixture "$profile_json")"
  out="$tmp_root/${name}.json"
  log="$tmp_root/logs/${name}.log"
  if ( cd "$proj" && "$FLOOR" 1 --out "$out" >"$log" 2>&1 ); then code=0; else code=$?; fi
  echo "$code|$out"
}

# Case 6: no profile.json -> smoke_in_floor defaults true, smoke runs.
r="$(run_smoke_profile_case case6 "")"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" smoke-run)" == "pass" ]]; then
  pass "floor: class 1, no profile.json -> smoke_in_floor defaults true, smoke runs"
else
  fail "floor: class 1, no profile.json -> smoke_in_floor defaults true, smoke runs (exit=$code status=$(result_status "$out" smoke-run))"
fi

# Case 7: smoke_in_floor: false -> smoke never dispatched, even implemented
# and cached under budget. This is the case a naive `// true` jq idiom
# would silently get wrong.
r="$(run_smoke_profile_case case7 '{"smoke_in_floor": false}')"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" smoke-run; then
  pass "floor: class 1, smoke_in_floor:false -> smoke never dispatched despite being implemented+cached-under-budget"
else
  fail "floor: class 1, smoke_in_floor:false -> smoke never dispatched (exit=$code present=$(result_present "$out" smoke-run && echo yes || echo no))"
fi

# Case 8: smoke_in_floor: true (explicit) -> smoke runs, same as default.
r="$(run_smoke_profile_case case8 '{"smoke_in_floor": true}')"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" smoke-run)" == "pass" ]]; then
  pass "floor: class 1, smoke_in_floor:true -> smoke runs"
else
  fail "floor: class 1, smoke_in_floor:true -> smoke runs (exit=$code status=$(result_status "$out" smoke-run))"
fi

# ---------------------------------------------------------------------------
# adversary-cache-tier: /verify's REUSED/FOCUSED/FULL decision
# ---------------------------------------------------------------------------
# Mechanical restatement of verify/SKILL.md's three-outcome caching rule —
# these cases are the same ones used to spot-check the script by hand
# before this coverage existed; kept here so a future edit to the tiering
# logic can't silently drift from the documented algorithm.

ACT="$SCRIPT_DIR/adversary-cache-tier"
act_proj="$(mktemp -d "$tmp_root/actproj.XXXXXX")"
mkdir -p "$act_proj/work/actT/artifacts" "$act_proj/src"
printf 'content A\n' >"$act_proj/src/a.txt"
printf 'content B\n' >"$act_proj/src/b.txt"
printf 'content C\n' >"$act_proj/src/c.txt"
act_hash_a="$(shasum -a 256 "$act_proj/src/a.txt" | awk '{print $1}')"
act_hash_b="$(shasum -a 256 "$act_proj/src/b.txt" | awk '{print $1}')"

act_check() {
  # act_check <desc> <expected> <blast-radius-lines>
  local desc="$1" expected="$2" lines="$3" got
  got="$(printf '%s' "$lines" | "$ACT" actT falsifier --project "$act_proj" 2>/dev/null || true)"
  if [[ "$got" == "$expected" ]]; then
    pass "adversary-cache-tier: $desc -> $expected"
  else
    fail "adversary-cache-tier: $desc -> expected $expected, got '$got'"
  fi
}

act_check "no coverage file yet" "FULL" "src/a.txt
src/b.txt"

jq -n --arg a "$act_hash_a" --arg b "$act_hash_b" '{files:{"src/a.txt":$a,"src/b.txt":$b}}' \
  >"$act_proj/work/actT/artifacts/falsifier-coverage.json"
act_check "full match, no prior verdict file" "REUSED" "src/a.txt
src/b.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"low"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "full match, prior verdict low-only" "REUSED" "src/a.txt
src/b.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"medium"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "full match, prior verdict has medium (not REUSED)" "FULL" "src/a.txt
src/b.txt"

act_check "partial match (c.txt uncovered), prior verdict medium" "FOCUSED" "src/a.txt
src/b.txt
src/c.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"high"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "partial match, prior verdict has high (never reduced effort)" "FULL" "src/a.txt
src/b.txt
src/c.txt"

printf 'changed\n' >"$act_proj/src/a.txt"
printf 'changed\n' >"$act_proj/src/b.txt"
jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "zero match (content changed)" "FULL" "src/a.txt
src/b.txt"

act_check "empty blast radius" "FULL" ""

# ---------------------------------------------------------------------------
# adapter-conformance: shell-strictness lint (ADAPTER-CONTRACT.md §2.1)
# ---------------------------------------------------------------------------

lint_proj="$(mktemp -d "$tmp_root/lintproj.XXXXXX")"
mkdir -p "$lint_proj/.spine/adapters"

write_selftest_adapter() {
  # write_selftest_adapter <path> <set-line> <extra-body>
  cat >"$1" <<EOF
#!/bin/bash
$2
if [[ "\${1:-}" == "--self-test" ]]; then
  if [[ "\${2:-}" == "pass" ]]; then echo "ok"; exit 0; fi
  if [[ "\${2:-}" == "fail" ]]; then echo "forced diagnostics" >&2; exit 1; fi
fi
$3
echo "ok"
exit 0
EOF
  chmod +x "$1"
}

write_selftest_adapter "$lint_proj/.spine/adapters/good" "set -euo pipefail" ""
write_selftest_adapter "$lint_proj/.spine/adapters/no-strict" "set -uo pipefail" ""
write_selftest_adapter "$lint_proj/.spine/adapters/bash4-unguarded" "set -euo pipefail" \
'_unused_bash4_helper() { local -A cache; cache[foo]=bar; }'
write_selftest_adapter "$lint_proj/.spine/adapters/bash4-guarded" "set -euo pipefail" \
'if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
  _unused_bash4_helper() { local -A cache; cache[foo]=bar; }
fi'

check_lint_case() {
  # check_lint_case <name> <adapter> <expect:pass|fail> [grep-for]
  local name="$1" adapter="$2" expect="$3" grepfor="${4:-}" out code=0
  out="$("$ADAPTER_CONFORMANCE" "$adapter" --project "$lint_proj" 2>&1)" || code=$?
  local got="fail"; [[ $code -eq 0 ]] && got="pass"
  if [[ "$got" != "$expect" ]]; then
    fail "adapter-conformance: $name -> expected $expect, got $got (exit $code)"
    echo "$out"
    return
  fi
  if [[ -n "$grepfor" ]] && ! grep -qF "$grepfor" <<<"$out"; then
    fail "adapter-conformance: $name -> expected diagnostics containing \"$grepfor\""
    echo "$out"
    return
  fi
  pass "adapter-conformance: $name"
}

check_lint_case "set -euo pipefail, no bash4 syntax -> conformant" good pass
check_lint_case "missing -e -> flagged, conformance fails" no-strict fail "missing 'set -euo pipefail'"
check_lint_case "unguarded bash-4-only construct -> flagged, conformance fails" bash4-unguarded fail "BASH_VERSINFO guard"
check_lint_case "bash-4-only construct behind \$BASH_VERSINFO guard -> conformant" bash4-guarded pass

# ---------------------------------------------------------------------------
# adapter-conformance: SELF-TEST-FAIL-FIXTURE-BROKEN marker distinguishes a
# --self-test fail fixture whose own unexpected-success path fired from one
# that correctly demonstrated the failure (ADAPTER-CONTRACT.md §4) — both
# used to converge on the same generic exit 1, indistinguishable to
# adapter-conformance's exit-code/non-empty-diagnostics check alone.
# ---------------------------------------------------------------------------

marker_proj="$(mktemp -d "$tmp_root/markerproj.XXXXXX")"
mkdir -p "$marker_proj/.spine/adapters"

write_selftest_adapter "$marker_proj/.spine/adapters/ordinary-fail" "set -euo pipefail" ""

cat >"$marker_proj/.spine/adapters/broken-fail" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ "${1:-}" == "--self-test" ]]; then
  if [[ "${2:-}" == "pass" ]]; then echo "ok"; exit 0; fi
  if [[ "${2:-}" == "fail" ]]; then
    echo "SELF-TEST-FAIL-FIXTURE-BROKEN: probe unexpectedly succeeded" >&2
    exit 1
  fi
fi
echo "ok"
exit 0
EOF
chmod +x "$marker_proj/.spine/adapters/broken-fail"

if out="$("$ADAPTER_CONFORMANCE" ordinary-fail --project "$marker_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -eq 0 ]] && ! grep -q "SELF-TEST-FAIL-FIXTURE-BROKEN" <<<"$out"; then
  pass "adapter-conformance: fail fixture with no marker stays an ordinary conformant fail"
else
  fail "adapter-conformance: fail fixture with no marker stays an ordinary conformant fail (exit=$code)"
  echo "$out"
fi

if out="$("$ADAPTER_CONFORMANCE" broken-fail --project "$marker_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -ne 0 ]] && grep -q "unexpected-success path fired" <<<"$out" \
  && grep -q "probe unexpectedly succeeded" <<<"$out"; then
  pass "adapter-conformance: SELF-TEST-FAIL-FIXTURE-BROKEN marker fails conformance distinctly"
else
  fail "adapter-conformance: SELF-TEST-FAIL-FIXTURE-BROKEN marker fails conformance distinctly (exit=$code)"
  echo "$out"
fi

# ---------------------------------------------------------------------------
# adapter-conformance: --self-test cold requirement for smoke-seed/
# smoke-run/smoke-golden (ADAPTER-CONTRACT.md §2.2, §3.8)
# ---------------------------------------------------------------------------

write_selfheal_smoke_seed() {
  # write_selfheal_smoke_seed <path> — implements pass/fail/cold correctly.
  # --self-test cold deliberately starts from its scratch stack torn down
  # and routes through the same ensure_up helper the pass path uses
  # (ADAPTER-CONTRACT.md §4's "real invocation path" rule), proving
  # self-heal is real rather than asserted.
  cat >"$1" <<'EOF'
#!/bin/bash
set -euo pipefail
ensure_up() {
  local marker="$1"
  [[ -f "$marker" ]] || : >"$marker"
}
if [[ "${1:-}" == "--self-test" ]]; then
  scratch="$(mktemp -d)"
  trap 'rm -rf "$scratch"' EXIT
  case "${2:-}" in
    pass) ensure_up "$scratch/up"; echo "smoke-seed selftest: ok"; exit 0 ;;
    fail) echo "smoke-seed selftest: forced failure" >&2; exit 1 ;;
    cold)
      # no marker pre-seeded here -> starts torn down
      ensure_up "$scratch/up"
      [[ -f "$scratch/up" ]] || { echo "self-heal did not bring stack up" >&2; exit 1; }
      echo "smoke-seed selftest: ok (self-healed from cold)"
      exit 0
      ;;
    *) echo "unknown self-test scenario: ${2:-}" >&2; exit 2 ;;
  esac
fi
echo "smoke-seed: ok"
exit 0
EOF
  chmod +x "$1"
}

write_nonhealing_smoke_seed() {
  # write_nonhealing_smoke_seed <path> — the real-world bug shape: resolves
  # pass/fail fine but assumes the stack is already up and never attempts
  # to start it, so --self-test cold fails.
  cat >"$1" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ "${1:-}" == "--self-test" ]]; then
  case "${2:-}" in
    pass) echo "smoke-seed selftest: ok"; exit 0 ;;
    fail) echo "smoke-seed selftest: forced failure" >&2; exit 1 ;;
    cold) echo "could not resolve the local stack -- is it running?" >&2; exit 1 ;;
    *) echo "unknown self-test scenario: ${2:-}" >&2; exit 2 ;;
  esac
fi
echo "smoke-seed: ok"
exit 0
EOF
  chmod +x "$1"
}

cold_proj="$(mktemp -d "$tmp_root/coldproj.XXXXXX")"
mkdir -p "$cold_proj/.spine/adapters"

write_selfheal_smoke_seed "$cold_proj/.spine/adapters/smoke-seed"
if out="$("$ADAPTER_CONFORMANCE" smoke-seed --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -eq 0 ]] && grep -qF "self-healed from cold" <<<"$out"; then
  pass "adapter-conformance: self-healing smoke-seed passes --self-test cold"
else
  fail "adapter-conformance: self-healing smoke-seed passes --self-test cold (exit=$code)"
  echo "$out"
fi

rm -f "$cold_proj/.spine/adapters/smoke-seed"
write_nonhealing_smoke_seed "$cold_proj/.spine/adapters/smoke-seed"
if out="$("$ADAPTER_CONFORMANCE" smoke-seed --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -ne 0 ]] && grep -qF "self-test cold exited" <<<"$out"; then
  pass "adapter-conformance: non-self-healing smoke-seed fails conformance via --self-test cold"
else
  fail "adapter-conformance: non-self-healing smoke-seed fails conformance via --self-test cold (exit=$code)"
  echo "$out"
fi

write_selftest_adapter "$cold_proj/.spine/adapters/test" "set -euo pipefail" ""
if out="$("$ADAPTER_CONFORMANCE" test --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -eq 0 ]] && ! grep -q "self-test cold" <<<"$out"; then
  pass "adapter-conformance: capability with no environment assumption never asked for --self-test cold"
else
  fail "adapter-conformance: capability with no environment assumption never asked for --self-test cold (exit=$code)"
  echo "$out"
fi

# ---------------------------------------------------------------------------
# floor: Class 2 smoke hard-gate (ADAPTER-CONTRACT.md §3.8) — an
# unimplemented smoke-run must fail floor outright at Class 2, never a soft
# skip. Deliberately uses a different "not implemented" status string
# ("unavailable") than the original bug report ("not-applicable") did, per
# the lesson that a fix's own repro isn't enough to trust it's general.
# ---------------------------------------------------------------------------

new_smoke_hardgate_fixture() {
  local proj
  proj="$(mktemp -d "$tmp_root/hardgateproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"unavailable","reason":"selftest: deliberately not implemented"},
  "smoke-golden": {"status":"implemented"}
}
EOF
  cat >"$proj/.spine/adapters/smoke-seed" <<'EOF'
#!/bin/bash
set -euo pipefail
echo "smoke-seed selftest stub: ok"
EOF
  chmod +x "$proj/.spine/adapters/smoke-seed"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  echo "more" >>"$proj/src/app.js"
  git -C "$proj" add -A
  printf '%s' "$proj"
}

hg_proj="$(new_smoke_hardgate_fixture)"
hg_out="$tmp_root/hardgate.json"
hg_log="$tmp_root/logs/hardgate.log"
if ( cd "$hg_proj" && "$FLOOR" 2 --out "$hg_out" >"$hg_log" 2>&1 ); then hg_code=0; else hg_code=$?; fi
if [[ "$hg_code" != "0" && "$(result_status "$hg_out" smoke-run)" == "fail" ]]; then
  pass "floor: class 2, smoke-run not implemented -> hard gate fails floor (not a soft skip)"
else
  fail "floor: class 2, smoke-run not implemented -> hard gate fails floor (exit=$hg_code status=$(result_status "$hg_out" smoke-run))"
fi

# ---------------------------------------------------------------------------
# floor: M0 bootstrap waiver for the Class 2 smoke hard gate. The waiver must
# apply ONLY when every independently-declared fact holds (task in M0,
# capabilities.json `unavailable` + "skeleton target" reason, milestone table
# row `unavailable*`); each case below removes exactly one and must fall back
# to the hard gate. The `not-applicable` case guards the original wrong-shape
# bug the hard gate was hardened against.
# ---------------------------------------------------------------------------

# expect_bootstrap <label> <waived|fail> <task-milestone> <cap-status> <cap-reason> <milestone-table-planned-status>
expect_bootstrap() {
  local label="$1" expect="$2" task_ms="$3" cap_st="$4" cap_reason="$5" planned="$6"
  local proj out log code st
  proj="$(new_smoke_hardgate_fixture)"
  jq --arg s "$cap_st" --arg r "$cap_reason" '.["smoke-run"] = {status:$s, reason:$r}' \
    "$proj/.spine/capabilities.json" >"$proj/.spine/capabilities.json.new"
  mv "$proj/.spine/capabilities.json.new" "$proj/.spine/capabilities.json"
  mkdir -p "$proj/work/T-boot" "$proj/work/M0"
  printf '%s\n' "$task_ms" >"$proj/work/T-boot/milestone"
  printf '# Milestone `M0`: skeleton\n\n## Capability targets\n\n| Capability | Planned status |\n|---|---|\n| smoke-run | %s |\n' "$planned" >"$proj/work/M0/milestone.md"
  out="$tmp_root/bootstrap-$RANDOM.json"
  log="$tmp_root/logs/bootstrap-$RANDOM.log"
  if ( cd "$proj" && "$FLOOR" 2 --task T-boot --out "$out" >"$log" 2>&1 ); then code=0; else code=$?; fi
  st="$(result_status "$out" smoke-run)"
  if [[ "$expect" == "waived" ]]; then
    if [[ "$code" == "0" && "$st" == "degraded:waived-bootstrap" ]] && grep -q "waived: M0 bootstrap" "$log"; then
      pass "$label"
    else
      fail "$label (exit=$code status=$st)"
    fi
  else
    if [[ "$code" != "0" && "$st" == "fail" ]]; then pass "$label"; else fail "$label (exit=$code status=$st)"; fi
  fi
}

SKEL="no code yet — skeleton target"
expect_bootstrap "floor: class 2, M0 task + skeleton-target smoke-run -> waived as degraded, not pass" \
  waived "M0" "unavailable" "$SKEL" "unavailable (no code yet — skeleton target)"
expect_bootstrap "floor: class 2, task in M1 (not M0) -> hard gate still fails" \
  fail "M1" "unavailable" "$SKEL" "unavailable (no code yet — skeleton target)"
expect_bootstrap "floor: class 2, reason lacks 'skeleton target' marker -> hard gate still fails" \
  fail "M0" "unavailable" "selftest: deliberately not implemented" "unavailable (no code yet — skeleton target)"
expect_bootstrap "floor: class 2, milestone table does not declare smoke-run unavailable -> hard gate still fails" \
  fail "M0" "unavailable" "$SKEL" "implemented"
expect_bootstrap "floor: class 2, smoke-run not-applicable (wrong shape) even with marker -> hard gate still fails" \
  fail "M0" "not-applicable" "$SKEL" "unavailable (no code yet — skeleton target)"

# ---------------------------------------------------------------------------
# hooks: phase-gate / path-escalate / dep-gate direct repro coverage
# ---------------------------------------------------------------------------
# Three separate real bypasses of this layer have each been found only by
# direct testing, after code review and the previous round's own tests
# missed them: a lexical `../` (round 1), a planted/live symlink (round 2),
# and a project-root reached through a different real alias than the one
# $file_path was given through (round 3). These cases exist so the next
# edit to _workspace-route/_bash-write-targets/the hooks themselves can't
# silently reopen any of the three. The alias case uses a self-created
# symlink rather than depending on the host's own /tmp layout, so this
# suite is portable — but exercises the identical code path a real /tmp ->
# /private/tmp alias would (ownership decided from a lexical prefix match
# with a resolved-path fallback).

PHASE_GATE="$SCRIPT_DIR/../hooks/phase-gate"
PATH_ESCALATE="$SCRIPT_DIR/../hooks/path-escalate"
DEP_GATE="$SCRIPT_DIR/../hooks/dep-gate"

new_hook_fixture() {
  local real alias
  real="$(mktemp -d "$tmp_root/hookproj.XXXXXX")"
  mkdir -p "$real/.spine" "$real/src/auth" "$real/src/other" "$real/pkg" "$real/work/T1"
  printf 'src/auth/**\npkg/manifest.json #manifest\n' >"$real/.spine/protected-paths.conf"
  printf 'npm install\n' >"$real/.spine/install-command-patterns.conf"
  echo secret >"$real/src/auth/secret.txt"
  echo '{}' >"$real/pkg/manifest.json"
  echo T1 >"$real/.spine/current-task"
  echo research >"$real/work/T1/state"
  echo 0 >"$real/work/T1/class"
  alias="$(mktemp -u "$tmp_root/hookalias.XXXXXX")"
  ln -s "$real" "$alias"
  printf '%s|%s' "$real" "$alias"
}

hook_run() {
  # hook_run <hook-bin> <CLAUDE_PROJECT_DIR-value> <json> -> "<exit>|<output>"
  local bin="$1" proj="$2" json="$3" out code=0
  out="$(CLAUDE_PROJECT_DIR="$proj" "$bin" <<<"$json" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

hook_check() {
  # hook_check <desc> <result> <expect:deny|allow|ask>
  local desc="$1" result="$2" expect="$3" code="${2%%|*}" out="${2#*|}"
  case "$expect" in
    deny) [[ "$code" != "0" ]] && pass "hooks: $desc" || fail "hooks: $desc (expected deny, got exit=$code: $out)" ;;
    allow) [[ "$code" == "0" && "$out" != *permissionDecision* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected allow, got exit=$code: $out)" ;;
    ask) [[ "$out" == *'"permissionDecision": "ask"'* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected ask, got exit=$code: $out)" ;;
  esac
}

hook_run_bounded() {
  # hook_run_bounded <timeout-seconds> <hook-bin> <CLAUDE_PROJECT_DIR-value>
  # <json> -> "<exit>|<elapsed-seconds>|<output>", where exit is the literal
  # string "timeout" if the process was still running after
  # <timeout-seconds>. No `timeout`/`gtimeout` binary is assumed present
  # (neither is on this machine) — a portable background-job + poll + kill
  # instead. Exists specifically for the round-4 empty-array/runaway-
  # recursion regression case: without a bound, a reintroduced version of
  # that bug would eventually self-terminate via the host's own process
  # limits (a real, but non-deterministic and environment-dependent, exit
  # path) rather than reliably fail this suite — <elapsed-seconds> lets
  # hook_check_fast assert real speed, not just "some non-zero exit
  # eventually happened," since a resource-exhaustion crash can itself
  # produce a non-zero exit that would otherwise be indistinguishable from
  # a correct, fast, intentional deny.
  local bound="$1" bin="$2" proj="$3" json="$4" outfile pid waited=0 code out
  outfile="$(mktemp "$tmp_root/hookbounded.XXXXXX")"
  ( CLAUDE_PROJECT_DIR="$proj" "$bin" <<<"$json" >"$outfile" 2>&1
    echo "$?" >"$outfile.code" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt $bound ]]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    printf 'timeout|%s|still running after %ss' "$bound" "$bound"
    return
  fi
  wait "$pid" 2>/dev/null
  code="$(cat "$outfile.code" 2>/dev/null)"; code="${code:-1}"
  out="$(cat "$outfile" 2>/dev/null)"
  printf '%s|%s|%s' "$code" "$waited" "$out"
}

hook_check_fast() {
  # hook_check_fast <desc> <result-from-hook_run_bounded> <expect:deny|allow>
  # <max-seconds> — like hook_check, but additionally fails if the process
  # took anywhere near <max-seconds> (including the literal "timeout"
  # outcome): a fork-bomb regression can crash out with a real, otherwise-
  # plausible-looking non-zero exit once the host's own process/fork limits
  # kick in, which is a *symptom* of the runaway, not a legitimate fast
  # deny — confirmed directly: a reverted pre-fix build of this codepath
  # produced exactly that shape (a real deny-looking exit, reached only
  # after several seconds and thousands of forked subprocesses).
  local desc="$1" result="$2" expect="$3" max="$4"
  local code="${result%%|*}" rest="${result#*|}" elapsed="${rest%%|*}" out="${rest#*|}"
  if [[ "$code" == "timeout" ]]; then
    fail "hooks: $desc (hung past ${max}s — runaway, not a fast decision)"
    return
  fi
  if [[ "$elapsed" -ge "$max" ]]; then
    fail "hooks: $desc (took ${elapsed}s, expected well under ${max}s — likely the same runaway resolving via host resource limits rather than a real fast decision; got exit=$code: $out)"
    return
  fi
  case "$expect" in
    deny) [[ "$code" != "0" ]] && pass "hooks: $desc" || fail "hooks: $desc (expected deny, got exit=$code: $out)" ;;
    allow) [[ "$code" == "0" && "$out" != *permissionDecision* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected allow, got exit=$code: $out)" ;;
  esac
}

hf="$(new_hook_fixture)"
hook_real="${hf%%|*}"
hook_alias="${hf#*|}"

hook_check "path-escalate denies canonical protected path (control)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a protected path reached via a project-root alias" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a Bash write to a protected path via a project-root alias" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"echo pwned > '"$hook_alias"'/src/auth/secret.txt"}}')" deny

hook_check "phase-gate denies an out-of-task-dir write reached via a project-root alias" \
  "$(hook_run "$PHASE_GATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/src/other/x.txt"}}')" deny

hook_check "dep-gate asks on a manifest write reached via a project-root alias" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/pkg/manifest.json"}}')" ask

hook_check "dep-gate asks on a Bash write to a #manifest path (not just Edit/Write)" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"echo x > '"$hook_real"'/pkg/manifest.json"}}')" ask

hook_check "dep-gate asks on a Bash sed -i to a #manifest path" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"sed -i \"\" -e s/a/b/ '"$hook_real"'/pkg/manifest.json"}}')" ask

hook_check "path-escalate allows a genuinely unrelated external path (control)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$tmp_root"'/unrelated.txt"}}')" allow

hook_check "path-escalate denies (reverse alias direction: project via alias, target canonical)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_alias" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a ../ traversal to a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"src/other/../auth/secret.txt"}}')" deny

ln -sf "$hook_real/src/auth/secret.txt" "$hook_real/src/other/innocuous.txt"
hook_check "path-escalate denies a planted symlink into a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"src/other/innocuous.txt"}}')" deny
rm -f "$hook_real/src/other/innocuous.txt"

# Round 4: a relative CLAUDE_PROJECT_DIR, or a ../ chain deep enough to
# cancel a whole absolute project prefix to nothing, drove _wsr_collapse's
# empty-array dereference into a silently-swallowed crash whose caller
# (_wsr_realpath) then recursed forever on the resulting "" — a genuine
# multi-thousand-subprocess runaway that still resolved to fail-open.
# Bounded so a regression here fails fast instead of just running long.
hook_check_fast "path-escalate fails closed on a relative CLAUDE_PROJECT_DIR, fast (not a runaway that only eventually deny-shaped-crashes)" \
  "$(hook_run_bounded 20 "$PATH_ESCALATE" "hookproj-relative" '{"tool_name":"Write","tool_input":{"file_path":"src/auth/secret.txt"}}')" deny 5

hook_check_fast "path-escalate resolves a root-cancelling ../ chain fast, without a runaway (control: genuinely outside project, so allow is correct)" \
  "$(hook_run_bounded 20 "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"../../../../../../../../../../../../../../../../../../../../src/auth/secret.txt"}}')" allow 5

# Round 4: an NFC- and an NFD-encoded (byte-distinct) form of the same
# accented path name the identical real file on a normalization-insensitive
# filesystem (APFS/HFS+), but a bare bash glob comparison is byte-level —
# a protected-paths.conf glob written in one form silently missed a
# file_path given in the other. Skipped if python3 (the only normalizer
# _wsr_nfc uses) isn't on PATH, matching that helper's own fallback.
if command -v python3 >/dev/null 2>&1; then
  nfc_dir="$(python3 -c "print('café')")"
  nfd_dir="$(python3 -c "import unicodedata; print(unicodedata.normalize('NFD', 'café'))")"
  mkdir -p "$hook_real/src/other/$nfc_dir"
  echo secret >"$hook_real/src/other/$nfc_dir/x.txt"
  printf 'src/other/%s/**\n' "$nfc_dir" >>"$hook_real/.spine/protected-paths.conf"
  nfd_file_path="src/other/${nfd_dir}/x.txt"
  hook_check "path-escalate denies the NFD byte-form of a glob registered in NFC form (same real file)" \
    "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$nfd_file_path"'"}}')" deny
else
  echo "hooks: SKIP NFC/NFD case — python3 not on PATH"
fi

# Deletion coverage: six audit rounds tested every *write* bypass shape
# (../, symlink, alias, NFC/NFD, dep-gate's missing Bash branch, a bash-3.2
# crash) but never a *delete* one — rm/unlink/git-rm/git-checkout--/git-
# restore previously reached protected paths, manifest files, and
# out-of-task-dir locations with zero scrutiny. Same fixture as above.

hook_check "path-escalate denies a Bash rm of a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"rm '"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate allows a Bash rm of an unrelated path (control)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"rm '"$hook_real"'/src/other/scratch.txt"}}')" allow

hook_check "dep-gate asks on a Bash rm of a #manifest path" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"rm '"$hook_real"'/pkg/manifest.json"}}')" ask

hook_check "phase-gate denies a Bash rm outside the task folder during research/plan" \
  "$(hook_run "$PHASE_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"rm '"$hook_real"'/src/other/scratch.txt"}}')" deny

hook_check "path-escalate denies a Bash git rm of a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"git rm -r --cached '"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a Bash git checkout -- of a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"git checkout -- '"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate allows a bare git checkout <branch> (disclosed non-goal, no -- present)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"git checkout main"}}')" allow

hook_check "path-escalate denies a Bash git restore of a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"git restore --staged '"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate allows a Bash mv whose destination filename merely contains \"rm\" as a substring (not an rm invocation)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"mv '"$hook_real"'/src/other/a.txt '"$hook_real"'/src/other/some-rm-thing.txt"}}')" allow

# ---------------------------------------------------------------------------
# fuzz: property-based coverage for _workspace-route's path functions
# ---------------------------------------------------------------------------
# Round 5. Four rounds of hand-picked adversarial scenarios found six
# distinct hooks bypass mechanisms (../, symlink, alias mismatch, dep-gate's
# missing Bash branch, a bash-3.2 empty-array crash, NFC/NFD) — one new
# mechanism almost every round, including a genuine bug inside the shared
# normalizer itself (round 4) that three prior rounds of hand-testing never
# tried. Rather than add another hand-picked scenario, this generates a
# large corpus of randomized path strings (varying segment count, ./..
# density, leading/trailing/doubled slashes, empty segments, non-ASCII in
# both NFC and NFD form, absolute vs. relative) and asserts invariants that
# must hold regardless of input shape, independent of any specific bug
# anyone has thought to check for.
#
# python3 generates the corpus (already an accepted core-selftest/_wsr_nfc
# dependency, same graceful-fallback posture: a smaller bash-only corpus if
# python3 isn't on PATH, never a hard failure). The seed is fixed
# (20260823) deliberately, not truly randomized per run — this is wired in
# as a permanent regression case, and a fixed corpus that fails
# reproducibly is more valuable here than a different one every run that
# can't be re-run to confirm a fix. The corpus includes explicit copies of
# every prior round's own trigger shape (a root-cancelling ../ chain, a
# relative "project"-shaped string, a bare empty string, all-slash strings)
# alongside genuine random generation, so a regression of any prior finding
# is caught by this section even before the random half runs at all.
#
# Every fuzz section runs under a bounded background job (same
# fork+poll+kill pattern as hook_run_bounded, since neither timeout nor
# gtimeout exists on this host) so a reintroduced runaway hangs the section
# for at most its bound, not the whole suite indefinitely — the section
# then fails loudly ("hung past Ns") instead of the run just never
# finishing. Bounds are sized generously (5-10x a clean run's observed
# time on this host) so ordinary machine slowness doesn't false-positive.
#
# Unlike the rest of this "hooks:" section (which execs phase-gate/
# path-escalate/dep-gate as real subprocesses via hook_run/hook_run_bounded),
# fuzzing calls _workspace-route's own functions directly in-process — the
# whole point is exercising _wsr_collapse/_wsr_realpath/_wsr_glob_eq/
# workspace_route themselves, not a hook wrapper around them — so this file
# needs its own `source`, never implicitly inherited from anywhere else.
source "$SCRIPT_DIR/../hooks/_workspace-route"
declare -F workspace_route >/dev/null || { echo "core-selftest: _workspace-route did not load — cannot run the fuzz section" >&2; exit 1; }

_wsr_fuzz_gen_paths() {
  # _wsr_fuzz_gen_paths <n> -> n path strings on stdout, one per line.
  local n="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$n" <<'PYEOF'
import random, sys
random.seed(20260823)
n = int(sys.argv[1])
segs_pool = ["a", "bb", "ccc", "d.e", "x-y", "z_1", "..", ".", "",
             "café", "日本語", "🎉", "emoji😀name", "a..b", "...",
             "  spaced  ", "a b", "-", "~"]
def rand_path():
    depth = random.randint(0, 10)
    parts = [random.choice(segs_pool) for _ in range(depth)]
    lead = random.choice(["", "/", "//", "///"])
    trail = random.choice(["", "/", "//"])
    return (lead + "/".join(parts) + trail).replace("\n", " ")
edge_cases = [
    "", "/", "..", "../..", ".", "./.", "/./../", "//////",
    "///a///b///", "/" + "../"*30 + "etc/passwd", "../"*30 + "etc/passwd",
    "a/" + "../"*5, "/a/b/../../../../..", "proj", "proj/work/T1",
]
out = list(edge_cases)
for _ in range(max(0, n - len(edge_cases))):
    out.append(rand_path())
for p in out:
    print(p)
PYEOF
  else
    local i j depth parts pool=("a" "bb" ".." "." "" "x-y" "z_1")
    printf '%s\n' "" "/" ".." "../.." "." "proj" "proj/work/T1"
    for ((i = 0; i < n; i++)); do
      depth=$((RANDOM % 6)); parts=""
      for ((j = 0; j < depth; j++)); do
        parts+="/${pool[$((RANDOM % ${#pool[@]}))]}"
      done
      [[ $((RANDOM % 2)) -eq 0 ]] && printf '%s\n' "$parts" || printf '%s\n' "${parts#/}"
    done
  fi
}

fuzz_run_bounded() {
  # fuzz_run_bounded <label> <bound-seconds> <body-fn> — runs <body-fn> in a
  # backgrounded subshell (so a hang can be killed rather than blocking the
  # suite), captures its stdout, and reports one aggregated pass/fail via
  # the suite's own fail()/pass(). <body-fn> must print exactly one
  # "FUZZSUMMARY: pass=<n> fail=<n>" line, plus one "FUZZDETAIL: <msg>" line
  # per failing case (subshell state doesn't propagate to the parent, so
  # aggregation happens here by parsing that output, not by touching
  # $overall/$fail_count from inside the background job).
  local label="$1" bound="$2" fn="$3" outfile pid waited=0
  outfile="$(mktemp "$tmp_root/fuzzout.XXXXXX")"
  # The subshell's own exit status must always be 0, deliberately — same
  # trick hook_run_bounded already uses, for the same reason: if <body-fn>
  # itself crashes (set -e killing it mid-loop on a reintroduced bug —
  # exactly the negative-control scenario this section exists to catch),
  # a bare `( "$fn" ... ) &` would propagate that non-zero status through
  # `wait "$pid"` below and kill this *entire suite* under its own set -e,
  # with no FAIL line and no indication which section crashed or why —
  # confirmed by direct negative control (reverting the _wsr_collapse fix
  # this section exists to guard) before this echo-wrap was added: exit
  # 1, zero output, no diagnostic. The echo-wrapped exit code is written
  # but intentionally unused below — a crash is instead detected the same
  # way a clean "fail=N>0" run is, via the missing/malformed FUZZSUMMARY
  # line, which is a strictly more informative signal than a bare exit code.
  ( "$fn" >"$outfile" 2>&1; echo "$?" >"$outfile.code" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt $bound ]]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null || true
    fail "fuzz: $label hung past ${bound}s — treating as a runaway, not a slow-but-correct pass"
    return
  fi
  wait "$pid" 2>/dev/null || true
  local summary details
  # `|| true` on both: grep exits 1 on zero matches (pipefail then propagates
  # that through `| head`/`| tail`), and under this script's own set -e that
  # would silently kill the suite on the *good* outcome (zero FUZZDETAIL
  # lines, i.e. every case passed) — the exact bug class round 3's
  # ledger-field-audit fix already named once (a zero-match grep dying
  # under set -e), reproduced here while building this round's own fuzz
  # harness and caught by actually running it, not by review.
  summary="$(grep '^FUZZSUMMARY:' "$outfile" | tail -1)" || true
  details="$(grep '^FUZZDETAIL:' "$outfile" | head -10)" || true
  if [[ -z "$summary" ]]; then
    fail "fuzz: $label produced no summary line (crashed? see $outfile)"
    return
  fi
  if [[ "$summary" == *"fail=0"* ]]; then
    pass "fuzz: $label — ${summary#FUZZSUMMARY: }"
  else
    fail "fuzz: $label — ${summary#FUZZSUMMARY: }"$'\n'"$details"
  fi
}

_wsr_fuzz_collapse_body() {
  # Invariants (never dependent on knowing any specific bug in advance):
  #   1. never returns empty (always at least "/")
  #   2. idempotent: collapse(collapse(x)) == collapse(x)
  #   3. output never contains a "." or ".." path segment
  local n=0 fails=0 input result result2 part bad_seg
  local -a parts
  while IFS= read -r input; do
    n=$((n + 1))
    result="$(_wsr_collapse "$input" 2>&1)"
    if [[ -z "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse('$input') returned empty (want at least '/')"
      continue
    fi
    result2="$(_wsr_collapse "$result" 2>&1)"
    if [[ "$result2" != "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse not idempotent: collapse('$input')='$result' but collapse(that)='$result2'"
      continue
    fi
    bad_seg=0
    IFS='/' read -ra parts <<<"$result"
    for part in "${parts[@]:-}"; do
      [[ "$part" == '.' || "$part" == '..' ]] && bad_seg=1
    done
    if [[ "$bad_seg" -eq 1 ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse('$input') = '$result' still contains a . or .. segment"
    fi
  done < <(_wsr_fuzz_gen_paths 3000)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_realpath_body() {
  # Invariant: never hangs (bounded by the caller) and always terminates
  # with *some* string — this is the function whose unbounded recursion
  # produced round 4's multi-thousand-process runaway, so "terminates at
  # all, within the bounded wrapper" is itself the load-bearing check here,
  # not any particular return value (there's no single "correct" realpath
  # for an arbitrary, mostly-nonexistent fuzzed string).
  local n=0 fails=0 input result
  while IFS= read -r input; do
    n=$((n + 1))
    result="$(_wsr_realpath "$input" 2>&1)"
    if [[ -z "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_realpath('$input') returned empty"
    fi
  done < <(_wsr_fuzz_gen_paths 800)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_route_body() {
  # Invariant: WSR_OWNER_ROOT is always either the empty string or an
  # absolute path — never anything else, regardless of how malformed
  # $file_path is (including deliberately relative/empty $project values,
  # which must fail closed per workspace_route's own precondition check
  # rather than ever producing a non-absolute WSR_OWNER_ROOT).
  local real_proj n=0 fails=0 fp proj_choice proj
  real_proj="$(mktemp -d "$tmp_root/wsrfuzzproj.XXXXXX")"
  mkdir -p "$real_proj/.spine" "$real_proj/work/T1"
  while IFS= read -r fp; do
    n=$((n + 1))
    proj_choice=$((n % 3))
    case "$proj_choice" in
      0) proj="$real_proj" ;;
      1) proj="relative-proj-$n" ;;
      2) proj="" ;;
    esac
    # `|| true`: workspace_route deliberately returns 1 (fail-closed) for
    # the relative/empty $proj cases this loop intentionally generates —
    # under this script's set -e a bare non-zero return here would abort
    # the whole fuzz body on the very first such case instead of letting
    # every case run; the invariant under test is WSR_OWNER_ROOT's shape
    # regardless of workspace_route's own return code.
    workspace_route "$proj" "$fp" >/dev/null 2>&1 || true
    if [[ -n "$WSR_OWNER_ROOT" ]]; then
      case "$WSR_OWNER_ROOT" in
        /*) : ;;
        *)
          fails=$((fails + 1))
          echo "FUZZDETAIL: workspace_route(project='$proj', file_path='$fp') left WSR_OWNER_ROOT='$WSR_OWNER_ROOT' non-absolute"
          ;;
      esac
    fi
  done < <(_wsr_fuzz_gen_paths 800)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_globeq_body() {
  # Invariant: _wsr_glob_eq's result must not depend on which of the two
  # sides (rel, glob) happens to be in NFC vs. NFD form — all four
  # combinations of a name compared against itself must agree. Smaller
  # corpus than the others (each case pays two real python3 subprocess
  # calls to build the NFC/NFD forms), but breadth here is about covering
  # a variety of real accented/CJK/emoji shapes, not path-structure
  # combinatorics. Skipped entirely if python3 isn't on PATH, matching
  # _wsr_nfc's own fallback (byte comparison only, disclosed limit).
  local n=0 fails=0 base nfc nfd r1 r2 r3 r4
  if ! command -v python3 >/dev/null 2>&1; then
    echo "FUZZSUMMARY: pass=0 fail=0 (of 0 cases) — SKIPPED, no python3 on PATH"
    return
  fi
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    n=$((n + 1))
    nfc="$(python3 -c "import unicodedata,sys; sys.stdout.write(unicodedata.normalize('NFC', sys.argv[1]))" "$base")"
    nfd="$(python3 -c "import unicodedata,sys; sys.stdout.write(unicodedata.normalize('NFD', sys.argv[1]))" "$base")"
    r1=0; r2=0; r3=0; r4=0
    _wsr_glob_eq "$nfc" "$nfc" && r1=1
    _wsr_glob_eq "$nfc" "$nfd" && r2=1
    _wsr_glob_eq "$nfd" "$nfc" && r3=1
    _wsr_glob_eq "$nfd" "$nfd" && r4=1
    if [[ "$r1" -ne 1 || "$r2" -ne 1 || "$r3" -ne 1 || "$r4" -ne 1 ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_glob_eq asymmetric for '$base': nfc/nfc=$r1 nfc/nfd=$r2 nfd/nfc=$r3 nfd/nfd=$r4 (all should be 1)"
    fi
  done < <(printf '%s\n' "café" "naïve" "Zürich" "日本語ファイル" "emoji😀name" "ÀÉÎÕÜ" "áb́c" "xéy" "plain" "has space é" "Café's file" "İstanbul" "north's café" "🏳️‍🌈flag" "über" "façade" "señor" "coöperate" "résumé" "naïve café")
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

fuzz_run_bounded "_wsr_collapse: never-empty, idempotent, no ./.. segments (3000 generated cases)" 60 _wsr_fuzz_collapse_body
fuzz_run_bounded "_wsr_realpath: always terminates with a non-empty result (800 generated cases)" 90 _wsr_fuzz_realpath_body
fuzz_run_bounded "workspace_route: WSR_OWNER_ROOT always empty-or-absolute (800 generated cases)" 90 _wsr_fuzz_route_body
fuzz_run_bounded "_wsr_glob_eq: NFC/NFD-symmetric (20 real accented/CJK/emoji names)" 60 _wsr_fuzz_globeq_body

# ---------------------------------------------------------------------------
# second-approver-check: Class 2's second-approver gate
# ---------------------------------------------------------------------------
# Round 5's audit flagged core/scripts/* test coverage as a standing gap
# (17 scripts, zero permanent coverage, five consecutive rounds). Rather
# than either close all 17 or defer a sixth time, this closes coverage for
# the two whose silent failure would matter most: this script gates a real
# approval decision (an unnoticed regression here means Class 2 work ships
# without a genuine second approver), contract-touch below gates cross-repo
# blast-radius/breaking-change classification.

SECOND_APPROVER_CHECK="$SCRIPT_DIR/second-approver-check"

sac_fixture() {
  # sac_fixture <owner> [<approval.json-body>] -> "<project>"
  local owner="$1" body="${2:-}" proj
  proj="$(mktemp -d "$tmp_root/sacproj.XXXXXX")"
  mkdir -p "$proj/work/SAC1"
  printf '%s' "$owner" >"$proj/work/SAC1/owner"
  [[ -n "$body" ]] && printf '%s' "$body" >"$proj/work/SAC1/approval.json"
  printf '%s' "$proj"
}

sac_run() {
  # sac_run <project> -> "<exit>|<output>"
  local proj="$1" out code=0
  out="$("$SECOND_APPROVER_CHECK" SAC1 --project "$proj" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

sac_check() {
  # sac_check <desc> <result> <expect-exit> <expect-substring>
  local desc="$1" result="$2" expect_exit="$3" expect_sub="$4" code="${2%%|*}" out="${2#*|}"
  if [[ "$code" == "$expect_exit" && "$out" == *"$expect_sub"* ]]; then
    pass "second-approver-check: $desc"
  else
    fail "second-approver-check: $desc (expected exit=$expect_exit containing '$expect_sub', got exit=$code: $out)"
  fi
}

sac_check "no approval.json -> HALT" \
  "$(sac_run "$(sac_fixture "alice")")" 1 "no approval.json"

sac_check "approval.json with no approver field -> HALT" \
  "$(sac_run "$(sac_fixture "alice" '{}')")" 1 "no 'approver' field"

sac_check "approver == owner, no override -> HALT" \
  "$(sac_run "$(sac_fixture "alice" '{"approver":"alice"}')")" 1 "same identity as owner"

sac_check "approver == owner, override:true -> PROCEED, reason echoed" \
  "$(sac_run "$(sac_fixture "alice" '{"approver":"alice","override":true,"override_reason":"solo project"}')")" 0 "solo project"

sac_check "real second approver -> PROCEED" \
  "$(sac_run "$(sac_fixture "alice" '{"approver":"bob"}')")" 0 "real second approver on record: bob"

sac_check "missing owner file -> exit 2 (can't evaluate, not a halt)" \
  "$(sac_run "$(mktemp -d "$tmp_root/sacproj.XXXXXX")")" 2 ""

# Negative control: temporarily invert the self-approval identity check
# (the specific line this coverage exists to guard) and confirm the
# regression case above actually fails without it — a test that only ever
# passes isn't evidence, per every prior round's own standing lesson.
sac_negctrl_backup="$(mktemp "$tmp_root/sac-negctrl.XXXXXX")"
cp "$SECOND_APPROVER_CHECK" "$sac_negctrl_backup"
sed -i.bak 's/"\$approver" == "\$owner"/"$approver" != "$owner"/' "$SECOND_APPROVER_CHECK"
rm -f "$SECOND_APPROVER_CHECK.bak"
negctrl_result="$(sac_run "$(sac_fixture "alice" '{"approver":"alice"}')")"
cp "$sac_negctrl_backup" "$SECOND_APPROVER_CHECK"
if [[ "${negctrl_result%%|*}" != "1" ]]; then
  pass "second-approver-check: negative control confirms the self-approval case above is meaningful (fails without the real check)"
else
  fail "second-approver-check: negative control did NOT fail as expected — the self-approval regression case may be vacuous"
fi

# ---------------------------------------------------------------------------
# contract-touch: additive/breaking classification, blast radius, registry
# staleness
# ---------------------------------------------------------------------------

CONTRACT_TOUCH="$SCRIPT_DIR/contract-touch"

new_contract_touch_fixture() {
  # new_contract_touch_fixture <producer-file-matches-glob:yes|no> ->
  # "<workspace-root>|<producer-repo>". "no" seeds the producer repo with a
  # committed file that does NOT match producer_paths, while workspace.json
  # still records producer_paths_match_count:1 — a registry that's already
  # stale before this task's own diff, isolating registry-staleness
  # detection from spec/producer-touch detection (which a fresh, matching
  # fixture would otherwise conflate: removing the one matching file to
  # drive the count to zero also shows up as a producer-touched change).
  local matches="$1" ws producer producer_file
  ws="$(mktemp -d "$tmp_root/ctws.XXXXXX")"
  producer="$(mktemp -d "$tmp_root/ctproducer.XXXXXX")"

  git init -q "$producer"
  git -C "$producer" config user.email "core-selftest@example.com"
  git -C "$producer" config user.name "core-selftest"
  mkdir -p "$producer/src/routes"
  if [[ "$matches" == "yes" ]]; then
    producer_file="$producer/src/routes/items.ts"
  else
    producer_file="$producer/src/routes/other.ts"
  fi
  echo "export const items = {}" >"$producer_file"
  git -C "$producer" add -A
  git -C "$producer" commit -q -m seed

  git init -q "$ws"
  git -C "$ws" config user.email "core-selftest@example.com"
  git -C "$ws" config user.name "core-selftest"
  mkdir -p "$ws/contracts/items-api"
  cat >"$ws/contracts/items-api/spec.md" <<'SPECEOF'
# items-api

- GET /items returns a list of items
- POST /items creates an item
SPECEOF
  cat >"$ws/workspace.json" <<WSEOF
{
  "repos": [
    {"name": "producer", "path": "$producer", "role": "producer"}
  ],
  "contracts": [
    {
      "name": "items-api",
      "producer": "producer",
      "producer_paths": ["src/routes/items.*"],
      "producer_paths_match_count": 1,
      "consumers": ["consumer-app"],
      "spec_path": "contracts/items-api/spec.md",
      "registered": "2026-08-01"
    }
  ]
}
WSEOF
  git -C "$ws" add -A
  git -C "$ws" commit -q -m seed
  printf '%s|%s' "$ws" "$producer"
}

ct_run() {
  # ct_run <workspace-root> -> "<exit>|<out-json-path>"
  local ws="$1" out code=0
  out="$tmp_root/ct-$$-$RANDOM.json"
  ( cd "$ws" && "$CONTRACT_TOUCH" --out "$out" >/dev/null 2>&1 ) || code=$?
  printf '%s|%s' "$code" "$out"
}

ct_field() { jq -r --arg n "$2" '.touched_contracts[] | select(.name==$n) | .[$3]' "$1" --arg n "items-api" 2>/dev/null; }

# Case A: spec.md changed with only additions (pure append) -> additive,
# spec_touched, touched, consumer enters blast radius.
ctf="$(new_contract_touch_fixture yes)"; ws="${ctf%%|*}"
echo "- DELETE /items removes an item" >>"$ws/contracts/items-api/spec.md"
r="$(ct_run "$ws")"; ct_out="${r#*|}"
spec_change="$(jq -r '.touched_contracts[0].spec_change' "$ct_out" 2>/dev/null)"
blast="$(jq -r '.consumers_in_blast_radius | join(",")' "$ct_out" 2>/dev/null)"
if [[ "$spec_change" == "additive" && "$blast" == "consumer-app" ]]; then
  pass "contract-touch: pure-addition spec change classified additive, consumer enters blast radius"
else
  fail "contract-touch: pure-addition spec change -> expected additive/consumer-app, got spec_change=$spec_change blast=$blast ($ct_out)"
fi

# Case B: spec.md changed with a removed/modified line -> breaking.
ctf="$(new_contract_touch_fixture yes)"; ws="${ctf%%|*}"
sed -i.bak 's/GET \/items returns a list of items/GET \/items returns a paginated list of items/' "$ws/contracts/items-api/spec.md"
rm -f "$ws/contracts/items-api/spec.md.bak"
r="$(ct_run "$ws")"; ct_out="${r#*|}"
spec_change="$(jq -r '.touched_contracts[0].spec_change' "$ct_out" 2>/dev/null)"
if [[ "$spec_change" == "breaking" ]]; then
  pass "contract-touch: modified spec line classified breaking"
else
  fail "contract-touch: modified spec line -> expected breaking, got spec_change=$spec_change ($ct_out)"
fi

# Case C: producer's own producer_paths file changed, spec untouched ->
# touched via producer_touched alone, spec_change stays "unchanged".
ctf="$(new_contract_touch_fixture yes)"; ws="${ctf%%|*}"; producer="${ctf#*|}"
echo "export const items = { v2: true }" >>"$producer/src/routes/items.ts"
r="$(ct_run "$ws")"; ct_out="${r#*|}"
spec_touched="$(jq -r '.touched_contracts[0].spec_touched' "$ct_out" 2>/dev/null)"
producer_touched="$(jq -r '.touched_contracts[0].producer_touched' "$ct_out" 2>/dev/null)"
spec_change="$(jq -r '.touched_contracts[0].spec_change' "$ct_out" 2>/dev/null)"
if [[ "$spec_touched" == "false" && "$producer_touched" == "true" && "$spec_change" == "unchanged" ]]; then
  pass "contract-touch: producer-path-only change detected, spec_change stays unchanged"
else
  fail "contract-touch: producer-only change -> expected spec_touched=false producer_touched=true spec_change=unchanged, got spec_touched=$spec_touched producer_touched=$producer_touched spec_change=$spec_change ($ct_out)"
fi

# Case D: registry already stale (producer_paths_match_count:1 registered,
# but the committed producer file doesn't match producer_paths at all) with
# NO other change anywhere -> registry_stale alone drives touched=true.
ctf="$(new_contract_touch_fixture no)"; ws="${ctf%%|*}"
r="$(ct_run "$ws")"; ct_out="${r#*|}"
# `if . == null then ... else . end`, not `// "missing"` — jq's `//`
# treats a present `false` as falsy too (the same gotcha round 2 already
# hit for smoke_in_floor), which would otherwise silently rewrite the
# very `false` values this case exists to check into the string "missing".
registry_stale="$(jq -r '.touched_contracts[0].registry_stale | if . == null then "missing" else . end' "$ct_out" 2>/dev/null)"
spec_touched="$(jq -r '.touched_contracts[0].spec_touched | if . == null then "missing" else . end' "$ct_out" 2>/dev/null)"
producer_touched="$(jq -r '.touched_contracts[0].producer_touched | if . == null then "missing" else . end' "$ct_out" 2>/dev/null)"
if [[ "$registry_stale" == "true" && "$spec_touched" == "false" && "$producer_touched" == "false" ]]; then
  pass "contract-touch: a stale registry alone (no other change) still marks the contract touched"
else
  fail "contract-touch: stale registry -> expected registry_stale=true with spec/producer_touched both false, got registry_stale=$registry_stale spec_touched=$spec_touched producer_touched=$producer_touched ($ct_out)"
fi

# Case E: control — nothing touched, registry current -> empty
# touched_contracts and empty blast radius.
ctf="$(new_contract_touch_fixture yes)"; ws="${ctf%%|*}"
r="$(ct_run "$ws")"; ct_out="${r#*|}"
touched_count="$(jq -r '.touched_contracts | length' "$ct_out" 2>/dev/null)"
blast_count="$(jq -r '.consumers_in_blast_radius | length' "$ct_out" 2>/dev/null)"
if [[ "$touched_count" == "0" && "$blast_count" == "0" ]]; then
  pass "contract-touch: control — nothing touched, registry current -> empty touched_contracts and blast radius"
else
  fail "contract-touch: control -> expected 0/0, got touched_count=$touched_count blast_count=$blast_count ($ct_out)"
fi

# Case F: no workspace.json at $project -> exit 2, informational-only
# script fails closed on its own precondition rather than silently no-op.
ct_nows="$(mktemp -d "$tmp_root/ctnows.XXXXXX")"
ct_nows_code=0
( cd "$ct_nows" && "$CONTRACT_TOUCH" >/dev/null 2>&1 ) || ct_nows_code=$?
if [[ "$ct_nows_code" == "2" ]]; then
  pass "contract-touch: no workspace.json -> exit 2"
else
  fail "contract-touch: no workspace.json -> expected exit 2, got $ct_nows_code"
fi

# Case G: malformed (non-JSON) workspace.json -> exit 2.
ct_badjson="$(mktemp -d "$tmp_root/ctbadjson.XXXXXX")"
echo "not json" >"$ct_badjson/workspace.json"
ct_badjson_code=0
( cd "$ct_badjson" && "$CONTRACT_TOUCH" >/dev/null 2>&1 ) || ct_badjson_code=$?
if [[ "$ct_badjson_code" == "2" ]]; then
  pass "contract-touch: malformed workspace.json -> exit 2"
else
  fail "contract-touch: malformed workspace.json -> expected exit 2, got $ct_badjson_code"
fi

# Negative control: temporarily disable the breaking-vs-additive awk
# heuristic (force it to always report additive) and confirm case B above
# actually fails without it.
ct_negctrl_backup="$(mktemp "$tmp_root/ct-negctrl.XXXXXX")"
cp "$CONTRACT_TOUCH" "$ct_negctrl_backup"
sed -i.bak "s/if awk '\/\^@@\/{p=1; next} p \&\& \/\^-\/{f=1} END{exit !f}' <<<\"\$diff_out\"; then/if false; then/" "$CONTRACT_TOUCH"
rm -f "$CONTRACT_TOUCH.bak"
ctf="$(new_contract_touch_fixture yes)"; ws="${ctf%%|*}"
sed -i.bak 's/GET \/items returns a list of items/GET \/items returns a paginated list of items/' "$ws/contracts/items-api/spec.md"
rm -f "$ws/contracts/items-api/spec.md.bak"
negctrl_result="$(ct_run "$ws")"
negctrl_spec_change="$(jq -r '.touched_contracts[0].spec_change' "${negctrl_result#*|}" 2>/dev/null)"
cp "$ct_negctrl_backup" "$CONTRACT_TOUCH"
if [[ "$negctrl_spec_change" != "breaking" ]]; then
  pass "contract-touch: negative control confirms the breaking-classification case above is meaningful (fails without the real check)"
else
  fail "contract-touch: negative control did NOT fail as expected — the breaking-classification case may be vacuous"
fi

# ---------------------------------------------------------------------------
# claims-check: the write/write vs write/read vs read/read asymmetric
# collision matrix, done-task exclusion, and --diff DECLARED/UNDECLARED
# tagging
# ---------------------------------------------------------------------------
# Second batch of round-5's scripts-coverage backlog closure (see the
# second-approver-check/contract-touch section above for why these two
# were picked next: both run on every real task's ship-time re-grounding
# sequence, so a silent regression here would matter on every real ship).

CLAIMS_CHECK="$SCRIPT_DIR/claims-check"

cc_task() {
  # cc_task <proj> <task-id> <state> <owner> <claims-json-body>
  local proj="$1" tid="$2" state="$3" owner="$4" body="$5"
  mkdir -p "$proj/work/$tid"
  printf '%s' "$state" >"$proj/work/$tid/state"
  printf '%s' "$owner" >"$proj/work/$tid/owner"
  printf '%s' "$body" >"$proj/work/$tid/claims.json"
}

cc_run() {
  # cc_run <proj> <self-id> [extra-args...] -> "<exit>|<output>"
  local proj="$1" self="$2"; shift 2
  local out code=0
  out="$("$CLAIMS_CHECK" "$self" --project "$proj" --no-pull "$@" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

# Case A: write/write — both tasks predict touching the same path -> BLOCK.
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":["src/a.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":["src/a.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"write/write with OTHER"* ]]; then
  pass "claims-check: write/write collision blocks"
else
  fail "claims-check: write/write collision -> expected exit=1 'write/write with OTHER', got $r"
fi

# Case B: write/read — self predicts writing a path the other task's
# research grounds on -> BLOCK (either direction is a real collision, not
# just the one this task initiates).
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":["src/b.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":[],"grounding_files":["src/b.ts"],"grounding_decisions":[],"contracts":[]}'
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"write/read with OTHER"* ]]; then
  pass "claims-check: write/read collision blocks (self writes what other reads)"
else
  fail "claims-check: write/read collision -> expected exit=1 'write/read with OTHER', got $r"
fi

# Case C: read/read — both merely ground on the same file, neither writes
# it -> WARN only, never blocks. This is the specific asymmetry the
# script's own header calls "the whole reason this is usable in a real
# codebase" — blocking on shared reads would make it unusable.
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":[],"grounding_files":["src/c.ts"],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":[],"grounding_files":["src/c.ts"],"grounding_decisions":[],"contracts":[]}'
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"read/read with OTHER"* && "${r#*|}" == *"clear"* ]]; then
  pass "claims-check: read/read overlap warns but does not block"
else
  fail "claims-check: read/read overlap -> expected exit=0 with a read/read warning and still 'clear', got $r"
fi

# Case D: a task in "done" state is excluded from the comparison entirely
# — a real collision against closed work must not block.
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":["src/d.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER done bob '{"predicted_touch":["src/d.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"clear"* ]]; then
  pass "claims-check: a done task's claims are excluded from the collision check"
else
  fail "claims-check: done-task exclusion -> expected exit=0 'clear' (OTHER is done), got $r"
fi

# Case E: no overlap anywhere -> clear, exit 0.
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":["src/e1.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":["src/e2.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"clear"* ]]; then
  pass "claims-check: control — no overlap at all -> clear"
else
  fail "claims-check: control -> expected exit=0 'clear', got $r"
fi

# Case F: missing self claims.json -> exit 2 (can't evaluate).
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
mkdir -p "$proj/work/ME"
r="$(cc_run "$proj" ME)"
if [[ "${r%%|*}" == "2" ]]; then
  pass "claims-check: missing self claims.json -> exit 2"
else
  fail "claims-check: missing self claims.json -> expected exit 2, got $r"
fi

# Case G: --diff mode. self's real (uncommitted) diff touches a path never
# in its own declared predicted_touch — the "narrow-claims defeat" the
# --diff mode exists to catch — colliding with another open task's own
# predicted_touch -> BLOCK, tagged [UNDECLARED]. A second path IS in the
# declared set and also collides -> tagged [DECLARED].
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
git init -q "$proj"
git -C "$proj" config user.email "core-selftest@example.com"
git -C "$proj" config user.name "core-selftest"
mkdir -p "$proj/src"
echo "seed" >"$proj/src/declared.ts"
echo "seed" >"$proj/src/undeclared.ts"
git -C "$proj" add -A
git -C "$proj" commit -q -m seed
cc_task "$proj" ME open alice '{"predicted_touch":["src/declared.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":["src/declared.ts","src/undeclared.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
echo "changed" >>"$proj/src/declared.ts"
echo "changed" >>"$proj/src/undeclared.ts"
r="$(cc_run "$proj" ME --diff HEAD)"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"[UNDECLARED"* && "${r#*|}" == *"[DECLARED]"* ]]; then
  pass "claims-check --diff: tags a real-diff collision outside declared claims UNDECLARED, and one inside declared claims DECLARED"
else
  fail "claims-check --diff: expected exit=1 with both [UNDECLARED and [DECLARED] present, got $r"
fi

# Negative control: temporarily disable the write/write blocking append
# (the specific asymmetry Case A/C above exist to guard — the script's own
# header calls it "the whole reason this is usable in a real codebase")
# and confirm Case A actually fails without it.
cc_negctrl_backup="$(mktemp "$tmp_root/cc-negctrl.XXXXXX")"
cp "$CLAIMS_CHECK" "$cc_negctrl_backup"
sed -i.bak "s/blocking+=(\"write\/write with/warnings+=(\"write\/write with/" "$CLAIMS_CHECK"
rm -f "$CLAIMS_CHECK.bak"
proj="$(mktemp -d "$tmp_root/ccproj.XXXXXX")"
cc_task "$proj" ME open alice '{"predicted_touch":["src/a.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
cc_task "$proj" OTHER open bob '{"predicted_touch":["src/a.ts"],"grounding_files":[],"grounding_decisions":[],"contracts":[]}'
negctrl_result="$(cc_run "$proj" ME)"
cp "$cc_negctrl_backup" "$CLAIMS_CHECK"
if [[ "${negctrl_result%%|*}" != "1" ]]; then
  pass "claims-check: negative control confirms the write/write blocking case above is meaningful (fails without the real check)"
else
  fail "claims-check: negative control did NOT fail as expected — the write/write blocking case may be vacuous"
fi

# ---------------------------------------------------------------------------
# check-stale: grounding-file drift, quarantine banner, own-task-folder
# exemption, and grounding-decisions status/content drift (including the
# specific disclosed fix: a decision already superseded at citation time is
# NOT drift, even though it reads "superseded" on both sides forever)
# ---------------------------------------------------------------------------

CHECK_STALE="$SCRIPT_DIR/check-stale"
DECISION_HASH="$SCRIPT_DIR/decision-hash"

new_check_stale_fixture() {
  # -> "<proj>|<sha-of-initial-commit>". Initial commit has:
  #   src/grounded.ts               — a plain grounding file
  #   docs/decisions/D-1-adopted.md — Status: adopted
  #   docs/decisions/D-2-superseded.md — Status: superseded (from the start)
  local proj sha
  proj="$(mktemp -d "$tmp_root/csproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/src" "$proj/docs/decisions" "$proj/work/T1"
  echo "seed" >"$proj/src/grounded.ts"
  cat >"$proj/docs/decisions/D-1-adopted.md" <<'EOF'
# D-1: adopted decision

- Status: adopted

## Context
Original context.

## Decision
Original decision.
EOF
  cat >"$proj/docs/decisions/D-2-superseded.md" <<'EOF'
# D-2: already-superseded decision

- Status: superseded

## Context
This was already superseded before any research cited it.

## Decision
Use D-3 instead.
EOF
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  sha="$(git -C "$proj" rev-parse HEAD)"
  printf '%s|%s' "$proj" "$sha"
}

cs_write_research() {
  # cs_write_research <path> <sha> <files-yaml-block> [<decisions-yaml-block>]
  local path="$1" sha="$2" files_block="$3" dec_block="${4:-}"
  {
    echo "<!-- spine:research"
    echo "sha: $sha"
    echo "files:"
    printf '%s\n' "$files_block"
    if [[ -n "$dec_block" ]]; then
      echo "grounding-decisions:"
      printf '%s\n' "$dec_block"
    fi
    echo "-->"
    echo ""
    echo "# Research"
    echo "Body text, unrelated to the header."
  } >"$path"
}

# Case A: control — nothing drifted -> ok, exit 0.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "0" && "$out" == *"ok:"* ]]; then
  pass "check-stale: control — nothing drifted -> ok"
else
  fail "check-stale: control -> expected exit=0 'ok:', got exit=$code: $out"
fi

# Case B: the cited grounding file changed since the cited sha -> STALE,
# and a quarantine banner is written into the document in place.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts"
echo "changed after research was written" >>"$cs_proj/src/grounded.ts"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "1" && "$out" == *"STALE"* ]] && grep -q '^> \*\*STALE\*\*' "$doc"; then
  pass "check-stale: a changed grounding file -> STALE, quarantine banner written into the doc"
else
  fail "check-stale: changed grounding file -> expected exit=1 STALE with a banner written, got exit=$code: $out (banner present: $(grep -c '^> \*\*STALE\*\*' "$doc" 2>/dev/null))"
fi

# Case C: re-running check-stale on an already-quarantined doc does not
# duplicate the banner.
code2=0
out2="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code2=$?
banner_count="$(grep -c '^> \*\*STALE\*\*' "$doc" 2>/dev/null || true)"
if [[ "$code2" == "1" && "$out2" == *"already present"* && "$banner_count" == "1" ]]; then
  pass "check-stale: re-running on an already-quarantined doc does not duplicate the banner"
else
  fail "check-stale: re-run on quarantined doc -> expected exit=1 'already present' with exactly 1 banner, got exit=$code2 banner_count=$banner_count: $out2"
fi

# Case D: own-task-folder exemption — a grounding file under the citing
# doc's own task folder (work/T1/) is skipped even though it changed after
# the cited sha; bookkeeping state under a task's own folder is expected
# to change over its lifetime by design.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
echo "original notes" >"$cs_proj/work/T1/notes.md"
cs_write_research "$doc" "$cs_sha" "  - work/T1/notes.md"
echo "notes updated after research, expected lifecycle churn" >>"$cs_proj/work/T1/notes.md"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "0" && "$out" == *"ok:"* ]]; then
  pass "check-stale: own-task-folder exemption — a changed file under the citing task's own folder is not drift"
else
  fail "check-stale: own-task-folder exemption -> expected exit=0 'ok:' despite the change, got exit=$code: $out"
fi

# Case E: a cited decision's status changed since citation (adopted ->
# implemented, live working-tree edit, uncommitted) -> STALE.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
d1_hash="$("$DECISION_HASH" "$cs_proj/docs/decisions/D-1-adopted.md")"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts" "  - D-1@$d1_hash"
sed -i.bak 's/- Status: adopted/- Status: implemented/' "$cs_proj/docs/decisions/D-1-adopted.md"
rm -f "$cs_proj/docs/decisions/D-1-adopted.md.bak"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "1" && "$out" == *"status changed since citation"* ]]; then
  pass "check-stale: a cited decision's status changing since citation -> STALE"
else
  fail "check-stale: decision status drift -> expected exit=1 'status changed since citation', got exit=$code: $out"
fi

# Case F: the disclosed fix this script's header specifically documents —
# a decision already 'superseded' AT THE CITED SHA (not merely superseded
# now) produces ZERO drift, no matter how many times this re-runs, because
# both readings ('status at cited sha' and 'status now') are identically
# 'superseded'. check-stale's ORIGINAL (buggy) design compared current
# status against the literal string 'superseded' and so permanently,
# unfixably quarantined any research correctly citing supersession
# history — this case is the permanent regression guard for that fix.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
d2_hash="$("$DECISION_HASH" "$cs_proj/docs/decisions/D-2-superseded.md")"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts" "  - D-2@$d2_hash"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "0" && "$out" == *"ok:"* ]]; then
  pass "check-stale: a decision already superseded at citation time is NOT drift (the disclosed original-design fix)"
else
  fail "check-stale: already-superseded-at-citation -> expected exit=0 'ok:' (no drift), got exit=$code: $out"
fi

# Case G: missing spine:research header -> exit 2.
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"
doc="$cs_proj/work/T1/research.md"
echo "# Research with no header at all" >"$doc"
code=0
out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || code=$?
if [[ "$code" == "2" ]]; then
  pass "check-stale: missing spine:research header -> exit 2"
else
  fail "check-stale: missing header -> expected exit 2, got exit=$code: $out"
fi

# Negative control: temporarily disable the status-at-cited-sha-vs-now
# comparison (force it to instead compare current status against the
# literal string 'superseded', the script's own documented ORIGINAL bug)
# and confirm Case F above actually fails under that reverted behavior —
# proof this regression guard is meaningful, not vacuous.
cs_negctrl_backup="$(mktemp "$tmp_root/cs-negctrl.XXXXXX")"
cp "$CHECK_STALE" "$cs_negctrl_backup"
sed -i.bak 's/elif \[\[ "\$status_at_citation" != "\$status" \]\]; then/elif [[ "$status" == "superseded" ]]; then/' "$CHECK_STALE"
rm -f "$CHECK_STALE.bak"
cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
d2_hash="$("$DECISION_HASH" "$cs_proj/docs/decisions/D-2-superseded.md")"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts" "  - D-2@$d2_hash"
negctrl_code=0
negctrl_out="$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1)" || negctrl_code=$?
cp "$cs_negctrl_backup" "$CHECK_STALE"
if [[ "$negctrl_code" != "0" ]]; then
  pass "check-stale: negative control confirms the already-superseded-at-citation case above is meaningful (fails under the original literal-'superseded' comparison)"
else
  fail "check-stale: negative control did NOT fail as expected — the already-superseded case may be vacuous"
fi

# ---------------------------------------------------------------------------
# registry-sync: commit-scope discipline (work/<task-id>/ only, never the
# rest of the tree) and the push / pull-rebase-retry sequence against a
# real local remote
# ---------------------------------------------------------------------------

REGISTRY_SYNC="$SCRIPT_DIR/registry-sync"

new_registry_sync_fixture() {
  # -> "<proj>" — git-initialized project, one commit, work/T1/ present.
  local proj
  proj="$(mktemp -d "$tmp_root/rsproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/work/T1" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

rs_run() {
  # rs_run <proj> <task-id> -> "<exit>|<output>"
  local proj="$1" tid="$2" out code=0
  out="$("$REGISTRY_SYNC" "$tid" --project "$proj" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

# Case A: no changes under work/T1/ -> nothing to commit, exit 0.
rs_proj="$(new_registry_sync_fixture)"
r="$(rs_run "$rs_proj" T1)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"nothing to commit"* ]]; then
  pass "registry-sync: no changes -> nothing to commit"
else
  fail "registry-sync: no changes -> expected exit=0 'nothing to commit', got $r"
fi

# Case B: a real change under work/T1/ -> committed, no remote configured
# -> exit 0 "committed locally only".
rs_proj="$(new_registry_sync_fixture)"
echo '{"owner":"alice"}' >"$rs_proj/work/T1/claims.json"
r="$(rs_run "$rs_proj" T1)"
committed_file="$(git -C "$rs_proj" show --name-only --pretty=format: HEAD 2>/dev/null | awk 'NF')"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"committed T1"* && "${r#*|}" == *"locally only"* && "$committed_file" == "work/T1/claims.json" ]]; then
  pass "registry-sync: a real change is committed, no remote -> 'locally only'"
else
  fail "registry-sync: real change, no remote -> expected exit=0 'committed T1'/'locally only' with work/T1/claims.json in the commit, got $r (committed: $committed_file)"
fi

# Case C: scope discipline — an unrelated dirty file elsewhere in the same
# working tree must stay uncommitted/unstaged after registry-sync runs.
# This is the specific property the script's own header calls out: during
# implement, this is the only thing that keeps a registry sync from
# accidentally committing an engineer's in-progress, unreviewed code.
rs_proj="$(new_registry_sync_fixture)"
echo '{"owner":"alice"}' >"$rs_proj/work/T1/claims.json"
echo "unrelated in-progress edit" >>"$rs_proj/src/app.js"
r="$(rs_run "$rs_proj" T1)"
app_js_status="$(git -C "$rs_proj" status --porcelain -- src/app.js)"
if [[ "${r%%|*}" == "0" && -n "$app_js_status" && "$app_js_status" == " M src/app.js" ]]; then
  pass "registry-sync: scope discipline — an unrelated dirty file elsewhere in the tree stays uncommitted"
else
  fail "registry-sync: scope discipline -> expected src/app.js still uncommitted (' M src/app.js'), got status='$app_js_status' ($r)"
fi

# Case D: task-id folder doesn't exist -> exit 2.
rs_proj="$(new_registry_sync_fixture)"
r="$(rs_run "$rs_proj" NOSUCHTASK)"
if [[ "${r%%|*}" == "2" ]]; then
  pass "registry-sync: missing task folder -> exit 2"
else
  fail "registry-sync: missing task folder -> expected exit 2, got $r"
fi

# Case E: project isn't a git repo -> exit 2.
rs_nongit="$(mktemp -d "$tmp_root/rsnongit.XXXXXX")"
mkdir -p "$rs_nongit/work/T1"
r="$(rs_run "$rs_nongit" T1)"
if [[ "${r%%|*}" == "2" ]]; then
  pass "registry-sync: project is not a git repo -> exit 2"
else
  fail "registry-sync: not a git repo -> expected exit 2, got $r"
fi

# Case F: a real local remote (bare repo), nothing else has changed it ->
# push succeeds cleanly, exit 0 "pushed".
rs_bare="$(mktemp -d "$tmp_root/rsbare.XXXXXX")"
git init -q --bare "$rs_bare"
rs_proj="$(new_registry_sync_fixture)"
rs_branch="$(git -C "$rs_proj" rev-parse --abbrev-ref HEAD)"
git -C "$rs_proj" remote add origin "$rs_bare"
git -C "$rs_proj" push -q -u origin "$rs_branch"
echo '{"owner":"alice"}' >"$rs_proj/work/T1/claims.json"
r="$(rs_run "$rs_proj" T1)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"pushed T1 to origin/$rs_branch"* ]]; then
  pass "registry-sync: a real local remote, no conflict -> pushed"
else
  fail "registry-sync: real remote, no conflict -> expected exit=0 'pushed T1 to origin/$rs_branch', got $r"
fi

# Case F2: a local branch tracking a differently-named remote branch (main
# tracking origin/master) pushes to the tracked branch and never creates a
# same-named one on the remote — the regression that created a stray
# origin/main. Then a remote with no tracking branch commits locally only.
rs_bare2="$(mktemp -d "$tmp_root/rsbare2.XXXXXX")"
git init -q --bare "$rs_bare2"
rs_proj2="$(new_registry_sync_fixture)"
git -C "$rs_proj2" remote add origin "$rs_bare2"
git -C "$rs_proj2" branch -M main
git -C "$rs_proj2" push -q -u origin main:master
echo '{"owner":"alice"}' >"$rs_proj2/work/T1/claims.json"
r="$(rs_run "$rs_proj2" T1)"
remote_heads="$(git -C "$rs_bare2" for-each-ref --format='%(refname:short)' refs/heads | sort | tr '\n' ' ')"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"pushed T1 to origin/master"* && "$remote_heads" == "master " ]]; then
  pass "registry-sync: local main tracking origin/master pushes to master and creates no stray origin/main"
else
  fail "registry-sync: tracked-branch push -> expected 'pushed T1 to origin/master' and only 'master' on the remote, got $r (remote branches: $remote_heads)"
fi

rs_bare3="$(mktemp -d "$tmp_root/rsbare3.XXXXXX")"
git init -q --bare "$rs_bare3"
rs_proj3="$(new_registry_sync_fixture)"
git -C "$rs_proj3" remote add origin "$rs_bare3"
git -C "$rs_proj3" config "branch.$(git -C "$rs_proj3" rev-parse --abbrev-ref HEAD).remote" origin
echo '{"owner":"alice"}' >"$rs_proj3/work/T1/claims.json"
r="$(rs_run "$rs_proj3" T1)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"no tracking branch"* && -z "$(git -C "$rs_bare3" for-each-ref refs/heads)" ]]; then
  pass "registry-sync: a remote with no tracking branch commits locally and pushes nothing"
else
  fail "registry-sync: no tracking branch -> expected exit 0 'no tracking branch' and an empty remote, got $r"
fi

# Case G: the shared mainline moved (a second engineer pushed an unrelated
# commit to origin) before this sync's own push — the initial push is
# rejected, registry-sync pulls --rebase and retries once, and (since the
# two commits touch different files, no real conflict) the retry succeeds.
rs_bare2="$(mktemp -d "$tmp_root/rsbare2.XXXXXX")"
git init -q --bare "$rs_bare2"
rs_proj="$(new_registry_sync_fixture)"
rs_branch="$(git -C "$rs_proj" rev-parse --abbrev-ref HEAD)"
git -C "$rs_proj" remote add origin "$rs_bare2"
git -C "$rs_proj" push -q -u origin "$rs_branch"
# A second, independent clone pushes an unrelated commit to the same
# origin/branch first, simulating a colleague's registry-sync landing
# concurrently.
rs_clone2="$(mktemp -d "$tmp_root/rsclone2.XXXXXX")"
git clone -q "$rs_bare2" "$rs_clone2"
git -C "$rs_clone2" config user.email "core-selftest@example.com"
git -C "$rs_clone2" config user.name "core-selftest"
mkdir -p "$rs_clone2/work/T2"
echo '{"owner":"bob"}' >"$rs_clone2/work/T2/claims.json"
git -C "$rs_clone2" add -A
git -C "$rs_clone2" commit -q -m "spine: registry sync — T2"
git -C "$rs_clone2" push -q origin "$rs_branch"
# Now $rs_proj is behind origin. Its own work/T1/ change should still sync
# cleanly via the pull-rebase-retry path.
echo '{"owner":"alice"}' >"$rs_proj/work/T1/claims.json"
r="$(rs_run "$rs_proj" T1)"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"rejected"* && "${r#*|}" == *"pushed T1 to origin/$rs_branch after rebase"* ]]; then
  pass "registry-sync: shared mainline moved concurrently -> pull-rebase retry succeeds (no real conflict)"
else
  fail "registry-sync: concurrent push, no real conflict -> expected a rejected-then-pushed-after-rebase sequence, got $r"
fi
# Confirm both engineers' work actually landed on origin after the retry.
origin_files="$(git -C "$rs_proj" ls-tree -r --name-only origin/"$rs_branch" 2>/dev/null | sort)"
if [[ "$origin_files" == *"work/T1/claims.json"* && "$origin_files" == *"work/T2/claims.json"* ]]; then
  pass "registry-sync: after the rebase retry, both this task's and the concurrent task's registry entries are present on origin"
else
  fail "registry-sync: expected both work/T1/claims.json and work/T2/claims.json on origin after rebase, got: $origin_files"
fi

# Negative control: temporarily disable the commit scope (stage the whole
# tree, -A, instead of only work/<task-id>/) and confirm Case C above
# actually fails without the real scope discipline — the property the
# script's own header calls the load-bearing reason this script exists in
# this exact shape.
rs_negctrl_backup="$(mktemp "$tmp_root/rs-negctrl.XXXXXX")"
cp "$REGISTRY_SYNC" "$rs_negctrl_backup"
sed -i.bak 's/git -C "\$project" add -- "work\/\$task_id\/"/git -C "$project" add -A/' "$REGISTRY_SYNC"
rm -f "$REGISTRY_SYNC.bak"
rs_proj="$(new_registry_sync_fixture)"
echo '{"owner":"alice"}' >"$rs_proj/work/T1/claims.json"
echo "unrelated in-progress edit" >>"$rs_proj/src/app.js"
negctrl_result="$(rs_run "$rs_proj" T1)"
negctrl_app_js_status="$(git -C "$rs_proj" status --porcelain -- src/app.js)"
cp "$rs_negctrl_backup" "$REGISTRY_SYNC"
if [[ -z "$negctrl_app_js_status" ]]; then
  pass "registry-sync: negative control confirms the scope-discipline case above is meaningful (the unrelated file gets swept in without the real -- work/\$task_id/ scoping)"
else
  fail "registry-sync: negative control did NOT reproduce the expected over-broad-commit failure — the scope-discipline case may be vacuous (status: '$negctrl_app_js_status')"
fi

# ---------------------------------------------------------------------------
# decision-hash: excludes the Status line, deterministic, reacts to real
# content changes
# ---------------------------------------------------------------------------
# Fourth (final) batch of the round-5 scripts-coverage backlog: the
# remaining scripts, none individually as high-stakes as the ship-time
# gates above, but each still a real, load-bearing piece.

DECISION_HASH="$SCRIPT_DIR/decision-hash"

dh_proj="$(mktemp -d "$tmp_root/dhproj.XXXXXX")"
cat >"$dh_proj/d1.md" <<'EOF'
# D-1: test

- Status: adopted

## Context
Some context.
EOF
h1="$("$DECISION_HASH" "$dh_proj/d1.md")"
sed 's/- Status: adopted/- Status: implemented/' "$dh_proj/d1.md" >"$dh_proj/d1-status-changed.md"
h2="$("$DECISION_HASH" "$dh_proj/d1-status-changed.md")"
if [[ -n "$h1" && "$h1" == "$h2" ]]; then
  pass "decision-hash: identical content with a different Status line hashes the same"
else
  fail "decision-hash: expected the same hash across a status-only change, got h1=$h1 h2=$h2"
fi

sed 's/Some context\./Different context now./' "$dh_proj/d1.md" >"$dh_proj/d1-content-changed.md"
h3="$("$DECISION_HASH" "$dh_proj/d1-content-changed.md")"
if [[ -n "$h3" && "$h3" != "$h1" ]]; then
  pass "decision-hash: a real content change (not Status) changes the hash"
else
  fail "decision-hash: expected a different hash after a real content change, got h1=$h1 h3=$h3"
fi

dh_code=0
"$DECISION_HASH" "$dh_proj/nope.md" >/dev/null 2>&1 || dh_code=$?
if [[ "$dh_code" == "2" ]]; then
  pass "decision-hash: missing file -> exit 2"
else
  fail "decision-hash: missing file -> expected exit 2, got $dh_code"
fi

# ---------------------------------------------------------------------------
# profile-check: unrepresentable-floor-off, bounded/enumerated fields
# ---------------------------------------------------------------------------

PROFILE_CHECK="$SCRIPT_DIR/profile-check"

pc_run() {
  local proj="$1" out code=0
  out="$("$PROFILE_CHECK" --project "$proj" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

pc_proj="$(mktemp -d "$tmp_root/pcproj.XXXXXX")"
r="$(pc_run "$pc_proj")"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"built-in defaults apply"* ]]; then
  pass "profile-check: no profile.json -> built-in defaults apply"
else
  fail "profile-check: no profile.json -> expected exit=0 defaults, got $r"
fi

pc_proj="$(mktemp -d "$tmp_root/pcproj.XXXXXX")"
mkdir -p "$pc_proj/.spine"
echo '{"profile":"standard","class1_adversaries":2,"autonomy_ceiling":"guided"}' >"$pc_proj/.spine/profile.json"
r="$(pc_run "$pc_proj")"
if [[ "${r%%|*}" == "0" && "${r#*|}" == *"ok"* ]]; then
  pass "profile-check: a valid profile -> ok"
else
  fail "profile-check: valid profile -> expected exit=0 ok, got $r"
fi

pc_proj="$(mktemp -d "$tmp_root/pcproj.XXXXXX")"
mkdir -p "$pc_proj/.spine"
echo '{"floor":false}' >"$pc_proj/.spine/profile.json"
r="$(pc_run "$pc_proj")"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"unknown key"* ]]; then
  pass "profile-check: an unknown key (e.g. an attempt to smuggle floor:false) -> invalid"
else
  fail "profile-check: unknown key -> expected exit=1 'unknown key', got $r"
fi

pc_proj="$(mktemp -d "$tmp_root/pcproj.XXXXXX")"
mkdir -p "$pc_proj/.spine"
echo '{"class1_adversaries":0}' >"$pc_proj/.spine/profile.json"
r="$(pc_run "$pc_proj")"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"class1_adversaries must be 1 or 2"* ]]; then
  pass "profile-check: class1_adversaries:0 (would disable the falsifier entirely) -> invalid"
else
  fail "profile-check: class1_adversaries=0 -> expected exit=1, got $r"
fi

pc_proj="$(mktemp -d "$tmp_root/pcproj.XXXXXX")"
mkdir -p "$pc_proj/.spine"
echo 'not json' >"$pc_proj/.spine/profile.json"
r="$(pc_run "$pc_proj")"
if [[ "${r%%|*}" == "1" && "${r#*|}" == *"not valid JSON"* ]]; then
  pass "profile-check: malformed JSON -> invalid"
else
  fail "profile-check: malformed JSON -> expected exit=1, got $r"
fi

# ---------------------------------------------------------------------------
# q: quiet command wrapper — one line on success, full diagnostics + the
# wrapped command's own exit code on failure
# ---------------------------------------------------------------------------

Q="$SCRIPT_DIR/q"

q_code=0
q_out="$("$Q" echo hello 2>&1)" || q_code=$?
if [[ "$q_code" == "0" && "$q_out" == "ok: echo hello" ]]; then
  pass "q: a succeeding command -> one-line ok summary"
else
  fail "q: succeeding command -> expected exit=0 'ok: echo hello', got exit=$q_code: $q_out"
fi

q_code=0
q_out="$("$Q" bash -c 'echo diagnostic-output; exit 7' 2>&1)" || q_code=$?
if [[ "$q_code" == "7" && "$q_out" == *"diagnostic-output"* && "$q_out" == *"exited 7"* ]]; then
  pass "q: a failing command -> its own exit code, full diagnostics printed"
else
  fail "q: failing command -> expected exit=7 with diagnostics, got exit=$q_code: $q_out"
fi

q_code=0
"$Q" >/dev/null 2>&1 || q_code=$?
if [[ "$q_code" == "2" ]]; then
  pass "q: no command given -> exit 2"
else
  fail "q: no args -> expected exit 2, got $q_code"
fi

# ---------------------------------------------------------------------------
# ui-touch: conditional ui-render dispatch based on real diff content
# ---------------------------------------------------------------------------

UI_TOUCH="$SCRIPT_DIR/ui-touch"

new_ui_touch_fixture() {
  local proj
  proj="$(mktemp -d "$tmp_root/utproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/src/components" "$proj/src/lib" "$proj/.spine"
  echo "seed" >"$proj/src/lib/util.ts"
  echo 'src/components/*.tsx' >"$proj/.spine/ui-paths.conf"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

ut_proj="$(new_ui_touch_fixture)"
echo "export const X = 1" >"$ut_proj/src/components/Widget.tsx"
out="$(cd "$ut_proj" && "$UI_TOUCH" 2>&1)"
if [[ "$out" == *"ui_touched=true"* ]]; then
  pass "ui-touch: a new file matching ui-paths.conf -> ui_touched=true"
else
  fail "ui-touch: matching file -> expected ui_touched=true, got: $out"
fi

ut_proj="$(new_ui_touch_fixture)"
echo "export const Y = 2" >"$ut_proj/src/lib/other.ts"
out="$(cd "$ut_proj" && "$UI_TOUCH" 2>&1)"
if [[ "$out" == *"ui_touched=false"* ]]; then
  pass "ui-touch: a changed non-UI file -> ui_touched=false"
else
  fail "ui-touch: non-matching file -> expected ui_touched=false, got: $out"
fi

ut_proj="$(mktemp -d "$tmp_root/utproj.XXXXXX")"
git init -q "$ut_proj"
git -C "$ut_proj" config user.email "core-selftest@example.com"
git -C "$ut_proj" config user.name "core-selftest"
echo seed >"$ut_proj/a.txt"
git -C "$ut_proj" add -A
git -C "$ut_proj" commit -q -m seed
out="$(cd "$ut_proj" && "$UI_TOUCH" 2>&1)"
if [[ "$out" == *'"ui_touched":false'* && "$out" == *"no .spine/ui-paths.conf"* ]]; then
  pass "ui-touch: no ui-paths.conf -> ui_touched=false, treated as no UI declared"
else
  fail "ui-touch: no conf -> expected ui_touched=false, got: $out"
fi

# ---------------------------------------------------------------------------
# verdict-filter: schema validation + evidence resolution (decision-kind
# gets a stronger, second-pass check than file_line/command)
# ---------------------------------------------------------------------------

VERDICT_FILTER="$SCRIPT_DIR/verdict-filter"

vf_proj="$(mktemp -d "$tmp_root/vfproj.XXXXXX")"
mkdir -p "$vf_proj/docs/decisions"
cat >"$vf_proj/docs/decisions/D-5-example.md" <<'EOF'
# D-5: example

- Status: adopted

## Context
The relevant quoted span lives right here for verification.
EOF

vf_input="$tmp_root/vf-input.json"
cat >"$vf_input" <<'EOF'
{
  "agent": "falsifier",
  "task_id": "T1",
  "attacked": ["src/a.ts"],
  "verdicts": [
    {"claim":"a real file_line finding","severity":"high","evidence":{"kind":"file_line","file":"src/a.ts","line":10}},
    {"claim":"malformed - no evidence","severity":"low","evidence":{"kind":"file_line","file":"","line":null}},
    {"claim":"a real decision citation","severity":"medium","evidence":{"kind":"decision","decision_id":"D-5","quote":"The relevant quoted span lives right here"}},
    {"claim":"a fabricated decision citation","severity":"medium","evidence":{"kind":"decision","decision_id":"D-5","quote":"this text does not appear anywhere in the record"}}
  ]
}
EOF
vf_out="$tmp_root/vf-out.json"
vf_code=0
"$VERDICT_FILTER" "$vf_input" --out "$vf_out" --project "$vf_proj" >/dev/null 2>&1 || vf_code=$?
kept_claims="$(jq -r '.verdicts[].claim' "$vf_out" 2>/dev/null | sort)"
expected_claims="$(printf '%s\n' "a real decision citation" "a real file_line finding" | sort)"
if [[ "$vf_code" == "0" && "$kept_claims" == "$expected_claims" ]]; then
  pass "verdict-filter: keeps well-formed evidence, drops malformed shape and an unresolvable decision quote"
else
  fail "verdict-filter: expected exactly the two real verdicts kept, got kept='$kept_claims' code=$vf_code"
fi

vf_input2="$tmp_root/vf-input2.json"
echo '{"agent":"falsifier","task_id":"T1","attacked":[],"verdicts":[]}' >"$vf_input2"
vf_code2=0
"$VERDICT_FILTER" "$vf_input2" --project "$vf_proj" >/dev/null 2>&1 || vf_code2=$?
if [[ "$vf_code2" == "2" ]]; then
  pass "verdict-filter: empty attacked list -> exit 2"
else
  fail "verdict-filter: empty attacked -> expected exit 2, got $vf_code2"
fi

vf_input3="$tmp_root/vf-input3.json"
echo '{"task_id":"T1","attacked":["a"],"verdicts":[]}' >"$vf_input3"
vf_code3=0
"$VERDICT_FILTER" "$vf_input3" --project "$vf_proj" >/dev/null 2>&1 || vf_code3=$?
if [[ "$vf_code3" == "2" ]]; then
  pass "verdict-filter: missing agent field -> exit 2"
else
  fail "verdict-filter: missing agent -> expected exit 2, got $vf_code3"
fi

# verdict-filter: `render` evidence (ui-fidelity) resolves against the
# task's capture dir; fabricated quote, missing artifact, traversal and
# malformed shape are all dropped.
mkdir -p "$vf_proj/work/T1/artifacts/ui-fidelity/board"
echo '{"component":"ContextualAction","backgroundColor":"rgba(0, 0, 0, 0)","text":"Reassign"}' \
  >"$vf_proj/work/T1/artifacts/ui-fidelity/board/default.facts.json"
vf_r_input="$tmp_root/vf-render-input.json"
cat >"$vf_r_input" <<'EOF'
{
  "agent": "ui-fidelity",
  "task_id": "T1",
  "attacked": ["board/default"],
  "verdicts": [
    {"claim":"real render fact","severity":"medium","evidence":{"kind":"render","screen_id":"board","state":"default","artifact":"board/default.facts.json","quote":"\"backgroundColor\":\"rgba(0, 0, 0, 0)\""}},
    {"claim":"fabricated quote","severity":"medium","evidence":{"kind":"render","screen_id":"board","state":"default","artifact":"board/default.facts.json","quote":"\"backgroundColor\":\"rgb(0, 90, 200)\""}},
    {"claim":"missing artifact","severity":"medium","evidence":{"kind":"render","screen_id":"board","state":"open","artifact":"board/open.facts.json","quote":"x"}},
    {"claim":"path traversal","severity":"medium","evidence":{"kind":"render","screen_id":"board","state":"default","artifact":"../../../../docs/decisions/D-5-example.md","quote":"quoted span"}},
    {"claim":"malformed no state","severity":"low","evidence":{"kind":"render","screen_id":"board","artifact":"board/default.facts.json","quote":"Reassign"}}
  ]
}
EOF
vf_r_out="$tmp_root/vf-render-out.json"
"$VERDICT_FILTER" "$vf_r_input" --out "$vf_r_out" --project "$vf_proj" >/dev/null 2>&1 || true
vf_r_kept="$(jq -r '.verdicts[].claim' "$vf_r_out" 2>/dev/null)"
if [[ "$vf_r_kept" == "real render fact" ]]; then
  pass "verdict-filter: render evidence kept only when its quote resolves inside the capture dir"
else
  fail "verdict-filter: render evidence expected only 'real render fact' kept, got '$vf_r_kept'"
fi

# ---------------------------------------------------------------------------
# content-sources-check + ui-touch content paths
# ---------------------------------------------------------------------------

CSC="$SCRIPT_DIR/content-sources-check"
csc_proj="$(mktemp -d "$tmp_root/cscproj.XXXXXX")"
mkdir -p "$csc_proj/.spine" "$csc_proj/docs/ui/screens" "$csc_proj/work/T1"
echo 'apps/web/src/**/*.tsx' >"$csc_proj/.spine/ui-paths.conf"
echo 'apps/web/src/**/*.fixtures.ts' >"$csc_proj/.spine/ui-content-paths.conf"
echo '{}' >"$csc_proj/docs/ui/screens/home.json"
write_csc_plan() { # $1 = content-sources body ("" = omit fence)
  {
    echo '<!-- MACHINE: predicted-touch -->'
    echo '## Predicted touch'
    echo '- apps/web/src/home/home.fixtures.ts — seed content'
    echo '<!-- /MACHINE -->'
    if [[ -n "$1" ]]; then
      echo '<!-- MACHINE: content-sources -->'
      echo '## Content sources'
      printf '%s\n' "$1"
      echo '<!-- /MACHINE -->'
    fi
  } >"$csc_proj/work/T1/plan.md"
}
printf '<!-- spine:research\nsha: abc\nfiles:\n  - docs/ui/screens/home.json\n-->\n' >"$csc_proj/work/T1/research.md"

csc_run() { "$CSC" T1 --project "$csc_proj" 2>&1; }

write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: docs/ui/screens/home.json#content'
if csc_run >/dev/null; then pass "content-sources-check: cited, existing, research-grounded source -> ok"; else fail "content-sources-check: valid plan rejected"; fi

write_csc_plan ""
if ! csc_run >/dev/null; then pass "content-sources-check: UI plan with no Content sources fence -> fails"; else fail "content-sources-check: missing fence accepted"; fi

write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: none'
out="$(csc_run || true)"
if [[ "$out" == *"STOP AND ASK"* ]]; then pass "content-sources-check: 'source: none' -> STOP AND ASK"; else fail "content-sources-check: none not flagged: $out"; fi

write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: docs/ui/screens/missing.json'
if ! csc_run >/dev/null; then pass "content-sources-check: nonexistent cited path -> fails"; else fail "content-sources-check: nonexistent path accepted"; fi

write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: human — PM said use 12'
if csc_run >/dev/null; then pass "content-sources-check: 'source: human' accepted"; else fail "content-sources-check: human source rejected"; fi

write_csc_plan '- some other block — source: docs/ui/screens/home.json'
out="$(csc_run || true)"
if [[ "$out" == *"not listed in Content sources"* ]]; then pass "content-sources-check: unlisted content file in predicted touch -> fails"; else fail "content-sources-check: unlisted fixture accepted: $out"; fi

printf '<!-- spine:research\nsha: abc\nfiles:\n  - README.md\n-->\n' >"$csc_proj/work/T1/research.md"
write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: docs/ui/screens/home.json'
out="$(csc_run || true)"
if [[ "$out" == *"not in research.md"* ]]; then pass "content-sources-check: source absent from research files: -> fails"; else fail "content-sources-check: untracked source accepted: $out"; fi

{ echo '<!-- MACHINE: predicted-touch -->'; echo '- lib/util.ts — x'; echo '<!-- /MACHINE -->'; } >"$csc_proj/work/T1/plan.md"
if csc_run >/dev/null; then pass "content-sources-check: non-UI plan -> not applicable, exit 0"; else fail "content-sources-check: non-UI plan blocked"; fi

# ui-touch: a diff touching only a content-conf path counts as UI touched
(cd "$csc_proj" && git init -q . && git add -A && git -c user.email=t@t -c user.name=t commit -qm base --allow-empty \
  && mkdir -p apps/web/src/home && echo x >apps/web/src/home/home.fixtures.ts)
out="$("$SCRIPT_DIR/ui-touch" --project "$csc_proj" 2>/dev/null | sed '/^ui-touch:/d')"
if [[ "$(jq -r .ui_touched <<<"$out")" == "true" ]]; then pass "ui-touch: content-only diff (ui-content-paths.conf) -> ui_touched=true"; else fail "ui-touch: content-only diff not detected: $out"; fi

# `**/` matches zero directories: a file directly under the prefix must match.
printf 'apps/web/src/**/*.tsx\n' >"$csc_proj/.spine/ui-paths.conf"
(cd "$csc_proj" && mkdir -p apps/web/src && echo x >apps/web/src/main.tsx)
out="$("$SCRIPT_DIR/ui-touch" --project "$csc_proj" 2>/dev/null | sed '/^ui-touch:/d')"
if jq -e '.matched_paths | index("apps/web/src/main.tsx")' <<<"$out" >/dev/null 2>&1; then
  pass "ui-touch: 'dir/**/*.ext' also matches a file directly under dir"
else
  fail "ui-touch: apps/web/src/main.tsx not matched by apps/web/src/**/*.tsx: $out"
fi
{ echo '<!-- MACHINE: predicted-touch -->'; echo '- apps/web/src/main.tsx — x'; echo '<!-- /MACHINE -->'; } >"$csc_proj/work/T1/plan.md"
if ! csc_run >/dev/null; then pass "content-sources-check: direct-child view file matched by '**/' glob -> applies"; else fail "content-sources-check: direct-child view file not treated as UI"; fi

# ---------------------------------------------------------------------------
# next-milestone-task: TBD/BLOCKED/WAITING/NONE resolution, numeric
# milestone ordering
# ---------------------------------------------------------------------------

NEXT_MILESTONE_TASK="$SCRIPT_DIR/next-milestone-task"

nmt_task() {
  # nmt_task <proj> <task-id> <state>
  mkdir -p "$1/work/$2"
  printf '%s' "$3" >"$1/work/$2/state"
}

nmt_ms() {
  # nmt_ms <proj> <ms-id> <member-tasks-lines...>
  local proj="$1" ms="$2"; shift 2
  mkdir -p "$proj/work/$ms"
  {
    echo "# Milestone $ms"
    echo
    echo "## Member tasks"
    printf '%s\n' "$@"
  } >"$proj/work/$ms/milestone.md"
}

proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
nmt_ms "$proj" M0 "1. \`TBD\` — build the widget"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "TBD M0 build the widget" ]]; then
  pass "next-milestone-task: first entry TBD -> proposes it directly"
else
  fail "next-milestone-task: expected 'TBD M0 build the widget', got: $out"
fi

proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
nmt_task "$proj" T1 research
nmt_ms "$proj" M0 "1. \`T1\` — first task" "2. \`TBD\` — second task"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "BLOCKED M0 T1" ]]; then
  pass "next-milestone-task: predecessor not done -> BLOCKED on it"
else
  fail "next-milestone-task: expected 'BLOCKED M0 T1', got: $out"
fi

proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
nmt_task "$proj" T1 done
nmt_ms "$proj" M0 "1. \`T1\` — first task" "2. \`TBD\` — second task"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "TBD M0 second task" ]]; then
  pass "next-milestone-task: a done predecessor unblocks the next TBD"
else
  fail "next-milestone-task: expected 'TBD M0 second task', got: $out"
fi

proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
nmt_task "$proj" T1 implement
nmt_ms "$proj" M0 "1. \`T1\` — only task"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "WAITING M0" ]]; then
  pass "next-milestone-task: every member has a real id but none done -> WAITING"
else
  fail "next-milestone-task: expected 'WAITING M0', got: $out"
fi

proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
mkdir -p "$proj/work"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "NONE" ]]; then
  pass "next-milestone-task: no milestones -> NONE"
else
  fail "next-milestone-task: expected 'NONE', got: $out"
fi

# M0 complete, M1 not -> scans forward correctly (also exercises numeric,
# not lexical, milestone ordering once a third digit is involved elsewhere).
proj="$(mktemp -d "$tmp_root/nmtproj.XXXXXX")"
nmt_task "$proj" T1 done
nmt_ms "$proj" M0 "1. \`T1\` — only task"
nmt_task "$proj" T2 research
nmt_ms "$proj" M1 "1. \`T2\` — only task"
out="$("$NEXT_MILESTONE_TASK" --project "$proj" 2>&1)"
if [[ "$out" == "WAITING M1" ]]; then
  pass "next-milestone-task: a complete lower-numbered milestone is skipped in favor of the next incomplete one"
else
  fail "next-milestone-task: expected 'WAITING M1' (M0 complete, skipped), got: $out"
fi

out="$("$NEXT_MILESTONE_TASK" --project "$proj" --milestone M0 2>&1)"
if [[ "$out" == "NONE" ]]; then
  pass "next-milestone-task: --milestone targeting an already-complete milestone directly -> NONE, never falls through to scan others"
else
  fail "next-milestone-task: --milestone M0 (complete) -> expected NONE, got: $out"
fi

out="$("$NEXT_MILESTONE_TASK" --project "$proj" --milestone M1 2>&1)"
if [[ "$out" == "WAITING M1" ]]; then
  pass "next-milestone-task: --milestone targeting a specific incomplete milestone directly"
else
  fail "next-milestone-task: --milestone M1 -> expected WAITING M1, got: $out"
fi

nmt_code=0
"$NEXT_MILESTONE_TASK" --project "$proj" --milestone M99 >/dev/null 2>&1 || nmt_code=$?
if [[ "$nmt_code" == "2" ]]; then
  pass "next-milestone-task: --milestone naming a nonexistent milestone -> exit 2"
else
  fail "next-milestone-task: nonexistent --milestone -> expected exit 2, got $nmt_code"
fi

# ---------------------------------------------------------------------------
# design-gate: the four /design stopping-rule checks
# ---------------------------------------------------------------------------

DESIGN_GATE="$SCRIPT_DIR/design-gate"

new_design_gate_fixture() {
  # -> "<proj>" — passes all four checks cleanly.
  local proj n cat
  proj="$(mktemp -d "$tmp_root/dgproj.XXXXXX")"
  mkdir -p "$proj/work/M0" "$proj/.spine" "$proj/docs/decisions"
  cat >"$proj/work/M0/milestone.md" <<'EOF'
# Milestone 0

## Capability targets

| Capability | Status |
|---|---|
| test | planned: unit tests via vitest |
| smoke-seed | planned: seed script |
| smoke-run | planned: playwright smoke |
| smoke-golden | planned: golden snapshot compare |
EOF
  cat >"$proj/.spine/capabilities.json" <<'EOF'
{
  "typecheck":{"status":"implemented"}, "lint":{"status":"implemented"},
  "test":{"status":"implemented"}, "test-changed":{"status":"not-applicable"},
  "secret-scan":{"status":"implemented"}, "dep-diff":{"status":"implemented"},
  "clone-scan":{"status":"not-applicable"}, "callers":{"status":"not-applicable"},
  "mutate":{"status":"not-applicable"}, "smoke-seed":{"status":"implemented"},
  "smoke-run":{"status":"implemented"}, "smoke-golden":{"status":"implemented"},
  "migrate-rehearse":{"status":"not-applicable"}
}
EOF
  n=1
  for cat in state-management persistence module-boundaries error-handling auth-model repo-topology; do
    cat >"$proj/docs/decisions/D-$n-$cat.md" <<EOF
# D-$n: $cat decision

- Id: D-$n
- Category: $cat
- Status: adopted
- Scope: workspace

## Context
Context for $cat.

## Decision
Decision for $cat.
EOF
    n=$((n + 1))
  done
  printf '%s' "$proj"
}

dg_proj="$(new_design_gate_fixture)"
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" 2>&1)" || dg_code=$?
if [[ "$dg_code" == "0" && "$dg_out" == *"PASS"* ]]; then
  pass "design-gate: control — a fixture satisfying all four checks -> PASS"
else
  fail "design-gate: control -> expected exit=0 PASS, got exit=$dg_code: $dg_out"
fi

dg_proj="$(new_design_gate_fixture)"
rm -f "$dg_proj/work/M0/milestone.md"
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" 2>&1)" || dg_code=$?
if [[ "$dg_code" == "1" && "$dg_out" == *"milestone 0"* ]]; then
  pass "design-gate: no work/M0/milestone.md -> FAIL"
else
  fail "design-gate: missing M0 -> expected exit=1, got exit=$dg_code: $dg_out"
fi

dg_proj="$(new_design_gate_fixture)"
jq 'del(.["smoke-run"])' "$dg_proj/.spine/capabilities.json" >"$dg_proj/.spine/capabilities.json.tmp" && mv "$dg_proj/.spine/capabilities.json.tmp" "$dg_proj/.spine/capabilities.json"
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" 2>&1)" || dg_code=$?
if [[ "$dg_code" == "1" && "$dg_out" == *"smoke-run"* ]]; then
  pass "design-gate: a capability with no planned status -> FAIL"
else
  fail "design-gate: missing capability status -> expected exit=1, got exit=$dg_code: $dg_out"
fi

dg_proj="$(new_design_gate_fixture)"
rm -f "$dg_proj/docs/decisions/D-1-state-management.md"
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" 2>&1)" || dg_code=$?
if [[ "$dg_code" == "1" && "$dg_out" == *"state-management"* ]]; then
  pass "design-gate: an uncovered foundational category -> FAIL"
else
  fail "design-gate: uncovered category -> expected exit=1, got exit=$dg_code: $dg_out"
fi
cat >"$dg_proj/docs/decisions/DEFERRED.md" <<'EOF'
# Deferred decisions

## Deferred: state management

- Category: state-management
- Trigger: once a second data source is added
EOF
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" 2>&1)" || dg_code=$?
if [[ "$dg_code" == "0" && "$dg_out" == *"PASS"* ]]; then
  pass "design-gate: a DEFERRED.md entry with a trigger covers a category as well as an adopted decision"
else
  fail "design-gate: DEFERRED coverage -> expected exit=0 PASS, got exit=$dg_code: $dg_out"
fi

dg_proj="$(new_design_gate_fixture)"
dg_code=0
dg_out="$("$DESIGN_GATE" --project "$dg_proj" --cap 3 2>&1)" || dg_code=$?
if [[ "$dg_code" == "1" && "$dg_out" == *"exceeding the cap of 3"* ]]; then
  pass "design-gate: adopted-decision count exceeding a tighter --cap -> FAIL"
else
  fail "design-gate: cap exceeded -> expected exit=1, got exit=$dg_code: $dg_out"
fi

# ---------------------------------------------------------------------------
# decision-index: regenerated INDEX.md, numeric id ordering, --check
# staleness detection
# ---------------------------------------------------------------------------

DECISION_INDEX="$SCRIPT_DIR/decision-index"

new_decision_index_fixture() {
  local proj
  proj="$(mktemp -d "$tmp_root/diproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/docs/decisions"
  cat >"$proj/docs/decisions/D-1-first.md" <<'EOF'
# D-1: first decision

- Id: D-1
- Category: state-management
- Status: adopted
- Scope: workspace
- Supersedes:
- Superseded-by:

## Context
First.
EOF
  cat >"$proj/docs/decisions/D-9-ninth.md" <<'EOF'
# D-9: ninth decision

- Id: D-9
- Category: persistence
- Status: adopted
- Scope: workspace
- Supersedes:
- Superseded-by:

## Context
Ninth.
EOF
  cat >"$proj/docs/decisions/D-10-tenth.md" <<'EOF'
# D-10: tenth decision

- Id: D-10
- Category: auth-model
- Status: adopted
- Scope: workspace
- Supersedes:
- Superseded-by:

## Context
Tenth.
EOF
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

di_proj="$(new_decision_index_fixture)"
di_code=0
"$DECISION_INDEX" --project "$di_proj" >/dev/null 2>&1 || di_code=$?
idx="$di_proj/docs/decisions/INDEX.md"
row9_line="$( (grep -n '| D-9 |' "$idx" || true) | cut -d: -f1)"
row10_line="$( (grep -n '| D-10 |' "$idx" || true) | cut -d: -f1)"
if [[ "$di_code" == "0" && -f "$idx" && -n "$row9_line" && -n "$row10_line" && "$row9_line" -lt "$row10_line" ]]; then
  pass "decision-index: writes INDEX.md, sorted numerically (D-9 before D-10, not lexically)"
else
  fail "decision-index: expected INDEX.md with D-9 before D-10 numerically, got code=$di_code row9=$row9_line row10=$row10_line"
fi

di_code=0
di_out="$("$DECISION_INDEX" --project "$di_proj" --check 2>&1)" || di_code=$?
if [[ "$di_code" == "0" && "$di_out" == *"ok"* ]]; then
  pass "decision-index --check: a current INDEX.md -> ok"
else
  fail "decision-index --check: expected exit=0 ok, got exit=$di_code: $di_out"
fi

cat >"$di_proj/docs/decisions/D-20-twentieth.md" <<'EOF'
# D-20: twentieth decision

- Id: D-20
- Category: repo-topology
- Status: adopted
- Scope: workspace

## Context
Twentieth.
EOF
idx_before="$(cat "$idx")"
di_code=0
di_out="$("$DECISION_INDEX" --project "$di_proj" --check 2>&1)" || di_code=$?
idx_after="$(cat "$idx")"
if [[ "$di_code" == "1" && "$di_out" == *"STALE"* && "$idx_before" == "$idx_after" ]]; then
  pass "decision-index --check: a decision added without regenerating -> STALE, exit 1, writes nothing to disk"
else
  fail "decision-index --check: expected exit=1 STALE with no write, got code=$di_code changed=$([[ "$idx_before" != "$idx_after" ]] && echo yes || echo no)"
fi

di_empty_proj="$(mktemp -d "$tmp_root/diempty.XXXXXX")"
di_code=0
di_out="$("$DECISION_INDEX" --project "$di_empty_proj" 2>&1)" || di_code=$?
if [[ "$di_code" == "0" && "$di_out" == *"nothing to do"* ]]; then
  pass "decision-index: no docs/decisions/ anywhere -> nothing to do, exit 0"
else
  fail "decision-index: no decisions dir -> expected exit=0 'nothing to do', got exit=$di_code: $di_out"
fi

# ---------------------------------------------------------------------------
# propagate: supersession propagation — flags every OTHER open task that
# grounds on what changed, severity from the target's own phase, self- and
# done-task exclusion
# ---------------------------------------------------------------------------

PROPAGATE="$SCRIPT_DIR/propagate"

new_propagate_fixture() {
  local proj
  proj="$(mktemp -d "$tmp_root/propproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/work/SRC"
  echo done >"$proj/work/SRC/state"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

prop_task() {
  # prop_task <proj> <task-id> <state> <claims-json-body>
  mkdir -p "$1/work/$2"
  printf '%s' "$3" >"$1/work/$2/state"
  printf '%s' "$4" >"$1/work/$2/claims.json"
}

proj="$(new_propagate_fixture)"
prop_task "$proj" OTHER research '{"grounding_files":["src/a.ts"],"grounding_decisions":[],"contracts":[]}'
out="$(printf 'src/a.ts\n' | "$PROPAGATE" SRC --project "$proj" 2>&1)"
flags_count="$(jq 'length' "$proj/work/OTHER/flags.json" 2>/dev/null)"
severity="$(jq -r '.[0].severity' "$proj/work/OTHER/flags.json" 2>/dev/null)"
if [[ "$flags_count" == "1" && "$severity" == "advisory" && "$out" == *"flagged OTHER"* ]]; then
  pass "propagate: a changed file OTHER grounds on -> flags OTHER, severity=advisory (OTHER is in research/plan)"
else
  fail "propagate: expected 1 advisory flag for OTHER, got count=$flags_count severity=$severity out=$out"
fi

proj="$(new_propagate_fixture)"
prop_task "$proj" OTHER implement '{"grounding_files":["src/b.ts"],"grounding_decisions":[],"contracts":[]}'
out="$(printf 'src/b.ts\n' | "$PROPAGATE" SRC --project "$proj" 2>&1)"
severity="$(jq -r '.[0].severity' "$proj/work/OTHER/flags.json" 2>/dev/null)"
if [[ "$severity" == "disruptive" ]]; then
  pass "propagate: OTHER past research/plan -> severity=disruptive"
else
  fail "propagate: expected severity=disruptive, got $severity"
fi

proj="$(new_propagate_fixture)"
prop_task "$proj" OTHER plan '{"grounding_files":[],"grounding_decisions":["D-3"],"contracts":[]}'
out="$(printf '' | "$PROPAGATE" SRC --project "$proj" --decisions D-3 2>&1)"
flags_count="$(jq 'length' "$proj/work/OTHER/flags.json" 2>/dev/null)"
what="$(jq -r '.[0].what_changed' "$proj/work/OTHER/flags.json" 2>/dev/null)"
if [[ "$flags_count" == "1" && "$what" == *"decision 'D-3'"* ]]; then
  pass "propagate: a changed decision OTHER cites -> flags OTHER"
else
  fail "propagate: expected 1 flag citing decision D-3, got count=$flags_count what='$what'"
fi

proj="$(new_propagate_fixture)"
prop_task "$proj" OTHER plan '{"grounding_files":["src/unrelated.ts"],"grounding_decisions":[],"contracts":[]}'
out="$(printf 'src/z.ts\n' | "$PROPAGATE" SRC --project "$proj" 2>&1)"
if [[ "$out" == *"nothing flagged"* ]]; then
  pass "propagate: control — no match -> nothing flagged"
else
  fail "propagate: control -> expected 'nothing flagged', got: $out"
fi

proj="$(new_propagate_fixture)"
prop_task "$proj" OTHER done '{"grounding_files":["src/c.ts"],"grounding_decisions":[],"contracts":[]}'
out="$(printf 'src/c.ts\n' | "$PROPAGATE" SRC --project "$proj" 2>&1)"
if [[ "$out" == *"nothing flagged"* ]]; then
  pass "propagate: a done task is excluded from propagation targets"
else
  fail "propagate: done-task exclusion -> expected 'nothing flagged', got: $out"
fi

proj="$(new_propagate_fixture)"
prop_task "$proj" SRC research '{"grounding_files":["src/self.ts"],"grounding_decisions":[],"contracts":[]}'
out="$(printf 'src/self.ts\n' | "$PROPAGATE" SRC --project "$proj" 2>&1)"
src_flag_count="0"
[[ -f "$proj/work/SRC/flags.json" ]] && src_flag_count="$(jq 'length' "$proj/work/SRC/flags.json" 2>/dev/null)"
if [[ "$src_flag_count" == "0" && "$out" == *"nothing flagged"* ]]; then
  pass "propagate: the source task never flags itself"
else
  fail "propagate: source self-exclusion -> expected no flags for SRC, got count=$src_flag_count out=$out"
fi

prop_code=0
printf '' | "$PROPAGATE" SRC >/dev/null 2>&1 || prop_code=$?
if [[ "$prop_code" == "2" ]]; then
  pass "propagate: missing --project -> exit 2"
else
  fail "propagate: missing --project -> expected exit 2, got $prop_code"
fi

# ---------------------------------------------------------------------------
# setup: portable-install, per-machine step — real symlinks into this
# checkout, pin init/comparison across warn/strict, settings.local.json
# merge discipline
# ---------------------------------------------------------------------------
# Uses this actual spine checkout as --spine (a real, valid, read-only
# source — setup never writes anywhere under $resolved_spine, only reads
# core/skills, core/agents, core/rules, .git, confirmed by reading the
# script above), never a synthetic one — every write this section makes
# lands only inside a throwaway --project fixture.

SETUP="$SCRIPT_DIR/setup"
REAL_SPINE="$(cd "$SCRIPT_DIR/../.." && pwd)"
REAL_SPINE_SHA="$(git -C "$REAL_SPINE" rev-parse HEAD)"

new_setup_fixture() {
  # -> "<proj>" — spine-installed (capabilities.json present), no pin yet.
  local proj
  proj="$(mktemp -d "$tmp_root/setupproj.XXXXXX")"
  mkdir -p "$proj/.spine"
  echo '{}' >"$proj/.spine/capabilities.json"
  printf '%s' "$proj"
}

su_proj="$(new_setup_fixture)"
su_code=0
su_out="$("$SETUP" --project "$su_proj" --spine "$REAL_SPINE" --check 2>&1)" || su_code=$?
if [[ "$su_code" == "0" && "$su_out" == *"no pin recorded"* ]]; then
  pass "setup --check: no pin yet -> exit 0, 'no pin recorded'"
else
  fail "setup --check: no pin -> expected exit=0 'no pin recorded', got exit=$su_code: $su_out"
fi

su_proj="$(new_setup_fixture)"
jq -n --arg sha "$REAL_SPINE_SHA" '{sha:$sha, mode:"warn"}' >"$su_proj/.spine/core-pin.json"
su_code=0
su_out="$("$SETUP" --project "$su_proj" --spine "$REAL_SPINE" --check 2>&1)" || su_code=$?
if [[ "$su_code" == "0" && "$su_out" == *"core pin ok"* ]]; then
  pass "setup --check: a pin matching this machine's spine sha -> ok"
else
  fail "setup --check: matching pin -> expected exit=0 'core pin ok', got exit=$su_code: $su_out"
fi

su_proj="$(new_setup_fixture)"
jq -n '{sha:"0000000000000000000000000000000000000000", mode:"warn"}' >"$su_proj/.spine/core-pin.json"
su_code=0
su_out="$("$SETUP" --project "$su_proj" --spine "$REAL_SPINE" --check 2>&1)" || su_code=$?
if [[ "$su_code" == "0" && "$su_out" == *"CORE VERSION SKEW (warn)"* ]]; then
  pass "setup --check: pin mismatch under warn mode -> exit 0, loud warning, not blocking"
else
  fail "setup --check: warn-mode mismatch -> expected exit=0 with a (warn) SKEW message, got exit=$su_code: $su_out"
fi

su_proj="$(new_setup_fixture)"
jq -n '{sha:"0000000000000000000000000000000000000000", mode:"strict"}' >"$su_proj/.spine/core-pin.json"
su_code=0
su_out="$("$SETUP" --project "$su_proj" --spine "$REAL_SPINE" --check 2>&1)" || su_code=$?
if [[ "$su_code" == "1" && "$su_out" == *"CORE VERSION SKEW (strict)"* ]]; then
  pass "setup --check: pin mismatch under strict mode -> exit 1, blocking"
else
  fail "setup --check: strict-mode mismatch -> expected exit=1 with a (strict) SKEW message, got exit=$su_code: $su_out"
fi

su_proj="$(new_setup_fixture)"
su_code=0
su_out="$("$SETUP" --project "$su_proj" --spine "$REAL_SPINE" 2>&1)" || su_code=$?
skill_link_target="$(readlink "$su_proj/.claude/skills/task" 2>/dev/null)"
pinned_sha="$(jq -r '.sha' "$su_proj/.spine/core-pin.json" 2>/dev/null)"
if [[ "$su_code" == "0" && "$skill_link_target" == "$REAL_SPINE/core/skills/task" && "$pinned_sha" == "$REAL_SPINE_SHA" ]]; then
  pass "setup: a full run creates real symlinks into this spine checkout and initializes the pin at the current sha"
else
  fail "setup: full run -> expected a task skill symlink and a pin at $REAL_SPINE_SHA, got exit=$su_code link=$skill_link_target pin=$pinned_sha"
fi

su_proj="$(mktemp -d "$tmp_root/setupproj.XXXXXX")"
su_code=0
"$SETUP" --project "$su_proj" --spine "$REAL_SPINE" >/dev/null 2>&1 || su_code=$?
if [[ "$su_code" == "2" ]]; then
  pass "setup: a full run against a not-yet-installed project (no capabilities.json) -> exit 2"
else
  fail "setup: not installed -> expected exit 2, got $su_code"
fi

su_proj="$(new_setup_fixture)"
mkdir -p "$su_proj/.claude"
echo '{"permissions":{"allow":["Bash(npm test:*)"]}}' >"$su_proj/.claude/settings.local.json"
"$SETUP" --project "$su_proj" --spine "$REAL_SPINE" >/dev/null 2>&1
preexisting_kept="$(jq -r '.permissions.allow | index("Bash(npm test:*)")' "$su_proj/.claude/settings.local.json" 2>/dev/null)"
new_entry_added="$(jq -r --arg p "Bash($REAL_SPINE/core/scripts/*:*)" '.permissions.allow | index($p)' "$su_proj/.claude/settings.local.json" 2>/dev/null)"
if [[ "$preexisting_kept" != "null" && "$new_entry_added" != "null" ]]; then
  pass "setup: settings.local.json merge preserves a pre-existing engineer-added entry alongside the new one"
else
  fail "setup: settings.local.json merge -> expected both the pre-existing and new allow entries present, got preexisting=$preexisting_kept new=$new_entry_added"
fi

# ---------------------------------------------------------------------------
# wayfinder-frontier: FRONTIER/CLEARED/STALLED resolution, derived-not-
# stored blocked state, dangling-reference detection
# ---------------------------------------------------------------------------

WAYFINDER_FRONTIER="$SCRIPT_DIR/wayfinder-frontier"

wf_map() {
  # wf_map <proj> <map-id> <table-row-lines...> — writes a minimal
  # work/wayfinder/<map-id>/map.md with the given ticket rows already
  # inside the MACHINE fence, same shape core/templates/wayfinder-map.md
  # defines.
  local proj="$1" map="$2"; shift 2
  mkdir -p "$proj/work/wayfinder/$map"
  {
    echo "# Wayfinder map \`$map\`: test fixture"
    echo
    echo "## Tickets"
    echo
    echo "<!-- MACHINE: wayfinder-tickets -->"
    echo
    echo "| Ticket | Type | Status | Blocked-by | Question |"
    echo "|---|---|---|---|---|"
    printf '%s\n' "$@"
    echo
    echo "<!-- next-ticket-id: 99 -->"
  } >"$proj/work/wayfinder/$map/map.md"
}

wf_proj="$(mktemp -d "$tmp_root/wfproj.XXXXXX")"
wf_map "$wf_proj" W1 \
  '| T1 | grilling | resolved | none | already done |' \
  '| T2 | prototype | open | none | ready to go |' \
  '| T3 | research | open | T2 | blocked on T2 |'
out="$("$WAYFINDER_FRONTIER" --map W1 --project "$wf_proj" 2>&1)"
if [[ "$out" == "FRONTIER T2" ]]; then
  pass "wayfinder-frontier: an unblocked open ticket is the frontier, a blocked one is excluded"
else
  fail "wayfinder-frontier: expected 'FRONTIER T2', got: $out"
fi

wf_proj="$(mktemp -d "$tmp_root/wfproj.XXXXXX")"
wf_map "$wf_proj" W1 \
  '| T1 | grilling | resolved | none | already done |' \
  '| T2 | prototype | resolved | none | ready to go |' \
  '| T3 | research | open | T2 | blocked on T2 |'
out="$("$WAYFINDER_FRONTIER" --map W1 --project "$wf_proj" 2>&1)"
if [[ "$out" == "FRONTIER T3" ]]; then
  pass "wayfinder-frontier: resolving a blocker un-stalls its dependent with no stored 'blocked' status to flip"
else
  fail "wayfinder-frontier: expected 'FRONTIER T3' once T2 resolves, got: $out"
fi

wf_proj="$(mktemp -d "$tmp_root/wfproj.XXXXXX")"
wf_map "$wf_proj" W1 \
  '| T1 | grilling | resolved | none | already done |' \
  '| T2 | prototype | resolved | none | ready to go |' \
  '| T3 | research | resolved | T2 | blocked on T2 |'
out="$("$WAYFINDER_FRONTIER" --map W1 --project "$wf_proj" 2>&1)"
if [[ "$out" == "CLEARED" ]]; then
  pass "wayfinder-frontier: every ticket resolved -> CLEARED"
else
  fail "wayfinder-frontier: expected 'CLEARED', got: $out"
fi

wf_proj="$(mktemp -d "$tmp_root/wfproj.XXXXXX")"
wf_map "$wf_proj" W1 \
  '| T1 | grilling | open | T2 | cycle a |' \
  '| T2 | grilling | open | T1 | cycle b |'
out="$("$WAYFINDER_FRONTIER" --map W1 --project "$wf_proj" 2>&1)"
if [[ "$out" == "STALLED T1 T2" ]]; then
  pass "wayfinder-frontier: open tickets that only block each other -> STALLED, never silently worked around"
else
  fail "wayfinder-frontier: expected 'STALLED T1 T2', got: $out"
fi

wf_proj="$(mktemp -d "$tmp_root/wfproj.XXXXXX")"
wf_map "$wf_proj" W1 \
  '| T1 | grilling | open | T9 | dangling reference |'
wf_code=0
"$WAYFINDER_FRONTIER" --map W1 --project "$wf_proj" >/dev/null 2>&1 || wf_code=$?
if [[ "$wf_code" == "2" ]]; then
  pass "wayfinder-frontier: Blocked-by naming a ticket id not in the table -> exit 2, not treated as unblocked"
else
  fail "wayfinder-frontier: dangling Blocked-by -> expected exit 2, got $wf_code"
fi

wf_code=0
"$WAYFINDER_FRONTIER" --map W1 --project "$tmp_root/does-not-exist-$$" >/dev/null 2>&1 || wf_code=$?
if [[ "$wf_code" == "2" ]]; then
  pass "wayfinder-frontier: no map.md at all -> exit 2"
else
  fail "wayfinder-frontier: no map.md -> expected exit 2, got $wf_code"
fi



# ---------------------------------------------------------------------------
# touchpoint-lint: the human-touchpoint standard (core/templates/human-touchpoint.md)
# holds for every marked block in the real skills, the lint itself rejects
# each defect class it claims to catch, and the messages hooks/scripts show a
# human parse as compliant when run against real fixtures.
# ---------------------------------------------------------------------------

TPL="$SCRIPT_DIR/touchpoint-lint"

if "$TPL" >/dev/null 2>&1 </dev/null; then
  pass "touchpoint-lint: every marked touchpoint block in core/skills is compliant"
else
  fail "touchpoint-lint: a skill's touchpoint block is non-compliant: $("$TPL" 2>&1 </dev/null | head -5)"
fi

tpl_case() {
  # tpl_case <desc> <expect:pass|fail> <expected-substring-on-fail> <block-body>
  local desc="$1" expect="$2" sub="$3" body="$4" f out code=0
  f="$(mktemp "$tmp_root/tpl.XXXXXX")"
  printf '%s\n' "$body" >"$f"
  out="$("$TPL" "$f" 2>&1 </dev/null)" || code=$?
  if [[ "$expect" == "pass" ]]; then
    [[ "$code" == "0" ]] && pass "touchpoint-lint: $desc" || fail "touchpoint-lint: $desc (expected clean, got: $out)"
  else
    [[ "$code" == "1" && "$out" == *"$sub"* ]] && pass "touchpoint-lint: $desc" || fail "touchpoint-lint: $desc (expected exit 1 containing '$sub', got exit=$code: $out)"
  fi
}

TPL_OK='Ask with `AskUserQuestion`:
<!-- touchpoint:start -->
> **Deciding:** whether to redo research.
> **Need to know:** `check-stale` (the check that notices my notes are out of date) flagged one file, gap-3 (a leftover issue).
> **Recommend:** Keep — nothing relevant changed.
> 1. **Keep** — next: I plan now; cost: none; undo: yes
> 2. **Redo** — next: I re-research; cost: 10 minutes; undo: n/a
> **Safe to ignore:** the banner.
<!-- touchpoint:end -->'

tpl_case "a complete, glossed block passes" pass "" "$TPL_OK"
tpl_case "missing Recommend is caught" fail 'missing "Recommend:"' "${TPL_OK/> **Recommend:** Keep — nothing relevant changed.
/}"
tpl_case "an option with no undo: is caught" fail 'no "undo:"' "${TPL_OK/; undo: yes/}"
tpl_case "an unglossed internal id is caught" fail "internal id gap-3" "${TPL_OK/gap-3 (a leftover issue)/gap-3}"
tpl_case "an unglossed internal term is caught" fail 'internal term "check-stale"' "${TPL_OK/ (the check that notices my notes are out of date)/}"
tpl_case "a Class 2 mention with no gloss is caught" fail 'internal term "Class 2"' "${TPL_OK/flagged one file/flagged one file in a Class 2 task}"
tpl_case "an unclosed block is caught" fail "never closed" "${TPL_OK/<!-- touchpoint:end -->/}"
tpl_case "a report block missing Worth knowing is caught" fail 'missing "Worth knowing:"' '<!-- touchpoint:start report -->
> **Bottom line:** done.
> **What I did:** a thing.
> **What you need to do:** nothing.
<!-- touchpoint:end -->'

TPL_CONFIRM='Ask with `AskUserQuestion`:
<!-- touchpoint:start confirm -->
> **Start the next planned task?** Nothing is created until you say yes.
> **Yes** (recommended) — I begin researching it. **No** — tell me a different one.
<!-- touchpoint:end -->'
tpl_case "a compact confirm block passes" pass "" "$TPL_CONFIRM"
tpl_case "a full block not introduced with AskUserQuestion is caught" fail "not introduced with AskUserQuestion" "${TPL_OK/Ask with \`AskUserQuestion\`:/Ask the human:}"
tpl_case "a confirm block not introduced with AskUserQuestion is caught" fail "not introduced with AskUserQuestion" "${TPL_CONFIRM/Ask with \`AskUserQuestion\`:/Ask the human:}"
tpl_case "a confirm block with no (recommended) is caught" fail '"(recommended)"' "${TPL_CONFIRM/ (recommended)/}"
tpl_case "a confirm block with one answer is caught" fail "at least two bold answers" "${TPL_CONFIRM/\*\*No\*\* — tell me a different one./No: tell me a different one.}"
tpl_case "a confirm block that runs long is caught" fail "use the full block" "${TPL_CONFIRM/<!-- touchpoint:end -->/> a
> b
> c
> d
> e
<!-- touchpoint:end -->}"
tpl_case "a confirm block with an unglossed id is caught" fail "internal id M2" "${TPL_CONFIRM/next planned task/next planned task in M2}"

# A skill that cites the standard but contains no block is claiming compliance with nothing.
tpl_case "a skill citing the standard with no block is caught" fail "contains no" 'See core/templates/human-touchpoint.md for how to ask.'

# Negative control: the same defect in a message the lint is never shown must
# not be mistaken for a pass — an empty stdin is a failure, not a clean bill.
if printf '' | "$TPL" --stdin >/dev/null 2>&1; then
  fail "touchpoint-lint: negative control — empty --stdin input passed, so the message check may be vacuous"
else
  pass "touchpoint-lint: negative control — empty --stdin input fails (the message check is not vacuous)"
fi

tpl_msg() {
  # tpl_msg <desc> <message-text>
  local desc="$1" msg="$2" out code=0
  out="$(printf '%s\n' "$msg" | "$TPL" --stdin 2>&1)" || code=$?
  [[ "$code" == "0" ]] && pass "touchpoint-lint: $desc reads as a compliant message" || fail "touchpoint-lint: $desc is non-compliant: $out"
}

hf="$(new_hook_fixture)"; tpl_real="${hf%%|*}"
r="$(hook_run "$PATH_ESCALATE" "$tpl_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$tpl_real"'/src/auth/secret.txt"}}')"
tpl_msg "path-escalate's protected-path halt" "${r#*|}"
r="$(hook_run "$PHASE_GATE" "$tpl_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$tpl_real"'/src/other/x.txt"}}')"
tpl_msg "phase-gate's before-approval halt" "${r#*|}"
r="$(hook_run "$DEP_GATE" "$tpl_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$tpl_real"'/pkg/manifest.json"}}')"
tpl_msg "dep-gate's package-change question" "$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"${r#*|}")"
r="$(hook_run "$DEP_GATE" "$tpl_real" '{"tool_name":"Bash","tool_input":{"command":"npm install left-pad"}}')"
tpl_msg "dep-gate's install question" "$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"${r#*|}")"

for sac_case in "" '{}' '{"approver":"alice"}'; do
  r="$(sac_run "$(sac_fixture "alice" "$sac_case")")"
  tpl_msg "second-approver-check's halt (${sac_case:-no approval file})" "${r#*|}"
done

write_csc_plan '- apps/web/src/home/home.fixtures.ts — source: none'
tpl_msg "content-sources-check's stop-and-ask" "$(csc_run || true)"

cf="$(new_check_stale_fixture)"; cs_proj="${cf%%|*}"; cs_sha="${cf#*|}"
doc="$cs_proj/work/T1/research.md"
cs_write_research "$doc" "$cs_sha" "  - src/grounded.ts"
echo "changed after research was written" >>"$cs_proj/src/grounded.ts"
tpl_msg "check-stale's stale report" "$("$CHECK_STALE" "$doc" --project "$cs_proj" 2>&1 || true)"

exit "$overall"
