#!/bin/bash
# core-selftest — synthetic-fixture regression coverage for spine core's
# own scripts, as opposed to core/scripts/adapter-conformance which tests
# a project's adapters. Every case below builds a throwaway project under
# a temp dir (never this checkout, never a real installed project) and
# asserts on floor's/adapter-conformance's actual behavior against it.
#
# Currently covers:
#   - floor's migrate-rehearse dispatch (ADAPTER-CONTRACT.md §3.7): runs
#     only at Class 2 when the diff touches a migration path, records a
#     degraded gap when the capability isn't implemented, never appears
#     otherwise.
#   - floor's smoke_in_floor Class 1 opt-out (.spine/profile.json):
#     defaults true, an explicit false skips smoke even when implemented
#     and cached under budget, an explicit true behaves like the default.
#   - adversary-cache-tier's REUSED/FOCUSED/FULL decision (content-hash
#     match against blast radius, severity of the prior verdict).
#   - adapter-conformance's shell-strictness lint (ADAPTER-CONTRACT.md
#     §2.1): flags a bash adapter missing `set -euo pipefail` and a
#     bash-4-only construct with no $BASH_VERSINFO guard.
#   - adapter-conformance's `--self-test cold` requirement for
#     smoke-seed/smoke-run/smoke-golden (ADAPTER-CONTRACT.md §2.2, §3.8):
#     a self-healing adapter passes conformance, a non-self-healing one
#     (the real shape found in the wild — assumes the stack is already
#     up) fails it, and a capability with no environment assumption is
#     never asked for `--self-test cold` at all.
#   - floor's Class 2 smoke hard-gate: an unimplemented smoke-run fails
#     floor outright, not a soft skip (a prior audit round found this used
#     to log "HARD GATE" but never actually fail).
#   - phase-gate/path-escalate/dep-gate direct repro coverage: a protected
#     path reached through a real symlinked alias of the project root still
#     denies (three separate real bypasses of this shape — a lexical `../`,
#     a planted symlink, and a project-root alias mismatch — have each been
#     found in this layer by direct testing after code review alone missed
#     them), a `../` traversal, a planted symlink into a protected path,
#     and dep-gate asking on a Bash write to a `#manifest` path (previously
#     checked only for Edit/Write).
#   - fuzz coverage for _workspace-route's path functions (_wsr_collapse,
#     _wsr_realpath, workspace_route, _wsr_glob_eq): thousands of randomly
#     generated path strings (fixed seed, reproducible) checked against
#     invariants — never-empty/idempotent/no-dot-segments for collapse,
#     always-terminates for realpath, always-absolute-or-empty ownership
#     root for workspace_route, NFC/NFD symmetry for glob_eq — each run
#     bounded so a reintroduced runaway fails loudly instead of hanging.
#
# Usage: core-selftest
# Exit 0 iff every case passes.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLOOR="$SCRIPT_DIR/floor"
ADAPTER_CONFORMANCE="$SCRIPT_DIR/adapter-conformance"

tmp_root="$(mktemp -d)"
trap 'rm -rf "$tmp_root"' EXIT
mkdir -p "$tmp_root/logs"

overall=0
fail() { echo "FAIL: $1"; overall=1; }
pass() { echo "PASS: $1"; }

result_status() { jq -r --arg c "$2" '.results[]? | select(.capability==$c) | .status' "$1" 2>/dev/null || true; }
result_present() { jq -e --arg c "$2" '.results[]? | select(.capability==$c)' "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# floor: migrate-rehearse dispatch
# ---------------------------------------------------------------------------

new_migrate_fixture() {
  # new_migrate_fixture <migrate-status> <migrate-behavior:pass|fail>
  local status="$1" behavior="$2" proj
  proj="$(mktemp -d "$tmp_root/proj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"implemented"},
  "smoke-golden": {"status":"implemented"},
  "migrate-rehearse": {"status":"$status","reason":"selftest: not wired"}
}
EOF
  # A real class-2 floor run hard-gates on smoke-run being "implemented"
  # (ADAPTER-CONTRACT.md §3.8, floor's own Class-2 gate) — the migrate-
  # rehearse cases below are only exercising migration dispatch, so the
  # smoke trio here just needs to pass cleanly, not test anything itself.
  for cap in smoke-seed smoke-run smoke-golden; do
    cat >"$proj/.spine/adapters/$cap" <<EOF
#!/bin/bash
set -euo pipefail
echo "$cap selftest stub: ok"
EOF
    chmod +x "$proj/.spine/adapters/$cap"
  done
  cat >"$proj/.spine/adapters/migrate-rehearse" <<'EOF'
#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
behavior="pass"
[[ -f "$root/migrate-behavior" ]] && behavior="$(cat "$root/migrate-behavior")"
if [[ "$behavior" == "fail" ]]; then
  echo "selftest: forced migrate-rehearse failure" >&2
  exit 1
fi
echo "migrate-rehearse selftest stub: ok"
EOF
  chmod +x "$proj/.spine/adapters/migrate-rehearse"
  echo "$behavior" >"$proj/.spine/migrate-behavior"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  printf '%s' "$proj"
}

run_floor_case() {
  # run_floor_case <name> <class> <status> <behavior> <touch-migration:yes|no>
  local name="$1" class="$2" status="$3" behavior="$4" touch="$5" proj out log code
  proj="$(new_migrate_fixture "$status" "$behavior")"
  if [[ "$touch" == "yes" ]]; then
    mkdir -p "$proj/migrations"
    echo "up" >"$proj/migrations/0001_init.sql"
  else
    echo "more" >>"$proj/src/app.js"
  fi
  git -C "$proj" add -A
  out="$tmp_root/${name}.json"
  log="$tmp_root/logs/${name}.log"
  if ( cd "$proj" && "$FLOOR" "$class" --out "$out" >"$log" 2>&1 ); then code=0; else code=$?; fi
  echo "$code|$out"
}

# Case 1: Class 2, migration touched, migrate-rehearse implemented+passing
# -> runs, recorded pass, floor exits 0.
r="$(run_floor_case case1 2 implemented pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" migrate-rehearse)" == "pass" ]]; then
  pass "floor: class 2 + migration touched + implemented -> runs and passes"
else
  fail "floor: class 2 + migration touched + implemented -> runs and passes (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 2: Class 2, migration touched, migrate-rehearse implemented+failing
# -> fail-fast, recorded fail, floor exits non-zero.
r="$(run_floor_case case2 2 implemented fail yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" != "0" && "$(result_status "$out" migrate-rehearse)" == "fail" ]]; then
  pass "floor: class 2 + migration touched + implemented, adapter fails -> floor fails"
else
  fail "floor: class 2 + migration touched + implemented, adapter fails -> floor fails (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 3: Class 2, migration touched, migrate-rehearse NOT implemented
# -> recorded as a degraded capability gap, never silently absent, floor
# still exits 0 (a degradation never fails floor by itself).
r="$(run_floor_case case3 2 unavailable pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" migrate-rehearse)" == "degraded:unavailable" ]]; then
  pass "floor: class 2 + migration touched + unavailable -> degraded gap, floor still passes"
else
  fail "floor: class 2 + migration touched + unavailable -> degraded gap, floor still passes (exit=$code status=$(result_status "$out" migrate-rehearse))"
fi

# Case 4: Class 2, migrate-rehearse implemented, but no migration path
# touched -> never invoked, no gap recorded at all.
r="$(run_floor_case case4 2 implemented pass no)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" migrate-rehearse; then
  pass "floor: class 2 + no migration path touched -> migrate-rehearse never dispatched"
else
  fail "floor: class 2 + no migration path touched -> migrate-rehearse never dispatched (exit=$code present=$(result_present "$out" migrate-rehearse && echo yes || echo no))"
fi

# Case 5: Class 1, migration path touched, migrate-rehearse implemented
# -> migrate-rehearse is a Class 2 gate only, never dispatched at Class 1.
r="$(run_floor_case case5 1 implemented pass yes)"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" migrate-rehearse; then
  pass "floor: class 1 + migration path touched -> migrate-rehearse never dispatched (Class 2 gate only)"
else
  fail "floor: class 1 + migration path touched -> migrate-rehearse never dispatched (exit=$code present=$(result_present "$out" migrate-rehearse && echo yes || echo no))"
fi

# ---------------------------------------------------------------------------
# floor: smoke_in_floor (.spine/profile.json) Class 1 opt-out
# ---------------------------------------------------------------------------
# Direct repro that motivated this coverage: with smoke implemented, cached
# well under budget, and profile.json's smoke_in_floor explicitly false,
# floor still ran smoke-seed/run/golden anyway before this was wired in —
# ADAPTER-CONTRACT.md's documented "team profile wins" precedence was pure
# prose with nothing behind it. This also guards the jq idiom itself: a
# naive `.smoke_in_floor // true` silently coerces an explicit `false` back
# to `true` (jq's `//` treats `false` as falsy, same as missing/null), so
# case 7 below fails loudly if that regresses.

new_smoke_profile_fixture() {
  # new_smoke_profile_fixture <profile.json-content-or-empty>
  local profile_json="$1" proj
  proj="$(mktemp -d "$tmp_root/smokeproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"implemented"},
  "smoke-golden": {"status":"implemented"}
}
EOF
  for cap in smoke-seed smoke-run smoke-golden; do
    cat >"$proj/.spine/adapters/$cap" <<EOF2
#!/bin/bash
set -euo pipefail
echo "$cap selftest stub: ok"
EOF2
    chmod +x "$proj/.spine/adapters/$cap"
  done
  [[ -n "$profile_json" ]] && echo "$profile_json" >"$proj/.spine/profile.json"
  # Pre-cache a runtime well under the 60s default budget so Class 1 would
  # include smoke on its own merits if smoke_in_floor didn't override it.
  echo 1 >"$proj/.spine/.smoke-runtime-seconds"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  echo "more" >>"$proj/src/app.js"
  git -C "$proj" add -A
  printf '%s' "$proj"
}

run_smoke_profile_case() {
  # run_smoke_profile_case <name> <profile.json-content-or-empty>
  local name="$1" profile_json="$2" proj out log code
  proj="$(new_smoke_profile_fixture "$profile_json")"
  out="$tmp_root/${name}.json"
  log="$tmp_root/logs/${name}.log"
  if ( cd "$proj" && "$FLOOR" 1 --out "$out" >"$log" 2>&1 ); then code=0; else code=$?; fi
  echo "$code|$out"
}

# Case 6: no profile.json -> smoke_in_floor defaults true, smoke runs.
r="$(run_smoke_profile_case case6 "")"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" smoke-run)" == "pass" ]]; then
  pass "floor: class 1, no profile.json -> smoke_in_floor defaults true, smoke runs"
else
  fail "floor: class 1, no profile.json -> smoke_in_floor defaults true, smoke runs (exit=$code status=$(result_status "$out" smoke-run))"
fi

# Case 7: smoke_in_floor: false -> smoke never dispatched, even implemented
# and cached under budget. This is the case a naive `// true` jq idiom
# would silently get wrong.
r="$(run_smoke_profile_case case7 '{"smoke_in_floor": false}')"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" ]] && ! result_present "$out" smoke-run; then
  pass "floor: class 1, smoke_in_floor:false -> smoke never dispatched despite being implemented+cached-under-budget"
else
  fail "floor: class 1, smoke_in_floor:false -> smoke never dispatched (exit=$code present=$(result_present "$out" smoke-run && echo yes || echo no))"
fi

# Case 8: smoke_in_floor: true (explicit) -> smoke runs, same as default.
r="$(run_smoke_profile_case case8 '{"smoke_in_floor": true}')"
code="${r%%|*}"; out="${r#*|}"
if [[ "$code" == "0" && "$(result_status "$out" smoke-run)" == "pass" ]]; then
  pass "floor: class 1, smoke_in_floor:true -> smoke runs"
else
  fail "floor: class 1, smoke_in_floor:true -> smoke runs (exit=$code status=$(result_status "$out" smoke-run))"
fi

# ---------------------------------------------------------------------------
# adversary-cache-tier: /verify's REUSED/FOCUSED/FULL decision
# ---------------------------------------------------------------------------
# Mechanical restatement of verify/SKILL.md's three-outcome caching rule —
# these cases are the same ones used to spot-check the script by hand
# before this coverage existed; kept here so a future edit to the tiering
# logic can't silently drift from the documented algorithm.

ACT="$SCRIPT_DIR/adversary-cache-tier"
act_proj="$(mktemp -d "$tmp_root/actproj.XXXXXX")"
mkdir -p "$act_proj/work/actT/artifacts" "$act_proj/src"
printf 'content A\n' >"$act_proj/src/a.txt"
printf 'content B\n' >"$act_proj/src/b.txt"
printf 'content C\n' >"$act_proj/src/c.txt"
act_hash_a="$(shasum -a 256 "$act_proj/src/a.txt" | awk '{print $1}')"
act_hash_b="$(shasum -a 256 "$act_proj/src/b.txt" | awk '{print $1}')"

act_check() {
  # act_check <desc> <expected> <blast-radius-lines>
  local desc="$1" expected="$2" lines="$3" got
  got="$(printf '%s' "$lines" | "$ACT" actT falsifier --project "$act_proj" 2>/dev/null || true)"
  if [[ "$got" == "$expected" ]]; then
    pass "adversary-cache-tier: $desc -> $expected"
  else
    fail "adversary-cache-tier: $desc -> expected $expected, got '$got'"
  fi
}

act_check "no coverage file yet" "FULL" "src/a.txt
src/b.txt"

jq -n --arg a "$act_hash_a" --arg b "$act_hash_b" '{files:{"src/a.txt":$a,"src/b.txt":$b}}' \
  >"$act_proj/work/actT/artifacts/falsifier-coverage.json"
act_check "full match, no prior verdict file" "REUSED" "src/a.txt
src/b.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"low"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "full match, prior verdict low-only" "REUSED" "src/a.txt
src/b.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"medium"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "full match, prior verdict has medium (not REUSED)" "FULL" "src/a.txt
src/b.txt"

act_check "partial match (c.txt uncovered), prior verdict medium" "FOCUSED" "src/a.txt
src/b.txt
src/c.txt"

jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[{severity:"high"}]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "partial match, prior verdict has high (never reduced effort)" "FULL" "src/a.txt
src/b.txt
src/c.txt"

printf 'changed\n' >"$act_proj/src/a.txt"
printf 'changed\n' >"$act_proj/src/b.txt"
jq -n '{agent:"falsifier",task_id:"actT",attacked:["x"],verdicts:[]}' \
  >"$act_proj/work/actT/artifacts/falsifier-verdict.json"
act_check "zero match (content changed)" "FULL" "src/a.txt
src/b.txt"

act_check "empty blast radius" "FULL" ""

# ---------------------------------------------------------------------------
# adapter-conformance: shell-strictness lint (ADAPTER-CONTRACT.md §2.1)
# ---------------------------------------------------------------------------

lint_proj="$(mktemp -d "$tmp_root/lintproj.XXXXXX")"
mkdir -p "$lint_proj/.spine/adapters"

write_selftest_adapter() {
  # write_selftest_adapter <path> <set-line> <extra-body>
  cat >"$1" <<EOF
#!/bin/bash
$2
if [[ "\${1:-}" == "--self-test" ]]; then
  if [[ "\${2:-}" == "pass" ]]; then echo "ok"; exit 0; fi
  if [[ "\${2:-}" == "fail" ]]; then echo "forced diagnostics" >&2; exit 1; fi
fi
$3
echo "ok"
exit 0
EOF
  chmod +x "$1"
}

write_selftest_adapter "$lint_proj/.spine/adapters/good" "set -euo pipefail" ""
write_selftest_adapter "$lint_proj/.spine/adapters/no-strict" "set -uo pipefail" ""
write_selftest_adapter "$lint_proj/.spine/adapters/bash4-unguarded" "set -euo pipefail" \
'_unused_bash4_helper() { local -A cache; cache[foo]=bar; }'
write_selftest_adapter "$lint_proj/.spine/adapters/bash4-guarded" "set -euo pipefail" \
'if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
  _unused_bash4_helper() { local -A cache; cache[foo]=bar; }
fi'

check_lint_case() {
  # check_lint_case <name> <adapter> <expect:pass|fail> [grep-for]
  local name="$1" adapter="$2" expect="$3" grepfor="${4:-}" out code=0
  out="$("$ADAPTER_CONFORMANCE" "$adapter" --project "$lint_proj" 2>&1)" || code=$?
  local got="fail"; [[ $code -eq 0 ]] && got="pass"
  if [[ "$got" != "$expect" ]]; then
    fail "adapter-conformance: $name -> expected $expect, got $got (exit $code)"
    echo "$out"
    return
  fi
  if [[ -n "$grepfor" ]] && ! grep -qF "$grepfor" <<<"$out"; then
    fail "adapter-conformance: $name -> expected diagnostics containing \"$grepfor\""
    echo "$out"
    return
  fi
  pass "adapter-conformance: $name"
}

check_lint_case "set -euo pipefail, no bash4 syntax -> conformant" good pass
check_lint_case "missing -e -> flagged, conformance fails" no-strict fail "missing 'set -euo pipefail'"
check_lint_case "unguarded bash-4-only construct -> flagged, conformance fails" bash4-unguarded fail "BASH_VERSINFO guard"
check_lint_case "bash-4-only construct behind \$BASH_VERSINFO guard -> conformant" bash4-guarded pass

# ---------------------------------------------------------------------------
# adapter-conformance: --self-test cold requirement for smoke-seed/
# smoke-run/smoke-golden (ADAPTER-CONTRACT.md §2.2, §3.8)
# ---------------------------------------------------------------------------

write_selfheal_smoke_seed() {
  # write_selfheal_smoke_seed <path> — implements pass/fail/cold correctly.
  # --self-test cold deliberately starts from its scratch stack torn down
  # and routes through the same ensure_up helper the pass path uses
  # (ADAPTER-CONTRACT.md §4's "real invocation path" rule), proving
  # self-heal is real rather than asserted.
  cat >"$1" <<'EOF'
#!/bin/bash
set -euo pipefail
ensure_up() {
  local marker="$1"
  [[ -f "$marker" ]] || : >"$marker"
}
if [[ "${1:-}" == "--self-test" ]]; then
  scratch="$(mktemp -d)"
  trap 'rm -rf "$scratch"' EXIT
  case "${2:-}" in
    pass) ensure_up "$scratch/up"; echo "smoke-seed selftest: ok"; exit 0 ;;
    fail) echo "smoke-seed selftest: forced failure" >&2; exit 1 ;;
    cold)
      # no marker pre-seeded here -> starts torn down
      ensure_up "$scratch/up"
      [[ -f "$scratch/up" ]] || { echo "self-heal did not bring stack up" >&2; exit 1; }
      echo "smoke-seed selftest: ok (self-healed from cold)"
      exit 0
      ;;
    *) echo "unknown self-test scenario: ${2:-}" >&2; exit 2 ;;
  esac
fi
echo "smoke-seed: ok"
exit 0
EOF
  chmod +x "$1"
}

write_nonhealing_smoke_seed() {
  # write_nonhealing_smoke_seed <path> — the real-world bug shape: resolves
  # pass/fail fine but assumes the stack is already up and never attempts
  # to start it, so --self-test cold fails.
  cat >"$1" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ "${1:-}" == "--self-test" ]]; then
  case "${2:-}" in
    pass) echo "smoke-seed selftest: ok"; exit 0 ;;
    fail) echo "smoke-seed selftest: forced failure" >&2; exit 1 ;;
    cold) echo "could not resolve the local stack -- is it running?" >&2; exit 1 ;;
    *) echo "unknown self-test scenario: ${2:-}" >&2; exit 2 ;;
  esac
fi
echo "smoke-seed: ok"
exit 0
EOF
  chmod +x "$1"
}

cold_proj="$(mktemp -d "$tmp_root/coldproj.XXXXXX")"
mkdir -p "$cold_proj/.spine/adapters"

write_selfheal_smoke_seed "$cold_proj/.spine/adapters/smoke-seed"
if out="$("$ADAPTER_CONFORMANCE" smoke-seed --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -eq 0 ]] && grep -qF "self-healed from cold" <<<"$out"; then
  pass "adapter-conformance: self-healing smoke-seed passes --self-test cold"
else
  fail "adapter-conformance: self-healing smoke-seed passes --self-test cold (exit=$code)"
  echo "$out"
fi

rm -f "$cold_proj/.spine/adapters/smoke-seed"
write_nonhealing_smoke_seed "$cold_proj/.spine/adapters/smoke-seed"
if out="$("$ADAPTER_CONFORMANCE" smoke-seed --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -ne 0 ]] && grep -qF "self-test cold exited" <<<"$out"; then
  pass "adapter-conformance: non-self-healing smoke-seed fails conformance via --self-test cold"
else
  fail "adapter-conformance: non-self-healing smoke-seed fails conformance via --self-test cold (exit=$code)"
  echo "$out"
fi

write_selftest_adapter "$cold_proj/.spine/adapters/test" "set -euo pipefail" ""
if out="$("$ADAPTER_CONFORMANCE" test --project "$cold_proj" 2>&1)"; then code=0; else code=$?; fi
if [[ $code -eq 0 ]] && ! grep -q "self-test cold" <<<"$out"; then
  pass "adapter-conformance: capability with no environment assumption never asked for --self-test cold"
else
  fail "adapter-conformance: capability with no environment assumption never asked for --self-test cold (exit=$code)"
  echo "$out"
fi

# ---------------------------------------------------------------------------
# floor: Class 2 smoke hard-gate (ADAPTER-CONTRACT.md §3.8) — an
# unimplemented smoke-run must fail floor outright at Class 2, never a soft
# skip. Deliberately uses a different "not implemented" status string
# ("unavailable") than the original bug report ("not-applicable") did, per
# the lesson that a fix's own repro isn't enough to trust it's general.
# ---------------------------------------------------------------------------

new_smoke_hardgate_fixture() {
  local proj
  proj="$(mktemp -d "$tmp_root/hardgateproj.XXXXXX")"
  git init -q "$proj"
  git -C "$proj" config user.email "core-selftest@example.com"
  git -C "$proj" config user.name "core-selftest"
  mkdir -p "$proj/.spine/adapters" "$proj/src"
  echo "seed" >"$proj/src/app.js"
  cat >"$proj/.spine/capabilities.json" <<EOF
{
  "typecheck": {"status":"not-applicable","reason":"selftest fixture"},
  "lint": {"status":"not-applicable","reason":"selftest fixture"},
  "test": {"status":"not-applicable","reason":"selftest fixture"},
  "secret-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "dep-diff": {"status":"not-applicable","reason":"selftest fixture"},
  "clone-scan": {"status":"not-applicable","reason":"selftest fixture"},
  "callers": {"status":"not-applicable","reason":"selftest fixture"},
  "mutate": {"status":"not-applicable","reason":"selftest fixture"},
  "smoke-seed": {"status":"implemented"},
  "smoke-run": {"status":"unavailable","reason":"selftest: deliberately not implemented"},
  "smoke-golden": {"status":"implemented"}
}
EOF
  cat >"$proj/.spine/adapters/smoke-seed" <<'EOF'
#!/bin/bash
set -euo pipefail
echo "smoke-seed selftest stub: ok"
EOF
  chmod +x "$proj/.spine/adapters/smoke-seed"
  git -C "$proj" add -A
  git -C "$proj" commit -q -m seed
  echo "more" >>"$proj/src/app.js"
  git -C "$proj" add -A
  printf '%s' "$proj"
}

hg_proj="$(new_smoke_hardgate_fixture)"
hg_out="$tmp_root/hardgate.json"
hg_log="$tmp_root/logs/hardgate.log"
if ( cd "$hg_proj" && "$FLOOR" 2 --out "$hg_out" >"$hg_log" 2>&1 ); then hg_code=0; else hg_code=$?; fi
if [[ "$hg_code" != "0" && "$(result_status "$hg_out" smoke-run)" == "fail" ]]; then
  pass "floor: class 2, smoke-run not implemented -> hard gate fails floor (not a soft skip)"
else
  fail "floor: class 2, smoke-run not implemented -> hard gate fails floor (exit=$hg_code status=$(result_status "$hg_out" smoke-run))"
fi

# ---------------------------------------------------------------------------
# hooks: phase-gate / path-escalate / dep-gate direct repro coverage
# ---------------------------------------------------------------------------
# Three separate real bypasses of this layer have each been found only by
# direct testing, after code review and the previous round's own tests
# missed them: a lexical `../` (round 1), a planted/live symlink (round 2),
# and a project-root reached through a different real alias than the one
# $file_path was given through (round 3). These cases exist so the next
# edit to _workspace-route/_bash-write-targets/the hooks themselves can't
# silently reopen any of the three. The alias case uses a self-created
# symlink rather than depending on the host's own /tmp layout, so this
# suite is portable — but exercises the identical code path a real /tmp ->
# /private/tmp alias would (ownership decided from a lexical prefix match
# with a resolved-path fallback).

PHASE_GATE="$SCRIPT_DIR/../hooks/phase-gate"
PATH_ESCALATE="$SCRIPT_DIR/../hooks/path-escalate"
DEP_GATE="$SCRIPT_DIR/../hooks/dep-gate"

new_hook_fixture() {
  local real alias
  real="$(mktemp -d "$tmp_root/hookproj.XXXXXX")"
  mkdir -p "$real/.spine" "$real/src/auth" "$real/src/other" "$real/pkg" "$real/work/T1"
  printf 'src/auth/**\npkg/manifest.json #manifest\n' >"$real/.spine/protected-paths.conf"
  printf 'npm install\n' >"$real/.spine/install-command-patterns.conf"
  echo secret >"$real/src/auth/secret.txt"
  echo '{}' >"$real/pkg/manifest.json"
  echo T1 >"$real/.spine/current-task"
  echo research >"$real/work/T1/state"
  echo 0 >"$real/work/T1/class"
  alias="$(mktemp -u "$tmp_root/hookalias.XXXXXX")"
  ln -s "$real" "$alias"
  printf '%s|%s' "$real" "$alias"
}

hook_run() {
  # hook_run <hook-bin> <CLAUDE_PROJECT_DIR-value> <json> -> "<exit>|<output>"
  local bin="$1" proj="$2" json="$3" out code=0
  out="$(CLAUDE_PROJECT_DIR="$proj" "$bin" <<<"$json" 2>&1)" || code=$?
  printf '%s|%s' "$code" "$out"
}

hook_check() {
  # hook_check <desc> <result> <expect:deny|allow|ask>
  local desc="$1" result="$2" expect="$3" code="${2%%|*}" out="${2#*|}"
  case "$expect" in
    deny) [[ "$code" != "0" ]] && pass "hooks: $desc" || fail "hooks: $desc (expected deny, got exit=$code: $out)" ;;
    allow) [[ "$code" == "0" && "$out" != *permissionDecision* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected allow, got exit=$code: $out)" ;;
    ask) [[ "$out" == *'"permissionDecision": "ask"'* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected ask, got exit=$code: $out)" ;;
  esac
}

hook_run_bounded() {
  # hook_run_bounded <timeout-seconds> <hook-bin> <CLAUDE_PROJECT_DIR-value>
  # <json> -> "<exit>|<elapsed-seconds>|<output>", where exit is the literal
  # string "timeout" if the process was still running after
  # <timeout-seconds>. No `timeout`/`gtimeout` binary is assumed present
  # (neither is on this machine) — a portable background-job + poll + kill
  # instead. Exists specifically for the round-4 empty-array/runaway-
  # recursion regression case: without a bound, a reintroduced version of
  # that bug would eventually self-terminate via the host's own process
  # limits (a real, but non-deterministic and environment-dependent, exit
  # path) rather than reliably fail this suite — <elapsed-seconds> lets
  # hook_check_fast assert real speed, not just "some non-zero exit
  # eventually happened," since a resource-exhaustion crash can itself
  # produce a non-zero exit that would otherwise be indistinguishable from
  # a correct, fast, intentional deny.
  local bound="$1" bin="$2" proj="$3" json="$4" outfile pid waited=0 code out
  outfile="$(mktemp "$tmp_root/hookbounded.XXXXXX")"
  ( CLAUDE_PROJECT_DIR="$proj" "$bin" <<<"$json" >"$outfile" 2>&1
    echo "$?" >"$outfile.code" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt $bound ]]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    printf 'timeout|%s|still running after %ss' "$bound" "$bound"
    return
  fi
  wait "$pid" 2>/dev/null
  code="$(cat "$outfile.code" 2>/dev/null)"; code="${code:-1}"
  out="$(cat "$outfile" 2>/dev/null)"
  printf '%s|%s|%s' "$code" "$waited" "$out"
}

hook_check_fast() {
  # hook_check_fast <desc> <result-from-hook_run_bounded> <expect:deny|allow>
  # <max-seconds> — like hook_check, but additionally fails if the process
  # took anywhere near <max-seconds> (including the literal "timeout"
  # outcome): a fork-bomb regression can crash out with a real, otherwise-
  # plausible-looking non-zero exit once the host's own process/fork limits
  # kick in, which is a *symptom* of the runaway, not a legitimate fast
  # deny — confirmed directly: a reverted pre-fix build of this codepath
  # produced exactly that shape (a real deny-looking exit, reached only
  # after several seconds and thousands of forked subprocesses).
  local desc="$1" result="$2" expect="$3" max="$4"
  local code="${result%%|*}" rest="${result#*|}" elapsed="${rest%%|*}" out="${rest#*|}"
  if [[ "$code" == "timeout" ]]; then
    fail "hooks: $desc (hung past ${max}s — runaway, not a fast decision)"
    return
  fi
  if [[ "$elapsed" -ge "$max" ]]; then
    fail "hooks: $desc (took ${elapsed}s, expected well under ${max}s — likely the same runaway resolving via host resource limits rather than a real fast decision; got exit=$code: $out)"
    return
  fi
  case "$expect" in
    deny) [[ "$code" != "0" ]] && pass "hooks: $desc" || fail "hooks: $desc (expected deny, got exit=$code: $out)" ;;
    allow) [[ "$code" == "0" && "$out" != *permissionDecision* ]] && pass "hooks: $desc" || fail "hooks: $desc (expected allow, got exit=$code: $out)" ;;
  esac
}

hf="$(new_hook_fixture)"
hook_real="${hf%%|*}"
hook_alias="${hf#*|}"

hook_check "path-escalate denies canonical protected path (control)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a protected path reached via a project-root alias" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a Bash write to a protected path via a project-root alias" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"echo pwned > '"$hook_alias"'/src/auth/secret.txt"}}')" deny

hook_check "phase-gate denies an out-of-task-dir write reached via a project-root alias" \
  "$(hook_run "$PHASE_GATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/src/other/x.txt"}}')" deny

hook_check "dep-gate asks on a manifest write reached via a project-root alias" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_alias"'/pkg/manifest.json"}}')" ask

hook_check "dep-gate asks on a Bash write to a #manifest path (not just Edit/Write)" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"echo x > '"$hook_real"'/pkg/manifest.json"}}')" ask

hook_check "dep-gate asks on a Bash sed -i to a #manifest path" \
  "$(hook_run "$DEP_GATE" "$hook_real" '{"tool_name":"Bash","tool_input":{"command":"sed -i \"\" -e s/a/b/ '"$hook_real"'/pkg/manifest.json"}}')" ask

hook_check "path-escalate allows a genuinely unrelated external path (control)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$tmp_root"'/unrelated.txt"}}')" allow

hook_check "path-escalate denies (reverse alias direction: project via alias, target canonical)" \
  "$(hook_run "$PATH_ESCALATE" "$hook_alias" '{"tool_name":"Write","tool_input":{"file_path":"'"$hook_real"'/src/auth/secret.txt"}}')" deny

hook_check "path-escalate denies a ../ traversal to a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"src/other/../auth/secret.txt"}}')" deny

ln -sf "$hook_real/src/auth/secret.txt" "$hook_real/src/other/innocuous.txt"
hook_check "path-escalate denies a planted symlink into a protected path" \
  "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"src/other/innocuous.txt"}}')" deny
rm -f "$hook_real/src/other/innocuous.txt"

# Round 4: a relative CLAUDE_PROJECT_DIR, or a ../ chain deep enough to
# cancel a whole absolute project prefix to nothing, drove _wsr_collapse's
# empty-array dereference into a silently-swallowed crash whose caller
# (_wsr_realpath) then recursed forever on the resulting "" — a genuine
# multi-thousand-subprocess runaway that still resolved to fail-open.
# Bounded so a regression here fails fast instead of just running long.
hook_check_fast "path-escalate fails closed on a relative CLAUDE_PROJECT_DIR, fast (not a runaway that only eventually deny-shaped-crashes)" \
  "$(hook_run_bounded 20 "$PATH_ESCALATE" "hookproj-relative" '{"tool_name":"Write","tool_input":{"file_path":"src/auth/secret.txt"}}')" deny 5

hook_check_fast "path-escalate resolves a root-cancelling ../ chain fast, without a runaway (control: genuinely outside project, so allow is correct)" \
  "$(hook_run_bounded 20 "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"../../../../../../../../../../../../../../../../../../../../src/auth/secret.txt"}}')" allow 5

# Round 4: an NFC- and an NFD-encoded (byte-distinct) form of the same
# accented path name the identical real file on a normalization-insensitive
# filesystem (APFS/HFS+), but a bare bash glob comparison is byte-level —
# a protected-paths.conf glob written in one form silently missed a
# file_path given in the other. Skipped if python3 (the only normalizer
# _wsr_nfc uses) isn't on PATH, matching that helper's own fallback.
if command -v python3 >/dev/null 2>&1; then
  nfc_dir="$(python3 -c "print('café')")"
  nfd_dir="$(python3 -c "import unicodedata; print(unicodedata.normalize('NFD', 'café'))")"
  mkdir -p "$hook_real/src/other/$nfc_dir"
  echo secret >"$hook_real/src/other/$nfc_dir/x.txt"
  printf 'src/other/%s/**\n' "$nfc_dir" >>"$hook_real/.spine/protected-paths.conf"
  nfd_file_path="src/other/${nfd_dir}/x.txt"
  hook_check "path-escalate denies the NFD byte-form of a glob registered in NFC form (same real file)" \
    "$(hook_run "$PATH_ESCALATE" "$hook_real" '{"tool_name":"Write","tool_input":{"file_path":"'"$nfd_file_path"'"}}')" deny
else
  echo "hooks: SKIP NFC/NFD case — python3 not on PATH"
fi

# ---------------------------------------------------------------------------
# fuzz: property-based coverage for _workspace-route's path functions
# ---------------------------------------------------------------------------
# Round 5. Four rounds of hand-picked adversarial scenarios found six
# distinct hooks bypass mechanisms (../, symlink, alias mismatch, dep-gate's
# missing Bash branch, a bash-3.2 empty-array crash, NFC/NFD) — one new
# mechanism almost every round, including a genuine bug inside the shared
# normalizer itself (round 4) that three prior rounds of hand-testing never
# tried. Rather than add another hand-picked scenario, this generates a
# large corpus of randomized path strings (varying segment count, ./..
# density, leading/trailing/doubled slashes, empty segments, non-ASCII in
# both NFC and NFD form, absolute vs. relative) and asserts invariants that
# must hold regardless of input shape, independent of any specific bug
# anyone has thought to check for.
#
# python3 generates the corpus (already an accepted core-selftest/_wsr_nfc
# dependency, same graceful-fallback posture: a smaller bash-only corpus if
# python3 isn't on PATH, never a hard failure). The seed is fixed
# (20260823) deliberately, not truly randomized per run — this is wired in
# as a permanent regression case, and a fixed corpus that fails
# reproducibly is more valuable here than a different one every run that
# can't be re-run to confirm a fix. The corpus includes explicit copies of
# every prior round's own trigger shape (a root-cancelling ../ chain, a
# relative "project"-shaped string, a bare empty string, all-slash strings)
# alongside genuine random generation, so a regression of any prior finding
# is caught by this section even before the random half runs at all.
#
# Every fuzz section runs under a bounded background job (same
# fork+poll+kill pattern as hook_run_bounded, since neither timeout nor
# gtimeout exists on this host) so a reintroduced runaway hangs the section
# for at most its bound, not the whole suite indefinitely — the section
# then fails loudly ("hung past Ns") instead of the run just never
# finishing. Bounds are sized generously (5-10x a clean run's observed
# time on this host) so ordinary machine slowness doesn't false-positive.
#
# Unlike the rest of this "hooks:" section (which execs phase-gate/
# path-escalate/dep-gate as real subprocesses via hook_run/hook_run_bounded),
# fuzzing calls _workspace-route's own functions directly in-process — the
# whole point is exercising _wsr_collapse/_wsr_realpath/_wsr_glob_eq/
# workspace_route themselves, not a hook wrapper around them — so this file
# needs its own `source`, never implicitly inherited from anywhere else.
source "$SCRIPT_DIR/../hooks/_workspace-route"
declare -F workspace_route >/dev/null || { echo "core-selftest: _workspace-route did not load — cannot run the fuzz section" >&2; exit 1; }

_wsr_fuzz_gen_paths() {
  # _wsr_fuzz_gen_paths <n> -> n path strings on stdout, one per line.
  local n="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$n" <<'PYEOF'
import random, sys
random.seed(20260823)
n = int(sys.argv[1])
segs_pool = ["a", "bb", "ccc", "d.e", "x-y", "z_1", "..", ".", "",
             "café", "日本語", "🎉", "emoji😀name", "a..b", "...",
             "  spaced  ", "a b", "-", "~"]
def rand_path():
    depth = random.randint(0, 10)
    parts = [random.choice(segs_pool) for _ in range(depth)]
    lead = random.choice(["", "/", "//", "///"])
    trail = random.choice(["", "/", "//"])
    return (lead + "/".join(parts) + trail).replace("\n", " ")
edge_cases = [
    "", "/", "..", "../..", ".", "./.", "/./../", "//////",
    "///a///b///", "/" + "../"*30 + "etc/passwd", "../"*30 + "etc/passwd",
    "a/" + "../"*5, "/a/b/../../../../..", "proj", "proj/work/T1",
]
out = list(edge_cases)
for _ in range(max(0, n - len(edge_cases))):
    out.append(rand_path())
for p in out:
    print(p)
PYEOF
  else
    local i j depth parts pool=("a" "bb" ".." "." "" "x-y" "z_1")
    printf '%s\n' "" "/" ".." "../.." "." "proj" "proj/work/T1"
    for ((i = 0; i < n; i++)); do
      depth=$((RANDOM % 6)); parts=""
      for ((j = 0; j < depth; j++)); do
        parts+="/${pool[$((RANDOM % ${#pool[@]}))]}"
      done
      [[ $((RANDOM % 2)) -eq 0 ]] && printf '%s\n' "$parts" || printf '%s\n' "${parts#/}"
    done
  fi
}

fuzz_run_bounded() {
  # fuzz_run_bounded <label> <bound-seconds> <body-fn> — runs <body-fn> in a
  # backgrounded subshell (so a hang can be killed rather than blocking the
  # suite), captures its stdout, and reports one aggregated pass/fail via
  # the suite's own fail()/pass(). <body-fn> must print exactly one
  # "FUZZSUMMARY: pass=<n> fail=<n>" line, plus one "FUZZDETAIL: <msg>" line
  # per failing case (subshell state doesn't propagate to the parent, so
  # aggregation happens here by parsing that output, not by touching
  # $overall/$fail_count from inside the background job).
  local label="$1" bound="$2" fn="$3" outfile pid waited=0
  outfile="$(mktemp "$tmp_root/fuzzout.XXXXXX")"
  # The subshell's own exit status must always be 0, deliberately — same
  # trick hook_run_bounded already uses, for the same reason: if <body-fn>
  # itself crashes (set -e killing it mid-loop on a reintroduced bug —
  # exactly the negative-control scenario this section exists to catch),
  # a bare `( "$fn" ... ) &` would propagate that non-zero status through
  # `wait "$pid"` below and kill this *entire suite* under its own set -e,
  # with no FAIL line and no indication which section crashed or why —
  # confirmed by direct negative control (reverting the _wsr_collapse fix
  # this section exists to guard) before this echo-wrap was added: exit
  # 1, zero output, no diagnostic. The echo-wrapped exit code is written
  # but intentionally unused below — a crash is instead detected the same
  # way a clean "fail=N>0" run is, via the missing/malformed FUZZSUMMARY
  # line, which is a strictly more informative signal than a bare exit code.
  ( "$fn" >"$outfile" 2>&1; echo "$?" >"$outfile.code" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt $bound ]]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null || true
    fail "fuzz: $label hung past ${bound}s — treating as a runaway, not a slow-but-correct pass"
    return
  fi
  wait "$pid" 2>/dev/null || true
  local summary details
  # `|| true` on both: grep exits 1 on zero matches (pipefail then propagates
  # that through `| head`/`| tail`), and under this script's own set -e that
  # would silently kill the suite on the *good* outcome (zero FUZZDETAIL
  # lines, i.e. every case passed) — the exact bug class round 3's
  # ledger-field-audit fix already named once (a zero-match grep dying
  # under set -e), reproduced here while building this round's own fuzz
  # harness and caught by actually running it, not by review.
  summary="$(grep '^FUZZSUMMARY:' "$outfile" | tail -1)" || true
  details="$(grep '^FUZZDETAIL:' "$outfile" | head -10)" || true
  if [[ -z "$summary" ]]; then
    fail "fuzz: $label produced no summary line (crashed? see $outfile)"
    return
  fi
  if [[ "$summary" == *"fail=0"* ]]; then
    pass "fuzz: $label — ${summary#FUZZSUMMARY: }"
  else
    fail "fuzz: $label — ${summary#FUZZSUMMARY: }"$'\n'"$details"
  fi
}

_wsr_fuzz_collapse_body() {
  # Invariants (never dependent on knowing any specific bug in advance):
  #   1. never returns empty (always at least "/")
  #   2. idempotent: collapse(collapse(x)) == collapse(x)
  #   3. output never contains a "." or ".." path segment
  local n=0 fails=0 input result result2 part bad_seg
  local -a parts
  while IFS= read -r input; do
    n=$((n + 1))
    result="$(_wsr_collapse "$input" 2>&1)"
    if [[ -z "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse('$input') returned empty (want at least '/')"
      continue
    fi
    result2="$(_wsr_collapse "$result" 2>&1)"
    if [[ "$result2" != "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse not idempotent: collapse('$input')='$result' but collapse(that)='$result2'"
      continue
    fi
    bad_seg=0
    IFS='/' read -ra parts <<<"$result"
    for part in "${parts[@]:-}"; do
      [[ "$part" == '.' || "$part" == '..' ]] && bad_seg=1
    done
    if [[ "$bad_seg" -eq 1 ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_collapse('$input') = '$result' still contains a . or .. segment"
    fi
  done < <(_wsr_fuzz_gen_paths 3000)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_realpath_body() {
  # Invariant: never hangs (bounded by the caller) and always terminates
  # with *some* string — this is the function whose unbounded recursion
  # produced round 4's multi-thousand-process runaway, so "terminates at
  # all, within the bounded wrapper" is itself the load-bearing check here,
  # not any particular return value (there's no single "correct" realpath
  # for an arbitrary, mostly-nonexistent fuzzed string).
  local n=0 fails=0 input result
  while IFS= read -r input; do
    n=$((n + 1))
    result="$(_wsr_realpath "$input" 2>&1)"
    if [[ -z "$result" ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_realpath('$input') returned empty"
    fi
  done < <(_wsr_fuzz_gen_paths 800)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_route_body() {
  # Invariant: WSR_OWNER_ROOT is always either the empty string or an
  # absolute path — never anything else, regardless of how malformed
  # $file_path is (including deliberately relative/empty $project values,
  # which must fail closed per workspace_route's own precondition check
  # rather than ever producing a non-absolute WSR_OWNER_ROOT).
  local real_proj n=0 fails=0 fp proj_choice proj
  real_proj="$(mktemp -d "$tmp_root/wsrfuzzproj.XXXXXX")"
  mkdir -p "$real_proj/.spine" "$real_proj/work/T1"
  while IFS= read -r fp; do
    n=$((n + 1))
    proj_choice=$((n % 3))
    case "$proj_choice" in
      0) proj="$real_proj" ;;
      1) proj="relative-proj-$n" ;;
      2) proj="" ;;
    esac
    # `|| true`: workspace_route deliberately returns 1 (fail-closed) for
    # the relative/empty $proj cases this loop intentionally generates —
    # under this script's set -e a bare non-zero return here would abort
    # the whole fuzz body on the very first such case instead of letting
    # every case run; the invariant under test is WSR_OWNER_ROOT's shape
    # regardless of workspace_route's own return code.
    workspace_route "$proj" "$fp" >/dev/null 2>&1 || true
    if [[ -n "$WSR_OWNER_ROOT" ]]; then
      case "$WSR_OWNER_ROOT" in
        /*) : ;;
        *)
          fails=$((fails + 1))
          echo "FUZZDETAIL: workspace_route(project='$proj', file_path='$fp') left WSR_OWNER_ROOT='$WSR_OWNER_ROOT' non-absolute"
          ;;
      esac
    fi
  done < <(_wsr_fuzz_gen_paths 800)
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

_wsr_fuzz_globeq_body() {
  # Invariant: _wsr_glob_eq's result must not depend on which of the two
  # sides (rel, glob) happens to be in NFC vs. NFD form — all four
  # combinations of a name compared against itself must agree. Smaller
  # corpus than the others (each case pays two real python3 subprocess
  # calls to build the NFC/NFD forms), but breadth here is about covering
  # a variety of real accented/CJK/emoji shapes, not path-structure
  # combinatorics. Skipped entirely if python3 isn't on PATH, matching
  # _wsr_nfc's own fallback (byte comparison only, disclosed limit).
  local n=0 fails=0 base nfc nfd r1 r2 r3 r4
  if ! command -v python3 >/dev/null 2>&1; then
    echo "FUZZSUMMARY: pass=0 fail=0 (of 0 cases) — SKIPPED, no python3 on PATH"
    return
  fi
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    n=$((n + 1))
    nfc="$(python3 -c "import unicodedata,sys; sys.stdout.write(unicodedata.normalize('NFC', sys.argv[1]))" "$base")"
    nfd="$(python3 -c "import unicodedata,sys; sys.stdout.write(unicodedata.normalize('NFD', sys.argv[1]))" "$base")"
    r1=0; r2=0; r3=0; r4=0
    _wsr_glob_eq "$nfc" "$nfc" && r1=1
    _wsr_glob_eq "$nfc" "$nfd" && r2=1
    _wsr_glob_eq "$nfd" "$nfc" && r3=1
    _wsr_glob_eq "$nfd" "$nfd" && r4=1
    if [[ "$r1" -ne 1 || "$r2" -ne 1 || "$r3" -ne 1 || "$r4" -ne 1 ]]; then
      fails=$((fails + 1))
      echo "FUZZDETAIL: _wsr_glob_eq asymmetric for '$base': nfc/nfc=$r1 nfc/nfd=$r2 nfd/nfc=$r3 nfd/nfd=$r4 (all should be 1)"
    fi
  done < <(printf '%s\n' "café" "naïve" "Zürich" "日本語ファイル" "emoji😀name" "ÀÉÎÕÜ" "áb́c" "xéy" "plain" "has space é" "Café's file" "İstanbul" "north's café" "🏳️‍🌈flag" "über" "façade" "señor" "coöperate" "résumé" "naïve café")
  echo "FUZZSUMMARY: pass=$((n - fails)) fail=$fails (of $n cases)"
}

fuzz_run_bounded "_wsr_collapse: never-empty, idempotent, no ./.. segments (3000 generated cases)" 60 _wsr_fuzz_collapse_body
fuzz_run_bounded "_wsr_realpath: always terminates with a non-empty result (800 generated cases)" 90 _wsr_fuzz_realpath_body
fuzz_run_bounded "workspace_route: WSR_OWNER_ROOT always empty-or-absolute (800 generated cases)" 90 _wsr_fuzz_route_body
fuzz_run_bounded "_wsr_glob_eq: NFC/NFD-symmetric (20 real accented/CJK/emoji names)" 60 _wsr_fuzz_globeq_body

# ---------------------------------------------------------------------------
# ledger: harvest's message.id dedup + additive-sum behavior
# ---------------------------------------------------------------------------
# `ledger harvest` sums a transcript's token usage into a ledger phase. Two
# real properties, neither previously covered by any permanent test:
# (a) one real API call (one message.id) logs as several transcript lines
# (a thinking block, a tool_use block, etc.), each carrying an identical
# copy of that call's own usage — confirmed against a real Claude Code
# session transcript, where an undeduped sum would double- (or more-)count
# every multi-block turn; unique_by(.message.id) exists to prevent this.
# (b) harvesting the same phase key twice (verify's real fix-and-reverify
# flow, a re-dispatched adversary round) must ADD to the existing tokens,
# not overwrite them — a real installed project's ledger.json once worked
# around a plain-overwrite bug by inventing a second "-round2" key instead.

LEDGER="$SCRIPT_DIR/ledger"

ledger_test_fixture() {
  local proj task_dir
  proj="$(mktemp -d "$tmp_root/ledgerproj.XXXXXX")"
  mkdir -p "$proj/work/LT1"
  "$LEDGER" init LT1 --project "$proj" >/dev/null
  printf '%s' "$proj"
}

lproj="$(ledger_test_fixture)"

# message.id "m1" appears twice (thinking + tool_use blocks of the same
# real call) with identical usage; "m2" is a genuinely distinct call.
# Correct dedup sums exactly once per unique message.id: input 100+30=130,
# output 50+15=65.
transcript="$tmp_root/ledger-transcript.jsonl"
cat >"$transcript" <<'JSONL'
{"type":"assistant","timestamp":"2026-08-22T10:00:00Z","message":{"id":"m1","usage":{"input_tokens":100,"output_tokens":50,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}
{"type":"assistant","timestamp":"2026-08-22T10:00:01Z","message":{"id":"m1","usage":{"input_tokens":100,"output_tokens":50,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}
{"type":"assistant","timestamp":"2026-08-22T10:00:02Z","message":{"id":"m2","usage":{"input_tokens":30,"output_tokens":15,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}
JSONL

"$LEDGER" harvest LT1 implement --transcript "$transcript" --from 2026-08-22T09:59:00Z --to 2026-08-22T10:01:00Z --project "$lproj" >/dev/null

got_input="$(jq -r '.phases.implement.tokens.input' "$lproj/work/LT1/ledger.json")"
got_output="$(jq -r '.phases.implement.tokens.output' "$lproj/work/LT1/ledger.json")"
if [[ "$got_input" == "130" && "$got_output" == "65" ]]; then
  pass "ledger: harvest dedups repeated message.id blocks from the same real call before summing"
else
  fail "ledger: harvest dedup (expected input=130 output=65, got input=$got_input output=$got_output)"
fi

# Second harvest of the SAME phase key (re-dispatched round) must ADD, not
# overwrite: a second transcript with one new message.id, input 10.
transcript2="$tmp_root/ledger-transcript2.jsonl"
cat >"$transcript2" <<'JSONL'
{"type":"assistant","timestamp":"2026-08-22T11:00:00Z","message":{"id":"m3","usage":{"input_tokens":10,"output_tokens":5,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}
JSONL
"$LEDGER" harvest LT1 implement --transcript "$transcript2" --from 2026-08-22T10:59:00Z --to 2026-08-22T11:01:00Z --project "$lproj" >/dev/null
got_input2="$(jq -r '.phases.implement.tokens.input' "$lproj/work/LT1/ledger.json")"
if [[ "$got_input2" == "140" ]]; then
  pass "ledger: harvest sums additively into an already-harvested phase key, not overwrite"
else
  fail "ledger: harvest additive-sum (expected input=140 after second harvest, got $got_input2)"
fi

# ---------------------------------------------------------------------------
# render-task: two round-4 fixes to the per-task HTML report, previously
# uncovered by any permanent test (round 3's own report flagged this as a
# gap across ledger/render-task/render-dashboard; this closes it for the
# two bugs actually fixed this round, not the whole surface).
# ---------------------------------------------------------------------------

RENDER_TASK="$SCRIPT_DIR/render-task"

render_task_fixture() {
  # render_task_fixture <ledger-json-body> -> "<project>|<report-html>"
  local body="$1" proj report
  proj="$(mktemp -d "$tmp_root/rtproj.XXXXXX")"
  mkdir -p "$proj/work/RT1"
  printf '%s' "$body" >"$proj/work/RT1/ledger.json"
  report="$tmp_root/rtreport-$$-$RANDOM.html"
  "$RENDER_TASK" --task RT1 --project "$proj" --out "$report" >/dev/null 2>&1
  printf '%s|%s' "$proj" "$report"
}

# A phase whose own `marked_at` is present but whose harvest never
# happened (a real, confirmed shape: the mark and the harvest are two
# separate calls, and sessions reliably make the former without reliably
# also making the latter) must not render as a bare "0 tok" — that reads
# as "this phase genuinely cost nothing," not "this phase's cost was never
# recorded." Real elapsed duration since the previous phase is the signal.
rt1="$(render_task_fixture '{
  "phases": {
    "research": {"marked_at": "2026-08-21T18:00:00Z", "tokens": {"input": 1000, "output": 500, "cache_create": 0, "cache_read": 0}},
    "implement": {"marked_at": "2026-08-21T19:30:00Z", "tokens": {"input": 0, "output": 0, "cache_create": 0, "cache_read": 0}}
  }
}')"
rt1_html="${rt1#*|}"
if grep -q '0 tok (not recorded)' "$rt1_html" 2>/dev/null; then
  pass "render-task: a marked-but-unharvested phase with real elapsed duration shows a (not recorded) caveat, not a bare 0 tok"
else
  fail "render-task: expected '0 tok (not recorded)' caveat for the unharvested implement phase, not found in $rt1_html"
fi

# briefing_word_count and briefing_line_count are written by two separate
# `ledger set` calls in the same ship/SKILL.md step, not atomically — a
# briefing missing only its line count must not silently lose its
# over-cap flag along with it (round-4 bug: the whole block was nested
# under the line-count field alone).
rt2="$(render_task_fixture '{"phases": {}, "briefing_word_count": 805}')"
rt2_html="${rt2#*|}"
if grep -q 'briefing.md length' "$rt2_html" 2>/dev/null && grep -q 'over the ~1-page cap' "$rt2_html" 2>/dev/null; then
  pass "render-task: an over-cap briefing word count still renders when the line count field is absent"
else
  fail "render-task: expected a briefing.md over-cap line despite missing briefing_line_count, not found in $rt2_html"
fi

if [[ $overall -eq 0 ]]; then
  echo "core-selftest: PASS"
else
  echo "core-selftest: FAIL — see above"
fi
exit $overall
