#!/bin/bash
# second-approver-check — Class 2's second-approver gate, as a real
# executable with a real exit code, not just skill prose describing the
# logic. Extracted during Phase D's self-red-team ("populated but not
# gated" sweep): every other Extension C gate (claims-check, propagate)
# has a script backing its check that a human or a future automated
# caller — the design intent being that every check here is a script CI
# could invoke — can run independently and get a real answer from; this
# one didn't, until now — it was jq logic embedded in ship/SKILL.md's
# prose, verified only by hand-running matching commands. Same shape as
# claims-check now: one script, one job, real exit codes.
#
# Usage: second-approver-check <task-id> --project <path>
# Exit: 0 clear to proceed (stdout says whether it's a real second
#   approver or a recorded, loud override — /ship's briefing/ledger
#   steps read this distinction from the same JSON `--out` would write,
#   or by re-reading approval.json directly, either is fine, this script
#   doesn't gate that formatting). 1 halt — no approval.json, or
#   self-approved without an override. 2 usage error.
set -uo pipefail

usage() { echo "usage: second-approver-check <task-id> --project <path>" >&2; exit 2; }

[[ $# -ge 1 ]] || usage
task_id="$1"; shift
project=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$project" ]] || usage

owner_file="$project/work/$task_id/owner"
approval_file="$project/work/$task_id/approval.json"

[[ -f "$owner_file" ]] || { echo "second-approver-check: $owner_file not found" >&2; exit 2; }

if [[ ! -f "$approval_file" ]]; then
  printf '%s\n' \
    "What happened: HALT — no approval.json for $task_id, so the plan was never approved." \
    "What it means for you: this is a Class 2 (the highest-risk kind of change: needs a second person's approval) task, so I can't start implementing." \
    "To continue: have a colleague read work/$task_id/plan.md and record their approval, or record your own with a stated reason." >&2
  exit 1
fi

owner="$(cat "$owner_file")"
approver="$(jq -r '.approver // empty' "$approval_file")"
override="$(jq -r '.override // false' "$approval_file")"
reason="$(jq -r '.override_reason // empty' "$approval_file")"

if [[ -z "$approver" ]]; then
  printf '%s\n' \
    "What happened: HALT — approval.json for $task_id has no 'approver' field, so I can't tell who approved the plan." \
    "What it means for you: I can't start implementing until the approval names a person." \
    "To continue: have the approver re-record their approval with their name filled in." >&2
  exit 1
fi

if [[ "$approver" == "$owner" && "$override" != "true" ]]; then
  printf '%s\n' \
    "What happened: HALT — the approver ($approver) is the same identity as owner, and no override is recorded." \
    "What it means for you: a Class 2 (the highest-risk kind of change: needs a second person's approval) plan can't be approved by the person who owns it." \
    "To continue: have a different person approve, or the owner can record a self-approval with a stated reason." >&2
  exit 1
fi

if [[ "$override" == "true" ]]; then
  echo "second-approver-check: PROCEED — self-approved override recorded. reason: ${reason:-<none given>}"
  exit 0
fi

echo "second-approver-check: PROCEED — real second approver on record: $approver"
exit 0
