#!/bin/bash
# decision-index — regenerates docs/decisions/INDEX.md: one row per
# docs/decisions/D-*.md record (id, title, category, scope, status,
# supersedes/superseded-by), stamped with the sha it was generated
# against. Same spirit as core/scripts/render-dashboard's aggregation and
# core/templates/map.md's "never hand-maintained, regenerated by a
# script" discipline — this is a mechanical extraction (grep/awk over
# each record's fixed field shape), never an LLM summary, so it carries
# no independent trust: every real citation still has to open the actual
# record and compute its own core/scripts/decision-hash. This file exists
# purely to make triage cheap at scale ("which 2-3 records are even worth
# opening"), not to replace verification.
#
# Multi-repo (Extension B): docs/decisions/ may exist at the workspace
# root, in any member repo (workspace.json's repos[]), or both — same
# qualification convention core/agents/researcher.md and check-stale
# already use. Each repo's own store gets its own INDEX.md, written at
# that repo's own docs/decisions/INDEX.md, stamped with that repo's own
# sha — never one merged cross-repo index, matching check-stale's own
# repo-scoped sha model (a workspace-root INDEX.md governs only its own
# unqualified store).
#
# --check verifies the committed INDEX.md matches what a fresh generation
# would produce right now (ignoring only the `generated:` timestamp line,
# which legitimately differs on every run) instead of overwriting it —
# for a mechanical pre-commit/CI staleness check that a decisions/ edit
# didn't skip regenerating the index. Exits non-zero and names each
# store that drifted; writes nothing to disk either way.
#
# Usage: decision-index --project <path> [--check]
set -uo pipefail

usage() { echo "usage: decision-index --project <path> [--check]" >&2; exit 2; }

project=""
check=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --check) check=1; shift ;;
    *) usage ;;
  esac
done
[[ -n "$project" ]] || usage
project="$(cd "$project" && pwd)" || { echo "decision-index: $project not found" >&2; exit 2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

field() {
  # field <file> <label> — value after "- <label>: " on its own line, or
  # empty. Same fixed field shape core/templates/decision.md defines.
  awk -F': ' -v want="- $2:" '$0 ~ "^"want" " {sub(/^[^:]*: /, ""); print; exit}' "$1"
}

title_of() {
  awk '/^# / {sub(/^# /, ""); print; exit}' "$1"
}

render_index() {
  # render_index <decisions-dir> <sha> <generated> — the table-generation
  # logic itself, factored out so --check can render into a scratch file
  # and diff it (modulo the generated: line) rather than reimplementing
  # this in a second place — same "single source of truth for the
  # algorithm" reasoning core/scripts/decision-hash's own header states.
  local dir="$1" sha="$2" generated="$3"
  shopt -s nullglob
  local files=("$dir"/D-*.md)
  shopt -u nullglob

  {
    echo "<!-- spine:decision-index"
    echo "sha: $sha"
    echo "generated: $generated"
    echo "-->"
    echo
    echo "# Decision index"
    echo
    echo "Generated by \`core/scripts/decision-index\`. Never hand-maintained —"
    echo "if a row here is wrong, regenerate rather than editing this file"
    echo "directly. A triage aid only: every real citation still opens the"
    echo "actual \`D-<n>-*.md\` record and computes its own"
    echo "\`core/scripts/decision-hash\` — nothing here is cited directly."
    echo
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "No decisions recorded yet."
    else
      echo "| Id | Title | Category | Status | Scope | Supersedes | Superseded-by |"
      echo "|---|---|---|---|---|---|---|"
      # Sort by numeric id (D-<n>-...) so the table reads in decision
      # order regardless of filesystem/glob ordering.
      local sorted=()
      while IFS= read -r f; do sorted+=("$f"); done < <(
        for f in "${files[@]}"; do
          local base id
          base="$(basename "$f")"
          id="${base#D-}"; id="${id%%-*}"
          printf '%s\t%s\n' "$id" "$f"
        done | sort -n -k1,1 | cut -f2-
      )
      for f in "${sorted[@]}"; do
        local id title category status scope supersedes superseded_by
        id="$(field "$f" Id)"
        title="$(title_of "$f")"
        category="$(field "$f" Category)"
        status="$(field "$f" Status)"
        scope="$(field "$f" Scope)"
        supersedes="$(field "$f" Supersedes)"
        superseded_by="$(field "$f" Superseded-by)"
        # Table-cell escaping: a literal `|` in any field would break the
        # row; decision.md's own field grammar never expects one, but
        # escape defensively rather than trust every past/future record.
        title="${title//|/\\|}"; scope="${scope//|/\\|}"
        printf '| %s | %s | %s | %s | %s | %s | %s |\n' \
          "${id:-?}" "${title:-?}" "${category:-?}" "${status:-?}" \
          "${scope:-?}" "${supersedes:-?}" "${superseded_by:-?}"
      done
    fi
  }
}

process_store() {
  # process_store <decisions-dir> <repo-root> — either writes
  # <decisions-dir>/INDEX.md (default) or, under --check, renders to a
  # scratch file and diffs it against the committed one (ignoring only
  # the generated: line) without touching disk.
  local dir="$1" repo_root="$2"
  local out="$dir/INDEX.md"

  local sha
  sha="$(cd "$repo_root" && git rev-parse HEAD 2>/dev/null)"
  if [[ -z "$sha" ]]; then
    echo "decision-index: $repo_root is not a git repo (or has no commits yet) — skipping $out" >&2
    return 1
  fi
  local generated
  generated="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local file_count
  file_count=$(shopt -s nullglob; local f=("$dir"/D-*.md); shopt -u nullglob; echo "${#f[@]}")

  if [[ "$check" -eq 1 ]]; then
    if [[ ! -f "$out" ]]; then
      echo "decision-index --check: STALE — $out does not exist" >&2
      return 1
    fi
    local scratch
    scratch="$(mktemp)"
    render_index "$dir" "$sha" "$generated" > "$scratch"
    if diff -q <(grep -v '^generated: ' "$out") <(grep -v '^generated: ' "$scratch") >/dev/null; then
      echo "decision-index --check: ok — $out is current as of $sha"
      rm -f "$scratch"
      return 0
    else
      echo "decision-index --check: STALE — $out does not match the store at $sha" >&2
      rm -f "$scratch"
      return 1
    fi
  fi

  render_index "$dir" "$sha" "$generated" > "$out"
  echo "decision-index: wrote $out ($file_count decision(s), sha $sha)"
}

wrote_any=0
any_failed=0

if [[ -d "$project/docs/decisions" ]]; then
  if process_store "$project/docs/decisions" "$project"; then wrote_any=1; else any_failed=1; fi
fi

ws_conf="$project/workspace.json"
if [[ -f "$ws_conf" ]]; then
  while IFS= read -r repo_path; do
    [[ -n "$repo_path" ]] || continue
    case "$repo_path" in
      /*) abs_path="$repo_path" ;;
      *) abs_path="$project/$repo_path" ;;
    esac
    if [[ -d "$abs_path/docs/decisions" ]]; then
      if process_store "$abs_path/docs/decisions" "$abs_path"; then wrote_any=1; else any_failed=1; fi
    fi
  done < <(jq -r '(.repos // [])[].path' "$ws_conf" 2>/dev/null)
fi

if [[ "$wrote_any" -eq 0 && "$any_failed" -eq 0 ]]; then
  echo "decision-index: no docs/decisions/ found under $project (workspace root or any member repo) — nothing to do" >&2
  exit 0
fi

[[ "$any_failed" -eq 0 ]] || exit 1
